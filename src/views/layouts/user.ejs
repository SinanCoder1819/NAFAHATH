<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nafahath Perfumes & Fragrances</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.jpeg" type="image/png">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #000000; color: white; }
        .font-serif-brand { font-family: 'Playfair Display', serif; }
        .neon-accent { color: #00FFFF; }
        .neon-bg { background-color: #00FFFF; }
        .neon-btn:hover { box-shadow: 0 0 15px rgba(0, 255, 255, 0.4); }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar') %>

    <main class="flex-grow">
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <!-- GLOBAL TOAST NOTIFICATION SYSTEM -->
    <div id="ct-toast-el" class="ct-toast"></div>
    <style>
      .ct-toast {
        position: fixed; bottom: 32px; right: 32px; z-index: 9999;
        display: flex; align-items: center; gap: 12px;
        padding: 14px 20px; border-radius: 14px;
        background: rgba(8,12,20,0.95); backdrop-filter: blur(14px);
        font-size: 13px; font-weight: 600; color: #e2e8f0;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
        transform: translateY(20px); opacity: 0; transition: transform .3s, opacity .3s;
        pointer-events: none;
      }
      .ct-toast.show { transform: translateY(0); opacity: 1; }
      .ct-toast.success { border: 1px solid rgba(40,201,244,0.3); }
      .ct-toast.error   { border: 1px solid rgba(248,113,113,0.3); }
    </style>
    <script>
      function showToast(message, type = 'success') {
        const toast = document.getElementById('ct-toast-el');
        if (!toast) return;
        
        const icon = type === 'success' 
            ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#28c9f4" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>'
            : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
            
        toast.className = `ct-toast ${type} show`;
        toast.innerHTML = `${icon} <span>${message}</span>`;
        
        clearTimeout(window._toastTimeout);
        window._toastTimeout = setTimeout(() => {
          toast.classList.remove('show');
        }, 3000);
      }

      // Check URL for global messages
      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        let toastMsg = urlParams.get('toast');
        let toastType = urlParams.get('type') || 'success';
        
        if (urlParams.has('success')) {
            toastMsg = urlParams.get('success');
            toastType = 'success';
        } else if (urlParams.has('error')) {
            toastMsg = urlParams.get('error');
            toastType = 'error';
        }
        
        if (toastMsg) {
            showToast(toastMsg, toastType);
            
            // Remove toast parameters from URL without refreshing
            const newUrl = window.location.pathname + window.location.hash;
            window.history.replaceState({}, document.title, newUrl);
        }
      });
    </script>

</body>
</html>