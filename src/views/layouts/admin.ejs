<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Nafahath</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #0a0a0a;
            color: #e5e5e5;
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ──────────────────────────────────────── */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: #111;
            border-right: 1px solid #222;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
            overflow: hidden;
            transition: width 0.3s ease;
        }

        /* Profile block */
        .sb-profile {
            padding: 32px 24px 24px;
            border-bottom: 1px solid #222;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }
        .sb-avatar {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, #28c9f4, #0f6c87);
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            box-shadow: 0 4px 12px rgba(40, 201, 244, 0.2);
            transition: transform 0.2s ease;
        }
        .sb-avatar:hover {
            transform: scale(1.05);
        }
        .sb-name {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }
        .sb-email {
            font-size: 12px;
            color: #888;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
            margin-top: 4px;
        }

        /* Nav */
        .sb-nav {
            flex: 1;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
        }
        .sb-nav::-webkit-scrollbar { width: 4px; }
        .sb-nav::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 500;
            color: #888;
            text-decoration: none;
            border-radius: 8px;
            white-space: nowrap;
            transition: all 0.2s ease;
            position: relative;
        }
        .sb-link svg {
            width: 18px;
            height: 18px;
            opacity: 0.7;
            transition: all 0.2s ease;
        }
        .sb-link:hover {
            background: rgba(255,255,255,0.04);
            color: #fff;
            transform: translateX(4px);
        }
        .sb-link:hover svg {
            opacity: 1;
            color: #28c9f4;
        }
        .sb-link.active {
            background: rgba(40, 201, 244, 0.1);
            color: #28c9f4;
            font-weight: 600;
        }
        .sb-link.active svg {
            opacity: 1;
            color: #28c9f4;
        }
        .sb-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            height: 20px;
            width: 3px;
            background: #28c9f4;
            border-radius: 0 4px 4px 0;
        }

        /* Sign out */
        .sb-footer {
            flex-shrink: 0;
            padding: 20px 16px;
            border-top: 1px solid #222;
        }
        .sb-signout {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 500;
            color: #888;
            background: transparent;
            border: 1px solid transparent;
            width: 100%;
            text-decoration: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .sb-signout:hover {
            background: rgba(248,113,113,0.08);
            border-color: rgba(248,113,113,0.2);
            color: #f87171;
            transform: translateX(4px);
        }
        .sb-signout svg { 
            width: 18px;
            height: 18px;
            opacity: 0.8; 
            transition: all 0.2s ease;
        }
        .sb-signout:hover svg {
            opacity: 1;
            color: #f87171;
        }

        /* ── Main content ─────────────────────────────────── */
        .main-content {
            margin-left: 240px;
            flex: 1;
            min-width: 0;
            padding: 48px 56px;
            transition: margin-left 0.3s ease, opacity 0.3s ease;
            opacity: 1;
        }

        /* Page Transition Classes */
        body.page-transitioning .main-content {
            opacity: 0;
        }

        /* Top Loader Bar */
        .top-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 3px;
            background: #00FFFF;
            z-index: 9999;
            transition: width 0.3s ease;
            box-shadow: 0 0 10px #00FFFF;
            opacity: 0;
        }
        .top-loader.loading {
            width: 70%;
            opacity: 1;
            transition: width 2s cubic-bezier(0.1, 0.5, 0.1, 1);
        }
    </style>
</head>
<body>

<% if (typeof admin !== 'undefined' && admin) { %>
<aside class="sidebar">

    <div class="sb-profile">
        <div class="sb-avatar"><%= admin.name ? admin.name.charAt(0).toUpperCase() : 'A' %></div>
        <div class="sb-name"><%= admin.name || 'Admin' %></div>
        <div class="sb-email"><%= admin.email || 'admin@nafahath.com' %></div>
    </div>

    <nav class="sb-nav">
        <a href="/admin/dashboard" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
