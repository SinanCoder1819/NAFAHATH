        </a>
        <a href="#" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
            Orders
        </a>
        <a href="/admin/products" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" />
            </svg>
            Products
        </a>
        <a href="/admin/categories" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'categories' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
            </svg>
            Category
        </a>
        <a href="/admin/customers" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Customers
        </a>
        <a href="#" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'coupon' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
            </svg>
            Coupon
        </a>
        <a href="#" class="sb-link <%= typeof activePage !== 'undefined' && activePage === 'sales_report' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
            Sales Report
        </a>
    </nav>

    <div class="sb-footer">
        <form action="/admin/logout" method="POST">
            <button type="submit" class="sb-signout">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"/>
                </svg>
                Sign Out
            </button>
        </form>
    </div>

</aside>
<% } %>

<main class="main-content">
    <%- body %>
</main>

<div class="top-loader" id="topLoader"></div>

<script>
    // Helper to execute scripts in order (handles external src and inline scripts)
    async function executeScripts(container) {
        const scripts = Array.from(container.querySelectorAll('script'));
        for (const oldScript of scripts) {
            await new Promise((resolve) => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                newScript.textContent = oldScript.textContent;
                
                if (newScript.src) {
                    newScript.onload = resolve;
                    newScript.onerror = resolve;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                } else {
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                    resolve();
                }
            });
        }
    }

    // Global Toast Function
    window.showToast = function(message, type = 'success') {
      const toast = document.getElementById('ct-toast-el');
      if (!toast) return;
      
      const icon = type === 'success' 
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#28c9f4" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
          
      toast.className = `ct-toast ${type} show`;
      toast.innerHTML = `${icon} <span>${message}</span>`;
      
      clearTimeout(window._toastTimeout);
      window._toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    };

    // Utility to read and show toast, then clean up params
    function cleanUrlParams() {
        const urlParams = new URLSearchParams(window.location.search);
        let toastMsg = urlParams.get('toast');
        let toastType = urlParams.get('type') || 'success';
        
        if (urlParams.has('success')) {
            toastMsg = urlParams.get('success');
            toastType = 'success';
        } else if (urlParams.has('error')) {
            toastMsg = urlParams.get('error');
            toastType = 'error';
        }
        
        if (toastMsg) {
            window.showToast(toastMsg, toastType);
        }

        // Clean URL
        const url = new URL(window.location);
        let changed = false;
        if (url.searchParams.has('success') || url.searchParams.has('error') || url.searchParams.has('toast')) {
            url.searchParams.delete('success');
            url.searchParams.delete('error');
            url.searchParams.delete('toast');
            url.searchParams.delete('type');
            changed = true;
        }
        if (changed) {
            window.history.replaceState({}, '', url.toString());
        }
    }

    // Check on initial hard load
    document.addEventListener('DOMContentLoaded', cleanUrlParams);

    // Main PJAX Navigation Function
    async function navigateTo(url, pushToHistory = true) {
        const topLoader = document.getElementById('topLoader');
        const mainContent = document.querySelector('.main-content');
        
        // Start Loading Animation
        topLoader.classList.add('loading');
        document.body.classList.add('page-transitioning');
        
        try {
            // Fetch the new page
            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const html = await response.text();
            
            // Parse HTML
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const newMain = doc.querySelector('.main-content');
            
            if (newMain) {
                // Swap HTML
                mainContent.innerHTML = newMain.innerHTML;
                
                // Re-execute scripts synchronously
                await executeScripts(mainContent);
                
                // Update URL using response.url to handle server redirects correctly
                if (pushToHistory) {
                    window.history.pushState({}, '', response.url);
                }
                
                // Immediately clean up success/error parameters from the URL bar
                cleanUrlParams();
                
                // Update Sidebar Active State
                document.querySelectorAll('.sb-link').forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === new URL(response.url).pathname) {
                        link.classList.add('active');
                    }
                });

                // Manually trigger DOMContentLoaded for any scripts that rely on it
                window.document.dispatchEvent(new Event('DOMContentLoaded', { bubbles: true, cancelable: true }));
            } else {
                // Fallback to normal navigation if parsing fails
                window.location.href = url;
            }
        } catch (err) {
            console.error("PJAX Error:", err);
            window.location.href = url; // Fallback
        } finally {
            // End Animation
            topLoader.classList.remove('loading');
            document.body.classList.remove('page-transitioning');
        }
    }

    // Intercept all internal link clicks for true SPA experience
    document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;
        
        const href = link.getAttribute('href');
        
        // Ignore external, empty, or special links
        if (!href || href === '#' || href.startsWith('javascript:') || href.startsWith('mailto:')) return;
        if (link.hostname && link.hostname !== window.location.hostname) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;

        // Ignore if clicking the exact same URL
        if (href === window.location.pathname + window.location.search) return;
        
        e.preventDefault();
        navigateTo(href);
    });

    // Handle Browser Back/Forward Buttons
    window.addEventListener('popstate', () => {
        navigateTo(window.location.href, false);
    });
</script>

<!-- GLOBAL TOAST NOTIFICATION SYSTEM -->
<div id="ct-toast-el" class="ct-toast"></div>
<style>
  .ct-toast {
    position: fixed; bottom: 32px; right: 32px; z-index: 9999;
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px; border-radius: 14px;
    background: rgba(8,12,20,0.95); backdrop-filter: blur(14px);
    font-size: 13px; font-weight: 600; color: #e2e8f0;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    transform: translateY(20px); opacity: 0; transition: transform .3s, opacity .3s;
    pointer-events: none;
  }
  .ct-toast.show { transform: translateY(0); opacity: 1; }
  .ct-toast.success { border: 1px solid rgba(40,201,244,0.3); }
  .ct-toast.error   { border: 1px solid rgba(248,113,113,0.3); }
</style>


</body>
</html>
