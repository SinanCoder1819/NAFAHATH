<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ══════════════════════════════════
   BASE
══════════════════════════════════ */
.ap-page {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: #c8cdd8;
  padding: 28px 32px 60px;
  max-width: 1160px;
  margin: 0 auto;
}

/* ══════════════════════════════════
   TOP NAV BAR
══════════════════════════════════ */
.ap-topbar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 32px;
}
.ap-breadcrumb {
  display: flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: #374151;
}
.ap-breadcrumb a { color: #374151; text-decoration: none; transition: color .2s; }
.ap-breadcrumb a:hover { color: #28c9f4; }
.ap-breadcrumb .sep { color: #1f2937; }
.ap-breadcrumb .current { color: #6b7280; }

.ap-back-btn {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 12px; font-weight: 600; color: #4a5568;
  text-decoration: none; padding: 8px 14px; border-radius: 9px;
  border: 1px solid rgba(255,255,255,0.07);
  background: rgba(255,255,255,0.03);
  transition: all .2s;
}
.ap-back-btn:hover { color: #e2e8f0; border-color: rgba(255,255,255,0.14); background: rgba(255,255,255,0.07); }

/* ══════════════════════════════════
   HERO HEADER BANNER
══════════════════════════════════ */
.ap-hero {
  position: relative;
  padding: 36px 44px;
  border-radius: 20px;
  background: linear-gradient(135deg, #0d1b2a 0%, #0f2337 45%, #091828 100%);
  border: 1px solid rgba(40,201,244,0.1);
  overflow: hidden;
  margin-bottom: 36px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(40,201,244,0.05);
}
.ap-hero::before {
  content: '';
  position: absolute; top: -60px; right: -40px;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(40,201,244,0.1) 0%, transparent 70%);
  animation: apBlob 7s ease-in-out infinite;
}
.ap-hero::after {
  content: '';
  position: absolute; bottom: -40px; left: 40%;
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(120,80,255,0.07) 0%, transparent 70%);
  animation: apBlob 10s ease-in-out infinite reverse;
}
@keyframes apBlob {
  0%,100% { transform: scale(1);   opacity: .8; }
  50%      { transform: scale(1.2); opacity: 1;  }
}
.ap-hero-grid {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(40,201,244,0.04) 1px, transparent 1px);
  background-size: 28px 28px; pointer-events: none;
}
.ap-hero-inner { position: relative; z-index: 1; }
.ap-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  color: #28c9f4; margin-bottom: 10px;
  padding: 4px 10px; border: 1px solid rgba(40,201,244,0.25);
  border-radius: 20px; background: rgba(40,201,244,0.06);
}
.ap-eyebrow::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%; background: #28c9f4;
  animation: apDot 2s ease-in-out infinite;
}
@keyframes apDot {
  0%,100% { opacity:1; transform:scale(1);   }
  50%     { opacity:.4; transform:scale(0.7); }
}
.ap-hero-title {
  font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; margin: 0;
  background: linear-gradient(135deg, #ffffff 0%, #a0d8ef 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.ap-hero-sub {
  font-size: 14px; color: #374151; margin: 8px 0 0; font-weight: 400;
}

/* ══════════════════════════════════
   ERROR ALERT
══════════════════════════════════ */
.ap-alert {
  display: flex; align-items: center; gap: 12px;
  background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);
  color: #fca5a5; padding: 14px 18px; border-radius: 12px;
  font-size: 14px; font-weight: 500; margin-bottom: 28px;
}

/* ══════════════════════════════════
   FORM SECTIONS
══════════════════════════════════ */
.ap-section {
  background: rgba(14,18,27,0.7);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 18px; margin-bottom: 24px;
  backdrop-filter: blur(12px);
  box-shadow: 0 4px 24px rgba(0,0,0,0.35);
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 0;
  overflow: visible; /* keep dropdown unclipped */
  transition: border-color .3s ease, box-shadow .3s ease;
}
/* Round only the direct child columns so the section card still looks rounded */
.ap-section-label { border-radius: 18px 0 0 18px; }
.ap-section-body  { border-radius: 0 18px 18px 0; }
.ap-section:hover {
  border-color: rgba(40,201,244,0.12);
  box-shadow: 0 8px 36px rgba(0,0,0,0.45);
}

/* Section sidebar */
.ap-section-label {
  padding: 36px 28px;
  border-right: 1px solid rgba(255,255,255,0.05);
  background: rgba(0,0,0,0.15);
}
.ap-section-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: 8px;
  background: rgba(40,201,244,0.1); border: 1px solid rgba(40,201,244,0.2);
  color: #28c9f4; font-size: 12px; font-weight: 800;
  margin-bottom: 14px;
}
.ap-section-title {
  font-size: 16px; font-weight: 700; color: #e2e8f0;
  margin: 0 0 10px; letter-spacing: -0.2px;
}
.ap-section-desc {
  font-size: 12.5px; color: #374151; line-height: 1.65; margin: 0;
}

/* Section body */
.ap-section-body {
  padding: 36px 36px 28px;
}

/* ══════════════════════════════════
   FORM FIELDS
══════════════════════════════════ */
.ap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.ap-full { grid-column: span 2; }
.ap-field {
  display: flex; flex-direction: column; gap: 8px; margin-bottom: 22px;
}
.ap-field label {
  font-size: 11px; font-weight: 700; color: #28c9f4;
  text-transform: uppercase; letter-spacing: 0.1em; padding-left: 2px;
}

.ap-input {
  width: 100%;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.09);
  color: #e2e8f0;
  padding: 14px 16px;
  border-radius: 11px;
  font-size: 14px;
  outline: none;
  transition: border-color .25s, box-shadow .25s, background .25s;
  font-family: inherit;
  box-sizing: border-box;
}
.ap-input:focus {
  border-color: rgba(40,201,244,0.5);
  box-shadow: 0 0 0 3px rgba(40,201,244,0.08);
  background: rgba(40,201,244,0.03);
}
.ap-input::placeholder { color: #2d3748; }

select.ap-input {
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg fill='%2364748b' height='20' viewBox='0 0 24 24' width='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E");
  background-repeat: no-repeat; background-position: right 14px center;
  padding-right: 40px; cursor: pointer;
}
select.ap-input option { background: #0d1117; color: #e2e8f0; }
textarea.ap-input { min-height: 130px; resize: vertical; line-height: 1.65; }

/* Inline errors */
.ap-field-error {
  display: flex; align-items: center; gap: 5px;
  color: #f87171; font-size: 12px; font-weight: 500; margin-top: 4px;
  animation: apErrSlide .25s ease;
}
@keyframes apErrSlide {
  from { opacity:0; transform: translateY(-4px); }
  to   { opacity:1; transform: translateY(0);    }
}

/* ══════════════════════════════════
   CUSTOM DROPDOWN
══════════════════════════════════ */
.ap-select-wrap { position: relative; width: 100%; user-select: none; }
.ap-select-trigger {
  width: 100%; padding: 14px 16px; border-radius: 11px;
  background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.09);
  color: #e2e8f0; font-size: 14px; font-family: inherit;
  transition: all .25s; cursor: pointer;
  display: flex; justify-content: space-between; align-items: center;
}
.ap-select-trigger svg { transition: transform .25s; flex-shrink: 0; }
.ap-select-wrap.open .ap-select-trigger {
  border-color: rgba(40,201,244,0.5);
  box-shadow: 0 0 0 3px rgba(40,201,244,0.08);
  background: rgba(40,201,244,0.03);
}
.ap-select-wrap.open .ap-select-trigger svg { transform: rotate(180deg); }
.ap-select-opts {
  position: absolute; top: calc(100% + 8px); left: 0; right: 0;
  background: #0d1117; border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,0.6);
  z-index: 200; overflow: hidden;
  opacity: 0; visibility: hidden; pointer-events: none;
  transform: translateY(-8px); transition: all .2s ease;
  max-height: 220px; overflow-y: auto;
}
.ap-select-opts::-webkit-scrollbar { width: 4px; }
.ap-select-opts::-webkit-scrollbar-thumb { background: #1e2533; border-radius: 4px; }
.ap-select-wrap.open .ap-select-opts {
  opacity: 1; visibility: visible; pointer-events: all; transform: translateY(0);
}
.ap-select-opt {
  padding: 13px 18px; color: #64748b; cursor: pointer;
  transition: all .2s; border-bottom: 1px solid rgba(255,255,255,0.04);
  font-size: 14px;
}
.ap-select-opt:last-child { border-bottom: none; }
.ap-select-opt:hover { background: rgba(40,201,244,0.08); color: #28c9f4; padding-left: 24px; }
.ap-select-opt.selected { color: #28c9f4; background: rgba(40,201,244,0.05); font-weight: 600; }

/* ══════════════════════════════════
   VARIANT ROWS
══════════════════════════════════ */
.ap-variant-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  padding: 24px; margin-bottom: 16px;
  background: rgba(0,0,0,0.25);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 13px;
  position: relative;
  transition: border-color .2s;
}
.ap-variant-row:hover { border-color: rgba(255,255,255,0.09); }
.ap-variant-badge {
  position: absolute; top: -1px; left: 20px;
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  color: #28c9f4; background: rgba(40,201,244,0.1);
  border: 1px solid rgba(40,201,244,0.2); border-top: none;
  padding: 3px 10px; border-radius: 0 0 6px 6px;
}
.ap-variant-header {
  display: flex; justify-content: space-between; align-items: center;
}
.ap-remove-btn {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
  color: #f87171; border: 1px solid rgba(248,113,113,0.2);
  background: rgba(248,113,113,0.06); padding: 4px 10px;
  border-radius: 6px; cursor: pointer; transition: all .2s;
}
.ap-remove-btn:hover { background: rgba(248,113,113,0.15); border-color: rgba(248,113,113,0.4); }

.ap-add-variant-btn {
  display: inline-flex; align-items: center; gap: 7px;
  background: transparent; color: #28c9f4;
  border: 1px dashed rgba(40,201,244,0.35);
  padding: 11px 20px; border-radius: 10px;
  font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
  cursor: pointer; transition: all .25s; text-transform: uppercase;
  margin-top: 8px; font-family: inherit;
}
.ap-add-variant-btn:hover {
  background: rgba(40,201,244,0.07); border-style: solid;
  border-color: rgba(40,201,244,0.5); transform: translateY(-1px);
}

/* ══════════════════════════════════
   IMAGE UPLOAD
══════════════════════════════════ */
.ap-gallery-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  margin-top: 4px;
}
.ap-upload-box {
  height: 160px; border: 2px dashed rgba(255,255,255,0.1);
  border-radius: 13px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10px;
  cursor: pointer; transition: all .3s;
  color: #2d3748; text-align: center; padding: 20px;
  background: rgba(0,0,0,0.2); position: relative; overflow: hidden;
}
.ap-upload-box input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 10; }
.ap-upload-box:hover {
  border-color: rgba(40,201,244,0.5); background: rgba(40,201,244,0.05);
  color: #e2e8f0; transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(40,201,244,0.1);
}
/* Shimmer */
.ap-upload-box::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.03), transparent);
  transform: skewX(-25deg); transition: .7s;
}
.ap-upload-box:hover::after { left: 150%; }

.ap-upload-icon { width: 28px; height: 28px; transition: .3s; z-index: 1; }
.ap-upload-box:hover .ap-upload-icon { color: #28c9f4; transform: scale(1.15) translateY(-2px); }
.ap-upload-label { font-size: 12px; font-weight: 600; z-index: 1; }
.ap-upload-sub   { font-size: 10px; z-index: 1; letter-spacing: 0.05em; color: #1f2937; }

/* Delete image X button */
.ap-delete-img-btn {
  position: absolute; top: 8px; right: 8px; z-index: 20;
  width: 28px; height: 28px; border-radius: 50%;
  background: rgba(8,8,14,0.88); border: 1px solid rgba(248,113,113,0.5);
  color: #f87171; display: none; align-items: center; justify-content: center;
  cursor: pointer; transition: all .2s; backdrop-filter: blur(4px);
  flex-shrink: 0;
}
.ap-delete-img-btn:hover {
  background: #ef4444; border-color: transparent; color: #fff;
  transform: scale(1.15); box-shadow: 0 4px 12px rgba(239,68,68,0.5);
}
.ap-upload-box.has-preview .ap-delete-img-btn { display: flex; }

/* Image counter badge */
.ap-img-counter {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600; color: #374151;
  margin-bottom: 14px;
}
.ap-img-counter span { color: #28c9f4; }

/* Image error */
.ap-img-error {
  display: none; align-items: center; gap: 8px;
  background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2);
  color: #f87171; padding: 11px 16px; border-radius: 10px;
  font-size: 13px; font-weight: 500; margin-top: 14px;
}

/* ══════════════════════════════════
   BOTTOM ACTIONS
══════════════════════════════════ */
.ap-actions {
  display: flex; justify-content: flex-end; align-items: center; gap: 14px;
  margin-top: 36px; padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.ap-cancel-btn {
  background: transparent; color: #4a5568; border: none;
  padding: 14px 22px; font-size: 13px; font-weight: 600;
  cursor: pointer; transition: color .2s; font-family: inherit; text-decoration: none;
  display: inline-flex; align-items: center; gap: 6px;
}
.ap-cancel-btn:hover { color: #e2e8f0; }
.ap-submit-btn {
  display: inline-flex; align-items: center; gap: 9px;
  background: linear-gradient(135deg, #28c9f4, #0ea5e9);
  color: #03111a; border: 0; padding: 14px 32px;
  font-size: 14px; font-weight: 800; letter-spacing: 0.04em;
  cursor: pointer; border-radius: 12px; text-transform: uppercase;
  box-shadow: 0 6px 22px rgba(40,201,244,0.3);
  transition: all .25s; font-family: inherit;
}
.ap-submit-btn:hover {
  background: linear-gradient(135deg, #4dd8f8, #38bdf8);
  transform: translateY(-2px); box-shadow: 0 10px 30px rgba(40,201,244,0.45);
}
.ap-submit-btn:active { transform: translateY(0); }

/* ══════════════════════════════════
   CROP MODAL
══════════════════════════════════ */
.ap-modal {
  display: none; position: fixed; inset: 0; z-index: 500;
  background: rgba(0,0,0,0.82); backdrop-filter: blur(6px);
  align-items: center; justify-content: center;
}
.ap-modal.open { display: flex; }
.ap-modal-box {
  width: 100%; max-width: 620px; margin: 0 16px;
  background: #0d1117; border: 1px solid rgba(40,201,244,0.15);
  border-radius: 20px; padding: 32px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.8);
  animation: apModalIn .25s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes apModalIn {
  from { opacity:0; transform: scale(0.93) translateY(16px); }
  to   { opacity:1; transform: scale(1)    translateY(0);    }
}
.ap-modal-header {
  display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
}
.ap-modal-icon {
  width: 40px; height: 40px; border-radius: 10px;
  background: rgba(40,201,244,0.1); border: 1px solid rgba(40,201,244,0.2);
  display: flex; align-items: center; justify-content: center; color: #28c9f4;
}
.ap-modal-title { font-size: 18px; font-weight: 800; color: #fff; margin: 0; }
.ap-modal-sub   { font-size: 12px; color: #374151; margin-top: 2px; }
.ap-img-container {
  background: #000; border-radius: 12px; overflow: hidden;
  max-height: 420px; display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(255,255,255,0.06);
}
.ap-modal-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 24px 0 20px; }
.ap-modal-actions { display: flex; gap: 12px; }
.ap-modal-cancel {
  flex: 1; padding: 13px; border-radius: 11px;
  font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
  background: rgba(255,255,255,0.05); color: #9ca3af;
  border: 1px solid rgba(255,255,255,0.1); transition: all .2s;
}
.ap-modal-cancel:hover { background: rgba(255,255,255,0.09); color: #e2e8f0; }
.ap-modal-crop {
  flex: 2; padding: 13px; border-radius: 11px;
  font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit;
  background: linear-gradient(135deg, #28c9f4, #0ea5e9);
  color: #03111a; border: 0;
  box-shadow: 0 4px 16px rgba(40,201,244,0.3); transition: all .2s;
}
.ap-modal-crop:hover {
  background: linear-gradient(135deg, #4dd8f8, #38bdf8);
  box-shadow: 0 6px 22px rgba(40,201,244,0.45); transform: translateY(-1px);
}
</style>

<div class="ap-page">

  <!-- ═══════ TOP NAV ═══════ -->
  <div class="ap-topbar">
    <div class="ap-breadcrumb">
      <a href="/admin/dashboard">Dashboard</a>
      <span class="sep">/</span>
      <a href="/admin/products">Products</a>
      <span class="sep">/</span>
      <span class="current">Add New Product</span>
    </div>
    <a href="/admin/products" class="ap-back-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Back to Products
    </a>
  </div>

  <!-- ═══════ HERO BANNER ═══════ -->
  <div class="ap-hero">
    <div class="ap-hero-grid"></div>
    <div class="ap-hero-inner">
      <div class="ap-eyebrow">Product Management</div>
      <h1 class="ap-hero-title">Add New Product</h1>
      <p class="ap-hero-sub">Fill in the details below to publish a new product on the storefront.</p>
    </div>
  </div>

  <!-- ═══════ ERROR ALERT ═══════ -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="ap-alert">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="/admin/products/add" enctype="multipart/form-data" novalidate>

    <!-- ════════════════════════════════════════
         SECTION 1 — PRODUCT DETAILS
    ════════════════════════════════════════ -->
    <div class="ap-section" style="position: relative; z-index: 50;">

      <div class="ap-section-label">
        <div class="ap-section-num">1</div>
        <h3 class="ap-section-title">Product Details</h3>
        <p class="ap-section-desc">Core information displayed on the public storefront for customers to browse.</p>
      </div>

      <div class="ap-section-body">
        <div class="ap-grid">

          <div class="ap-field ap-full">
            <label>Product Name *</label>
            <input type="text" class="ap-input" name="productName" placeholder="e.g. Bleu de Chanel" required>
          </div>

          <div class="ap-field ap-full">
            <label>Product Description *</label>
            <textarea class="ap-input" name="description" placeholder="Write an engaging product description…" required></textarea>
          </div>

          <div class="ap-field">
            <label>Category *</label>
            <div class="ap-select-wrap">
              <div class="ap-select-trigger">
                <span>Select a category…</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="ap-select-opts">
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                  <% categories.forEach(cat => { %>
                    <div class="ap-select-opt" data-value="<%= cat.name %>"><%= cat.name %></div>
                  <% }) %>
                <% } else { %>
                  <div class="ap-select-opt" data-value="">No categories found</div>
                <% } %>
              </div>
              <input type="hidden" name="category" value="" id="categoryInput">
            </div>
          </div>

          <div class="ap-field">
            <label>Brand *</label>
            <input type="text" class="ap-input" name="brand" placeholder="e.g. Chanel, Dior, Versace" required>
          </div>

        </div>
      </div>
    </div>

    <!-- ════════════════════════════════════════
         SECTION 2 — VARIANTS & STOCK
    ════════════════════════════════════════ -->
    <div class="ap-section">

      <div class="ap-section-label">
        <div class="ap-section-num">2</div>
        <h3 class="ap-section-title">Variants & Stock</h3>
        <p class="ap-section-desc">Set sizes, inventory levels, and pricing for each product variant.</p>
      </div>

      <div class="ap-section-body">
        <div id="variantsContainer">
          <div class="ap-variant-row">
            <div class="ap-variant-badge">Variant 1</div>

            <div class="ap-field">
              <label>Format / Size</label>
              <select class="ap-input" name="variantSize[]">
                <option value="5ml">5 ml</option>
                <option value="15ml">15 ml</option>
                <option value="30ml">30 ml</option>
                <option value="50ml">50 ml</option>
                <option value="100ml">100 ml</option>
                <option value="200ml">200 ml</option>
              </select>
            </div>

            <div class="ap-field">
              <div class="ap-variant-header">
                <label style="padding-left:0;">Stock Quantity</label>
                <button type="button" class="ap-remove-btn">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  Remove
                </button>
              </div>
              <input type="number" class="ap-input" name="stock[]" placeholder="0" min="0">
            </div>

            <div class="ap-field">
              <label>Regular Price (MRP)</label>
              <input type="number" class="ap-input" name="regularPrice[]" placeholder="0.00" step="0.01">
            </div>

            <div class="ap-field">
              <label>Sale Price</label>
              <input type="number" class="ap-input" name="salePrice[]" placeholder="0.00" step="0.01">
            </div>
          </div>
        </div>

        <button type="button" class="ap-add-variant-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
          </svg>
          Add Variant
        </button>
      </div>
    </div>

    <!-- ════════════════════════════════════════
         SECTION 3 — PRODUCT IMAGES
    ════════════════════════════════════════ -->
    <div class="ap-section">

      <div class="ap-section-label">
        <div class="ap-section-num">3</div>
        <h3 class="ap-section-title">Product Images</h3>
        <p class="ap-section-desc">Upload 2–4 high-quality images. Each will be cropped to 1:1 square before saving.</p>
      </div>

      <div class="ap-section-body">

        <div class="ap-img-counter">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          Upload <span id="imgCountDisplay">0</span> / 4 images &nbsp;·&nbsp; Minimum 2 required
        </div>

        <div class="ap-gallery-grid">
          <div class="ap-upload-box" id="galleryBox1">
            <input type="file" name="galleryImage1" accept="image/*">
            <button type="button" class="ap-delete-img-btn" title="Remove image">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <svg class="ap-upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            <span class="ap-upload-label">Upload Photo 1</span>
            <span class="ap-upload-sub">Required</span>
          </div>

          <div class="ap-upload-box" id="galleryBox2" style="display:none;">
            <input type="file" name="galleryImage2" accept="image/*">
            <button type="button" class="ap-delete-img-btn" title="Remove image">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <svg class="ap-upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            <span class="ap-upload-label">Upload Photo 2</span>
            <span class="ap-upload-sub">Required</span>
          </div>

          <div class="ap-upload-box" id="galleryBox3" style="display:none;">
            <input type="file" name="galleryImage3" accept="image/*">
            <button type="button" class="ap-delete-img-btn" title="Remove image">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <svg class="ap-upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            <span class="ap-upload-label">Upload Photo 3</span>
            <span class="ap-upload-sub">Optional</span>
          </div>

          <div class="ap-upload-box" id="galleryBox4" style="display:none;">
            <input type="file" name="galleryImage4" accept="image/*">
            <button type="button" class="ap-delete-img-btn" title="Remove image">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <svg class="ap-upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            <span class="ap-upload-label">Upload Photo 4</span>
            <span class="ap-upload-sub">Optional</span>
          </div>
        </div>

        <div id="imageError" class="ap-img-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          You must upload between 2 and 4 photos.
        </div>

      </div>
    </div>

    <!-- ════════════════════════════════════════
         SUBMIT ACTIONS
    ════════════════════════════════════════ -->
    <div class="ap-actions">
      <a href="/admin/products" class="ap-cancel-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Cancel
      </a>
      <button type="submit" class="ap-submit-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        Publish Product
      </button>
    </div>

  </form>
</div><!-- /ap-page -->

<!-- ═══════════════════════════════════════ CROP MODAL ═══════════════════════════════════════ -->
<div id="cropModal" class="ap-modal">
  <div class="ap-modal-box">
    <div class="ap-modal-header">
      <div class="ap-modal-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/>
        </svg>
      </div>
      <div>
        <h2 class="ap-modal-title">Crop Image</h2>
        <p class="ap-modal-sub">Drag to select the crop area — output is 1200 × 1200 px</p>
      </div>
    </div>

    <div class="ap-img-container">
      <img id="imageToCrop" src="" style="max-width:100%; display:block;">
    </div>

    <div class="ap-modal-divider"></div>
    <div class="ap-modal-actions">
      <button id="cancelCropBtn" type="button" class="ap-modal-cancel">Cancel</button>
      <button id="saveCropBtn"   type="button" class="ap-modal-crop">
        <span>✓</span> Crop & Save
      </button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ─────────────────────────────
     1. ADD / REMOVE VARIANT
  ───────────────────────────── */
  const addVariantBtn     = document.querySelector('.ap-add-variant-btn');
  const variantsContainer = document.getElementById('variantsContainer');
  

  

  addVariantBtn.addEventListener('click', function () {
    const allRows  = variantsContainer.querySelectorAll('.ap-variant-row');
    const newRow   = allRows[0].cloneNode(true);
    const num      = allRows.length + 1;
    newRow.querySelector('.ap-variant-badge').textContent = 'Variant ' + num;
    newRow.querySelectorAll('input').forEach(inp => inp.value = '');
    variantsContainer.appendChild(newRow);
  });

  variantsContainer.addEventListener('click', function (e) {
    const btn = e.target.closest('.ap-remove-btn');
    if (!btn) return;
    const allRows = variantsContainer.querySelectorAll('.ap-variant-row');
    if (allRows.length > 1) {
      btn.closest('.ap-variant-row').remove();
      // Re-number badges
      variantsContainer.querySelectorAll('.ap-variant-row').forEach((row, i) => {
        row.querySelector('.ap-variant-badge').textContent = 'Variant ' + (i + 1);
      });
    } else {
      alert('You must keep at least one variant.');
    }
  });

  /* ─────────────────────────────
     2. IMAGE CROPPING
  ───────────────────────────── */
  let cropper           = null;
  let currentFileInput  = null;
  let currentPreviewBox = null;

  const cropModal    = document.getElementById('cropModal');
  const imageToCrop  = document.getElementById('imageToCrop');
  const cancelCropBtn= document.getElementById('cancelCropBtn');
  const saveCropBtn  = document.getElementById('saveCropBtn');
  const imgCounter   = document.getElementById('imgCountDisplay');

  function updateImgCounter () {
    imgCounter.textContent = document.querySelectorAll('.gallery-box-preview').length;
  }

  document.querySelectorAll('.ap-upload-box').forEach(box => {
    const fileInput = box.querySelector('input[type="file"]');
    fileInput.addEventListener('change', function () {
      if (!this.files || !this.files[0]) return;
      const reader = new FileReader();
      reader.onload = function (ev) {
        currentFileInput  = fileInput;
        currentPreviewBox = box;
        imageToCrop.src   = ev.target.result;
        cropModal.classList.add('open');
        setTimeout(() => {
          if (cropper) cropper.destroy();
          cropper = new Cropper(imageToCrop, {
            aspectRatio: 1, viewMode: 2, background: false,
          });
        }, 100);
      };
      reader.readAsDataURL(this.files[0]);
    });
  });

  cancelCropBtn.addEventListener('click', () => {
    cropModal.classList.remove('open');
    if (cropper) { cropper.destroy(); cropper = null; }
    if (currentFileInput) currentFileInput.value = '';
  });

  saveCropBtn.addEventListener('click', () => {
    if (!cropper) return;
    cropper.getCroppedCanvas({ width: 1200, height: 1200 }).toBlob(blob => {
      const fileName    = currentFileInput.files[0].name || 'cropped.jpg';
      const croppedFile = new File([blob], fileName, { type: 'image/jpeg', lastModified: Date.now() });
      const dt = new DataTransfer();
      dt.items.add(croppedFile);
      currentFileInput.files = dt.files;

      /* Show preview */
      let preview = currentPreviewBox.querySelector('.gallery-box-preview');
      if (!preview) {
        preview = document.createElement('img');
        preview.className = 'gallery-box-preview';
        Object.assign(preview.style, {
          position:'absolute', inset:'0', width:'100%', height:'100%',
          objectFit:'cover', borderRadius:'11px', zIndex:'1', opacity:'.85',
        });
        currentPreviewBox.insertBefore(preview, currentPreviewBox.firstChild);
      }
      preview.src = URL.createObjectURL(blob);
      currentPreviewBox.classList.add('has-preview');

      cropModal.classList.remove('open');
      cropper.destroy(); cropper = null;

      /* Unlock next box */
      const boxMap = {
        galleryBox1: 'galleryBox2',
        galleryBox2: 'galleryBox3',
        galleryBox3: 'galleryBox4',
      };
      const nextId = boxMap[currentPreviewBox.id];
      if (nextId) document.getElementById(nextId).style.display = 'flex';

      updateImgCounter();
    }, 'image/jpeg', 0.9);
  });

  /* ─────────────────────────────
     3. DELETE IMAGE BUTTON
  ───────────────────────────── */
  document.querySelector('.ap-gallery-grid').addEventListener('click', function (e) {
    const delBtn = e.target.closest('.ap-delete-img-btn');
    if (!delBtn) return;
    e.stopPropagation(); /* prevent file picker opening */

    const box     = delBtn.closest('.ap-upload-box');
    const preview = box.querySelector('.gallery-box-preview');
    if (preview) preview.remove();
    const fileInput = box.querySelector('input[type="file"]');
    if (fileInput) fileInput.value = '';
    box.classList.remove('has-preview');

    /* Cascade: hide subsequent empty boxes */
    const order = ['galleryBox1','galleryBox2','galleryBox3','galleryBox4'];
    const idx   = order.indexOf(box.id);
    for (let i = idx + 1; i < order.length; i++) {
      const nextBox = document.getElementById(order[i]);
      if (!nextBox) continue;
      if (!nextBox.classList.contains('has-preview')) {
        nextBox.style.display = 'none';
        const nf = nextBox.querySelector('input[type="file"]');
        if (nf) nf.value = '';
      }
    }
    updateImgCounter();
  });

  /* ─────────────────────────────
     4. CUSTOM DROPDOWN
  ───────────────────────────── */
  document.querySelectorAll('.ap-select-wrap').forEach(wrap => {
    const trigger    = wrap.querySelector('.ap-select-trigger');
    const hidden     = wrap.querySelector('input[type="hidden"]');
    const opts       = wrap.querySelectorAll('.ap-select-opt');
    const textSpan   = trigger.querySelector('span');

    trigger.addEventListener('click', e => { e.stopPropagation(); wrap.classList.toggle('open'); });
    opts.forEach(opt => {
      opt.addEventListener('click', () => {
        opts.forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        hidden.value       = opt.dataset.value;
        textSpan.textContent = opt.textContent;
        wrap.classList.remove('open');
      });
    });
    document.addEventListener('click', e => { if (!wrap.contains(e.target)) wrap.classList.remove('open'); });
  });

  /* ─────────────────────────────
     4. FORM VALIDATION
  ───────────────────────────── */
  const productForm = document.querySelector('form[enctype="multipart/form-data"]');
  if (!productForm) return;

  productForm.addEventListener('submit', function (e) {
    let isValid = true;

    /* Clear old errors */
    document.querySelectorAll('.ap-field-error-inline').forEach(el => el.remove());
    document.querySelectorAll('.ap-input').forEach(el => el.style.borderColor = '');
    document.querySelectorAll('.ap-select-trigger').forEach(el => el.style.borderColor = '');
    document.getElementById('imageError').style.display = 'none';

    function showErr(inputEl, msg) {
      const field = inputEl.closest('.ap-field');
      if (!field) return;
      if (field.querySelector('.ap-field-error-inline')) return;

      const errDiv = document.createElement('div');
      errDiv.className = 'ap-field-error ap-field-error-inline';
      errDiv.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg> ${msg}`;

      const wrap = field.querySelector('.ap-select-wrap');
      if (wrap) {
        wrap.after(errDiv);
        wrap.querySelector('.ap-select-trigger').style.borderColor = '#f87171';
      } else {
        inputEl.after(errDiv);
        inputEl.style.borderColor = '#f87171';
      }

      if (isValid) field.scrollIntoView({ behavior: 'smooth', block: 'center' });
      isValid = false;

      setTimeout(() => {
        errDiv.style.transition = 'opacity .5s';
        errDiv.style.opacity = '0';
        if (wrap) wrap.querySelector('.ap-select-trigger').style.borderColor = '';
        else { inputEl.style.transition = 'border-color .5s'; inputEl.style.borderColor = ''; }
        setTimeout(() => errDiv.remove(), 500);
      }, 4000);
    }

    const textRx   = /[a-zA-Z0-9]/;
    const nameEl   = document.querySelector('input[name="productName"]');
    const descEl   = document.querySelector('textarea[name="description"]');
    const brandEl  = document.querySelector('input[name="brand"]');
    const catEl    = document.getElementById('categoryInput');
    const name     = nameEl.value.trim();
    const desc     = descEl.value.trim();
    const brand    = brandEl.value.trim();

    if (name.length < 3)         showErr(nameEl,  'Product name must be at least 3 characters.');
    else if (!textRx.test(name)) showErr(nameEl,  'Product name must contain valid letters or numbers.');
    if (desc.length < 10)        showErr(descEl,  'Description must be at least 10 characters.');
    else if (!textRx.test(desc)) showErr(descEl,  'Description must contain valid letters or numbers.');
    if (!brand)                  showErr(brandEl, 'Brand is required.');
    else if (!textRx.test(brand))showErr(brandEl, 'Brand must contain valid letters or numbers.');
    if (catEl && catEl.value === '') showErr(catEl, 'Please select a category.');

    /* Variants */
    const stocks  = document.querySelectorAll('input[name="stock[]"]');
    const regPrices= document.querySelectorAll('input[name="regularPrice[]"]');
    const salePrices=document.querySelectorAll('input[name="salePrice[]"]');
    stocks.forEach((s, i) => {
      const sv = Number(s.value), rp = Number(regPrices[i].value), sp = Number(salePrices[i].value);
      if (sv < 0 || !Number.isInteger(sv) || s.value === '')      showErr(s,           'Stock must be a valid positive whole number.');
      if (rp <= 0 || regPrices[i].value === '') showErr(regPrices[i],'Regular price must be greater than 0.');
      if (sp < 0  || salePrices[i].value === '') showErr(salePrices[i],'Sale price cannot be negative.');
      else if (sp > 0 && sp >= rp)  showErr(salePrices[i],'Sale price must be less than regular price.');
    });

    /* Prevent Duplicate Variant Sizes */
    const variantSizes = document.querySelectorAll('select[name="variantSize[]"]');
    const selectedSizes = [];
    variantSizes.forEach((selectEl) => {
      const sizeValue = selectEl.value;
      if (selectedSizes.includes(sizeValue)) {
        showErr(selectEl, 'Duplicate variant! You cannot add the exact same size twice.');
      } else {
        selectedSizes.push(sizeValue);
      }
    });

    /* Images */
    const previewCount = document.querySelectorAll('.gallery-box-preview').length;
    if (previewCount < 2 || previewCount > 4) {
      const imgErr = document.getElementById('imageError');
      imgErr.style.display = 'flex';
      if (isValid) imgErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      isValid = false;
    }

    if (!isValid) { e.preventDefault(); return false; }
  });
});
</script>