                <td style="text-align:right;"><span class="status-pill status-cancelled">Cancelled</span></td>
            </tr>
            <tr>
                <td class="td-id">#BK-9397</td>
                <td class="td-customer">Sylvia Plath</td>
                <td>2023-10-22</td>
                <td class="td-total">₹249</td>
                <td style="text-align:right;"><span class="status-pill status-shipped">Shipped</span></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const ctx = document.getElementById('salesChart').getContext('2d');

    // Static weekly data points (Mon–Sun × 4 weeks)
    const labels = [
        'Mon','Tue','Wed','Thu','Fri','Sat','Sun',
        'Mon','Tue','Wed','Thu','Fri','Sat','Sun',
        'Mon','Tue','Wed','Thu','Fri','Sat','Sun',
        'Mon','Tue','Wed','Thu','Fri','Sat','Sun'
    ];
    const data = [
        320, 290, 340, 310, 380, 420, 400,
        430, 410, 460, 490, 520, 580, 560,
        600, 570, 620, 650, 700, 740, 720,
        760, 730, 780, 820, 870, 910, 940
    ];

    // Gradient fill
    const gradient = ctx.createLinearGradient(0, 0, 0, 180);
    gradient.addColorStop(0,   'rgba(255,255,255,0.12)');
    gradient.addColorStop(1,   'rgba(255,255,255,0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                data,
                borderColor: '#ffffff',
                borderWidth: 1.8,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointHoverBackgroundColor: '#fff',
                fill: true,
                backgroundColor: gradient,
                tension: 0.4,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1a1a1a',
                    borderColor: '#2d2d2d',
                    borderWidth: 1,
                    titleColor: '#9ca3af',
                    bodyColor: '#fff',
                    titleFont: { size: 11, family: 'Inter' },
                    bodyFont: { size: 13, family: 'Inter', weight: '600' },
                    padding: 10,
                    callbacks: {
                        label: ctx => ' ₹' + ctx.parsed.y.toLocaleString()
                    }
                }
            },
            scales: {
                x: {
                    display: false,
                    grid: { display: false },
                },
                y: {
                    display: false,
                    grid: { display: false },
                    min: 200,
                }
            }
        }
    });
})();
</script>
