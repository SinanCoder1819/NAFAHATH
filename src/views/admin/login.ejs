<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,600&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
        font-family: 'Outfit', sans-serif;
        background-color: #030712;
        background-image: 
            radial-gradient(circle at 15% 50%, rgba(0, 255, 255, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 85% 30%, rgba(0, 191, 255, 0.05) 0%, transparent 50%);
        color: #fff;
        min-height: 100vh;
        overflow: hidden;
    }

    .admin-login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        position: relative;
        z-index: 1;
    }

    /* Ambient animated glow behind the card */
    .admin-login-wrap::before {
        content: '';
        position: absolute;
        width: 600px;
        height: 600px;
        background: linear-gradient(45deg, #00FFFF, #00BFFF, #0ea5e9);
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.15;
        animation: pulse-glow 8s infinite alternate;
        z-index: -1;
    }

    @keyframes pulse-glow {
        0% { transform: scale(0.8) translate(0, 0); opacity: 0.1; }
        100% { transform: scale(1.2) translate(-20px, 20px); opacity: 0.2; }
    }

    .admin-login-card {
        width: 100%;
        max-width: 440px;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 48px 40px;
        box-shadow: 
            0 25px 50px -12px rgba(0, 0, 0, 0.7),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
    }

    /* Card subtle gradient border top */
    .admin-login-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.5), transparent);
    }

    .al-title { 
        font-family: 'Playfair Display', serif;
        font-size: 32px; 
        color: #fff; 
        text-align: center; 
        margin-bottom: 8px;
        letter-spacing: 0.02em;
    }
    
    .al-sub { 
        font-size: 14px; 
        color: #94a3b8; 
        text-align: center; 
        margin-bottom: 36px;
        font-weight: 300;
        letter-spacing: 0.05em;
    }

    /* Alert */
    .al-alert {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        text-align: center;
        margin-bottom: 24px;
        display: none;
        backdrop-filter: blur(10px);
    }
    .al-alert.show { display: block; animation: slideDown 0.3s ease; }
    @keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .al-alert-error   { background: rgba(239, 68, 68, 0.1); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.2); }
    .al-alert-success { background: rgba(34, 197, 94, 0.1); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.2); }

    /* Form */
    .al-group { margin-bottom: 24px; }
    .al-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #cbd5e1;
        margin-bottom: 8px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .al-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 14px 16px;
        font-size: 14px;
        color: #fff;
        font-family: inherit;
        outline: none;
        transition: all 0.3s ease;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
    }
    .al-input::placeholder { color: #64748b; font-weight: 300; }
    .al-input:focus { 
        background: rgba(0, 255, 255, 0.02);
        border-color: #00FFFF; 
        box-shadow: 0 0 0 4px rgba(0, 255, 255, 0.1), inset 0 2px 4px rgba(0,0,0,0.2);
    }
    .al-input-wrap { position: relative; }
    .al-eye {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #64748b;
        padding: 4px;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }
    .al-eye:hover { color: #00FFFF; }

    /* Submit */
    .al-submit {
        width: 100%;
        background: linear-gradient(135deg, #00FFFF 0%, #00BFFF 100%);
        color: #000;
        font-size: 14px;
        font-weight: 700;
        padding: 16px 0;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: all 0.3s ease;
        margin-top: 12px;
        box-shadow: 0 10px 20px -5px rgba(0, 255, 255, 0.3);
    }
    .al-submit:hover { 
        transform: translateY(-2px);
        box-shadow: 0 15px 25px -5px rgba(0, 255, 255, 0.4);
        background: linear-gradient(135deg, #33FFFF 0%, #33CCFF 100%);
    }
    .al-submit:active { transform: translateY(0); }
    .al-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* Brand Logo / Top Icon placeholder */
    .brand-icon {
        width: 60px;
        height: 60px;
        background: rgba(0, 255, 255, 0.1);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        color: #00FFFF;
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.15);
        transform: rotate(45deg);
    }
    .brand-icon svg {
        transform: rotate(-45deg);
        width: 28px;
        height: 28px;
    }

    /* Loading overlay */
    .al-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(3, 7, 18, 0.8);
        backdrop-filter: blur(8px);
        align-items: center;
        justify-content: center;
    }
    .al-overlay.show { display: flex; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    
    .al-loading-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px 48px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
    }
    .al-spinner {
        width: 48px;
        height: 48px;
        border: 3px solid rgba(0, 255, 255, 0.1);
        border-top-color: #00FFFF;
        border-radius: 50%;
        animation: al-spin 0.8s cubic-bezier(0.5, 0, 0.5, 1) infinite;
        margin-bottom: 20px;
    }
    @keyframes al-spin { to { transform: rotate(360deg); } }
    .al-loading-title { font-size: 16px; font-weight: 600; color: #fff; letter-spacing: 0.05em; }
    .al-loading-sub   { font-size: 13px; color: #94a3b8; margin-top: 6px; }
</style>

<div class="admin-login-wrap">
    <div class="admin-login-card">
        
        <div class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
        </div>

        <h1 class="al-title">Nafahath Admin</h1>
        <p class="al-sub">Enter your credentials to access the dashboard.</p>

        <!-- Server-side error (e.g. from session flash) -->
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="al-alert al-alert-error show"><%= error %></div>
        <% } %>

        <!-- JS response message -->
        <div id="alMsg" class="al-alert"></div>

        <form id="adminLoginForm" novalidate>

            <div class="al-group">
                <label class="al-label" for="alEmail">Email Address</label>
                <input type="email" id="alEmail" name="email" placeholder="Enter your email address"
                       class="al-input" autocomplete="email" required />
            </div>

            <div class="al-group">
                <label class="al-label" for="alPassword">Password</label>
                <div class="al-input-wrap">
                    <input type="password" id="alPassword" name="password" placeholder="Enter your password"
                           class="al-input" style="padding-right:42px" autocomplete="current-password" required />
                    <button type="button" id="alEyeBtn" class="al-eye" aria-label="Toggle password">
                        <svg id="alEyeOpen" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <svg id="alEyeClosed" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="display:none">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
                        </svg>
                    </button>
                </div>
            </div>

            <button type="submit" id="alSubmit" class="al-submit">Login</button>
        </form>
    </div>
</div>

<!-- Loading overlay -->
<div id="alOverlay" class="al-overlay">
    <div class="al-loading-box">
        <div class="al-spinner"></div>
        <p class="al-loading-title">Authenticating</p>
        <p class="al-loading-sub">Verifying your credentials...</p>
    </div>
</div>

<script>
(function () {
    // Eye toggle
    const pwInput = document.getElementById('alPassword');
    const eyeOpen = document.getElementById('alEyeOpen');
    const eyeClosed = document.getElementById('alEyeClosed');

    document.getElementById('alEyeBtn').addEventListener('click', () => {
        const show = pwInput.type === 'password';
        pwInput.type = show ? 'text' : 'password';
        eyeOpen.style.display = show ? 'none' : '';
        eyeClosed.style.display = show ? '' : 'none';
    });

    // Message helper
    const msgDiv = document.getElementById('alMsg');
    function showMsg(text, type) {
        msgDiv.textContent = text;
        msgDiv.className = 'al-alert show ' + (type === 'error' ? 'al-alert-error' : 'al-alert-success');
    }
    function hideMsg() { msgDiv.className = 'al-alert'; }

    // Form submit
    const form = document.getElementById('adminLoginForm');
    const submitBtn = document.getElementById('alSubmit');
    const overlay = document.getElementById('alOverlay');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideMsg();
        overlay.classList.add('show');
        submitBtn.disabled = true;

        try {
            const res  = await fetch('/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: document.getElementById('alEmail').value.trim(),
                    password: pwInput.value,
                }),
            });
            const data = await res.json();

            if (res.ok) {
                showMsg('Login successful! Redirecting...', 'success');
                setTimeout(() => { window.location.href = data.redirectUrl || '/admin/dashboard'; }, 800);
            } else {
                overlay.classList.remove('show');
                submitBtn.disabled = false;
                showMsg(data.message || 'Invalid credentials.', 'error');
            }
        } catch {
            overlay.classList.remove('show');
            submitBtn.disabled = false;
            showMsg('Connection error. Please try again.', 'error');
        }
    });
})();
</script>
