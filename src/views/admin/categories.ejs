<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ── Base ── */
/* Offer column removed — managed via dedicated offers section */
.cat-page {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: #ffffff;
  padding: 28px 32px 48px;
  min-height: 100vh;
  position: relative;
}

/* ── Hero header ── */
.cat-header {
  position: relative;
  margin-bottom: 36px;
  padding: 36px 40px;
  border-radius: 20px;
  background: linear-gradient(135deg, #0d1b2a 0%, #0f2337 40%, #0b1e35 70%, #091828 100%);
  border: 1px solid rgba(40, 201, 244, 0.12);
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(40, 201, 244, 0.08);
}

/* Animated glow blobs */
.cat-header::before {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 280px;
  height: 280px;
  background: radial-gradient(circle, rgba(40, 201, 244, 0.12) 0%, transparent 70%);
  animation: blobPulse 6s ease-in-out infinite;
}
.cat-header::after {
  content: '';
  position: absolute;
  bottom: -40px;
  left: 30%;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(100, 80, 255, 0.08) 0%, transparent 70%);
  animation: blobPulse 8s ease-in-out infinite reverse;
}
@keyframes blobPulse {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.2); opacity: 1; }
}

/* Grid dots */
.cat-header-grid {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle, rgba(40, 201, 244, 0.06) 1px, transparent 1px);
  background-size: 28px 28px;
  pointer-events: none;
}

.cat-header-inner {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

/* Left side — title + search */
.cat-header-left { flex: 1; min-width: 260px; }

.cat-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #28c9f4;
  margin-bottom: 10px;
  padding: 4px 10px;
  border: 1px solid rgba(40, 201, 244, 0.25);
  border-radius: 20px;
  background: rgba(40, 201, 244, 0.06);
}
.cat-eyebrow::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #28c9f4;
  animation: dot-pulse 2s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}

.cat-title {
  font-size: 34px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 20px;
  letter-spacing: -1px;
  line-height: 1.1;
  background: linear-gradient(135deg, #ffffff 0%, #a0d8ef 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Search bar */
.cat-search-form { width: 100%; max-width: 420px; }
.cat-search-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 10px 16px;
  transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  backdrop-filter: blur(8px);
}
.cat-search-bar:focus-within {
  border-color: rgba(40, 201, 244, 0.5);
  background: rgba(40, 201, 244, 0.04);
  box-shadow: 0 0 0 3px rgba(40, 201, 244, 0.08), 0 4px 20px rgba(40, 201, 244, 0.08);
}
.cat-search-icon {
  color: #ffffff;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.cat-search-bar input {
  flex: 1;
  background: transparent;
  border: 0;
  outline: 0;
  color: #ffffff;
  font-size: 14px;
  font-family: inherit;
}
.cat-search-bar input::placeholder { color: #4a5568; }

.cat-search-btn {
  background: linear-gradient(135deg, #28c9f4, #0ea5e9);
  color: #03111a;
  border: none;
  padding: 6px 16px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.04em;
  transition: all 0.2s ease;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(40, 201, 244, 0.25);
}
.cat-search-btn:hover {
  background: linear-gradient(135deg, #4dd8f8, #38bdf8);
  box-shadow: 0 4px 14px rgba(40, 201, 244, 0.4);
  transform: translateY(-1px);
}

.cat-clear-btn {
  background: transparent;
  border: 0;
  color: #667;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
  transition: color 0.2s ease;
  flex-shrink: 0;
  text-decoration: none;
  display: inline-block;
}
.cat-clear-btn:hover { color: #f87171; }

/* Right side — stats + actions */
.cat-header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20px;
}

/* Stats chips */
.cat-stats {
  display: flex;
  gap: 12px;
}
.cat-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 20px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.03);
  min-width: 80px;
  backdrop-filter: blur(4px);
}
.cat-stat-num {
  font-size: 22px;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  margin-bottom: 3px;
}
.cat-stat-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #667;
}
.cat-stat.--active .cat-stat-num { color: #4ade80; }
.cat-stat.--inactive .cat-stat-num { color: #f87171; }

/* Action buttons */
.cat-actions { display: flex; align-items: center; gap: 12px; }

.cat-add-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #28c9f4 0%, #0ea5e9 100%);
  color: #03111a;
  border: 0;
  padding: 12px 22px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(40, 201, 244, 0.3);
  transition: all 0.25s ease;
  white-space: nowrap;
}
.cat-add-btn:hover {
  background: linear-gradient(135deg, #4dd8f8, #38bdf8);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(40, 201, 244, 0.45);
}
.cat-add-btn:active { transform: translateY(0); }
.cat-add-btn svg { flex-shrink: 0; }

.cat-sort-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #a0aec0;
  padding: 11px 18px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  cursor: pointer;
  border-radius: 10px;
  transition: all 0.2s ease;
  text-decoration: none;
}
.cat-sort-btn:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* ── Flash alerts ── */
.cat-flash {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  font-size: 14px;
  margin-bottom: 24px;
  border-radius: 12px;
  font-weight: 500;
  animation: slideDown 0.4s ease;
}
@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.cat-flash.error {
  background: rgba(248, 113, 113, 0.08);
  color: #fca5a5;
  border: 1px solid rgba(248, 113, 113, 0.2);
}
.cat-flash.success {
  background: rgba(74, 222, 128, 0.08);
  color: #86efac;
  border: 1px solid rgba(74, 222, 128, 0.2);
}
.cat-flash-icon { flex-shrink: 0; }

/* ── Table wrapper card ── */
.cat-card {
  background: rgba(14, 18, 27, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 18px;
  overflow: hidden;
  backdrop-filter: blur(12px);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
}

/* ── Table ── */
.cat-table {
  width: 100%;
  border-collapse: collapse;
}
.cat-table thead tr {
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.cat-table th {
  background: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-align: left;
  padding: 18px 24px;
  text-transform: uppercase;
}
.cat-table th:last-child { text-align: right; }

.cat-table tbody tr {
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  transition: background 0.2s ease;
  cursor: default;
}
.cat-table tbody tr:hover {
  background: rgba(40, 201, 244, 0.025);
}
.cat-table tbody tr:last-child { border-bottom: none; }
.cat-table td { padding: 22px 24px; vertical-align: middle; }

/* Category name cell */
.cat-name-cell { display: flex; align-items: center; gap: 14px; }
.cat-icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(40, 201, 244, 0.12), rgba(14, 165, 233, 0.08));
  border: 1px solid rgba(40, 201, 244, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #28c9f4;
  flex-shrink: 0;
}
.cat-name-text {
  font-weight: 700;
  color: #ffffff;
  font-size: 14px;
  line-height: 1.3;
}

/* Description */
.cat-desc {
  color: #ffffff;
  font-size: 13px;
  line-height: 1.55;
  max-width: 340px;
}



/* Status pill */
.cat-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 20px;
}
.cat-status-pill::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
}
.cat-status-pill.--active {
  background: rgba(74, 222, 128, 0.1);
  color: #4ade80;
  border: 1px solid rgba(74, 222, 128, 0.2);
}
.cat-status-pill.--active::before {
  background: #4ade80;
  box-shadow: 0 0 4px #4ade80;
  animation: glow-green 2s ease-in-out infinite;
}
.cat-status-pill.--inactive {
  background: rgba(248, 113, 113, 0.1);
  color: #f87171;
  border: 1px solid rgba(248, 113, 113, 0.2);
}
.cat-status-pill.--inactive::before { background: #f87171; }
@keyframes glow-green {
  0%, 100% { box-shadow: 0 0 4px #4ade80; }
  50% { box-shadow: 0 0 8px #4ade80; }
}

/* Actions cell */
.cat-actions-cell { text-align: right; }
.cat-action-row { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }

.cat-edit-btn {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}
.cat-edit-btn:hover {
  background: rgba(40, 201, 244, 0.12);
  border-color: rgba(40, 201, 244, 0.3);
  color: #28c9f4;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(40, 201, 244, 0.15);
}

/* Table toggle switch */
.cat-toggle { position: relative; display: inline-flex; align-items: center; cursor: pointer; }
.cat-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.cat-toggle-track {
  width: 40px;
  height: 22px;
  background: #1e2533;
  border: 1px solid #2d3748;
  border-radius: 22px;
  transition: all 0.3s ease;
  position: relative;
  display: block;
}
.cat-toggle-track::after {
  content: '';
  position: absolute;
  top: 3px;
  left: 3px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #4a5568;
  transition: all 0.3s ease;
}
.cat-toggle input:checked + .cat-toggle-track {
  background: rgba(74, 222, 128, 0.15);
  border-color: rgba(74, 222, 128, 0.4);
}
.cat-toggle input:checked + .cat-toggle-track::after {
  transform: translateX(18px);
  background: #4ade80;
  box-shadow: 0 0 6px rgba(74, 222, 128, 0.5);
}

/* Empty state */
.cat-empty {
  text-align: center;
  padding: 70px 24px;
}
.cat-empty-icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 20px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}
.cat-empty p { color: #ffffff; font-size: 15px; font-weight: 500; margin: 0; }
.cat-empty span { color: #ffffff; font-size: 13px; display: block; margin-top: 6px; }

/* ── Footer ── */
.cat-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28px;
  padding: 0 4px;
}
.cat-count {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #ffffff;
}
.cat-count strong { color: #6b7280; font-weight: 700; }

/* Pagination */
.cat-pagination { display: flex; gap: 6px; align-items: center; }
.cat-page-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34px;
  height: 34px;
  padding: 0 10px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  color: #ffffff;
  cursor: pointer;
  background: transparent;
}
.cat-page-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
  color: #ffffff;
}
.cat-page-btn.--current {
  background: linear-gradient(135deg, #28c9f4, #0ea5e9);
  border-color: transparent;
  color: #03111a;
  font-weight: 800;
  box-shadow: 0 4px 14px rgba(40, 201, 244, 0.3);
}
.cat-page-btn.--disabled { color: #ffffff; cursor: not-allowed; pointer-events: none; }
.cat-page-sep { color: #ffffff; padding: 0 4px; font-size: 13px; }

/* ── Modal ── */
.cat-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(6px);
  z-index: 400;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.cat-modal.open { display: flex; opacity: 1; }

.cat-modal-box {
  width: 460px;
  max-width: calc(100vw - 32px);
  max-height: 90vh;
  overflow-y: auto;
  background: #0d1117;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 36px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(40, 201, 244, 0.05) inset;
  transform: translateY(24px) scale(0.97);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.cat-modal.open .cat-modal-box { transform: translateY(0) scale(1); }

/* Scrollbar */
.cat-modal-box::-webkit-scrollbar { width: 4px; }
.cat-modal-box::-webkit-scrollbar-track { background: transparent; }
.cat-modal-box::-webkit-scrollbar-thumb { background: #2d3748; border-radius: 4px; }

.cat-modal-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 32px;
}
.cat-modal-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(40, 201, 244, 0.15), rgba(14, 165, 233, 0.1));
  border: 1px solid rgba(40, 201, 244, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #28c9f4;
  flex-shrink: 0;
}
.cat-modal-title { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -0.5px; margin: 0; }
.cat-modal-subtitle { font-size: 12px; color: #ffffff; margin-top: 2px; }

/* Form fields */
.cat-field { margin-bottom: 22px; }
.cat-field label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 10px;
  color: #ffffff;
}
.cat-field input:not([type="checkbox"]),
.cat-field textarea,
.cat-field select {
  width: 100%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: #ffffff;
  padding: 12px 16px;
  font-family: inherit;
  font-size: 14px;
  border-radius: 12px;
  outline: 0;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  box-sizing: border-box;
  -webkit-appearance: none;
  appearance: none;
}
.cat-field input:focus,
.cat-field textarea:focus,
.cat-field select:focus {
  border-color: rgba(40, 201, 244, 0.5);
  background: rgba(40, 201, 244, 0.03);
  box-shadow: 0 0 0 3px rgba(40, 201, 244, 0.08);
}
.cat-field select {
  background-image: url("data:image/svg+xml,%3Csvg fill='%2364748b' height='20' viewBox='0 0 24 24' width='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 14px center;
  padding-right: 40px;
  cursor: pointer;
}
.cat-field textarea { min-height: 100px; resize: vertical; line-height: 1.55; }
.cat-field input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.4);
  cursor: pointer;
}

/* Status toggle row */
.cat-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 12px;
  margin-bottom: 22px;
}
.cat-toggle-info { flex: 1; }
.cat-toggle-title { font-size: 13px; font-weight: 600; color: #a0aec0; margin-bottom: 2px; }
.cat-toggle-sub { font-size: 11px; color: #ffffff; }
.cat-modal-switch { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
.cat-modal-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
.cat-modal-slider {
  position: absolute;
  inset: 0;
  background: #1e2533;
  border: 1px solid #2d3748;
  border-radius: 26px;
  cursor: pointer;
  transition: all 0.35s ease;
  pointer-events: none;
}
.cat-modal-slider::before {
  content: '';
  position: absolute;
  width: 18px;
  height: 18px;
  left: 3px;
  top: 3px;
  border-radius: 50%;
  background: #4a5568;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.cat-modal-switch input:checked + .cat-modal-slider {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
}
.cat-modal-switch input:checked + .cat-modal-slider::before {
  transform: translateX(20px);
  background: #fff;
}
.cat-modal-switch input { cursor: pointer; position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; z-index: 2; margin: 0; }

/* Two-col grid */
.cat-field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 22px; }
.cat-field-grid .cat-field { margin-bottom: 0; }

/* Divider */
.cat-modal-divider { height: 1px; background: rgba(255, 255, 255, 0.06); margin: 28px 0 24px; }

/* Modal buttons */
.cat-modal-actions { display: flex; gap: 12px; }
.cat-save-btn {
  flex: 2;
  background: linear-gradient(135deg, #28c9f4, #0ea5e9);
  color: #03111a;
  border: 0;
  padding: 14px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  border-radius: 12px;
  transition: all 0.2s ease;
  box-shadow: 0 4px 16px rgba(40, 201, 244, 0.25);
  letter-spacing: 0.02em;
}
.cat-save-btn:hover {
  background: linear-gradient(135deg, #4dd8f8, #38bdf8);
  box-shadow: 0 6px 24px rgba(40, 201, 244, 0.4);
  transform: translateY(-1px);
}
.cat-save-btn:active { transform: translateY(0); }
.cat-save-btn.--danger {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(239, 68, 68, 0.25);
}
.cat-save-btn.--danger:hover {
  background: linear-gradient(135deg, #f87171, #ef4444);
  box-shadow: 0 6px 24px rgba(239, 68, 68, 0.4);
}
.cat-cancel-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.04);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 14px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  border-radius: 12px;
  transition: all 0.2s ease;
}
.cat-cancel-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.18);
}

/* Inline errors */
.cat-inline-error {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #f87171;
  font-size: 12px;
  margin-top: 6px;
  font-weight: 500;
  animation: errSlide 0.25s ease;
}
@keyframes errSlide {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<div class="cat-page">

  <!-- ═══════════════ HEADER ═══════════════ -->
  <div class="cat-header">
    <div class="cat-header-grid"></div>
    <div class="cat-header-inner">

      <!-- Left -->
      <div class="cat-header-left">
        <div class="cat-eyebrow">Admin Panel</div>
        <h1 class="cat-title">Category Management</h1>

        <form method="GET" action="/admin/categories" class="cat-search-form">
          <div class="cat-search-bar">
            <span class="cat-search-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
            </span>
            <input type="text" name="search" value="<%= search %>" placeholder="Search categories…" autocomplete="off">
            <button type="submit" class="cat-search-btn">Search</button>
            <% if (search) { %>
              <a class="cat-clear-btn" href="/admin/categories" title="Clear search">✕</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Right -->
      <div class="cat-header-right">
        <!-- Quick stats -->
        <div class="cat-stats">
          <div class="cat-stat">
            <span class="cat-stat-num"><%= totalCategories %></span>
            <span class="cat-stat-label">Total</span>
          </div>
          <div class="cat-stat --active">
            <span class="cat-stat-num"><%= categories.filter(c => !c.isDeleted).length %></span>
            <span class="cat-stat-label">Active</span>
          </div>
          <div class="cat-stat --inactive">
            <span class="cat-stat-num"><%= categories.filter(c => c.isDeleted).length %></span>
            <span class="cat-stat-label">Inactive</span>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="cat-actions">
          <!-- <a class="cat-sort-btn" href="/admin/categories?sort=desc<%= search ? '&search=' + encodeURIComponent(search) : '' %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18M7 12h10M11 18h2"/>
            </svg>
            Sort
          </a> -->
          <button class="cat-add-btn" type="button" onclick="openAddModal()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
            </svg>
            Add Category
          </button>
        </div>
      </div>

    </div>
  </div>



  <!-- ═══════════════ TABLE CARD ═══════════════ -->
  <div class="cat-card">
    <table class="cat-table">
      <thead>
        <tr>
          <th>Category</th>
          <th>Description</th>
          <th>Status</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (categories.length === 0) { %>
          <tr>
            <td colspan="4">
              <div class="cat-empty">
                <div class="cat-empty-icon">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                  </svg>
                </div>
                <p>No categories found</p>
                <span>Try a different search or add a new category</span>
              </div>
            </td>
          </tr>
        <% } %>

        <% categories.forEach(function(category) { %>
          <tr>
            <!-- Name -->
            <td>
              <div class="cat-name-cell">
                <div class="cat-icon-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>
                  </svg>
                </div>
                <span class="cat-name-text"><%= category.name %></span>
              </div>
            </td>

            <!-- Description -->
            <td>
              <span class="cat-desc"><%= category.description || "—" %></span>
            </td>

            </td>

            <!-- Status -->
            <td>
              <span class="cat-status-pill <%= category.isDeleted ? '--inactive' : '--active' %>">
                <%= category.isDeleted ? 'Inactive' : 'Active' %>
              </span>
            </td>

            <!-- Actions -->
            <td class="cat-actions-cell">
              <div class="cat-action-row">
                <!-- Edit button -->
                <button type="button" class="cat-edit-btn"
                  onclick='openEditModal(<%- JSON.stringify(category) %>)'
                  title="Edit Category">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </button>

                <!-- Status toggle -->
                <% if (category.isDeleted) { %>
                  <form method="POST" action="/admin/categories/<%= category._id %>/restore" style="margin:0;" class="category-toggle-form">
                    <label class="cat-toggle" title="Click to Activate">
                      <input type="checkbox" class="category-status-toggle" data-name="<%= category.name %>" data-action="activate">
                      <span class="cat-toggle-track"></span>
                    </label>
                  </form>
                <% } else { %>
                  <form method="POST" action="/admin/categories/<%= category._id %>/delete" style="margin:0;" class="category-toggle-form">
                    <label class="cat-toggle" title="Click to Deactivate">
                      <input type="checkbox" checked class="category-status-toggle" data-name="<%= category.name %>" data-action="deactivate">
                      <span class="cat-toggle-track"></span>
                    </label>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- ═══════════════ FOOTER ═══════════════ -->
  <div class="cat-footer">
    <div class="cat-count">
      Showing&nbsp;
      <strong>
        <% if (totalCategories === 0) { %>0<% } else { %>
          <%= (currentPage - 1) * pageSize + 1 %>–<%= Math.min(currentPage * pageSize, totalCategories) %>
        <% } %>
      </strong>
      &nbsp;of&nbsp;<strong><%= totalCategories %></strong>&nbsp;categories
    </div>

    <div class="cat-pagination">
      <% if (currentPage > 1) { %>
        <a class="cat-page-btn" href="/admin/categories?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
      <% } else { %>
        <span class="cat-page-btn --disabled">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </span>
      <% } %>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a class="cat-page-btn <%= i === currentPage ? '--current' : '' %>"
           href="/admin/categories?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
          <%= i %>
        </a>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a class="cat-page-btn" href="/admin/categories?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      <% } else { %>
        <span class="cat-page-btn --disabled">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      <% } %>
    </div>
  </div>

</div><!-- /cat-page -->


<!-- ═══════════════════════════════════════════ MODAL ═══════════════════════════════════════════ -->
<div id="categoryModal" class="cat-modal">
  <div class="cat-modal-box">

    <!-- Header -->
    <div class="cat-modal-header">
      <div class="cat-modal-icon" id="modalIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
        </svg>
      </div>
      <div>
        <h2 class="cat-modal-title" id="modalTitle">Add Category</h2>
        <p class="cat-modal-subtitle" id="modalSubtitle">Fill in the details below to create a new category</p>
      </div>
    </div>

    <form id="categoryForm" method="POST" action="/admin/categories">

      <!-- Name -->
      <div class="cat-field">
        <label for="categoryName">Category Name</label>
        <input id="categoryName" name="name" type="text" placeholder="e.g. Electronics, Clothing…">
      </div>

      <!-- Description -->
      <div class="cat-field">
        <label for="categoryDescription">Description</label>
        <textarea id="categoryDescription" name="description" placeholder="Brief description of this category…"></textarea>
      </div>

      <!-- Status toggle -->
      <div class="cat-toggle-row">
        <div class="cat-toggle-info">
          <div class="cat-toggle-title">Category Status</div>
          <div class="cat-toggle-sub" id="statusText">Active — visible to customers</div>
        </div>
        <label class="cat-modal-switch">
          <input type="checkbox" id="categoryStatus" name="isActive" value="true" checked>
          <span class="cat-modal-slider"></span>
        </label>
      </div>

      

      <div class="cat-modal-divider"></div>

      <div class="cat-modal-actions">
        <button class="cat-save-btn" id="saveBtnText" type="submit">Save Category</button>
        <button class="cat-cancel-btn" type="button" onclick="closeCategoryModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════ CONFIRM MODAL ═══════════════════════════════════ -->
<div id="confirmModal" class="cat-modal">
  <div class="cat-modal-box" style="width: 400px;">
    <div class="flex items-center justify-center" id="confirmModalIconWrap" style="width: 52px; height: 52px; border-radius: 14px; margin-bottom: 20px;">
      <!-- icon injected by JS -->
    </div>
    <h2 class="cat-modal-title" id="confirmModalTitle" style="margin-bottom: 8px;"></h2>
    <p  class="cat-desc"   id="confirmModalMessage" style="margin-bottom: 24px; max-width: none; color: #cbd5e1;"></p>
    <div class="cat-modal-divider"></div>
    <div class="cat-modal-actions">
      <button id="confirmModalCancelBtn"  class="cat-cancel-btn">Cancel</button>
      <button id="confirmModalConfirmBtn" class="cat-save-btn"></button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════ SCRIPTS ═══════════════════════════════════════════ -->
<script>
/* ── Status toggle label ── */
document.addEventListener('change', function(e) {
  if (e.target && e.target.id === 'categoryStatus') {
    const sub = document.getElementById('statusText');
    if (sub) sub.textContent = e.target.checked
      ? 'Active — visible to customers'
      : 'Inactive — hidden from customers';
  }
});

/* ── Open / close modal ── */
function openAddModal() {
  document.getElementById('modalTitle').textContent = 'Add Category';
  document.getElementById('modalSubtitle').textContent = 'Fill in the details below to create a new category';
  document.getElementById('modalIcon').innerHTML = `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
    </svg>`;
  document.getElementById('categoryForm').action = '/admin/categories';
  document.getElementById('categoryName').value = '';
  document.getElementById('categoryDescription').value = '';
  document.getElementById('categoryStatus').checked = true;
  document.getElementById('statusText').textContent = 'Active — visible to customers';
  document.getElementById('saveBtnText').textContent = 'Save Category';
  clearModalErrors();
  document.getElementById('categoryModal').classList.add('open');
}

function openEditModal(category) {
  document.getElementById('modalTitle').textContent = 'Edit Category';
  document.getElementById('modalSubtitle').textContent = 'Update the details for this category';
  document.getElementById('modalIcon').innerHTML = `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
    </svg>`;
  document.getElementById('categoryForm').action = `/admin/categories/${category._id}/edit`;
  document.getElementById('categoryName').value = category.name || '';
  document.getElementById('categoryDescription').value = category.description || '';

  const isActive = !category.isDeleted;
  document.getElementById('categoryStatus').checked = isActive;
  document.getElementById('statusText').textContent = isActive
    ? 'Active — visible to customers'
    : 'Inactive — hidden from customers';

  document.getElementById('saveBtnText').textContent = 'Save Changes';
  clearModalErrors();
  document.getElementById('categoryModal').classList.add('open');
}

function closeCategoryModal() {
  document.getElementById('categoryModal').classList.remove('open');
}

/* Close on backdrop click */
document.getElementById('categoryModal').addEventListener('click', function(e) {
  if (e.target === this) closeCategoryModal();
});

/* ── Error helpers ── */
function clearModalErrors() {
  document.querySelectorAll('.cat-inline-error').forEach(el => el.remove());
  document.querySelectorAll('#categoryForm input, #categoryForm textarea').forEach(el => {
    el.style.borderColor = '';
  });
}

function showFieldError(inputEl, msg) {
  if (!inputEl) return;
  const existing = inputEl.parentElement.querySelector('.cat-inline-error');
  if (existing) existing.remove();

  const err = document.createElement('div');
  err.className = 'cat-inline-error';
  err.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg> ${msg}`;
  inputEl.after(err);
  inputEl.style.borderColor = '#f87171';

  setTimeout(() => {
    err.style.transition = 'opacity 0.5s ease';
    err.style.opacity = '0';
    inputEl.style.transition = 'border-color 0.5s ease';
    inputEl.style.borderColor = '';
    setTimeout(() => err.remove(), 500);
  }, 4000);
}

/* ── Flash auto-dismiss ── */
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(() => {
    document.querySelectorAll('.cat-flash').forEach(flash => {
      flash.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      flash.style.opacity = '0';
      flash.style.transform = 'translateY(-6px)';
      setTimeout(() => flash.remove(), 500);
    });
  }, 3500);
});



/* ── AJAX form submit ── */
document.getElementById('categoryForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const form = e.target;
  clearModalErrors();

  const nameInput  = document.getElementById('categoryName');
  const descInput  = document.getElementById('categoryDescription');

  const name   = nameInput.value.trim();
  const desc   = descInput.value.trim();
  const nameRegex = /^[A-Za-z0-9\s\-&]+$/;

  let isValid = true;

  if (name.length < 3 || name.length > 50) {
    showFieldError(nameInput, 'Category name must be between 3 and 50 characters.');
    isValid = false;
  } else if (!nameRegex.test(name)) {
    showFieldError(nameInput, 'Only letters, numbers, spaces, - and & are allowed.');
    isValid = false;
  }

  if (desc.length < 10) {
    showFieldError(descInput, 'Description must be at least 10 characters long.');
    isValid = false;
  }

  if (!isValid) return;

  const submitBtn = document.getElementById('saveBtnText');
  const originalText = submitBtn.textContent;
  submitBtn.textContent = 'Saving…';
  submitBtn.disabled = true;

  try {
    const response = await fetch(form.action, {
      method: form.method,
      body: new URLSearchParams(new FormData(form))
    });

    const resultUrl = new URL(response.url);

    if (resultUrl.searchParams.has('error')) {
      showFieldError(nameInput, resultUrl.searchParams.get('error'));
    } else {
      window.location.href = resultUrl.href;
    }
  } catch (err) {
    console.error(err);
  } finally {
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  }
});

/* ── Status Change Confirmation Modal ── */
const statusOverlay = document.getElementById('confirmModal');
const confirmTitleEl = document.getElementById('confirmModalTitle');
const confirmMsgEl = document.getElementById('confirmModalMessage');
const confirmConfirmBtn = document.getElementById('confirmModalConfirmBtn');
const confirmCancelBtn = document.getElementById('confirmModalCancelBtn');
const confirmIconWrap = document.getElementById('confirmModalIconWrap');

let pendingCategoryAction = null;

const DEACTIVATE_ICON = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
const ACTIVATE_ICON = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`;

function closeConfirmModal() {
  statusOverlay.classList.remove('open');
  setTimeout(() => {
    statusOverlay.style.display = 'none';
  }, 300);
  // Revert check state if we cancelled
  if (pendingCategoryAction && pendingCategoryAction.chk) {
    pendingCategoryAction.chk.checked = !pendingCategoryAction.originalCheckedState;
  }
  pendingCategoryAction = null;
}

confirmCancelBtn.addEventListener('click', closeConfirmModal);
statusOverlay.addEventListener('click', e => { if (e.target === statusOverlay) closeConfirmModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeConfirmModal(); });

document.querySelectorAll('.category-status-toggle').forEach(chk => {
  chk.addEventListener('change', function(e) {
    // Revert check state immediately visually, until confirmed
    const checked = this.checked;
    this.checked = !checked; 

    const form = this.closest('form');
    const categoryName = this.dataset.name;
    const action = this.dataset.action;

    pendingCategoryAction = { chk: this, form, originalCheckedState: !checked, newCheckedState: checked };

    statusOverlay.style.display = 'flex';
    // Force repaint to trigger animation
    statusOverlay.offsetHeight;
    statusOverlay.classList.add('open');

    if (action === 'activate') {
      confirmIconWrap.className = 'flex items-center justify-center bg-emerald-500/10 border border-emerald-500/20 text-emerald-400';
      confirmIconWrap.innerHTML = ACTIVATE_ICON;
      confirmTitleEl.textContent = 'Activate Category';
      confirmMsgEl.textContent = `Are you sure you want to activate "${categoryName}"? This will make it visible to customers on the shop page.`;
      confirmConfirmBtn.textContent = 'Yes, Activate';
      confirmConfirmBtn.className = 'cat-save-btn';
    } else {
      confirmIconWrap.className = 'flex items-center justify-center bg-red-500/10 border border-red-500/20 text-red-400';
      confirmIconWrap.innerHTML = DEACTIVATE_ICON;
      confirmTitleEl.textContent = 'Deactivate Category';
      confirmMsgEl.textContent = `Are you sure you want to deactivate "${categoryName}"? This will hide it and its products from the shop page.`;
      confirmConfirmBtn.textContent = 'Yes, Deactivate';
      confirmConfirmBtn.className = 'cat-save-btn --danger';
    }
  });
});

confirmConfirmBtn.addEventListener('click', () => {
  if (!pendingCategoryAction) return;
  const { chk, form, newCheckedState } = pendingCategoryAction;
  
  // Set actual checkbox value and submit
  chk.checked = newCheckedState;
  
  // We clean pendingCategoryAction before submit so the close modal reset check doesn't fire
  pendingCategoryAction = null;
  form.submit();
});
</script>