<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

  /* ══════════════════════════════════════════
   BASE
══════════════════════════════════════════ */
  .prod-page {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #ffffff;
    padding: 28px 32px 48px;
    min-height: 100vh;
  }

  /* ══════════════════════════════════════════
   HERO HEADER
══════════════════════════════════════════ */
  .prod-header {
    position: relative;
    margin-bottom: 32px;
    padding: 36px 40px;
    border-radius: 20px;
    background: linear-gradient(135deg, #0d1b2a 0%, #0f2337 40%, #0b1e35 70%, #091828 100%);
    border: 1px solid rgba(40, 201, 244, 0.1);
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(40, 201, 244, 0.06);
  }

  .prod-header::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -40px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(40, 201, 244, 0.1) 0%, transparent 70%);
    animation: pBlob 7s ease-in-out infinite;
  }

  .prod-header::after {
    content: '';
    position: absolute;
    bottom: -50px;
    left: 30%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(100, 80, 255, 0.07) 0%, transparent 70%);
    animation: pBlob 9s ease-in-out infinite reverse;
  }

  @keyframes pBlob {

    0%,
    100% {
      transform: scale(1);
      opacity: .8;
    }

    50% {
      transform: scale(1.2);
      opacity: 1;
    }
  }

  .prod-header-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(40, 201, 244, 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .prod-header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  /* Left */
  .prod-header-left {
    flex: 1;
    min-width: 260px;
  }

  .prod-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #28c9f4;
    margin-bottom: 10px;
    padding: 4px 10px;
    border: 1px solid rgba(40, 201, 244, 0.25);
    border-radius: 20px;
    background: rgba(40, 201, 244, 0.06);
  }

  .prod-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #28c9f4;
    animation: pDot 2s ease-in-out infinite;
  }

  @keyframes pDot {

    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: .4;
      transform: scale(0.7);
    }
  }

  .prod-title {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
    margin: 0 0 20px;
    background: linear-gradient(135deg, #ffffff 0%, #a0d8ef 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Search bar */
  .prod-search-form {
    width: 100%;
    max-width: 440px;
  }

  .prod-search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 10px 14px;
    transition: border-color .3s, background .3s, box-shadow .3s;
    backdrop-filter: blur(8px);
  }

  .prod-search-bar:focus-within {
    border-color: rgba(40, 201, 244, 0.5);
    background: rgba(40, 201, 244, 0.04);
    box-shadow: 0 0 0 3px rgba(40, 201, 244, 0.08), 0 4px 20px rgba(40, 201, 244, 0.06);
  }

  .prod-search-icon {
    color: #ffffff;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .prod-search-bar input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: #ffffff;
    font-size: 14px;
    font-family: inherit;
  }

  .prod-search-bar input::placeholder {
    color: #4a5568;
  }

  .prod-search-submit {
    background: linear-gradient(135deg, #28c9f4, #0ea5e9);
    color: #03111a;
    border: none;
    padding: 7px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.04em;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(40, 201, 244, 0.25);
    transition: all .2s;
  }

  .prod-search-submit:hover {
    background: linear-gradient(135deg, #4dd8f8, #38bdf8);
    box-shadow: 0 4px 14px rgba(40, 201, 244, 0.4);
    transform: translateY(-1px);
  }

  .prod-clear-link {
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: color .2s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .prod-clear-link:hover {
    color: #f87171;
  }

  /* Right */
  .prod-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .prod-stats {
    display: flex;
    gap: 12px;
  }

  .prod-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 20px;
    border-radius: 12px;
    min-width: 80px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(4px);
  }

  .prod-stat-num {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    margin-bottom: 3px;
  }

  .prod-stat-lbl {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .prod-stat.--instock .prod-stat-num {
    color: #4ade80;
  }

  .prod-stat.--low .prod-stat-num {
    color: #fbbf24;
  }

  .prod-stat.--out .prod-stat-num {
    color: #f87171;
  }

  .prod-add-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #28c9f4, #0ea5e9);
    color: #03111a;
    border: 0;
    padding: 12px 22px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(40, 201, 244, 0.3);
    transition: all .25s;
    text-decoration: none;
    white-space: nowrap;
  }

  .prod-add-btn:hover {
    background: linear-gradient(135deg, #4dd8f8, #38bdf8);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(40, 201, 244, 0.45);
  }

  .prod-add-btn:active {
    transform: translateY(0);
  }

  /* ══════════════════════════════════════════
   TABLE CARD
══════════════════════════════════════════ */
  .prod-card {
    background: rgba(14, 18, 27, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
  }

  .prod-table {
    width: 100%;
    border-collapse: collapse;
  }

  .prod-table thead tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .prod-table th {
    background: rgba(0, 0, 0, 0.22);
    color: #ffffff; /* Made much brighter for dark theme */
    font-size: 12px; /* Slightly larger for readability */
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    padding: 16px 20px;
    white-space: nowrap;
  }

  .prod-table th:last-child {
    text-align: right;
  }

  .prod-table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background .2s;
  }

  .prod-table tbody tr:last-child {
    border-bottom: none;
  }

  .prod-table tbody tr:hover {
    background: rgba(40, 201, 244, 0.02);
  }

  .prod-table td {
    padding: 14px 20px;
    vertical-align: middle;
  }

  /* Product image */
  .prod-img-wrap {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.03);
  }

  .prod-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Name cell */
  .prod-name-cell {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .prod-name-info {}

  .prod-name-text {
    font-weight: 700;
    color: #ffffff;
    font-size: 14px;
    line-height: 1.3;
  }

  .prod-brand-text {
    font-size: 11px;
    color: #ffffff;
    font-weight: 500;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .prod-brand-text svg {
    color: #ffffff;
  }

  /* Category badge */
  .prod-cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: #28c9f4;
    background: transparent;
    border: 1px solid #28c9f4;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: capitalize;
  }

  /* Price cells */
  .prod-price {
    font-size: 13px;
    color: #ffffff;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .prod-sale-price {
    font-size: 13px;
    color: #4ade80;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .prod-sale-price.--none {
    color: #ffffff;
  }

  /* Stock cell */
  .prod-stock-cell {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .prod-stock-num {
    font-size: 14px;
    font-weight: 700;
  }

  .prod-stock-num.--ok {
    color: #ffffff;
  }

  .prod-stock-num.--low {
    color: #fbbf24;
  }

  .prod-stock-num.--out {
    color: #f87171;
  }

  .prod-stock-bar {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    overflow: hidden;
    max-width: 48px;
  }

  .prod-stock-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width .4s ease;
  }

  .prod-stock-bar-fill.--ok {
    background: linear-gradient(90deg, #4ade80, #22c55e);
  }

  .prod-stock-bar-fill.--low {
    background: linear-gradient(90deg, #fbbf24, #f59e0b);
  }

  .prod-stock-bar-fill.--out {
    background: #f87171;
  }

  /* Status pill */
  .prod-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .prod-status-pill::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .prod-status-pill.--instock {
    background: rgba(74, 222, 128, 0.1);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.2);
  }

  .prod-status-pill.--instock::before {
    background: #4ade80;
    animation: pPulse 2s ease-in-out infinite;
  }

  .prod-status-pill.--low {
    background: rgba(251, 191, 36, 0.1);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.2);
  }

  .prod-status-pill.--low::before {
    background: #fbbf24;
  }

  .prod-status-pill.--outofstock {
    background: rgba(248, 113, 113, 0.1);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.2);
  }

  .prod-status-pill.--outofstock::before {
    background: #f87171;
  }

  @keyframes pPulse {

    0%,
    100% {
      box-shadow: 0 0 4px #4ade80;
    }

    50% {
      box-shadow: 0 0 8px #4ade80;
    }
  }

  /* Action icons */
  .prod-action-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .prod-icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #ffffff;
    cursor: pointer;
    transition: all .2s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .prod-icon-btn:hover {
    background: rgba(40, 201, 244, 0.1);
    border-color: rgba(40, 201, 244, 0.25);
    color: #28c9f4;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(40, 201, 244, 0.15);
  }

  .prod-icon-btn.--delete:hover {
    background: rgba(248, 113, 113, 0.1);
    border-color: rgba(248, 113, 113, 0.25);
    color: #f87171;
    box-shadow: 0 4px 12px rgba(248, 113, 113, 0.12);
  }

  /* Empty state */
  .prod-empty {
    text-align: center;
    padding: 70px 24px;
  }

  .prod-empty-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 20px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .prod-empty p {
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    margin: 0;
  }

  .prod-empty span {
    color: #ffffff;
    font-size: 13px;
    display: block;
    margin-top: 6px;
  }

  .prod-empty-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    padding: 10px 20px;
    border-radius: 10px;
    background: rgba(40, 201, 244, 0.1);
    border: 1px solid rgba(40, 201, 244, 0.2);
    color: #28c9f4;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all .2s;
  }

  .prod-empty-link:hover {
    background: rgba(40, 201, 244, 0.18);
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════════
   FOOTER & PAGINATION
══════════════════════════════════════════ */
  .prod-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding: 0 4px;
  }

  .prod-count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .prod-count strong {
    color: #ffffff;
    font-weight: 700;
  }

  .prod-pagination {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .prod-pg-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all .2s;
    border: 1px solid transparent;
    color: #ffffff;
    background: transparent;
  }

  .prod-pg-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .prod-pg-btn.--current {
    background: linear-gradient(135deg, #28c9f4, #0ea5e9);
    border-color: transparent;
    color: #03111a;
    font-weight: 800;
    box-shadow: 0 4px 14px rgba(40, 201, 244, 0.3);
  }

  .prod-pg-btn.--disabled {
    color: #ffffff;
    cursor: not-allowed;
    pointer-events: none;
  }

  .prod-pg-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: #ffffff;
  }

  /* ══════════════════════════════════════════
   DELETE MODAL
══════════════════════════════════════════ */
  .prod-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
  }

  .prod-modal.open {
    display: flex;
  }

  .prod-modal-box {
    width: 100%;
    max-width: 400px;
    margin: 0 16px;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 36px 32px 28px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    animation: pModalIn .25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes pModalIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(16px);
    }

    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .prod-modal-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.2);
    color: #f87171;
  }

  .prod-modal-title {
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.4px;
    margin: 0 0 8px;
  }

  .prod-modal-msg {
    font-size: 13.5px;
    color: #ffffff;
    line-height: 1.65;
    margin: 0 0 28px;
  }

  .prod-modal-msg strong {
    color: #ffffff;
  }

  .prod-modal-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 0 0 24px;
  }

  .prod-modal-actions {
    display: flex;
    gap: 10px;
  }

  .prod-modal-btn {
    flex: 1;
    padding: 13px;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    border: none;
    font-family: inherit;
    transition: all .2s;
  }

  .prod-modal-btn.--cancel {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .prod-modal-btn.--cancel:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
  }

  .prod-modal-btn.--delete {
    flex: 2;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #fff;
    box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3);
  }

  .prod-modal-btn.--delete:hover {
    background: linear-gradient(135deg, #f87171, #ef4444);
    box-shadow: 0 6px 22px rgba(239, 68, 68, 0.45);
    transform: translateY(-1px);
  }

  .prod-modal-btn.--confirm-list {
    flex: 2;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
  }

  .prod-modal-btn.--confirm-list:hover {
    background: linear-gradient(135deg, #34d399, #10b981);
    box-shadow: 0 6px 22px rgba(16, 185, 129, 0.45);
    transform: translateY(-1px);
  }
</style>

<div class="prod-page">

  <!-- ═══════════ HERO HEADER ═══════════ -->
  <div class="prod-header">
    <div class="prod-header-grid"></div>
    <div class="prod-header-inner">

      <!-- Left -->
      <div class="prod-header-left">
        <div class="prod-eyebrow">Admin Panel</div>
        <h1 class="prod-title">Product Management</h1>

        <form method="GET" action="/admin/products" class="prod-search-form">
          <div class="prod-search-bar">
            <span class="prod-search-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
              </svg>
            </span>
            <input type="text" name="search" value="<%= locals.search || '' %>" placeholder="Search by title, brand…"
              autocomplete="off">
            <button type="submit" class="prod-search-submit">Search</button>
            <% if (locals.search) { %>
              <a class="prod-clear-link" href="/admin/products" title="Clear">✕</a>
              <% } %>
          </div>
        </form>
      </div>

      <!-- Right — stats + add button -->
      <div class="prod-header-right">
        <% const totalP=(products && products.length) || 0; const inStockP=products ? products.filter(p=> { const s =
          p.variants ? p.variants.reduce((a,v)=>a+v.stock,0) : 0; return s >= 10; }).length : 0;
          const lowP = products ? products.filter(p => { const s = p.variants ? p.variants.reduce((a,v)=>a+v.stock,0) :
          0; return s > 0 && s < 10; }).length : 0; const outP=products ? products.filter(p=> { const s = p.variants ?
            p.variants.reduce((a,v)=>a+v.stock,0) : 0; return s === 0; }).length : 0;
            %>
            <div class="prod-stats">
              <div class="prod-stat">
                <span class="prod-stat-num">
                  <%= totalP %>
                </span>
                <span class="prod-stat-lbl">Total</span>
              </div>
              <div class="prod-stat --instock">
                <span class="prod-stat-num">
                  <%= inStockP %>
                </span>
                <span class="prod-stat-lbl">In Stock</span>
              </div>
              <div class="prod-stat --low">
                <span class="prod-stat-num">
                  <%= lowP %>
                </span>
                <span class="prod-stat-lbl">Low</span>
              </div>
              <div class="prod-stat --out">
                <span class="prod-stat-num">
                  <%= outP %>
                </span>
                <span class="prod-stat-lbl">Out</span>
              </div>
            </div>

            <a href="/admin/addProducts" class="prod-add-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v8M8 12h8" />
              </svg>
              Add Product
            </a>
      </div>

    </div>
  </div>

  <!-- ═══════════ TABLE CARD ═══════════ -->
  <div class="prod-card">
    <table class="prod-table">
      <thead>
        <tr>
          <th style="width:5%"></th>
          <th style="width:24%">Product</th>
          <th style="width:14%">Category</th>
          <th style="width:12%">Reg. Price</th>
          <th style="width:12%">Sale Price</th>
          <th style="width:14%">Stock</th>
          <th style="width:11%">Status</th>
          <th style="width:8%; text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>

        <% if (products && products.length> 0) { %>
          <% products.forEach(product=> {
            const regPrice = product.variants && product.variants.length > 0 ? product.variants[0].regularPrice : 0;
            const salePrice = product.variants && product.variants.length > 0 ? product.variants[0].salePrice : 0;
            const totalStock = product.variants ? product.variants.reduce((sum, v) => sum + v.stock, 0) : 0;

            const stockClass = totalStock === 0 ? '--out' : totalStock < 10 ? '--low' : '--ok' ; 
            const stockBarW = totalStock===0 ? 0 : Math.min(100, Math.round(totalStock / 50 * 100)); 
            const statusClass = totalStock===0 ? '--outofstock' : totalStock < 10 ? '--low' : '--instock' ; 
            const statusLabel = totalStock===0 ? 'Out of Stock' : totalStock < 10 ? 'Low Stock' : 'In Stock' ; 
            const outOfStock=totalStock===0; const imgSrc=product.primaryImage || (product.galleryImages.length &&
              product.galleryImages.length> 3 ? product.galleryImages[3] : null);
              %>
              <tr style="<%= product.isDeleted ? 'opacity: 0.5;' : '' %>">
                
                <!-- Image -->
                <td>
                  <div class="prod-img-wrap">
                    <% if (imgSrc) { %>
                      <img src="<%= imgSrc %>" alt="<%= product.productName %>">
                      <% } else { %>
                        <div
                          style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color: #ffffff;">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                          </svg>
                        </div>
                        <% } %>
                  </div>
                </td>

                <!-- Name + brand -->
                <td>
                  <div class="prod-name-cell">
                    <div class="prod-name-info">
                      <a href="/admin/products/details?id=<%= product._id %>" class="prod-name-text" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='#28c9f4'" onmouseout="this.style.color='inherit'">
                        <%= product.productName %>
                      </a>
                      <div class="prod-brand-text">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                          <line x1="7" y1="7" x2="7.01" y2="7" />
                        </svg>
                        <%= product.brand || '—' %>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Category -->
                <td>
                  <span class="prod-cat-badge">
                    <%= product.category %>
                  </span>
                </td>

                <!-- Regular price -->
                <td>
                  <span class="prod-price">₹<%= regPrice.toFixed(2) %></span>
                </td>

                <!-- Sale price -->
                <td>
                  <% if (salePrice> 0) { %>
                    <span class="prod-sale-price">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                      ₹<%= salePrice.toFixed(2) %>
                    </span>
                    <% } else { %>
                      <span class="prod-sale-price --none">—</span>
                      <% } %>
                </td>

                <!-- Stock with mini bar -->
                <td>
                  <div class="prod-stock-cell">
                    <span class="prod-stock-num <%= stockClass %>">
                      <%= totalStock %>
                    </span>
                    <!-- <div class="prod-stock-bar">
                      <div class="prod-stock-bar-fill <%= stockClass %>" style="width:<%= stockBarW %>%"></div>
                    </div> -->
                  </div>
                </td>

                <!-- Status pill -->
                <td>
                  <span class="prod-status-pill <%= statusClass %>">
                    <%= statusLabel %>
                  </span>
                </td>

                <!-- Actions -->
                <td>
                  <div class="prod-action-row">
                    <a href="/admin/products/details?id=<%= product._id %>" class="prod-icon-btn" title="View Product Details">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    </a>

                    <a href="/admin/products/edit?id=<%= product._id %>" class="prod-icon-btn" title="Edit Product">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </a>

                    <form method="POST" action="/admin/products/delete/<%= product._id %>" style="margin:0;"
                      class="delete-product-form flex items-center justify-center"
                      data-name="<%= product.productName %>">
                      <button type="button" class="delete-btn-trigger border-0 bg-transparent p-0 cursor-pointer group flex items-center" title="Toggle Status">
                        <div class="relative inline-flex items-center">
                          <div class="toggle-track w-11 h-6 rounded-full transition-colors duration-300 <%= product.isDeleted ? 'bg-[#374151] border-[#4b5563]' : 'bg-[#0f2e1f] border-[#166534] group-hover:bg-[#133c28]' %>"></div>
                          <div class="toggle-thumb absolute top-[3px] w-[18px] h-[18px] rounded-full transition-all duration-300 <%= product.isDeleted ? 'left-[3px] bg-[#9ca3af]' : 'left-[23px] bg-[#4ade80] shadow-[0_0_10px_rgba(74,222,128,0.6)] group-hover:shadow-[0_0_14px_rgba(74,222,128,0.8)]' %>"></div>
                        </div>
                      </button>
                    </form>

                  </div>
                </td>
              </tr>
              <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8">
                      <div class="prod-empty">
                        <div class="prod-empty-icon">
                          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <path d="M16 10a4 4 0 0 1-8 0" />
                          </svg>
                        </div>
                        <% if (locals.search) { %>
                          <p>No results for "<strong>
                              <%= locals.search %>
                            </strong>"</p>
                          <span>Try a different product name or brand</span>
                          <% } else { %>
                            <p>No products yet</p>
                            <span>Add your first product to get started</span>
                            <a href="/admin/addProducts" class="prod-empty-link">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 8v8M8 12h8" />
                              </svg>
                              Add First Product
                            </a>
                            <% } %>
                      </div>
                    </td>
                  </tr>
                  <% } %>

      </tbody>
    </table>
  </div>

  <!-- ═══════════ FOOTER / PAGINATION ═══════════ -->
  <% if (typeof totalPages !=='undefined' ) { %>
    <div class="prod-footer">
      <div class="prod-count">
        <% if (products && products.length> 0) { %>
          Showing&nbsp;<strong>
            <%= products.length %>
          </strong>&nbsp;of&nbsp;<strong>
            <%= typeof totalProducts !=='undefined' ? totalProducts : products.length %>
          </strong>&nbsp;products
          <% } %>
      </div>

      <% if (totalPages> 1) { %>
        <nav class="prod-pagination">
          <% if (currentPage> 1) { %>
            <a class="prod-pg-btn"
              href="?page=<%= currentPage - 1 %><%= locals.search ? '&search=' + encodeURIComponent(locals.search) : '' %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </a>
            <% } else { %>
              <span class="prod-pg-btn --disabled">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </span>
              <% } %>

                <% for (let i=1; i <=totalPages; i++) { const show=i===1 || i===totalPages || (i>= currentPage - 1 && i
                  <= currentPage + 1); const dot=i===currentPage - 2 || i===currentPage + 2; %>
                    <% if (show) { %>
                      <a class="prod-pg-btn <%= i === currentPage ? '--current' : '' %>"
                        href="?page=<%= i %><%= locals.search ? '&search=' + encodeURIComponent(locals.search) : '' %>">
                        <%= i %>
                      </a>
                      <% } else if (dot) { %>
                        <span class="prod-pg-dots">…</span>
                        <% } %>
                          <% } %>

                            <% if (currentPage < totalPages) { %>
                              <a class="prod-pg-btn"
                                href="?page=<%= currentPage + 1 %><%= locals.search ? '&search=' + encodeURIComponent(locals.search) : '' %>">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="9 18 15 12 9 6" />
                                </svg>
                              </a>
                              <% } else { %>
                                <span class="prod-pg-btn --disabled">
                                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6" />
                                  </svg>
                                </span>
                                <% } %>
        </nav>
        <% } %>
    </div>
    <% } %>

</div><!-- /prod-page -->

<!-- ═══════════════════════════════════ MODAL ═══════════════════════════════════ -->
<div id="confirmModal" class="prod-modal">
  <div class="prod-modal-box">
    <div class="prod-modal-icon-wrap flex items-center justify-center" id="modalIconWrap" style="width: 52px; height: 52px; border-radius: 14px; margin-bottom: 20px;">
      <!-- icon injected by JS -->
    </div>
    <h2 class="prod-modal-title" id="modalTitle"></h2>
    <p  class="prod-modal-msg"   id="modalMessage"></p>
    <div class="prod-modal-divider"></div>
    <div class="prod-modal-actions">
      <button id="modalCancelBtn"  class="prod-modal-btn --cancel">Cancel</button>
      <button id="modalConfirmBtn" class="prod-modal-btn"></button>
    </div>
  </div>
</div>

<script src="https://cdn.tailwindcss.com"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('confirmModal');
    const titleEl = document.getElementById('modalTitle');
    const msgEl = document.getElementById('modalMessage');
    const confirmBtn = document.getElementById('modalConfirmBtn');
    const cancelBtn = document.getElementById('modalCancelBtn');
    const iconWrap = document.getElementById('modalIconWrap');

    let pendingAction = null;

    const UNLIST_ICON = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
    const LIST_ICON = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`;

    function closeModal() {
      overlay.classList.remove('open');
      pendingAction = null;
    }

    cancelBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

    document.querySelectorAll('.delete-btn-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const track = btn.querySelector('.toggle-track');
        const thumb = btn.querySelector('.toggle-thumb');
        const form = btn.closest('.delete-product-form');
        
        if (!form || !track || !thumb) return;

        const productName = form.dataset.name;
        // Determine current state: if track contains 'bg-[#374151]' it is unlisted (isDeleted = true), so clicking will LIST it.
        const isCurrentlyUnlisted = track.classList.contains('bg-[#374151]');

        pendingAction = { btn, track, thumb, form, isCurrentlyUnlisted };

        if (isCurrentlyUnlisted) {
          // Confirm Listing the product
          iconWrap.className = 'prod-modal-icon-wrap flex items-center justify-center bg-emerald-500/10 border border-emerald-500/20 text-emerald-400';
          iconWrap.innerHTML = LIST_ICON;
          titleEl.textContent = 'List Product';
          msgEl.textContent = `Are you sure you want to list "${productName}"? It will become visible to customers on the shop page.`;
          confirmBtn.textContent = 'Yes, List';
          confirmBtn.className = 'prod-modal-btn --confirm-list';
        } else {
          // Confirm Unlisting the product
          iconWrap.className = 'prod-modal-icon-wrap flex items-center justify-center bg-red-500/10 border border-red-500/20 text-red-400';
          iconWrap.innerHTML = UNLIST_ICON;
          titleEl.textContent = 'Unlist Product';
          msgEl.textContent = `Are you sure you want to unlist "${productName}"? It will be hidden from customers on the shop page.`;
          confirmBtn.textContent = 'Yes, Unlist';
          confirmBtn.className = 'prod-modal-btn --delete';
        }

        overlay.classList.add('open');
      });
    });

    confirmBtn.addEventListener('click', async () => {
      if (!pendingAction) return;

      const { btn, track, thumb, form } = pendingAction;
      const url = form.action;

      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Processing...';

      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });

        const data = await response.json();
        if (data.success) {
          if (data.isDeleted) {
            // Soft delete activated: visually toggle the switch to gray
            track.className = 'toggle-track w-11 h-6 rounded-full transition-colors duration-300 bg-[#374151] border-[#4b5563]';
            thumb.className = 'toggle-thumb absolute top-[3px] w-[18px] h-[18px] rounded-full transition-all duration-300 left-[3px] bg-[#9ca3af]';
            
            // Dim the row to show it is hidden from the shop
            const rowToDim = form.closest('tr');
            if (rowToDim) {
              rowToDim.style.transition = 'opacity 0.3s';
              rowToDim.style.opacity = '0.5';
            }
          } else {
            // Product is now Listed
            track.className = 'toggle-track w-11 h-6 rounded-full transition-colors duration-300 bg-[#0f2e1f] border-[#166534] group-hover:bg-[#133c28]';
            thumb.className = 'toggle-thumb absolute top-[3px] w-[18px] h-[18px] rounded-full transition-all duration-300 left-[23px] bg-[#4ade80] shadow-[0_0_10px_rgba(74,222,128,0.6)] group-hover:shadow-[0_0_14px_rgba(74,222,128,0.8)]';
            
            // Restore row opacity
            const rowToRestore = form.closest('tr');
            if (rowToRestore) {
              rowToRestore.style.transition = 'opacity 0.3s';
              rowToRestore.style.opacity = '1';
            }
          }
        }
      } catch (err) {
        console.error("Failed to toggle status:", err);
      } finally {
        confirmBtn.disabled = false;
        closeModal();
      }
    });
  });
</script>