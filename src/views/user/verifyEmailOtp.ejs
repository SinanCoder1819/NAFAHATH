<main class="min-h-screen bg-[#060606] text-white py-12 px-4 md:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">

        <!-- Sidebar -->
        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 sticky top-28 shadow-2xl">
                <div class="mb-10">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-[#C5A267] font-bold mb-6 opacity-80">Dashboard</p>
                    <nav class="flex flex-col gap-2">
                        <a href="/profile" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium">Profile</span>
                        </a>
                        <% const navLinks = [
                            { href: '/orders', label: 'My Orders', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
                            { href: '/wallet', label: 'Wallet', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
                            { href: '/address', label: 'Addresses', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
                            { href: '/referrals', label: 'Refer & Earn', icon: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z' }
                        ] %>
                        <% navLinks.forEach(link => { %>
                            <a href="<%= link.href %>" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                                <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="<%= link.icon %>"/></svg>
                                <span class="text-sm font-medium"><%= link.label %></span>
                            </a>
                        <% }) %>
                    </nav>
                </div>
                <div class="pt-6 border-t border-gray-800">
                    <a href="/auth/logout" class="flex items-center gap-4 px-4 py-3 text-red-400 hover:bg-red-500/10 rounded-xl transition-all group">
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        <span class="text-sm font-medium">Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <section class="flex-1 flex items-start justify-center">
            <div class="w-full max-w-lg">
                <div class="text-center mb-10">
                    <h1 class="text-4xl font-serif italic text-white mb-2">Verify New Email</h1>
                    <p class="text-gray-500 text-[10px] tracking-[0.3em] uppercase">Enter the code we sent you</p>
                </div>

                <div class="bg-[#0f0f0f] border border-gray-800 rounded-[2.5rem] p-8 md:p-10 shadow-2xl">

                    <p class="text-gray-400 text-sm mb-1 text-center">Enter the 6-digit code sent to</p>
                    <p class="text-[#C5A267] text-sm font-medium text-center mb-8"><%= newEmail %></p>

                    <div id="formMessage" class="hidden mb-6 p-3 rounded-xl text-xs font-medium border text-center"></div>

                    <form id="otpForm" class="space-y-8">
                        <div class="flex justify-between gap-2 md:gap-3">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-[#00FFFF] outline-none transition-all text-white">
                        </div>

                        <button type="submit" id="verifyBtn"
                            class="w-full bg-[#00FFFF] text-black py-4 rounded-2xl font-bold uppercase tracking-widest text-sm hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_25px_rgba(0,255,255,0.25)] disabled:opacity-60 disabled:cursor-not-allowed">
                            Verify & Update Email
                        </button>
                    </form>

                    <div class="mt-8 text-center space-y-3">
                        <p class="text-xs text-gray-500">Didn't receive the code?</p>
                        <button id="resendBtn" disabled
                            class="text-[#00FFFF] text-xs font-bold uppercase tracking-wider hover:underline disabled:text-gray-600 disabled:no-underline transition-all">
                            Resend Code in <span id="timer">0:45</span>
                        </button>
                    </div>

                    <div class="mt-6 text-center">
                        <a href="/profile/change-email" class="text-xs text-gray-500 hover:text-white transition uppercase tracking-widest">← Change Email</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    const inputs = document.querySelectorAll('.otp-input');
    const verifyBtn = document.getElementById('verifyBtn');
    const resendBtn = document.getElementById('resendBtn');
    const timerSpan = document.getElementById('timer');
    const formMsg = document.getElementById('formMessage');

    // OTP input navigation
    inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            if (e.target.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                inputs[index - 1].focus();
            }
        });
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasted = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
            pasted.split('').forEach((char, i) => { if (inputs[i]) inputs[i].value = char; });
            const next = [...inputs].findIndex(i => !i.value);
            if (next !== -1) inputs[next].focus(); else inputs[5].focus();
        });
    });

    function getOtp() { return [...inputs].map(i => i.value).join(''); }

    function showFormMsg(text, type) {
        formMsg.textContent = text;
        formMsg.className = 'mb-6 p-3 rounded-xl text-xs font-medium border text-center block';
        formMsg.classList.add(type === 'error' ? 'bg-red-900/50' : 'bg-green-900/50');
        formMsg.classList.add(type === 'error' ? 'text-red-200' : 'text-green-200');
        formMsg.classList.add(type === 'error' ? 'border-red-800' : 'border-green-800');
    }

    // Countdown timer
    let timeLeft = 45;
    const countdown = setInterval(() => {
        timeLeft--;
        timerSpan.textContent = `0:${timeLeft < 10 ? '0' : ''}${timeLeft}`;
        if (timeLeft <= 0) {
            clearInterval(countdown);
            resendBtn.disabled = false;
            resendBtn.innerHTML = 'Resend Code';
        }
    }, 1000);

    // Verify OTP
    document.getElementById('otpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = getOtp();

        if (otp.length < 6) {
            showFormMsg('Please enter the complete 6-digit OTP.', 'error');
            return;
        }

        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Verifying...';

        try {
            const response = await fetch('/profile/change-email/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp })
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok) {
                showFormMsg('Email updated successfully! Redirecting...', 'success');
                setTimeout(() => window.location.href = '/profile', 1500);
            } else {
                showFormMsg(result.message || 'Invalid OTP. Please try again.', 'error');
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
                verifyBtn.disabled = false;
                verifyBtn.textContent = 'Verify & Update Email';
            }
        } catch (err) {
            showFormMsg('Network error. Please try again.', 'error');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Verify & Update Email';
        }
    });

    // Resend OTP
    resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        resendBtn.textContent = 'Sending...';

        try {
            const response = await fetch('/profile/change-email/resend-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok) {
                showFormMsg('A new OTP has been sent.', 'success');
                timeLeft = 45;
                timerSpan.textContent = '0:45';
                resendBtn.innerHTML = 'Resend Code in <span id="timer">0:45</span>';
                const newTimerSpan = document.getElementById('timer');
                const newCountdown = setInterval(() => {
                    timeLeft--;
                    newTimerSpan.textContent = `0:${timeLeft < 10 ? '0' : ''}${timeLeft}`;
                    if (timeLeft <= 0) {
                        clearInterval(newCountdown);
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = 'Resend Code';
                    }
                }, 1000);
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
            } else {
                showFormMsg(result.message || 'Failed to resend OTP.', 'error');
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend Code';
            }
        } catch (err) {
            showFormMsg('Network error. Please try again.', 'error');
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
        }
    });
</script>
