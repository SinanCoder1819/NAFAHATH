<section class="flex items-center justify-center px-6 py-12 md:py-24">
    <div class="w-full max-w-[480px] border border-gray-800 rounded-[40px] p-10 md:p-12 flex flex-col items-center bg-black">
        
        <div class="text-center mb-8">
            <h2 class="text-2xl font-semibold mb-3 text-white">Verify Your Email</h2>
            <p class="text-gray-400 text-sm leading-relaxed max-w-[280px] mx-auto">
                Enter the 6-digit code sent to your email address to complete verification.
            </p>
        </div>

        <form id="otpForm" class="w-full space-y-8">
            <div id="responseMessage" class="hidden p-3 rounded-lg text-sm text-center mb-4"></div>

            <div class="flex justify-between gap-2 sm:gap-4">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
                <input type="text" maxlength="1" required class="otp-input w-12 h-14 sm:w-14 sm:h-16 bg-transparent border border-gray-700 rounded-xl text-center text-xl font-semibold text-white outline-none focus:border-[#00FFFF] focus:shadow-[0_0_10px_rgba(0,255,255,0.2)] transition-all">
            </div>

            <div>
                <button type="submit" id="submitBtn" class="w-full bg-[#00FFFF] text-black font-bold py-3.5 rounded-xl hover:bg-cyan-400 shadow-[0_0_20px_rgba(0,255,255,0.2)] transition-all text-sm uppercase tracking-widest">
                    Verify Email
                </button>
            </div>
        </form>

    <div class="mt-8 text-center">
        <p class="text-xs text-gray-500">Didn't receive the code?</p>
        <div class="mt-2">
            <button id="resendBtn" type="button" disabled
                class="text-cyan-500 hover:text-cyan-400 font-medium transition-colors disabled:text-gray-600 disabled:cursor-not-allowed text-xs">
                Resend Code
            </button>
            <div id="lockoutMsg" class="hidden text-xs text-red-500 font-medium mt-1">
                Too many attempts. Try again in <span id="lockoutTimerVal">5:00</span>
            </div>
        </div>
    </div>
    </div>
</section>

<div id="loadingModal" class="fixed inset-0 z-50 hidden flex flex-col items-center justify-center bg-black/80 backdrop-blur-sm">
    <div class="flex flex-col items-center bg-gray-900 border border-gray-800 p-10 rounded-[32px] shadow-2xl">
        <div class="w-12 h-12 border-4 border-[#00FFFF]/20 border-t-[#00FFFF] rounded-full animate-spin mb-4"></div>
        <h3 class="text-white font-semibold text-lg">Verifying Code</h3>
        <p class="text-gray-400 text-xs mt-2">Please wait a moment...</p>
    </div>
</div>    

<script>
(function () {
    const inputs = document.querySelectorAll('.otp-input');
    const otpForm = document.getElementById('otpForm');
    const submitBtn = document.getElementById('submitBtn');
    const resendBtn = document.getElementById('resendBtn');
    const lockoutMsg = document.getElementById('lockoutMsg');
    const lockoutTimer = document.getElementById('lockoutTimerVal');
    const msgDiv = document.getElementById('responseMessage');
    const loadingModal = document.getElementById('loadingModal');

    const TIMER_DURATION = 180;  
    let countdownInterval = null;
    let isLockout = false;
    let messageTimeout = null;

    function updateResendLabel(timeLeft) {
        if (isLockout && timeLeft > 0) {
            resendBtn.classList.add('hidden');
            lockoutMsg.classList.remove('hidden');
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            lockoutTimer.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
            document.querySelector('#lockoutMsg p').textContent = `Too many attempts.Try again in ${mins}: ${secs < 10 ? '0' : ""} ${secs}`
        } else if (timeLeft > 0) {
            resendBtn.classList.remove('hidden');
            lockoutMsg.classList.add('hidden');
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            resendBtn.innerHTML = `Resend Code in <span id="timerVal">${mins}:${secs < 10 ? '0' : ''}${secs}</span>`;
            resendBtn.disabled = true;
        } else {
            isLockout = false;
            resendBtn.classList.remove('hidden');
            lockoutMsg.classList.add('hidden');
            resendBtn.textContent = 'Resend Code';
            resendBtn.disabled = false;
            hideMessage(); 
        }
    }

    function startCountdown(seconds,isLockoutMode = false) {
        clearInterval(countdownInterval);
        isLockout = isLockoutMode || (seconds > 180)
        let timeLeft = seconds;
        updateResendLabel(timeLeft);

        countdownInterval = setInterval(() => {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                updateResendLabel(0);
            } else {
                updateResendLabel(timeLeft);
            }
        }, 1000);
    }

    // Init on load — restore timer from server value
    (function init() {
        const serverTimeLeft = parseInt('<%= timeLeft %>', 10) || 0;
        if (serverTimeLeft > 0) {
            startCountdown(serverTimeLeft);
        } else {
            updateResendLabel(0);
        }
    })();

    // ── OTP box inputs ─────────────────────────────────────────────
    inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            if (!isLockout) {
                hideMessage(); // Auto-dismiss old errors when typing
            }
            if (e.target.value.length === 1 && index < inputs.length - 1) inputs[index + 1].focus();
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) inputs[index - 1].focus();
        });
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const chars = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6).split('');
            chars.forEach((c, i) => { if (inputs[i] && /^[0-9]$/.test(c)) inputs[i].value = c; });
            const next = chars.length >= 6 ? 5 : chars.length;
            if (inputs[next]) inputs[next].focus();
            if (chars.length === 6) otpForm.requestSubmit();
        });
    });

    // ── Resend button ──────────────────────────────────────────────
    resendBtn.addEventListener('click', async () => {
        hideMessage();
        resendBtn.disabled = true;
        resendBtn.textContent = 'Sending...';

        try {
            const res = await fetch('/auth/resend-otp', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();

            if (res.ok) {
                showMessage(data.message || 'New OTP sent!', 'success');
                startCountdown(data.resendCooldown || 180);
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
            } else {
                showMessage(data.message || 'Failed to resend.', 'error', true); // Keep lockout error
                if (data.blockedUntil) {
                    const timeLeft = Math.max(0, Math.ceil((data.blockedUntil - Date.now()) / 1000));
                    startCountdown(timeLeft);
                } else {
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend Code';
                }
            }
        } catch {
            showMessage('Network error. Please try again.', 'error');
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
        }
    });

    // ── Verify submit ──────────────────────────────────────────────
    otpForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = Array.from(inputs).map(i => i.value).join('');
        if (otp.length < 6) { showMessage('Please enter the full 6-digit code.', 'error'); return; }

        loadingModal.classList.remove('hidden');
        submitBtn.disabled = true;

        try {
            const res  = await fetch('/auth/verify-otp', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ otp })
            });
            const data = await res.json();

            if (res.ok) {
                showMessage(data.message || 'Verified!', 'success');
                setTimeout(() => window.location.href = data.redirectUrl || '/auth/login', 1500);
            } else {
                loadingModal.classList.add('hidden');
                showMessage(data.message || 'Invalid code.', 'error', !!data.blockedUntil); // Keep block error
                submitBtn.disabled = false;
                if (data.blockedUntil) {
                    const timeLeft = Math.max(0, Math.ceil((data.blockedUntil - Date.now()) / 1000));
                    startCountdown(timeLeft);
                }
            }
        } catch {
            loadingModal.classList.add('hidden');
            showMessage('Network error.', 'error');
            submitBtn.disabled = false;
        }
    });

    function showMessage(text, type, keepMessage = false) {
        msgDiv.textContent = text;
        msgDiv.className   = 'block p-3 rounded-lg text-sm text-center mb-4 border ' +
            (type === 'error'
                ? 'bg-red-900/50 text-red-200 border-red-800'
                : 'bg-green-900/50 text-green-200 border-green-800');

        clearTimeout(messageTimeout);
        if (!keepMessage) {
            messageTimeout = setTimeout(hideMessage, 5000); // auto-hide general messages in 5s
        }
    }

    function hideMessage() {
        msgDiv.textContent = '';
        msgDiv.className   = 'hidden p-3 rounded-lg text-sm text-center mb-4';
    }
})();
</script>