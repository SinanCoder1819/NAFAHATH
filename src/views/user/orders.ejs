<!-- ════════════════════════════════════════════════════════════════════════════ -->
<!--  CLIENT SIDE LOGIC FOR CANCEL & RETURN MULTI-STEP WIZARDS                    -->
<!-- ════════════════════════════════════════════════════════════════════════════ -->
<script>
    // Set default pickup date in picker to +3 days from now
    document.addEventListener("DOMContentLoaded", function() {
        const d = new Date();
        d.setDate(d.getDate() + 3);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const dateStr = `${yyyy}-${mm}-${dd}`;
        const input = document.getElementById("returnPickupDateInput");
        if (input) input.value = dateStr;
    });

    // ───────────────────────────────────────────────────────────────────────────
    // CANCEL ORDER WIZARD LOGIC
    // ───────────────────────────────────────────────────────────────────────────
    let currentCancelDbId = "";

    function startCancelWizard(dbId, orderId, totalAmount) {
        currentCancelDbId = dbId;
        document.getElementById('cancelWizardOrderId').value = dbId;
        document.getElementById('cancelWizardDisplayId1').textContent = orderId;
        document.getElementById('cancelWizardDisplayId2').textContent = orderId;
        document.getElementById('cancelCommentsInput').value = '';
        
        showCancelStep(2);
        document.getElementById('cancelWizardModal').classList.remove('hidden');
    }

    function closeCancelWizard() {
        document.getElementById('cancelWizardModal').classList.add('hidden');
    }

    function showCancelStep(step) {
        document.getElementById('cancelStep2View').classList.add('hidden');
        document.getElementById('cancelStep3View').classList.add('hidden');
        document.getElementById('cancelStep4View').classList.add('hidden');

        document.getElementById('cancelStepIndicator2').className = 'step-badge text-gray-500';
        document.getElementById('cancelStepIndicator3').className = 'step-badge text-gray-500';
        document.getElementById('cancelStepIndicator4').className = 'step-badge text-gray-500';

        if (step === 2) {
            document.getElementById('cancelStep2View').classList.remove('hidden');
            document.getElementById('cancelStepIndicator2').className = 'step-badge text-red-400 font-extrabold underline';
        } else if (step === 3) {
            document.getElementById('cancelStep3View').classList.remove('hidden');
            document.getElementById('cancelStepIndicator3').className = 'step-badge text-red-400 font-extrabold underline';
        } else if (step === 4) {
            document.getElementById('cancelStep4View').classList.remove('hidden');
            document.getElementById('cancelStepIndicator4').className = 'step-badge text-emerald-400 font-extrabold underline';
        }
    }

    function highlightCancelReason(radio) {
        document.querySelectorAll('.cancel-reason-option').forEach(el => {
            el.className = 'cancel-reason-option flex items-center gap-3 p-3.5 rounded-2xl border border-gray-800 bg-[#161618] hover:border-red-500/40 cursor-pointer transition-all';
        });
        if (radio && radio.checked) {
            radio.closest('label').className = 'cancel-reason-option flex items-center gap-3 p-3.5 rounded-2xl border border-red-500 bg-red-500/10 cursor-pointer transition-all';
        }
    }

    function goToCancelStep3() {
        showCancelStep(3);
    }

    function goToCancelStep2() {
        showCancelStep(2);
    }

    async function submitCancelWizard() {
        const btn = document.getElementById('cancelConfirmBtn');
        const dbId = document.getElementById('cancelWizardOrderId').value;
        const selectedReason = document.querySelector('input[name="cancelReasonRadio"]:checked')?.value || 'Ordered by mistake';
        const comments = document.getElementById('cancelCommentsInput').value.trim();

        btn.disabled = true;
        btn.textContent = 'Processing...';

        try {
            const res = await fetch(`/orders/${dbId}/cancel`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: selectedReason, comments })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                showCancelStep(4);
            } else {
                alert(data.message || 'Failed to cancel order.');
                btn.disabled = false;
                btn.textContent = 'Yes, Cancel Order';
            }
        } catch (err) {
            alert('Network error. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Yes, Cancel Order';
        }
    }

    // ───────────────────────────────────────────────────────────────────────────
    // RETURN ORDER WIZARD LOGIC
    // ───────────────────────────────────────────────────────────────────────────
    let currentReturnDbId = "";

    function startReturnWizard(dbId, orderId, totalAmount) {
        currentReturnDbId = dbId;
        document.getElementById('returnWizardOrderId').value = dbId;
        document.getElementById('returnWizardDisplayId1').textContent = orderId;
        document.getElementById('returnCommentsInput').value = '';
        document.getElementById('uploadPlaceholder').classList.remove('hidden');
        document.getElementById('uploadPreviewBox').classList.add('hidden');
        
        showReturnStep(2);
        document.getElementById('returnWizardModal').classList.remove('hidden');
    }

    function closeReturnWizard() {
        document.getElementById('returnWizardModal').classList.add('hidden');
    }

    function showReturnStep(step) {
        document.getElementById('returnStep2View').classList.add('hidden');
        document.getElementById('returnStep3View').classList.add('hidden');
        document.getElementById('returnStep4View').classList.add('hidden');
        document.getElementById('returnStep5View').classList.add('hidden');

        document.getElementById('returnStepIndicator2').className = 'step-badge text-gray-500';
        document.getElementById('returnStepIndicator3').className = 'step-badge text-gray-500';
        document.getElementById('returnStepIndicator4').className = 'step-badge text-gray-500';
        document.getElementById('returnStepIndicator5').className = 'step-badge text-gray-500';

        if (step === 2) {
            document.getElementById('returnStep2View').classList.remove('hidden');
            document.getElementById('returnStepIndicator2').className = 'step-badge text-[#22d3ee] font-extrabold underline';
        } else if (step === 3) {
            document.getElementById('returnStep3View').classList.remove('hidden');
            document.getElementById('returnStepIndicator3').className = 'step-badge text-[#22d3ee] font-extrabold underline';
        } else if (step === 4) {
            document.getElementById('returnStep4View').classList.remove('hidden');
            document.getElementById('returnStepIndicator4').className = 'step-badge text-[#22d3ee] font-extrabold underline';
        } else if (step === 5) {
            document.getElementById('returnStep5View').classList.remove('hidden');
            document.getElementById('returnStepIndicator5').className = 'step-badge text-emerald-400 font-extrabold underline';
        }
    }

    function highlightReturnReason(radio) {
        document.querySelectorAll('.return-reason-option').forEach(el => {
            el.className = 'return-reason-option flex items-center gap-3 p-3.5 rounded-2xl border border-gray-800 bg-[#161820] hover:border-[#22d3ee]/40 cursor-pointer transition-all';
        });
        if (radio && radio.checked) {
            radio.closest('label').className = 'return-reason-option flex items-center gap-3 p-3.5 rounded-2xl border border-[#22d3ee] bg-[#22d3ee]/10 cursor-pointer transition-all';
        }
    }

    function handlePhotoUploadPreview(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('uploadPreviewImg').src = e.target.result;
                document.getElementById('uploadPlaceholder').classList.add('hidden');
                document.getElementById('uploadPreviewBox').classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function goToReturnStep3() {
        showReturnStep(3);
    }
    function goToReturnStep2() {
        showReturnStep(2);
    }
    function goToReturnStep4() {
        showReturnStep(4);
    }

    async function submitReturnWizard() {
        const btn = document.getElementById('returnSubmitBtn');
        const dbId = document.getElementById('returnWizardOrderId').value;
        const selectedReason = document.querySelector('input[name="returnReasonRadio"]:checked')?.value || 'Product is defective';
        const comments = document.getElementById('returnCommentsInput').value.trim();
        const pickupMethod = document.querySelector('input[name="pickupMethodRadio"]:checked')?.value || 'Pick up from my address';
        const pickupDate = document.getElementById('returnPickupDateInput').value;

        btn.disabled = true;
        btn.textContent = 'Submitting...';

        try {
            const res = await fetch(`/orders/${dbId}/return`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    reason: selectedReason,
                    comments,
                    pickupMethod,
                    pickupDate
                })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                document.getElementById('returnSuccessPickupDateDisplay').textContent = data.pickupDate || pickupDate;
                showReturnStep(5);
            } else {
                alert(data.message || 'Failed to submit return request.');
                btn.disabled = false;
                btn.textContent = 'Submit Request';
            }
        } catch (err) {
            alert('Network error. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Submit Request';
        }
    }

    function navigateToReturnStatus() {
        const dbId = document.getElementById('returnWizardOrderId').value;
        window.location.href = `/orders/${dbId}#return-timeline`;
    }

    // Backdrop click close
    document.getElementById('cancelWizardModal').addEventListener('click', function(e) {
        if (e.target === this) closeCancelWizard();
    });
    document.getElementById('returnWizardModal').addEventListener('click', function(e) {
        if (e.target === this) closeReturnWizard();
    });
</script>
