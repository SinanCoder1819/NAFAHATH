<main class="min-h-screen bg-[#0a0a0a] flex items-center justify-center p-6 relative overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/10 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/5 blur-[120px] rounded-full"></div>

    <div class="w-full max-w-md bg-[#0f0f0f]/80 backdrop-blur-xl border border-gray-800 rounded-[2.5rem] p-10 md:p-12 relative z-10 shadow-2xl">
        <div class="text-center mb-10">
            <h2 class="text-2xl font-semibold text-white mb-3">Verify Your Email</h2>
            <p class="text-gray-400 text-sm leading-relaxed">Enter the 6-digit code sent to your email address to reset your password.</p>
        </div>

        <div id="responseMessage" class="hidden mb-6 p-3 rounded-xl text-xs font-medium text-center border"></div>

        <form id="otpForm" class="space-y-10">
            <div class="flex justify-between gap-2 md:gap-3">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
            </div>

            <button type="submit" id="verifyBtn"
                class="w-full bg-[#00FFFF] text-black py-4 rounded-2xl font-bold uppercase tracking-widest text-sm hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_25px_rgba(0,255,255,0.25)] disabled:opacity-60 disabled:cursor-not-allowed">
                Verify OTP
            </button>
        </form>

        <div class="mt-10 text-center">
            <p class="text-xs text-gray-500 mb-2">Didn't receive the code?</p>
            <button id="resendBtn" disabled
                class="text-cyan-400 text-xs font-bold uppercase tracking-wider hover:underline disabled:text-gray-600 disabled:no-underline transition-all">
                Resend Code in <span id="timer">0:45</span>
            </button>
        </div>
    </div>
</main>

<script>
    const inputs = document.querySelectorAll('.otp-input');
    const verifyBtn = document.getElementById('verifyBtn');
    const resendBtn = document.getElementById('resendBtn');
    const timerSpan = document.getElementById('timer');
    const msgDiv = document.getElementById('responseMessage');

    // --- OTP Input Navigation ---
    inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            // Only allow digits
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            if (e.target.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                inputs[index - 1].focus();
            }
        });
        // Handle paste
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasted = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
            pasted.split('').forEach((char, i) => {
                if (inputs[i]) inputs[i].value = char;
            });
            const nextEmpty = [...inputs].findIndex(inp => !inp.value);
            if (nextEmpty !== -1) inputs[nextEmpty].focus();
            else inputs[inputs.length - 1].focus();
        });
    });

    function getOtp() {
        return [...inputs].map(i => i.value).join('');
    }

    function showMessage(text, type) {
        msgDiv.textContent = text;
        msgDiv.className = 'mb-6 p-3 rounded-xl text-xs font-medium text-center border block';
        if (type === 'error') {
            msgDiv.classList.add('bg-red-900/50', 'text-red-200', 'border-red-800');
        } else {
            msgDiv.classList.add('bg-green-900/50', 'text-green-200', 'border-green-800');
        }
    }

    // --- Countdown Timer ---
    let timeLeft = 45;
    const countdown = setInterval(() => {
        timeLeft--;
        timerSpan.textContent = `0:${timeLeft < 10 ? '0' : ''}${timeLeft}`;
        if (timeLeft <= 0) {
            clearInterval(countdown);
            resendBtn.disabled = false;
            resendBtn.innerHTML = 'Resend Code';
        }
    }, 1000);

    // --- Verify OTP Submit ---
    document.getElementById('otpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = getOtp();

        if (otp.length < 6) {
            showMessage('Please enter the complete 6-digit OTP.', 'error');
            return;
        }

        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Verifying...';

        try {
            const response = await fetch('/auth/verify-forgotOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp })
            });

            const data = await response.json();

            if (response.ok) {
                showMessage('OTP verified! Redirecting...', 'success');
                setTimeout(() => {
                    window.location.href = '/auth/reset-password';
                }, 1000);
            } else {
                showMessage(data.message || 'Invalid OTP. Please try again.', 'error');
                // Clear inputs on wrong OTP
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
                verifyBtn.disabled = false;
                verifyBtn.textContent = 'Verify OTP';
            }
        } catch (err) {
            showMessage('Network error. Please try again.', 'error');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Verify OTP';
        }
    });

    // --- Resend OTP ---
    resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        resendBtn.textContent = 'Sending...';

        try {
            const response = await fetch('/auth/resend-forgotOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const data = await response.json();

            if (response.ok) {
                showMessage('A new OTP has been sent to your email.', 'success');
                // Restart timer
                timeLeft = 45;
                timerSpan.textContent = '0:45';
                resendBtn.innerHTML = 'Resend Code in <span id="timer">0:45</span>';
                const newTimer = document.getElementById('timer');
                const newCountdown = setInterval(() => {
                    timeLeft--;
                    newTimer.textContent = `0:${timeLeft < 10 ? '0' : ''}${timeLeft}`;
                    if (timeLeft <= 0) {
                        clearInterval(newCountdown);
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = 'Resend Code';
                    }
                }, 1000);
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
            } else {
                showMessage(data.message || 'Failed to resend OTP.', 'error');
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend Code';
            }
        } catch (err) {
            showMessage('Network error. Please try again.', 'error');
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
        }
    });
</script>
