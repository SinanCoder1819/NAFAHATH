<main class="min-h-screen bg-[#0a0a0a] flex items-center justify-center p-6 relative overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/10 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/5 blur-[120px] rounded-full"></div>

    <div class="w-full max-w-md bg-[#0f0f0f]/80 backdrop-blur-xl border border-gray-800 rounded-[2.5rem] p-10 md:p-12 relative z-10 shadow-2xl">
        <div class="text-center mb-10">
            <h2 class="text-2xl font-semibold text-white mb-3">Verify Your Email</h2>
            <p class="text-gray-400 text-sm leading-relaxed">Enter the 6-digit code sent to your email address to reset your password.</p>
        </div>

        <div id="responseMessage" class="hidden mb-6 p-3 rounded-xl text-xs font-medium text-center border"></div>

        <form id="otpForm" class="space-y-10">
            <div class="flex justify-between gap-2 md:gap-3">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                    class="otp-input w-full aspect-square text-center text-xl font-bold bg-transparent border border-gray-800 rounded-2xl focus:border-cyan-400 outline-none transition-all text-white">
            </div>

            <button type="submit" id="verifyBtn"
                class="w-full bg-[#00FFFF] text-black py-4 rounded-2xl font-bold uppercase tracking-widest text-sm hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_25px_rgba(0,255,255,0.25)] disabled:opacity-60 disabled:cursor-not-allowed">
                Verify OTP
            </button>
        </form>

        <div class="mt-10 text-center">
            <p class="text-xs text-gray-500 mb-2">Didn't receive the code?</p>
            <button id="resendBtn" disabled
                class="text-cyan-400 text-xs font-bold uppercase tracking-wider hover:underline disabled:text-gray-600 disabled:no-underline transition-all">
                Resend Code
            </button>
            <div id="lockoutMsg" class="hidden text-xs text-red-500 font-medium mt-2">
                Too many attempts. Try again in <span id="lockoutTimerVal">5:00</span>
            </div>
        </div>
    </div>
</main>

<script>
(function () {
    const inputs    = document.querySelectorAll('.otp-input');
    const verifyBtn = document.getElementById('verifyBtn');
    const resendBtn = document.getElementById('resendBtn');
    const lockoutMsg   = document.getElementById('lockoutMsg');
    const lockoutTimer = document.getElementById('lockoutTimerVal');
    const msgDiv    = document.getElementById('responseMessage');

    const TIMER_DURATION = 30;
    let countdownInterval = null;
    let isLockout = false;
    let messageTimeout = null;

    function updateResendLabel(timeLeft) {
        if (isLockout && timeLeft > 0) {
            resendBtn.classList.add('hidden');
            lockoutMsg.classList.remove('hidden');
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            lockoutTimer.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        } else if (timeLeft > 0) {
            resendBtn.classList.remove('hidden');
            lockoutMsg.classList.add('hidden');
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            resendBtn.innerHTML = `Resend Code in <span id="timerVal">${mins}:${secs < 10 ? '0' : ''}${secs}</span>`;
            resendBtn.disabled = true;
        } else {
            isLockout = false;
            resendBtn.classList.remove('hidden');
            lockoutMsg.classList.add('hidden');
            resendBtn.textContent = 'Resend Code';
            resendBtn.disabled = false;
            hideMessage(); // Lockout completed, clear lockout messages
        }
    }

    function startCountdown(seconds) {
        clearInterval(countdownInterval);
        isLockout = (seconds > 30);
        let timeLeft = seconds;
        updateResendLabel(timeLeft);

        countdownInterval = setInterval(() => {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                updateResendLabel(0);
            } else {
                updateResendLabel(timeLeft);
            }
        }, 1000);
    }

    (function init() {
        const serverTimeLeft = parseInt('<%= timeLeft %>', 10) || 0;
        if (serverTimeLeft > 0) {
            startCountdown(serverTimeLeft);
        } else {
            updateResendLabel(0);
        }
    })();

    // ── OTP Inputs ──────────────────────────────────────────────────
    inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            if (!isLockout) {
                hideMessage(); // Auto-dismiss old errors when typing
            }
            if (e.target.value.length === 1 && index < inputs.length - 1) inputs[index + 1].focus();
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) inputs[index - 1].focus();
        });
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const chars = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6).split('');
            chars.forEach((c, i) => { if (inputs[i]) inputs[i].value = c; });
            const next = [...inputs].findIndex(i => !i.value);
            if (next !== -1) inputs[next].focus(); else inputs[5].focus();
        });
    });

    function getOtp() { return [...inputs].map(i => i.value).join(''); }

    // ── Resend ──────────────────────────────────────────────────────
    resendBtn.addEventListener('click', async () => {
        hideMessage();
        resendBtn.disabled    = true;
        resendBtn.textContent = 'Sending...';

        try {
            const res  = await fetch('/auth/resend-forgotOtp', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();

            if (res.ok) {
                showMessage(data.message || 'New OTP sent!', 'success');
                startCountdown(TIMER_DURATION);
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
            } else {
                showMessage(data.message || 'Failed to resend.', 'error', true); // Keep lockout error
                if (data.blockedUntil) {
                    const timeLeft = Math.max(0, Math.ceil((data.blockedUntil - Date.now()) / 1000));
                    startCountdown(timeLeft);
                } else {
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend Code';
                }
            }
        } catch {
            showMessage('Network error.', 'error');
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
        }
    });

    // ── Verify ──────────────────────────────────────────────────────
    document.getElementById('otpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = getOtp();
        if (otp.length < 6) { showMessage('Please enter the complete 6-digit OTP.', 'error'); return; }

        verifyBtn.disabled    = true;
        verifyBtn.textContent = 'Verifying...';

        try {
            const res  = await fetch('/auth/verify-forgotOtp', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ otp })
            });
            const data = await res.json();

            if (res.ok) {
                showMessage('OTP verified! Redirecting...', 'success');
                setTimeout(() => window.location.href = '/auth/reset-password', 1000);
            } else {
                showMessage(data.message || 'Invalid OTP.', 'error', !!data.blockedUntil); // Keep block error
                inputs.forEach(i => i.value = '');
                inputs[0].focus();
                verifyBtn.disabled    = false;
                verifyBtn.textContent = 'Verify OTP';
                if (data.blockedUntil) {
                    const timeLeft = Math.max(0, Math.ceil((data.blockedUntil - Date.now()) / 1000));
                    startCountdown(timeLeft);
                }
            }
        } catch {
            showMessage('Network error.', 'error');
            verifyBtn.disabled    = false;
            verifyBtn.textContent = 'Verify OTP';
        }
    });

    function showMessage(text, type, keepMessage = false) {
        msgDiv.textContent = text;
        msgDiv.className   = 'mb-6 p-3 rounded-xl text-xs font-medium text-center border block ' +
            (type === 'error'
                ? 'bg-red-900/50 text-red-200 border-red-800'
                : 'bg-green-900/50 text-green-200 border-green-800');

        clearTimeout(messageTimeout);
        if (!keepMessage) {
            messageTimeout = setTimeout(hideMessage, 5000); // auto-hide general messages in 5s
        }
    }

    function hideMessage() {
        msgDiv.textContent = '';
        msgDiv.className   = 'hidden mb-6 p-3 rounded-xl text-xs font-medium text-center border';
    }
})();
</script>
