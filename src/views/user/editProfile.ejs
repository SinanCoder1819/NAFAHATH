<main class="min-h-screen bg-[#060606] text-white py-12 px-4 md:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">

        <!-- Sidebar -->
        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 sticky top-28 shadow-2xl">
                <div class="mb-10">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-[#22d3ee] font-bold mb-6 opacity-80">Dashboard</p>
                    <nav class="flex flex-col gap-2">
                        <a href="/profile" class="group flex items-center gap-4 px-4 py-3 rounded-xl bg-[#22d3ee]/10 text-[#22d3ee] border border-[#22d3ee]/20 transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium">Profile</span>
                        </a>

                        <% const navLinks = [
                            { href: '/orders', label: 'My Orders', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
                            { href: '/wallet', label: 'Wallet', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
                            { href: '/address', label: 'Addresses', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
                            { href: '/referrals', label: 'Refer & Earn', icon: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z' }
                        ] %>
                        <% navLinks.forEach(link => { %>
                            <a href="<%= link.href %>" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                                <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="<%= link.icon %>"/></svg>
                                <span class="text-sm font-medium"><%= link.label %></span>
                            </a>
                        <% }) %>
                    </nav>
                </div>

                <div class="pt-6 border-t border-gray-800">
                    <a href="/auth/logout" class="flex items-center gap-4 px-4 py-3 text-red-400 hover:bg-red-500/10 rounded-xl transition-all group">
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        <span class="text-sm font-medium">Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Edit Form -->
        <section class="flex-1">
            <div class="text-center mb-10">
                <h1 class="text-4xl font-serif tracking-tight mb-2 italic text-white">Edit Profile</h1>
                <p class="text-gray-500 text-[10px] tracking-[0.3em] uppercase">Refine your personal portrait</p>
            </div>

            <div class="bg-[#0f0f0f] border border-gray-800 rounded-[2.5rem] p-8 md:p-12 shadow-2xl">

                <!-- Avatar Upload (separate AJAX upload, same as profile page) -->
                <div class="flex flex-col items-center mb-10 group">
                    <div class="relative cursor-pointer" onclick="document.getElementById('profileImageInput').click()">
                        <div class="w-32 h-32 rounded-full border-2 border-[#22d3ee]/30 p-1 transition-all group-hover:border-[#22d3ee]">
                            <div id="avatarContainer" class="w-full h-full rounded-full bg-gradient-to-br from-gray-800 to-black flex items-center justify-center overflow-hidden relative">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" id="avatarPreview" alt="Profile"
                                        class="w-full h-full object-cover transition-opacity group-hover:opacity-40">
                                <% } else { %>
                                    <svg id="defaultAvatar" class="w-14 h-14 text-gray-600 transition-opacity group-hover:opacity-40" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                <% } %>
                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 rounded-full">
                                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="profileImageInput" class="hidden" accept="image/jpeg,image/jpg,image/png,image/webp" onchange="uploadImage(this)">
                        <div class="absolute bottom-1 right-1 w-5 h-5 bg-green-500 rounded-full border-4 border-[#0f0f0f]"></div>
                    </div>
                    <p class="mt-3 text-[9px] text-gray-500 uppercase tracking-widest">Change Portrait</p>
                    <div id="uploadStatus" class="hidden mt-2 px-4 py-2 rounded-xl text-xs font-medium border"></div>
                </div>

                <!-- Profile Form -->
                <form id="editProfileForm" class="space-y-8">

                    <div id="formMessage" class="hidden p-3 rounded-xl text-xs font-medium border text-center"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-[9px] uppercase tracking-[0.3em] text-[#22d3ee] font-bold ml-1">Full Name</label>
                            <input type="text" name="name" id="nameInput" value="<%= user.name || '' %>"
                                class="w-full bg-transparent border-b border-gray-700 py-3 px-1 focus:border-[#22d3ee] outline-none transition-all text-sm tracking-wide text-white">
                            <p id="nameError" class="hidden text-red-400 text-[11px] ml-1"></p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[9px] uppercase tracking-[0.3em] text-[#22d3ee] font-bold ml-1">Phone Number</label>
                            <input type="tel" name="phone" id="phoneInput" value="<%= user.phone || '' %>"
                                class="w-full bg-transparent border-b border-gray-700 py-3 px-1 focus:border-[#22d3ee] outline-none transition-all text-sm tracking-wide text-white">
                            <p id="phoneError" class="hidden text-red-400 text-[11px] ml-1"></p>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row items-center justify-center gap-6 pt-4">
                        <a href="/profile" class="text-[10px] uppercase tracking-widest text-gray-500 hover:text-white transition-colors">
                            Cancel
                        </a>
                        <button type="submit" id="saveBtn"
                            class="w-full md:w-64 bg-white text-black py-4 rounded-full font-bold uppercase tracking-[0.2em] text-[10px] hover:bg-[#22d3ee] transition-all active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed">
                            Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</main>

<script>
    // --- Avatar Upload (AJAX — same as profile page) ---
    async function uploadImage(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];

        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
            showUploadStatus('Only JPG, PNG, or WEBP images are allowed.', 'error');
            return;
        }
        if (file.size > 2 * 1024 * 1024) {
            showUploadStatus('Image must be under 2MB.', 'error');
            return;
        }

        showUploadStatus('Uploading...', 'success');

        const formData = new FormData();
        formData.append('profileImage', file);

        try {
            const response = await fetch('/profile/update-image', {
                method: 'POST',
                body: formData
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok && result.newImageUrl) {
                const container = document.getElementById('avatarContainer');
                let img = document.getElementById('avatarPreview');
                const svg = document.getElementById('defaultAvatar');

                if (img) {
                    img.src = result.newImageUrl;
                } else {
                    if (svg) svg.remove();
                    img = document.createElement('img');
                    img.id = 'avatarPreview';
                    img.alt = 'Profile';
                    img.className = 'w-full h-full object-cover transition-opacity group-hover:opacity-40';
                    img.src = result.newImageUrl;
                    container.prepend(img);
                }
                showUploadStatus('Profile picture updated!', 'success');
            } else {
                showUploadStatus(result.message || 'Upload failed.', 'error');
            }
        } catch (err) {
            console.error('Upload error:', err);
            showUploadStatus('Upload failed. Please try again.', 'error');
        }

        input.value = '';
    }

    function showUploadStatus(text, type) {
        const el = document.getElementById('uploadStatus');
        el.textContent = text;
        el.className = 'mt-2 px-4 py-2 rounded-xl text-xs font-medium border block text-center';
        el.classList.add(type === 'error' ? 'bg-red-900/50' : 'bg-green-900/50');
        el.classList.add(type === 'error' ? 'text-red-200' : 'text-green-200');
        el.classList.add(type === 'error' ? 'border-red-800' : 'border-green-800');
    }

    // --- Profile Form Submit (AJAX) ---
    const nameInput = document.getElementById('nameInput');
    const phoneInput = document.getElementById('phoneInput');
    const nameError = document.getElementById('nameError');
    const phoneError = document.getElementById('phoneError');
    const formMsg = document.getElementById('formMessage');
    const saveBtn = document.getElementById('saveBtn');

    function showFieldError(el, msg) { el.textContent = msg; el.classList.remove('hidden'); }
    function clearFieldError(el) { el.textContent = ''; el.classList.add('hidden'); }
    function showFormMsg(text, type) {
        formMsg.textContent = text;
        formMsg.className = 'p-3 rounded-xl text-xs font-medium border text-center block';
        formMsg.classList.add(type === 'error' ? 'bg-red-900/50' : 'bg-green-900/50');
        formMsg.classList.add(type === 'error' ? 'text-red-200' : 'text-green-200');
        formMsg.classList.add(type === 'error' ? 'border-red-800' : 'border-green-800');
    }

    nameInput.addEventListener('input', () => clearFieldError(nameError));
    phoneInput.addEventListener('input', () => clearFieldError(phoneError));

    document.getElementById('editProfileForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearFieldError(nameError);
        clearFieldError(phoneError);

        const name = nameInput.value.trim();
        const phone = phoneInput.value.trim();
        let valid = true;

        if (!name) {
            showFieldError(nameError, 'Full name is required.');
            valid = false;
        } else if (name.length < 2) {
            showFieldError(nameError, 'Name must be at least 2 characters.');
            valid = false;
        }

        if (phone && !/^[0-9]{10}$/.test(phone)) {
            showFieldError(phoneError, 'Enter a valid 10-digit phone number.');
            valid = false;
        }

        if (!valid) return;

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        try {
            const response = await fetch('/profile/edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, phone })
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok) {
                showFormMsg('Profile updated successfully!', 'success');
                setTimeout(() => window.location.href = '/profile', 1200);
            } else {
                showFormMsg(result.message || 'Update failed. Please try again.', 'error');
                saveBtn.disabled = false;
                saveBtn.textContent = 'Update Profile';
            }
        } catch (err) {
            showFormMsg('Network error. Please try again.', 'error');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Update Profile';
        }
    });
</script>
