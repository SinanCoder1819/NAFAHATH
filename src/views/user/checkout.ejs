<%- /* checkout.ejs */ '' %>

<!-- PAGE WRAPPER -->
<div class="max-w-[1280px] mx-auto px-7 py-12 min-h-[80vh] text-[#c8cdd8] font-['Inter',sans-serif]">

  <!-- HEADER -->
  <div class="text-center mb-10">
    <div class="inline-flex items-center gap-1.5 text-[10px] font-bold tracking-[0.16em] uppercase text-[#00FFFF] mb-3.5">
      <span class="w-7 h-px bg-gradient-to-r from-transparent to-[rgba(0,255,255,0.4)]"></span>
      Secure Checkout
      <span class="w-7 h-px bg-gradient-to-r from-[rgba(0,255,255,0.4)] to-transparent"></span>
    </div>
    <h1 class="text-[40px] font-extrabold tracking-tight bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent m-0 mb-2">
      Shipping & Payment
    </h1>
    <p class="text-[12px] text-[#374151] tracking-[0.1em]">Verify your delivery coordinates and finalize purchase</p>
  </div>

  <% if (typeof isMockData !== 'undefined' && isMockData) { %>
    <!-- MOCK DATA PREVIEW BANNER -->
    <div class="mb-8 p-4 bg-yellow-950/20 border border-yellow-800/40 rounded-2xl flex items-center gap-3 text-yellow-300/90 text-xs">
      <svg class="w-5 h-5 shrink-0 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <div>
        <span class="font-bold">Preview Mode:</span> Your cart is currently empty. We've populated the order summary with preview fragrances so you can test the checkout UI.
      </div>
    </div>
  <% } %>

  <!-- MAIN GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-8 items-start">

    <!-- ── LEFT COLUMN: ADDRESS & PAYMENT ── -->
    <div class="space-y-6">

      <!-- SECTION 1: SHIPPING ADDRESS -->
      <div class="bg-[#0a0e16]/60 backdrop-blur-xl border border-white/[0.06] rounded-[24px] p-6 md:p-8 shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
        
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/[0.06]">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-[#00FFFF]/10 border border-[#00FFFF]/20 flex items-center justify-center text-[#00FFFF]">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
            </div>
            <h2 class="text-base font-bold text-white uppercase tracking-wider">1. Shipping Address</h2>
          </div>
          <button onclick="openAddModal()" class="text-xs font-bold uppercase tracking-wider text-[#00FFFF] hover:underline flex items-center gap-1 bg-transparent border-none cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            Add New
          </button>
        </div>

        <div id="checkoutAddressContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% if (addresses && addresses.length > 0) { %>
            <% addresses.forEach((addr, index) => { %>
              <div 
                onclick="selectAddress('<%= addr._id %>')"
                class="address-card cursor-pointer border rounded-2xl p-4 sm:p-5 relative transition-all duration-300 hover:bg-white/[0.02] bg-[#0c121d]/40
                       <%= addr.isDefault || index === 0 ? 'border-[#00FFFF] shadow-[0_0_15px_rgba(0,255,255,0.08)] bg-[#00FFFF]/[0.01]' : 'border-white/[0.08]' %>"
                id="addr-card-<%= addr._id %>"
                data-id="<%= addr._id %>"
                data-name="<%= addr.fullName %>"
                data-fulladdress="<%= addr.addressLine %>, <%= addr.city %>, <%= addr.state %> - <%= addr.postalCode %>"
              >
                <!-- Radio Input -->
                <div class="absolute top-4 right-4 flex items-center justify-center">
                  <input 
                    type="radio" 
                    name="selectedAddress" 
                    id="radio-<%= addr._id %>" 
                    value="<%= addr._id %>" 
                    class="w-4 h-4 accent-[#00FFFF] cursor-pointer"
                    <%= addr.isDefault || index === 0 ? 'checked' : '' %>
                  >
                </div>

                <div class="pr-6">
                  <p class="font-bold text-white text-sm mb-1.5 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-[#00FFFF]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <%= addr.fullName %>
                    <% if (addr.isDefault) { %>
                      <span class="bg-[#00FFFF]/10 text-[#00FFFF] text-[8px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md border border-[#00FFFF]/20">Default</span>
                    <% } %>
                  </p>
                  <p class="text-gray-400 text-xs leading-relaxed"><%= addr.addressLine %></p>
                  <p class="text-gray-400 text-xs leading-relaxed"><%= addr.city %>, <%= addr.state %> - <%= addr.postalCode %></p>
                  <p class="text-gray-400 text-xs mt-2.5 font-medium flex items-center gap-1.5">
                    <svg class="w-3 h-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <%= addr.phone %>
                  </p>
                </div>

                <div class="flex items-center gap-2 mt-4 pt-3 border-t border-white/[0.04]">
                  <!-- Edit Button -->
                  <button 
                    onclick="event.stopPropagation(); openEditModal('<%= addr._id %>', '<%= addr.fullName.replace(/'/g, `\\'`) %>', '<%= addr.addressLine.replace(/'/g, `\\'`) %>', '<%= addr.city %>', '<%= addr.state %>', '<%= addr.postalCode %>', '<%= addr.phone %>', <%= addr.isDefault %>)"
                    class="bg-white/[0.03] border border-white/10 hover:bg-[#00FFFF]/10 hover:border-[#00FFFF]/30 text-gray-300 hover:text-white px-2.5 py-1.5 rounded-lg text-[9px] font-bold uppercase tracking-wider flex items-center gap-1 transition-all cursor-pointer"
                  >
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    Edit
                  </button>
                  
                  <!-- Delete Button -->
                  <button 
                    onclick="event.stopPropagation(); deleteAddress('<%= addr._id %>')"
                    class="bg-red-500/5 border border-red-500/10 hover:bg-red-500/15 hover:border-red-500/30 text-red-400 hover:text-red-300 px-2.5 py-1.5 rounded-lg text-[9px] font-bold uppercase tracking-wider flex items-center gap-1 transition-all cursor-pointer"
                  >
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Delete
                  </button>
                  
                  <!-- Set Default Button -->
                  <% if (!addr.isDefault) { %>
                    <button 
                      onclick="event.stopPropagation(); setDefault('<%= addr._id %>')"
                      class="bg-[#22d3ee]/5 border border-[#22d3ee]/15 hover:bg-[#22d3ee]/15 hover:border-[#22d3ee]/30 text-[#22d3ee] hover:text-[#67e8f9] px-3 py-1.5 rounded-lg text-[9px] font-bold uppercase tracking-wider flex items-center gap-1 transition-all cursor-pointer ml-auto"
                    >
                      <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      Set Default
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-span-2 py-10 px-6 border border-dashed border-white/[0.08] rounded-2xl text-center bg-[#0c121d]/20">
              <svg class="w-10 h-10 text-gray-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              <p class="text-gray-400 text-xs font-semibold">No saved addresses found.</p>
              <p class="text-gray-600 text-[10px] mt-1 mb-4">Please add a shipping address to complete your order.</p>
              <button onclick="openAddModal()" class="bg-[#00FFFF] text-black px-5 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-widest hover:scale-[1.02] active:scale-95 transition-all">
                + Add Delivery Address
              </button>
            </div>
          <% } %>
        </div>
      </div>

      <!-- SECTION 2: PAYMENT METHOD -->
      <div class="bg-[#0a0e16]/60 backdrop-blur-xl border border-white/[0.06] rounded-[24px] p-6 md:p-8 shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
        <div class="flex items-center gap-2.5 mb-6 pb-4 border-b border-white/[0.06]">
          <div class="w-8 h-8 rounded-full bg-[#00FFFF]/10 border border-[#00FFFF]/20 flex items-center justify-center text-[#00FFFF] font-extrabold text-xs">
            2
          </div>
          <h2 class="text-base font-bold text-white uppercase tracking-wider">Payment Method</h2>
        </div>

        <!-- Horizontal Tabs Grid (SDE-style) -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
          
          <!-- Card option -->
          <div 
            onclick="selectPaymentMethod('CARD')" 
            id="pay-card-CARD"
            class="pay-method-tab group cursor-pointer border border-white/[0.08] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#0c121d]/40 text-gray-400 hover:bg-[#121b2d]/60 hover:border-white/25 hover:scale-[1.02]"
          >
            <svg class="payment-icon w-7 h-7 transition-all duration-300 opacity-75" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3b82f6" />
                  <stop offset="100%" stop-color="#1d4ed8" />
                </linearGradient>
                <linearGradient id="chipGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f59e0b" />
                  <stop offset="100%" stop-color="#d97706" />
                </linearGradient>
              </defs>
              <rect x="2" y="5" width="20" height="14" rx="2" fill="url(#cardGrad)" stroke="#1e40af" stroke-width="0.5"/>
              <rect x="2" y="8" width="20" height="3" fill="#111827"/>
              <rect x="5" y="13" width="4" height="3" rx="0.5" fill="url(#chipGrad)"/>
              <line x1="11" y1="14" x2="15" y2="14" stroke="#93c5fd" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="11" y1="16" x2="18" y2="16" stroke="#93c5fd" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wider text-gray-400 transition-colors">Card</span>
          </div>

          <!-- UPI option -->
          <div 
            onclick="selectPaymentMethod('UPI')" 
            id="pay-card-UPI"
            class="pay-method-tab group cursor-pointer border border-white/[0.08] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#0c121d]/40 text-gray-400 hover:bg-[#121b2d]/60 hover:border-white/25 hover:scale-[1.02]"
          >
            <svg class="payment-icon w-7 h-7 transition-all duration-300 opacity-75" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="upiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#eab308" />
                  <stop offset="50%" stop-color="#ca8a04" />
                  <stop offset="100%" stop-color="#854d0e" />
                </linearGradient>
              </defs>
              <path d="M6 6L11 12L6 18H10L15 12L10 6H6Z" fill="url(#upiGrad)"/>
              <path d="M12 6L17 12L12 18H16L21 12L16 6H12Z" fill="url(#upiGrad)"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wider text-gray-400 transition-colors">UPI</span>
          </div>

          <!-- Net Banking option -->
          <div 
            onclick="selectPaymentMethod('NET_BANKING')" 
            id="pay-card-NET_BANKING"
            class="pay-method-tab group cursor-pointer border border-white/[0.08] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#0c121d]/40 text-gray-400 hover:bg-[#121b2d]/60 hover:border-white/25 hover:scale-[1.02]"
          >
            <svg class="payment-icon w-7 h-7 transition-all duration-300 opacity-75" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="bankGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#06b6d4" />
                  <stop offset="100%" stop-color="#0891b2" />
                </linearGradient>
              </defs>
              <path d="M12 3L3 9H21L12 3Z" fill="url(#bankGrad)"/>
              <rect x="4" y="9" width="16" height="2" fill="#0e7490"/>
              <rect x="5" y="11" width="2" height="7" fill="url(#bankGrad)"/>
              <rect x="9" y="11" width="2" height="7" fill="url(#bankGrad)"/>
              <rect x="13" y="11" width="2" height="7" fill="url(#bankGrad)"/>
              <rect x="17" y="11" width="2" height="7" fill="url(#bankGrad)"/>
              <rect x="3" y="18" width="18" height="3" rx="0.5" fill="#0e7490"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wider text-gray-400 transition-colors">Net Banking</span>
          </div>

          <!-- Wallet option -->
          <div 
            onclick="selectPaymentMethod('WALLET')" 
            id="pay-card-WALLET"
            class="pay-method-tab group cursor-pointer border border-white/[0.08] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#0c121d]/40 text-gray-400 hover:bg-[#121b2d]/60 hover:border-white/25 hover:scale-[1.02]"
          >
            <svg class="payment-icon w-7 h-7 transition-all duration-300 opacity-75" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="walletGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f97316" />
                  <stop offset="100%" stop-color="#c2410c" />
                </linearGradient>
                <linearGradient id="walletCardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#a855f7" />
                  <stop offset="100%" stop-color="#7e22ce" />
                </linearGradient>
              </defs>
              <rect x="6" y="4" width="10" height="6" rx="1" fill="url(#walletCardGrad)"/>
              <rect x="8" y="2" width="10" height="6" rx="1" fill="#3b82f6" opacity="0.8"/>
              <rect x="3" y="6" width="18" height="14" rx="2" fill="url(#walletGrad)" stroke="#9a3412" stroke-width="0.5"/>
              <path d="M15 11H21V15H15C13.8954 15 13 14.1046 13 13C13 11.8954 13.8954 11 15 11Z" fill="#7c2d12"/>
              <circle cx="16.5" cy="13" r="1.2" fill="#facc15"/>
            </svg>
            <span class="text-[11px] font-bold tracking-wider text-gray-400 transition-colors">Wallet</span>
          </div>

          <!-- COD option (Pre-selected) -->
          <div 
            onclick="selectPaymentMethod('COD')" 
            id="pay-card-COD"
            class="pay-method-tab group cursor-pointer border border-[#00FFFF] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#00FFFF]/[0.04] text-white shadow-[0_0_20px_rgba(0,255,255,0.12)] scale-[1.02]"
          >
            <svg class="payment-icon w-7 h-7 transition-all duration-300 opacity-100 scale-110" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="cashGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#10b981" />
                  <stop offset="100%" stop-color="#047857" />
                </linearGradient>
              </defs>
              <rect x="5" y="7" width="16" height="10" rx="1" fill="url(#cashGrad)" opacity="0.6"/>
              <rect x="3" y="9" width="16" height="10" rx="1" fill="url(#cashGrad)" stroke="#065f46" stroke-width="0.5"/>
              <circle cx="11" cy="14" r="2.5" stroke="#a7f3d0" stroke-width="1" fill="none"/>
              <line x1="5" y1="11" x2="7" y2="11" stroke="#a7f3d0" stroke-width="1.5"/>
              <line x1="15" y1="17" x2="17" y2="17" stroke="#a7f3d0" stroke-width="1.5"/>
            </svg>
            <span class="text-[11px] font-extrabold tracking-wider text-[#00FFFF] transition-colors">COD</span>
          </div>

        </div>

        <!-- Sub-panel detail blocks based on selected tab -->
        <div class="bg-black/40 rounded-2xl border border-white/[0.04] p-5">
          
          <!-- COD Details Panel -->
          <div id="panel-COD" class="payment-panel space-y-2">
            <h3 class="text-[11px] font-extrabold text-[#00FFFF] uppercase tracking-wider">Cash on Delivery details</h3>
            <p class="text-gray-400 text-xs leading-relaxed">
              Pay in cash directly to our delivery courier. Please ensure someone is available at the address with the exact amount when the package arrives.
            </p>
          </div>

          <!-- Card Details Panel (Hidden by default) -->
          <div id="panel-CARD" class="payment-panel hidden space-y-4">
            <h3 class="text-[11px] font-extrabold text-[#00FFFF] uppercase tracking-wider">Credit / Debit Card details</h3>
            
            <div class="space-y-3">
              <div>
                <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Card Number</label>
                <input type="text" id="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19"
                  class="w-full bg-black/40 border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-white placeholder:text-gray-700">
              </div>

              <div>
                <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Cardholder Name</label>
                <input type="text" id="cardName" placeholder="Enter Cardholder Name"
                  class="w-full bg-black/40 border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-white placeholder:text-gray-700">
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Expiry Date</label>
                  <input type="text" id="cardExpiry" placeholder="MM/YY" maxlength="5"
                    class="w-full bg-black/40 border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-white placeholder:text-gray-700">
                </div>
                <div>
                  <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">CVV / CVN</label>
                  <input type="password" id="cardCvv" placeholder="•••" maxlength="3"
                    class="w-full bg-black/40 border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-white placeholder:text-gray-700">
                </div>
              </div>
            </div>
          </div>

          <!-- UPI Details Panel (Hidden by default) -->
          <div id="panel-UPI" class="payment-panel hidden space-y-4">
            <h3 class="text-[11px] font-extrabold text-[#00FFFF] uppercase tracking-wider">UPI Payment Options</h3>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <div onclick="selectUpiApp('gpay')" class="upi-app border border-white/[0.08] rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#0c121d]/40 hover:border-white/20 transition-all duration-300">
                <span class="text-[10px] font-bold text-gray-500 transition-colors">Google Pay</span>
              </div>
              <div onclick="selectUpiApp('phonepe')" class="upi-app border border-white/[0.08] rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#0c121d]/40 hover:border-white/20 transition-all duration-300">
                <span class="text-[10px] font-bold text-gray-500 transition-colors">PhonePe</span>
              </div>
              <div onclick="selectUpiApp('paytm')" class="upi-app border border-white/[0.08] rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#0c121d]/40 hover:border-white/20 transition-all duration-300">
                <span class="text-[10px] font-bold text-gray-500 transition-colors">Paytm</span>
              </div>
              <div onclick="selectUpiApp('bhim')" class="upi-app border border-white/[0.08] rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#0c121d]/40 hover:border-white/20 transition-all duration-300">
                <span class="text-[10px] font-bold text-gray-500 transition-colors">BHIM UPI</span>
              </div>
            </div>

            <div>
              <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Or enter UPI ID</label>
              <div class="flex gap-2">
                <input type="text" id="upiId" placeholder="username@bank"
                  class="flex-1 bg-black/40 border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-white placeholder:text-gray-700">
                <button type="button" onclick="verifyUpi()" class="bg-[#00FFFF]/10 border border-[#00FFFF]/20 text-[#00FFFF] text-[9px] uppercase font-bold tracking-widest px-4 rounded-xl hover:bg-[#00FFFF]/20 transition-all cursor-pointer">Verify</button>
              </div>
            </div>
          </div>

          <!-- Net Banking Panel (Hidden by default) -->
          <div id="panel-NET_BANKING" class="payment-panel hidden space-y-4">
            <h3 class="text-[11px] font-extrabold text-[#00FFFF] uppercase tracking-wider">Select Bank</h3>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <label class="bank-option border border-white/[0.08] rounded-xl p-2.5 flex items-center gap-2 cursor-pointer bg-black/20 hover:border-[#00FFFF]/30 transition-all">
                <input type="radio" name="bankSelect" value="sbi" class="accent-[#00FFFF]" onclick="selectBankName('State Bank of India')">
                <span class="text-[10px] text-gray-500 font-bold">SBI</span>
              </label>
              <label class="bank-option border border-white/[0.08] rounded-xl p-2.5 flex items-center gap-2 cursor-pointer bg-black/20 hover:border-[#00FFFF]/30 transition-all">
                <input type="radio" name="bankSelect" value="hdfc" class="accent-[#00FFFF]" onclick="selectBankName('HDFC Bank')">
                <span class="text-[10px] text-gray-500 font-bold">HDFC</span>
              </label>
              <label class="bank-option border border-white/[0.08] rounded-xl p-2.5 flex items-center gap-2 cursor-pointer bg-black/20 hover:border-[#00FFFF]/30 transition-all">
                <input type="radio" name="bankSelect" value="icici" class="accent-[#00FFFF]" onclick="selectBankName('ICICI Bank')">
                <span class="text-[10px] text-gray-500 font-bold">ICICI</span>
              </label>
            </div>

            <div>
              <label class="block text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Or choose other bank</label>
              <select id="bankSelectDropdown" class="w-full bg-black border border-white/[0.08] rounded-xl px-4 py-3 outline-none focus:border-[#00FFFF] transition-all text-xs text-gray-400 cursor-pointer">
                <option value="">Choose Bank...</option>
                <option value="axis">Axis Bank</option>
                <option value="kotak">Kotak Mahindra Bank</option>
                <option value="pnb">Punjab National Bank</option>
                <option value="bob">Bank of Baroda</option>
              </select>
            </div>
          </div>

          <!-- Wallet Panel (Hidden by default) -->
          <div id="panel-WALLET" class="payment-panel hidden space-y-4">
            <h3 class="text-[11px] font-extrabold text-[#00FFFF] uppercase tracking-wider">Select Wallet</h3>
            
            <div class="grid grid-cols-2 gap-2">
              <label class="wallet-option border border-white/[0.08] rounded-xl p-2.5 flex items-center gap-2 cursor-pointer bg-black/20 hover:border-[#00FFFF]/30 transition-all">
                <input type="radio" name="walletSelect" value="amazonpay" class="accent-[#00FFFF]">
                <span class="text-[10px] text-gray-500 font-bold">Amazon Pay</span>
              </label>
              <label class="wallet-option border border-white/[0.08] rounded-xl p-2.5 flex items-center gap-2 cursor-pointer bg-black/20 hover:border-[#00FFFF]/30 transition-all">
                <input type="radio" name="walletSelect" value="paytm" class="accent-[#00FFFF]">
                <span class="text-[10px] text-gray-500 font-bold">Paytm Wallet</span>
              </label>
            </div>
