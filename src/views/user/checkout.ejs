        <div class="text-[10px] font-extrabold tracking-[0.16em] uppercase text-white mb-5 pb-4 border-b border-white/[0.06] flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00FFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <% const checkoutItems = typeof items !== 'undefined' ? items : (typeof displayItems !== 'undefined' ? displayItems : []); %>
          Cart Items (<%= checkoutItems.length %>)
        </div>

        <!-- ITEMS LIST -->
        <div class="space-y-4 max-h-[280px] overflow-y-auto pr-1 custom-scrollbar">
          <% checkoutItems.forEach(item => { %>
            <div class="flex items-center gap-3.5 pb-4 border-b border-white/[0.03] last:border-0 last:pb-0">
              <!-- Item Image -->
              <div class="w-14 h-18 shrink-0 rounded-lg border border-white/[0.08] overflow-hidden bg-[#0c121d]/80">
                <img 
                  src="<%= item.primaryImage || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume' %>" 
                  onerror="this.src='https://placehold.co/400x500/0a0e16/1e2533?text=Perfume'"
                  alt="<%= item.productName %>" 
                  class="w-full h-full object-cover"
                >
              </div>

              <!-- Item Info -->
              <div class="flex-1 min-w-0">
                <h4 class="text-xs font-bold text-white truncate"><%= item.productName %></h4>
                <p class="text-[10px] text-gray-500 truncate mb-1"><%= item.brand %></p>
                <div class="flex items-center gap-2">
                  <span class="text-[9px] font-bold text-gray-400 bg-white/[0.04] border border-white/[0.08] px-1.5 py-0.5 rounded">
                    <%= item.size %>
                  </span>
                  <span class="text-[10px] text-gray-500">
                    Qty: <%= item.quantity %>
                  </span>
                </div>
              </div>

              <!-- Item Total Price -->
              <div class="text-right">
                <span class="text-xs font-bold text-[#e2e8f0]">₹<%= item.totalPrice %></span>
                <p class="text-[9px] text-gray-500">₹<%= item.price %> ea</p>
              </div>
            </div>
          <% }) %>
        </div>

      </div>

      <!-- PRICE CALCULATION PANEL -->
      <div class="bg-[#0a0e16]/60 backdrop-blur-xl border border-white/[0.06] rounded-[24px] p-6 shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
        <div class="text-[10px] font-extrabold tracking-[0.16em] uppercase text-white mb-5 pb-4 border-b border-white/[0.06] flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00FFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          PRICE DETAILS
        </div>

        <div class="space-y-3.5 pb-4 border-b border-white/[0.06]">
          <% 
            const safeItems = typeof items !== 'undefined' ? items : (typeof displayItems !== 'undefined' ? displayItems : []); 
            const totalQty = safeItems.reduce((acc, item) => acc + (item.quantity || 1), 0);
            const safeOriginalSubtotal = typeof originalSubtotal !== 'undefined' ? originalSubtotal : (typeof originalPriceTotal !== 'undefined' ? originalPriceTotal : 0);
            const safeDiscount = typeof discount !== 'undefined' ? discount : (typeof discountAmount !== 'undefined' ? discountAmount : 0);
            const safeShipping = typeof shipping !== 'undefined' ? shipping : 0;
            const safeTaxes = typeof taxes !== 'undefined' ? taxes : 0;
            const safeProductDiscount = typeof productDiscount !== 'undefined' ? productDiscount : 0;
          %>
          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-400">Price (<%= totalQty %> item<%= totalQty !== 1 ? 's' : '' %>)</span>
            <span class="text-white font-medium">₹<%= safeOriginalSubtotal.toLocaleString('en-IN') %></span>
          </div>

          <% if (safeProductDiscount > 0) { %>
            <div class="flex justify-between items-center text-xs">
              <span class="text-gray-400">Discount</span>
              <span class="text-emerald-400 font-medium">-₹<%= safeProductDiscount.toLocaleString('en-IN') %></span>
            </div>
          <% } %>

          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-400">Coupon Discount</span>
            <span class="text-emerald-400 font-medium">-₹<%= safeDiscount.toLocaleString('en-IN') %></span>
          </div>

          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-400">Delivery Charges</span>
            <span class="font-medium <%= safeShipping === 0 ? 'text-emerald-400' : 'text-white' %>">
              <%= safeShipping === 0 ? 'FREE' : '₹' + safeShipping.toLocaleString('en-IN') %>
            </span>
          </div>

          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-400">Estimated Taxes (18% GST)</span>
            <span class="text-gray-500 text-[10px] italic">Included (₹<%= safeTaxes.toLocaleString('en-IN') %>)</span>
          </div>
        </div>

        <!-- Total Row -->
        <div class="flex justify-between items-baseline mt-4 mb-6">
          <span class="text-xs font-extrabold text-white uppercase tracking-wider">Total Amount</span>
          <span class="text-2xl font-extrabold text-[#00FFFF] tracking-tight">₹<span id="checkoutTotal"><%= finalTotal %></span></span>
        </div>

        <!-- Hidden inputs for form submit -->
        <input type="hidden" id="activeAddressId" value="<%= (addresses && addresses.length > 0) ? (addresses.find(a => a.isDefault)?._id || addresses[0]._id) : '' %>">
        <input type="hidden" id="orderFinalPrice" value="<%= finalTotal %>">

        <!-- Place Order Button -->
        <% if (addresses && addresses.length > 0) { %>
          <button 
            onclick="placeOrderSubmit()" 
            id="placeOrderBtn"
            class="block w-full py-4 rounded-xl bg-gradient-to-r from-[#00FFFF] to-[#0ea5e9]
                   text-[#03111a] text-xs font-extrabold tracking-widest uppercase text-center
                   hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,255,255,0.4)] active:scale-98 transition-all duration-300 no-underline
                   shadow-[0_4px_20px_rgba(0,255,255,0.2)] cursor-pointer border-none"
          >
            Place Order (COD)
          </button>
        <% } else { %>
          <button 
            disabled 
            class="block w-full py-4 rounded-xl bg-white/[0.04] text-gray-500 border border-white/[0.08]
                   text-xs font-extrabold tracking-widest uppercase text-center cursor-not-allowed"
          >
            Add Address to Continue
          </button>
        <% } %>

        <div class="flex items-center justify-center gap-1.5 mt-4 text-[9px] font-bold tracking-[0.1em] uppercase text-gray-600">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          256-Bit SSL Encrypted checkout
        </div>
      </div>

    </div>

  </div>

</div>

