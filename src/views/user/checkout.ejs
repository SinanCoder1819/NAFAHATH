<!-- SCRIPTS FOR INTERACTION -->
<script>
  /* ── SLOW STAGGERED ODOMETER DIGIT ROLLING ANIMATION FOR TOTAL AMOUNT ── */
  function setOdometerValue(element, value) {
    if (!element) return;
    const formatString = Number(value).toLocaleString('en-IN');
    
    element.innerHTML = '';
    element.style.display = 'inline-flex';
    element.style.alignItems = 'baseline';
    
    for (let i = 0; i < formatString.length; i++) {
      const char = formatString[i];
      if (char >= '0' && char <= '9') {
        const digit = parseInt(char);
        
        const col = document.createElement('span');
        col.style.display = 'inline-block';
        col.style.height = '1em';
        col.style.overflow = 'hidden';
        col.style.position = 'relative';
        col.style.verticalAlign = 'bottom';
        
        const strip = document.createElement('span');
        strip.style.display = 'flex';
        strip.style.flexDirection = 'column';
        strip.style.transition = 'transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
        strip.style.transform = 'translateY(0)';
        
        for (let d = 0; d <= 9; d++) {
          const digitSpan = document.createElement('span');
          digitSpan.innerText = d;
          digitSpan.style.display = 'block';
          digitSpan.style.height = '1em';
          digitSpan.style.lineHeight = '1em';
          strip.appendChild(digitSpan);
        }
        
        col.appendChild(strip);
        element.appendChild(col);
        
        // Trigger transition with slow staggered delay (150ms delay per column)
        setTimeout(() => {
          strip.style.transform = `translateY(-${digit}em)`;
        }, 50 + i * 150);
      } else {
        const staticSpan = document.createElement('span');
        staticSpan.innerText = char;
        staticSpan.style.display = 'inline-block';
        staticSpan.style.verticalAlign = 'bottom';
        element.appendChild(staticSpan);
      }
    }
  }

  // Initialize Odometer on page load for the checkout total
  document.addEventListener('DOMContentLoaded', () => {
    const checkoutTotalEl = document.getElementById('checkoutTotal');
    if (checkoutTotalEl) {
      const originalValue = checkoutTotalEl.innerText.trim();
      setOdometerValue(checkoutTotalEl, originalValue);
    }
  });

  let deleteTargetId = null;

  // Select Address Card
  function selectAddress(id) {
    // Check radio button
    const radio = document.getElementById('radio-' + id);
    if (radio) radio.checked = true;

    // Remove active styles from other cards
    document.querySelectorAll('.address-card').forEach(card => {
      card.classList.remove('border-[#00FFFF]', 'shadow-[0_0_15px_rgba(0,255,255,0.08)]', 'bg-[#00FFFF]/[0.01]');
      card.classList.add('border-white/[0.08]');
    });

    // Add active styles to selected card
    const selectedCard = document.getElementById('addr-card-' + id);
    if (selectedCard) {
      selectedCard.classList.remove('border-white/[0.08]');
      selectedCard.classList.add('border-[#00FFFF]', 'shadow-[0_0_15px_rgba(0,255,255,0.08)]', 'bg-[#00FFFF]/[0.01]');
    }

    // Set hidden inputs
    document.getElementById('activeAddressId').value = id;
  }

  // Horizontal Payment Method Tabs Interaction
  function selectPaymentMethod(method) {
    // Update hidden input
    document.getElementById('selectedPaymentMethod').value = method;

    // Reset all tabs to inactive state
    document.querySelectorAll('.pay-method-tab').forEach(tab => {
      tab.className = "pay-method-tab group cursor-pointer border border-white/[0.08] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#0c121d]/40 text-gray-400 hover:bg-[#121b2d]/60 hover:border-white/25 hover:scale-[1.02]";
      const icon = tab.querySelector('.payment-icon');
      if (icon) {
        icon.className = "payment-icon w-7 h-7 transition-all duration-300 opacity-75";
      }
      const text = tab.querySelector('span');
      if (text) {
        text.className = "text-[11px] font-bold tracking-wider text-gray-400 transition-colors";
      }
    });

    // Mark clicked tab as active
    const activeTab = document.getElementById('pay-card-' + method);
    if (activeTab) {
      activeTab.className = "pay-method-tab group cursor-pointer border border-[#00FFFF] rounded-2xl p-4 flex flex-col items-center justify-center gap-2.5 transition-all duration-300 bg-[#00FFFF]/[0.04] text-white shadow-[0_0_20px_rgba(0,255,255,0.12)] scale-[1.02]";
      const icon = activeTab.querySelector('.payment-icon');
      if (icon) {
        icon.className = "payment-icon w-7 h-7 transition-all duration-300 opacity-100 scale-110";
      }
      const text = activeTab.querySelector('span');
      if (text) {
        text.className = "text-[11px] font-extrabold tracking-wider text-[#00FFFF] transition-colors";
      }
    }

    // Toggle details sub-panels
    document.querySelectorAll('.payment-panel').forEach(panel => {
      panel.classList.add('hidden');
    });
    const activePanel = document.getElementById('panel-' + method);
    if (activePanel) {
      activePanel.classList.remove('hidden');
    }

    // Dynamically update place order CTA button label
    const placeBtn = document.getElementById('placeOrderBtn');
    if (placeBtn) {
      if (method === 'COD') {
        placeBtn.innerText = 'Place Order (COD)';
      } else if (method === 'CARD') {
        placeBtn.innerText = 'Pay & Place Order';
      } else {
        placeBtn.innerText = 'Proceed to Pay';
      }
    }
  }

  // UPI App Selection
  function selectUpiApp(app) {
    document.querySelectorAll('.upi-app').forEach(el => {
      el.className = "upi-app border border-white/[0.08] rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#0c121d]/40 hover:border-white/20 transition-all duration-300";
      const span = el.querySelector('span');
      if (span) {
        span.className = "text-[10px] font-bold text-gray-500 transition-colors";
      }
    });

    const activeApp = event.currentTarget;
    activeApp.className = "upi-app border border-[#00FFFF]/60 rounded-xl p-3 flex items-center justify-center cursor-pointer bg-[#00FFFF]/[0.05] shadow-[0_0_12px_rgba(0,255,255,0.06)] transition-all duration-300";
    const activeSpan = activeApp.querySelector('span');
    if (activeSpan) {
      activeSpan.className = "text-[10px] font-extrabold text-[#00FFFF] transition-colors";
    }

    const suffixMap = {
      gpay: '@okaxis',
      phonepe: '@ybl',
      paytm: '@paytm',
      bhim: '@upi'
    };
    document.getElementById('upiId').value = 'testuser' + (suffixMap[app] || '@upi');
  }

  function verifyUpi() {
    const upiId = document.getElementById('upiId').value.trim();
    if (!upiId) {
      showToast('Please enter a UPI ID.', 'error');
      return;
    }
    showToast('UPI VPA Verified: Test User', 'success');
  }

  function selectBankName(bankName) {
    showToast('Selected Bank: ' + bankName, 'success');
  }

  // Submit Order Details
  async function placeOrderSubmit() {
    const addressId = document.getElementById('activeAddressId').value;
    const paymentMethod = document.getElementById('selectedPaymentMethod').value;
    const placeBtn = document.getElementById('placeOrderBtn');

    if (!addressId) {
      showToast('Please select or add a shipping address.', 'error');
      return;
    }

    // Extra validation based on payment method
    if (paymentMethod === 'CARD') {
      const cardNum = document.getElementById('cardNumber').value.trim();
      const cardName = document.getElementById('cardName').value.trim();
      const expiry = document.getElementById('cardExpiry').value.trim();
      const cvv = document.getElementById('cardCvv').value.trim();

      if (!cardNum || !cardName || !expiry || !cvv) {
        showToast('Please fill in all credit card details.', 'error');
        return;
      }
    } else if (paymentMethod === 'UPI') {
      const upiId = document.getElementById('upiId').value.trim();
      if (!upiId) {
        showToast('Please enter your UPI ID.', 'error');
        return;
      }
    }

    // Disable button and show spinner loader
    placeBtn.disabled = true;
    placeBtn.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-black inline" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Processing Payment...
    `;

    try {
      const response = await fetch('/checkout/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId, paymentMethod })
      });

      const data = await response.json();
      if (response.ok && data.success) {
        showToast(data.message || 'Order placed successfully!', 'success');
        
        // Decode details for redirect
        const finalPrice = document.getElementById('orderFinalPrice').value;
        setTimeout(() => {
          window.location.href = `/checkout/success?orderId=${encodeURIComponent(data.orderId)}&name=${encodeURIComponent(data.deliveryName)}&address=${encodeURIComponent(data.deliveryAddress)}&total=${encodeURIComponent(finalPrice)}&paymentMethod=${encodeURIComponent(data.paymentMethod)}`;
        }, 1200);
      } else {
        showToast(data.message || 'Failed to place order.', 'error');
        resetPlaceButton();
      }
    } catch(err) {
      console.error(err);
      showToast('Network error, please try again.', 'error');
      resetPlaceButton();
    }
  }

  function resetPlaceButton() {
    const placeBtn = document.getElementById('placeOrderBtn');
    if (placeBtn) {
      placeBtn.disabled = false;
      const method = document.getElementById('selectedPaymentMethod').value;
      if (method === 'COD') {
        placeBtn.innerText = 'Place Order (COD)';
      } else if (method === 'CARD') {
        placeBtn.innerText = 'Pay & Place Order';
      } else {
        placeBtn.innerText = 'Proceed to Pay';
      }
    }
  }

  // --- Modal Helpers (Same as address.ejs) ---
  function openAddModal() {
    document.getElementById('modalTitle').textContent = 'Add Address';
    document.getElementById('editAddressId').value = '';
    document.getElementById('addressForm').reset();
    clearAllErrors();
    hideModalMsg();
    document.getElementById('addressModal').classList.remove('hidden');
  }

  function openEditModal(id, fullName, addressLine, city, state, postalCode, phone, isDefault) {
    document.getElementById('modalTitle').textContent = 'Edit Address';
    document.getElementById('editAddressId').value = id;
    document.getElementById('f_fullName').value = fullName;
    document.getElementById('f_addressLine').value = addressLine;
    document.getElementById('f_city').value = city;
    document.getElementById('f_state').value = state;
    document.getElementById('f_postalCode').value = postalCode;
    document.getElementById('f_phone').value = phone;
    document.getElementById('f_isDefault').checked = isDefault;
    clearAllErrors();
    hideModalMsg();
    document.getElementById('addressModal').classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('addressModal').classList.add('hidden');
  }

  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    deleteTargetId = null;
  }

  // Close modals on backdrop click
  document.getElementById('addressModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
  });

  // --- Validation Helpers ---
  function validateName(value) {
    if (!value || typeof value !== 'string') {
      return { valid: false, message: 'Name is required.' };
    }
    const trimmed = value.trim();
    if (trimmed.length === 0) {
      return { valid: false, message: 'Name is required.' };
    }
    if (trimmed.length < 2) {
      return { valid: false, message: 'Name must be at least 2 characters.' };
    }
    if (trimmed.length > 50) {
      return { valid: false, message: 'Name must not exceed 50 characters.' };
    }
    if (/[<>&"`;{}]/.test(trimmed)) {
      return { valid: false, message: 'Name contains invalid characters.' };
    }
    if (!/[a-zA-Z]/.test(trimmed)) {
      return { valid: false, message: 'Name must contain at least one letter.' };
    }
    return { valid: true, value: trimmed };
  }

  function validatePhone(value) {
    if (!value || typeof value !== 'string') {
      return { valid: false, message: 'Phone number is required.' };
    }
    const trimmed = value.trim();
    if (trimmed.length === 0) {
      return { valid: false, message: 'Phone number is required.' };
    }
    const digits = trimmed.replace(/[\s\-]/g, '');
    if (!/^\d+$/.test(digits)) {
      return { valid: false, message: 'Phone number must contain digits only.' };
    }
    let cleanedDigits = digits;
    if (cleanedDigits.startsWith('+91')) cleanedDigits = cleanedDigits.slice(3);
    else if (cleanedDigits.startsWith('91') && cleanedDigits.length === 12) cleanedDigits = cleanedDigits.slice(2);
    else if (cleanedDigits.startsWith('0') && cleanedDigits.length === 11) cleanedDigits = cleanedDigits.slice(1);

    if (cleanedDigits.length !== 10) {
      return { valid: false, message: 'Phone must be exactly 10 digits.' };
    }
    if (!/^[6-9]/.test(cleanedDigits)) {
      return { valid: false, message: 'Phone must start with 6, 7, 8, or 9.' };
    }
    return { valid: true, value: cleanedDigits };
  }

  function showErr(id, msg) {
    const el = document.getElementById('e_' + id);
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
  }
  
  function clearErr(id) {
    const el = document.getElementById('e_' + id);
    if (el) { el.textContent = ''; el.classList.add('hidden'); }
  }
  
  function clearAllErrors() {
    ['fullName','addressLine','city','postalCode','state','phone'].forEach(clearErr);
  }

  function showModalMsg(text, type) {
    const el = document.getElementById('modalMessage');
    el.textContent = text;
    el.className = 'mb-4 p-3 rounded-xl text-xs font-medium border text-center block';
    el.classList.add(type === 'error' ? 'bg-red-900/50' : 'bg-green-900/50');
    el.classList.add(type === 'error' ? 'text-red-200' : 'text-green-200');
    el.classList.add(type === 'error' ? 'border-red-800' : 'border-green-800');
  }

  function hideModalMsg() {
    document.getElementById('modalMessage').className = 'hidden';
  }

  // Clear error triggers
  ['fullName','addressLine','city','postalCode','state','phone'].forEach(id => {
    document.getElementById('f_' + id).addEventListener('input', () => clearErr(id));
  });

  // --- Address Form Submit ---
  document.getElementById('addressForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearAllErrors();

    const id = document.getElementById('editAddressId').value;
    const fullName = document.getElementById('f_fullName').value.trim();
    const addressLine = document.getElementById('f_addressLine').value.trim();
    const city = document.getElementById('f_city').value.trim();
    const state = document.getElementById('f_state').value.trim();
    const postalCodeRaw = document.getElementById('f_postalCode').value;
    const postalCodeCleaned = postalCodeRaw.trim().replace(/[\s\-]/g, '');
    const phone = document.getElementById('f_phone').value.trim();
    const isDefault = document.getElementById('f_isDefault').checked;

    let valid = true;

    const nameCheck = validateName(fullName);
    if (!nameCheck.valid) { showErr('fullName', nameCheck.message); valid = false; }
    if (!addressLine) { showErr('addressLine', 'Address line is required.'); valid = false; }
    if (!city) { showErr('city', 'City is required.'); valid = false; }
    if (!state) { showErr('state', 'State is required.'); valid = false; }

    if (!postalCodeRaw.trim()) { 
      showErr('postalCode', 'Postal code is required.'); 
      valid = false; 
    } else if (!/^\d+$/.test(postalCodeCleaned)) { 
      showErr('postalCode', 'Pincode must contain numbers only.'); 
      valid = false; 
    } else if (postalCodeCleaned.length !== 6) { 
      showErr('postalCode', 'Pincode must be exactly 6 digits.'); 
      valid = false; 
    } else if (!/^[1-9]/.test(postalCodeCleaned)) { 
      showErr('postalCode', 'Pincode cannot start with 0.'); 
      valid = false; 
    }

    const phoneCheck = validatePhone(phone);
    if (!phoneCheck.valid) { showErr('phone', phoneCheck.message); valid = false; }

    if (!valid) return;

    const saveBtn = document.getElementById('modalSaveBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const isEdit = !!id;
    const url = isEdit ? `/address/${id}` : '/address';
    const method = isEdit ? 'PUT' : 'POST';

    try {
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          fullName: nameCheck.value || fullName, 
          addressLine, 
          city, 
          state, 
          postalCode: postalCodeCleaned, 
          phone: phoneCheck.value || phone, 
          isDefault 
        })
      });

      let result = {};
      try { result = await response.json(); } catch(_) {}

      if (response.ok) {
        showModalMsg(result.message || 'Saved successfully!', 'success');
        setTimeout(() => { closeModal(); location.reload(); }, 800);
      } else {
        showModalMsg(result.message || 'Failed to save address.', 'error');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Address';
      }
    } catch(err) {
      showModalMsg('Network error. Please try again.', 'error');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Address';
    }
  });

  // --- Delete Address ---
  function deleteAddress(id) {
    deleteTargetId = id;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
    if (!deleteTargetId) return;
    const btn = document.getElementById('confirmDeleteBtn');
    btn.disabled = true;
    btn.textContent = 'Removing...';

    try {
      const response = await fetch(`/address/${deleteTargetId}`, { method: 'DELETE' });
      let result = {};
      try { result = await response.json(); } catch(_) {}

      if (response.ok) {
        closeDeleteModal();
        location.reload();
      } else {
        alert(result.message || 'Failed to remove address.');
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    } catch(err) {
      alert('Network error.');
      btn.disabled = false;
      btn.textContent = 'Delete';
    }
  });

  // --- Set default ---
  async function setDefault(id) {
    try {
      const response = await fetch(`/address/${id}/set-default`, { method: 'PATCH' });
      if (response.ok) {
        location.reload();
      } else {
        // Fallback to reload if custom patch isn't in backend yet, or alert
        location.reload();
      }
    } catch(err) {
      console.error(err);
      location.reload();
    }
  }

  // Set default radio selection load trigger
  document.addEventListener('DOMContentLoaded', () => {
    const selected = document.querySelector('input[name="selectedAddress"]:checked');
    if (selected) {
      selectAddress(selected.value);
    }
  });
</script>
