<main class="min-h-screen bg-[#060606] text-white py-12 px-4 md:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar Navigation -->
        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 sticky top-28 shadow-2xl">
                <div class="mb-10">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-[#C5A267] font-bold mb-6 opacity-80">Dashboard</p>
                    <nav class="flex flex-col gap-2">
                        <a href="/profile" class="group flex items-center gap-4 px-4 py-3 rounded-xl bg-[#C5A267]/10 text-[#C5A267] border border-[#C5A267]/20 transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium">Profile</span>
                        </a>
                        
                        <% const navLinks = [
                            { href: '/orders', label: 'My Orders', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
                            { href: '/wallet', label: 'Wallet', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
                            { href: '/address', label: 'Addresses', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
                            { href: '/referrals', label: 'Refer & Earn', icon: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z' }
                        ] %>

                        <% navLinks.forEach(link => { %>
                            <a href="<%= link.href %>" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                                <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="<%= link.icon %>"/></svg>
                                <span class="text-sm font-medium"><%= link.label %></span>
                            </a>
                        <% }) %>
                    </nav>
                </div>

                <div class="pt-6 border-t border-gray-800">
                    <a href="/auth/logout" class="flex items-center gap-4 px-4 py-3 text-red-400 hover:bg-red-500/10 rounded-xl transition-all group">
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        <span class="text-sm font-medium">Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Profile Section -->
        <section class="flex-1 space-y-8">
            
            <div class="relative overflow-hidden bg-[#0f0f0f] border border-gray-800 rounded-3xl p-10 shadow-2xl">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-[#C5A267]/10 blur-[80px] rounded-full"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-10">
                    <!-- Profile Image with Upload Trigger -->
                    <div class="relative group cursor-pointer shrink-0" onclick="document.getElementById('profileUpload').click()">
                        <div class="w-28 h-28 rounded-full border-2 border-[#C5A267]/30 p-1 transition-all group-hover:border-[#C5A267]">
                            <div id="avatarContainer" class="w-full h-full rounded-full bg-gradient-to-br from-gray-800 to-black flex items-center justify-center overflow-hidden relative">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" id="currentProfilePic" class="w-full h-full object-cover transition-opacity group-hover:opacity-40" alt="Profile">
                                <% } else { %>
                                    <svg id="defaultAvatar" class="w-14 h-14 text-gray-600 transition-opacity group-hover:opacity-40" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                <% } %>
                                <!-- Camera overlay -->
                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 rounded-full">
                                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="profileUpload" class="hidden" accept="image/jpeg,image/png,image/webp" onchange="uploadImage(this)">
                        <div class="absolute bottom-1 right-1 w-5 h-5 bg-green-500 rounded-full border-4 border-[#0f0f0f]"></div>
                    </div>

                    <div class="text-center md:text-left flex-1">
                        <h2 class="text-3xl md:text-4xl font-serif text-white mb-2 italic">Greetings, <%= user.name ? user.name.split(' ')[0] : 'Guest' %></h2>
                        <p class="text-gray-400 text-sm tracking-wide max-w-md">Your personal essence, curated. Manage your profile details and security below.</p>
                        <div id="uploadStatus" class="hidden mt-3 px-4 py-2 rounded-xl text-xs font-medium border"></div>
                    </div>

                    <a href="/profile/edit" class="shrink-0">
                        <button class="bg-white text-black px-8 py-3 rounded-full text-[11px] font-bold uppercase tracking-widest hover:bg-[#C5A267] transition-all transform active:scale-95">
                            Edit Profile
                        </button>
                    </a>
                </div>

                <!-- Profile Info Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 pt-10 border-t border-gray-800/50">
                    <div class="space-y-1">
                        <span class="text-[9px] uppercase tracking-[0.2em] text-gray-500 font-bold">Email Address</span>
                        <p class="text-sm font-medium text-gray-200"><%= user.email %></p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-[9px] uppercase tracking-[0.2em] text-gray-500 font-bold">Phone Number</span>
                        <p class="text-sm font-medium text-gray-200"><%= user.phone || 'Not provided' %></p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-[9px] uppercase tracking-[0.2em] text-gray-500 font-bold">Full Name</span>
                        <p class="text-sm font-medium text-gray-200"><%= user.name || 'Not provided' %></p>
                    </div>
                </div>
            </div>

            <!-- Security Section -->
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-10 shadow-2xl">
                <div class="flex items-center gap-4 mb-10">
                    <div class="w-10 h-10 rounded-lg bg-[#C5A267]/10 flex items-center justify-center border border-[#C5A267]/20">
                        <svg class="w-5 h-5 text-[#C5A267]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-medium">Security & Access</h3>
                        <p class="text-xs text-gray-500 tracking-wide">Protect your Nafahath account with encrypted security.</p>
                    </div>
                </div>

                <div id="responseMessage" class="hidden mb-6 p-4 rounded-xl text-xs font-medium border"></div>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/profile/change-password"
                            class="flex-1 text-center bg-transparent border border-gray-700 text-white px-6 py-4 rounded-2xl text-[10px] font-bold uppercase tracking-widest hover:border-[#C5A267] hover:text-[#C5A267] transition-all">
                        Change Password
                    </a>
                    <a href="/profile/change-email"
                            class="flex-1 text-center bg-transparent border border-gray-700 text-white px-6 py-4 rounded-2xl text-[10px] font-bold uppercase tracking-widest hover:border-[#C5A267] hover:text-[#C5A267] transition-all">
                        Update Email
                    </a>
                </div>
            </div>

        </section>
    </div>
</main>

<script>
    // --- Image Upload ---
    async function uploadImage(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];

        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
            showStatus('Only JPG, PNG, or WEBP images are allowed.', 'error');
            return;
        }
        if (file.size > 2 * 1024 * 1024) {
            showStatus('Image must be under 2MB.', 'error');
            return;
        }

        showStatus('Uploading...', 'success');

        const formData = new FormData();
        formData.append('profileImage', file);

        try {
            const response = await fetch('/profile/update-image', {
                method: 'POST',
                body: formData
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok && result.newImageUrl) {
                // Update the avatar in the page immediately
                const container = document.getElementById('avatarContainer');
                let img = document.getElementById('currentProfilePic');
                const svg = document.getElementById('defaultAvatar');

                if (img) {
                    img.src = result.newImageUrl;
                } else {
                    if (svg) svg.remove();
                    img = document.createElement('img');
                    img.id = 'currentProfilePic';
                    img.alt = 'Profile';
                    img.className = 'w-full h-full object-cover transition-opacity group-hover:opacity-40';
                    img.src = result.newImageUrl;
                    container.prepend(img);
                }

                // Also update navbar avatar if present
                const navAvatar = document.getElementById('navProfilePic');
                const navSvg = document.getElementById('navDefaultIcon');
                if (navAvatar) {
                    navAvatar.src = result.newImageUrl;
                } else if (navSvg) {
                    navSvg.style.display = 'none';
                    const navImg = document.createElement('img');
                    navImg.id = 'navProfilePic';
                    navImg.src = result.newImageUrl;
                    navImg.alt = 'Profile';
                    navImg.className = 'w-full h-full object-cover rounded-full';
                    navSvg.parentNode.appendChild(navImg);
                }

                showStatus('Profile picture updated!', 'success');
            } else {
                showStatus(result.message || 'Upload failed.', 'error');
            }
        } catch (err) {
            console.error('Upload error:', err);
            showStatus('Upload failed. Please try again.', 'error');
        }

        // Reset input so same file can be re-selected
        input.value = '';
    }

    // --- Security Actions ---
    async function handleSecurityAction(action) {
        if (!confirm(`Are you sure you want to ${action.replace(/([A-Z])/g, ' $1').toLowerCase()}?`)) return;

        try {
            const response = await fetch(`/${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await response.json();
            showStatus(response.ok ? result.message : (result.error || 'Failed.'), response.ok ? 'success' : 'error', 'responseMessage');
        } catch (err) {
            showStatus('Network error occurred.', 'error', 'responseMessage');
        }
    }

    // --- Status Helper ---
    function showStatus(text, type, targetId = 'uploadStatus') {
        const el = document.getElementById(targetId);
        if (!el) return;
        el.textContent = text;
        el.className = 'mt-3 px-4 py-2 rounded-xl text-xs font-medium border block';
        if (type === 'error') {
            el.classList.add('bg-red-900/50', 'text-red-200', 'border-red-800');
        } else {
            el.classList.add('bg-green-900/50', 'text-green-200', 'border-green-800');
        }
    }
</script>
