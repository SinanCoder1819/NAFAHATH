<main class="min-h-screen bg-[#060606] text-white py-12 px-4 md:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">

        <!-- Sidebar -->
        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 sticky top-28 shadow-2xl">
                <div class="mb-10">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-[#22d3ee] font-bold mb-6 opacity-80">Dashboard</p>
                    <nav class="flex flex-col gap-2">
                        <a href="/profile" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium">Profile</span>
                        </a>

                        <% const navLinks = [
                            { href: '/orders', label: 'My Orders', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
                            { href: '/wallet', label: 'Wallet', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
                            { href: '/address', label: 'Addresses', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
                            { href: '/referrals', label: 'Refer & Earn', icon: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z' }
                        ] %>
                        <% navLinks.forEach(link => { %>
                            <a href="<%= link.href %>" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                                <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="<%= link.icon %>"/></svg>
                                <span class="text-sm font-medium"><%= link.label %></span>
                            </a>
                        <% }) %>
                    </nav>
                </div>

                <div class="pt-6 border-t border-gray-800">
                    <a href="/auth/logout" class="flex items-center gap-4 px-4 py-3 text-red-400 hover:bg-red-500/10 rounded-xl transition-all group">
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        <span class="text-sm font-medium">Logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <section class="flex-1 flex items-start justify-center">
            <div class="w-full max-w-lg">
                <div class="text-center mb-10">
                    <h1 class="text-4xl font-serif italic text-white mb-2">Set New Password</h1>
                    <p class="text-gray-500 text-[10px] tracking-[0.3em] uppercase">Keep your account secure</p>
                </div>

                <div class="bg-[#0f0f0f] border border-gray-800 rounded-[2.5rem] p-8 md:p-10 shadow-2xl">

                    <div id="formMessage" class="hidden mb-6 p-3 rounded-xl text-xs font-medium border text-center"></div>

                    <form id="changePasswordForm" class="space-y-6">

                        <!-- Current Password -->
                        <div class="space-y-2">
                            <label class="block text-[10px] font-medium text-gray-400 uppercase tracking-widest ml-1">Current Password</label>
                            <div class="relative">
                                <input type="password" id="currentPassword" name="currentPassword"
                                    placeholder="Enter your current password"
                                    class="w-full bg-black/40 border border-gray-700 rounded-2xl px-5 py-4 outline-none focus:border-[#00FFFF] focus:ring-1 focus:ring-[#00FFFF]/20 transition-all text-sm text-white placeholder:text-gray-600 pr-12">
                                <button type="button" onclick="togglePwd('currentPassword','eye0')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition">
                                    <svg id="eye0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </button>
                            </div>
                            <p id="currentPasswordError" class="hidden text-red-400 text-[11px] ml-1"></p>
                        </div>

                        <!-- New Password -->
                        <div class="space-y-2">
                            <label class="block text-[10px] font-medium text-gray-400 uppercase tracking-widest ml-1">New Password</label>
                            <div class="relative">
                                <input type="password" id="newPassword" name="newPassword"
                                    placeholder="Enter your new password"
                                    class="w-full bg-black/40 border border-gray-700 rounded-2xl px-5 py-4 outline-none focus:border-[#00FFFF] focus:ring-1 focus:ring-[#00FFFF]/20 transition-all text-sm text-white placeholder:text-gray-600 pr-12">
                                <button type="button" onclick="togglePwd('newPassword','eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition">
                                    <svg id="eye1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </button>
                            </div>
                            <p class="text-gray-600 text-[10px] ml-1">Minimum 8 characters, with one uppercase, one lowercase, one number, and one special character.</p>
                            <p id="newPasswordError" class="hidden text-red-400 text-[11px] ml-1"></p>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="space-y-2">
                            <label class="block text-[10px] font-medium text-gray-400 uppercase tracking-widest ml-1">Confirm New Password</label>
                            <div class="relative">
                                <input type="password" id="confirmPassword" name="confirmPassword"
                                    placeholder="Confirm your new password"
                                    class="w-full bg-black/40 border border-gray-700 rounded-2xl px-5 py-4 outline-none focus:border-[#00FFFF] focus:ring-1 focus:ring-[#00FFFF]/20 transition-all text-sm text-white placeholder:text-gray-600 pr-12">
                                <button type="button" onclick="togglePwd('confirmPassword','eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition">
                                    <svg id="eye2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </button>
                            </div>
                            <p id="confirmPasswordError" class="hidden text-red-400 text-[11px] ml-1"></p>
                        </div>

                        <div class="pt-2">
                            <button type="submit" id="saveBtn"
                                class="w-full bg-[#00FFFF] text-black py-4 rounded-2xl font-bold uppercase tracking-widest text-sm hover:scale-[1.01] active:scale-95 transition-all shadow-[0_0_25px_rgba(0,255,255,0.2)] disabled:opacity-60 disabled:cursor-not-allowed">
                                Save
                            </button>
                        </div>
                    </form>

                    <div class="mt-6 text-center">
                        <a href="/profile" class="text-xs text-gray-500 hover:text-white transition uppercase tracking-widest">← Back to Profile</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    // Toggle password visibility
    function togglePwd(inputId, eyeId) {
        const input = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        eye.innerHTML = isHidden
            ? `<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />`
            : `<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`;
    }

    const saveBtn = document.getElementById('saveBtn');
    const formMsg = document.getElementById('formMessage');

    function showFieldError(id, msg) {
        const el = document.getElementById(id);
        el.textContent = msg;
        el.classList.remove('hidden');
    }
    function clearFieldError(id) {
        const el = document.getElementById(id);
        el.textContent = '';
        el.classList.add('hidden');
    }
    function showFormMsg(text, type) {
        formMsg.textContent = text;
        formMsg.className = 'mb-6 p-3 rounded-xl text-xs font-medium border text-center block';
        formMsg.classList.add(type === 'error' ? 'bg-red-900/50' : 'bg-green-900/50');
        formMsg.classList.add(type === 'error' ? 'text-red-200' : 'text-green-200');
        formMsg.classList.add(type === 'error' ? 'border-red-800' : 'border-green-800');
    }

    ['currentPassword', 'newPassword', 'confirmPassword'].forEach(id => {
        document.getElementById(id).addEventListener('input', () => clearFieldError(id + 'Error'));
    });

    document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        clearFieldError('currentPasswordError');
        clearFieldError('newPasswordError');
        clearFieldError('confirmPasswordError');

        let valid = true;

        if (!currentPassword) {
            showFieldError('currentPasswordError', 'Current password is required.');
            valid = false;
        }

        if (!newPassword) {
            showFieldError('newPasswordError', 'New password is required.');
            valid = false;
        } else if (newPassword.length < 8) {
            showFieldError('newPasswordError', 'Password must be at least 8 characters.');
            valid = false;
        } else if (!/[A-Z]/.test(newPassword)) {
            showFieldError('newPasswordError', 'Password must contain at least one uppercase letter.');
            valid = false;
        } else if (!/[a-z]/.test(newPassword)) {
            showFieldError('newPasswordError', 'Password must contain at least one lowercase letter.');
            valid = false;
        } else if (!/[0-9]/.test(newPassword)) {
            showFieldError('newPasswordError', 'Password must contain at least one number.');
            valid = false;
        } else if (!/[!@#$%^&*(),.?":{}|<>]/.test(newPassword)) {
            showFieldError('newPasswordError', 'Password must contain at least one special character (e.g. !@#$%^&*).');
            valid = false;
        } else if (newPassword === currentPassword) {
            showFieldError('newPasswordError', 'New password must be different from current password.');
            valid = false;
        }

        if (!confirmPassword) {
            showFieldError('confirmPasswordError', 'Please confirm your new password.');
            valid = false;
        } else if (newPassword !== confirmPassword) {
            showFieldError('confirmPasswordError', 'Passwords do not match.');
            valid = false;
        }

        if (!valid) return;

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        try {
            const response = await fetch('/profile/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
            });

            let result = {};
            try { result = await response.json(); } catch (_) {}

            if (response.ok) {
                showFormMsg('Password changed successfully! Redirecting...', 'success');
                setTimeout(() => window.location.href = '/profile', 1500);
            } else {
                showFormMsg(result.message || 'Failed to change password.', 'error');
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save';
            }
        } catch (err) {
            showFormMsg('Network error. Please try again.', 'error');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save';
        }
    });
</script>
