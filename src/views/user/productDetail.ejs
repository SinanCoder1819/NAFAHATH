<!-- Breadcrumbs -->
<div class="max-w-7xl mx-auto px-6 pt-10 pb-4">
    <nav class="flex text-[11px] font-bold tracking-widest text-gray-500 uppercase">
        <a href="/" class="hover:text-[#00FFFF] transition-colors">Home</a>
        <span class="mx-3">/</span>
        <a href="/shop" class="hover:text-[#00FFFF] transition-colors">Shop</a>
        <span class="mx-3">/</span>
        <a href="/shop?category=<%= product.category %>" class="hover:text-[#00FFFF] transition-colors"><%= product.category %></a>
        <span class="mx-3">/</span>
        <span class="text-white"><%= product.productName %></span>
    </nav>
</div>

<!-- Main Product Detail Section -->
<section class="max-w-7xl mx-auto px-6 py-8 md:py-12 flex flex-col md:flex-row gap-12 md:gap-20 relative">
    
    <!-- Left: Product Image with Zoom -->
    <div class="md:w-1/2 flex flex-col justify-start items-center">
        <!-- Main Image Container (Zoomable) -->
        <div class="w-full max-w-md aspect-[4/5] relative overflow-hidden group cursor-crosshair bg-transparent rounded-lg mb-6 flex items-center justify-center" 
             id="zoom-container"
             onmousemove="zoomImage(event)" 
             onmouseleave="resetZoom()">
            
            <img id="mainProductImage" 
                 src="<%= product.primaryImage %>" 
                 alt="<%= product.productName %>" 
                 class="w-full h-full object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-transform duration-200 pointer-events-none">
        </div>
             
        <!-- Gallery Thumbnails -->
        <% if (product.galleryImages && product.galleryImages.length > 0) { %>
            <div class="flex gap-4 overflow-x-auto pb-2 w-full max-w-md justify-center">
                <% product.galleryImages.forEach(img => { %>
                    <% if (img) { %>
                        <img src="<%= img %>" 
                             class="w-16 h-16 object-cover border border-[#333] cursor-pointer hover:border-[#00FFFF] transition-colors rounded"
                             onclick="document.getElementById('mainProductImage').src = this.src">
                    <% } %>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Right: Product Info -->
    <div class="md:w-1/2 flex flex-col justify-start">
        
        <p class="text-[#00FFFF] font-serif-italic text-sm mb-2"><%= product.brand %></p>
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">
            <%= product.productName %>
        </h1>

        <!-- Ratings & Reviews (Placeholder) -->
        <div class="flex items-center gap-3 mb-6">
            <div class="flex text-[#00FFFF]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-600" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            </div>
            <a href="#reviews" class="text-xs font-bold tracking-widest text-gray-500 uppercase hover:text-white transition-colors">4.8 (124 Reviews)</a>
        </div>

        <!-- Dynamic Price Display with Discounts -->
        <% 
            const defaultVariant = (product.variants && product.variants.length > 0) ? product.variants[0] : { regularPrice: 0, salePrice: 0, stock: 0, _id: '' };
            const hasDiscount = defaultVariant.salePrice > 0 && defaultVariant.salePrice < defaultVariant.regularPrice;
            const displayPrice = hasDiscount ? defaultVariant.salePrice : defaultVariant.regularPrice;
            let discountPercentage = 0;
            if (hasDiscount && defaultVariant.regularPrice > 0) {
                discountPercentage = Math.round(((defaultVariant.regularPrice - defaultVariant.salePrice) / defaultVariant.regularPrice) * 100);
            }
        %>
        
        <div class="flex items-center gap-4 mb-4">
            <div class="text-2xl font-bold text-white" id="priceDisplay">
                ₹<%= displayPrice %>
            </div>
            
            <div id="discountContainer" class="<%= hasDiscount ? 'flex' : 'hidden' %> items-center gap-3">
                <span class="text-gray-500 line-through text-lg" id="regularPriceDisplay">₹<%= defaultVariant.regularPrice %></span>
                <span class="bg-[#00FFFF] text-black text-[10px] font-bold px-2 py-1 rounded-sm uppercase tracking-widest" id="discountBadge">
                    <%= discountPercentage %>% OFF
                </span>
            </div>
        </div>

        <!-- Stock Indicator -->
        <div class="mb-8" id="stockStatusContainer">
            <% if (defaultVariant.stock > 10) { %>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-green-400 uppercase tracking-widest bg-green-400/10 px-3 py-1.5 rounded border border-green-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                    In Stock
                </span>
            <% } else if (defaultVariant.stock > 0 && defaultVariant.stock <= 10) { %>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-orange-400 uppercase tracking-widest bg-orange-400/10 px-3 py-1.5 rounded border border-orange-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
                    Hurry! Only <%= defaultVariant.stock %> left
                </span>
            <% } else { %>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-red-500 uppercase tracking-widest bg-red-500/10 px-3 py-1.5 rounded border border-red-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                    Out of Stock
                </span>
            <% } %>
        </div>

        <!-- Format Selection -->
        <div class="mb-8">
            <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Select Format</h3>
            <div class="flex flex-wrap gap-4" id="variantContainer">
                <% if (product.variants && product.variants.length > 0) { %>
                    <% product.variants.forEach((variant, index) => { %>
                        <% 
                            const vHasDiscount = variant.salePrice > 0 && variant.salePrice < variant.regularPrice;
                            let vDiscountPct = 0;
                            if (vHasDiscount) vDiscountPct = Math.round(((variant.regularPrice - variant.salePrice) / variant.regularPrice) * 100);
                        %>
                        <button 
                            type="button"
                            class="variant-btn px-6 py-2 text-sm transition-colors bg-transparent border <%= index === 0 ? 'text-white border-[#00FFFF]' : 'text-gray-500 border-[#333] hover:border-[#00FFFF]' %>"
                            data-price="<%= vHasDiscount ? variant.salePrice : variant.regularPrice %>"
                            data-regprice="<%= variant.regularPrice %>"
                            data-hasdiscount="<%= vHasDiscount %>"
                            data-discountpct="<%= vDiscountPct %>"
                            data-id="<%= variant._id %>"
                            data-stock="<%= variant.stock %>"
                        >
                            <%= variant.size %>
                        </button>
                    <% }) %>
                <% } else { %>
                    <span class="text-sm text-gray-500">No variants available</span>
                <% } %>
            </div>
        </div>

        <!-- Add to Cart Form -->
        <form id="addToCartForm" onsubmit="event.preventDefault(); submitAddToCart('<%= product._id %>');" class="space-y-8">
            <input type="hidden" name="productId" value="<%= product._id %>">
            <input type="hidden" name="variantId" id="selectedVariantId" value="<%= defaultVariant._id %>">
            
            <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Quantity</h3>
            <div class="flex flex-col sm:flex-row gap-4 h-auto sm:h-[46px]">
                
                <!-- Quantity Box -->
                <div class="flex items-center border border-[#333] h-[46px] sm:h-full w-32">
                    <button type="button" onclick="decrementQuantity()" class="px-4 h-full text-gray-400 hover:text-white transition-colors bg-transparent border-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
                    </button>
                    
                    <input type="number" name="quantity" id="qtyInput" value="<%= defaultVariant.stock > 0 ? 1 : 0 %>" min="1" max="<%= defaultVariant.stock %>" class="w-full text-center text-sm text-white bg-transparent border-none outline-none appearance-none p-0" readonly>
                    
                    <button type="button" id="qtyPlus" onclick="incrementQuantity()" class="px-4 h-full text-gray-400 hover:text-white transition-colors bg-transparent border-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    </button>
                </div>

                <!-- Add to Cart -->
                <button type="submit" id="addToCartBtn" 
                        class="flex-1 h-[46px] sm:h-full bg-[#00FFFF] text-black text-xs font-bold tracking-widest uppercase hover:bg-[#66FFFF] transition-all shadow-[0_0_15px_rgba(0,255,255,0.2)] hover:shadow-[0_0_20px_rgba(0,255,255,0.4)] disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none disabled:hover:bg-[#00FFFF]"
                        <%= defaultVariant.stock === 0 ? 'disabled' : '' %>>
                    <% if (defaultVariant.stock > 0) { %>
                        Add To Cart
                    <% } else { %>
                        Sold Out
                    <% } %>
                </button>

                <!-- Wishlist -->
                <button type="button" id="wishlistBtn" onclick="toggleWishlist('<%= product._id %>', this)" data-in-wishlist="<%= inWishlist %>" class="h-[46px] sm:h-full px-5 border <%= inWishlist ? 'border-red-500 text-red-500' : 'border-[#333] text-gray-400 hover:text-white hover:border-gray-500' %> transition-all duration-500 ease-out transform active:scale-90 bg-transparent group flex items-center justify-center">
                    <svg id="wishlistIcon" xmlns="http://www.w3.org/2000/svg" fill="<%= inWishlist ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 transition-all duration-500 ease-out <%= inWishlist ? 'text-red-500 scale-110' : 'group-hover:text-white group-hover:scale-110' %>"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                </button>
            </div>
        </form>

        <hr class="border-[#222] mb-8">

        <!-- Info Tabs -->
        <div>
            <div class="flex gap-8 mb-6 border-b border-[#222]">
                <button class="text-[11px] font-bold tracking-widest uppercase text-white pb-3 border-b-2 border-white">Description & Highlights</button>
                <button class="text-[11px] font-bold tracking-widest uppercase text-gray-500 pb-3 border-b-2 border-transparent hover:text-white transition-colors" id="reviews">Reviews</button>
            </div>
            
            <div class="text-sm text-gray-400 leading-relaxed max-w-xl">
                <!-- Product Highlights List -->
                <ul class="mb-6 space-y-2 text-white">
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Long-lasting sillage (8+ hours)
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Premium Extrait de Parfum concentration
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        100% Cruelty-free & Vegan
                    </li>
                </ul>

                <p><%= product.description %></p>
            </div>
        </div>
    </div>
</section>

<!-- You Might Also Like Section -->
<% if (typeof relatedProducts !== 'undefined' && relatedProducts.length > 0) { %>
<section class="max-w-7xl mx-auto px-6 py-20 border-t border-[#1a1a1a]">
    <h2 class="text-[11px] font-bold tracking-widest text-gray-400 uppercase text-center mb-16">You Might Also Like</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <% relatedProducts.forEach(related => { %>
            <a href="/productDetail/<%= related._id %>" class="group cursor-pointer block text-left">
                <div class="aspect-[4/5] flex justify-center items-center mb-6 overflow-hidden bg-transparent">
                    <img src="<%= related.primaryImage %>" alt="<%= related.productName %>" class="h-4/5 object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]">
                </div>
                <h3 class="text-sm font-semibold text-white mb-1 group-hover:text-[#00FFFF] transition-colors"><%= related.productName %></h3>
                <p class="text-xs text-gray-500 font-serif-italic mb-3"><%= related.brand %></p>
                <p class="text-sm font-semibold text-white">
                    <% if (related.variants && related.variants.length > 0) { %>
                        ₹<%= related.variants[0].salePrice > 0 ? related.variants[0].salePrice : related.variants[0].regularPrice %>
                    <% } else { %>
                        ₹0
                    <% } %>
                </p>
            </a>
        <% }) %>
    </div>
</section>
<% } %>

<!-- Client-side script -->
<script>
// --- Zoom Effect Script ---
function zoomImage(e) {
    const container = document.getElementById('zoom-container');
    const img = document.getElementById('mainProductImage');
    
    // Get cursor position relative to the container
    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    // Calculate percentage across the container
    const xPercent = (x / rect.width) * 100;
    const yPercent = (y / rect.height) * 100;
    
    // Apply transform origin and scale
    img.style.transformOrigin = `${xPercent}% ${yPercent}%`;
    img.style.transform = 'scale(2)'; // 2x Zoom level
}

function resetZoom() {
    const img = document.getElementById('mainProductImage');
    img.style.transformOrigin = 'center center';
    img.style.transform = 'scale(1)';
}

function incrementQuantity() {
    const input = document.getElementById('qtyInput');
    if (parseInt(input.value) < parseInt(input.max)) input.value = parseInt(input.value) + 1;
}

function decrementQuantity() {
    const input = document.getElementById('qtyInput');
    if (parseInt(input.value) > parseInt(input.min)) input.value = parseInt(input.value) - 1;
}

// --- Toast Notification System ---
function showToast(message, type = 'success') {
    const existingToast = document.getElementById('custom-toast');
    if (existingToast) existingToast.remove();

    const toast = document.createElement('div');
    toast.id = 'custom-toast';
    toast.className = `fixed bottom-10 right-10 flex items-center gap-3 px-6 py-4 rounded shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50 ${type === 'success' ? 'bg-[#111] border border-[#00FFFF] text-white' : 'bg-[#111] border border-red-500 text-white'}`;
    
    const icon = type === 'success' 
        ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>`;
        
    toast.innerHTML = `${icon} <span class="text-sm font-semibold tracking-wide">${message}</span>`;
    
    document.body.appendChild(toast);
    
    setTimeout(() => toast.classList.remove('translate-y-20', 'opacity-0'), 10);
    setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

// --- Cart Script ---
async function submitAddToCart(productId) {
    // Read the hidden input that tracks the currently selected size variant
    const variantId = document.getElementById('selectedVariantId').value;
    const quantity = document.getElementById('qtyInput').value;
    
    if (!variantId) {
        showToast("Please select a size variant first.", 'error');
        return;
    }

    try {
        const response = await fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                productId: productId,
                variantId: variantId,
                quantity: quantity
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Show a beautiful toast notification
            showToast("Added to cart successfully!", 'success');
            
            // Redirect to the cart page after a short delay so they can see the message
            setTimeout(() => {
                window.location.href = '/cart';
            }, 1000);
        } else {
            showToast(data.message || "Failed to add to cart.", 'error');
            if (data.message && data.message.toLowerCase().includes("login")) {
                setTimeout(() => window.location.href = "/auth/login", 1500);
            }
        }
    } catch (error) {
        console.error("Error:", error);
        showToast("Something went wrong", 'error');
    }
}

// --- Wishlist Script ---
async function toggleWishlist(productId, btnElement) {
    const icon = btnElement.querySelector('svg');
    const isAdding = btnElement.getAttribute('data-in-wishlist') !== 'true'; 
    
    const url = isAdding ? `/wishlist/add/${productId}` : `/wishlist/remove/${productId}`;
    const method = isAdding ? 'POST' : 'DELETE';
    
    try {
        const response = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' }
        });
        
        const data = await response.json();
        
        if (data.success) {
            if (isAdding) {
                // Update state
                btnElement.setAttribute('data-in-wishlist', 'true');
                
                // SVG updates
                icon.setAttribute('fill', 'currentColor');
                icon.classList.remove('group-hover:text-white', 'group-hover:scale-110');
                icon.classList.add('text-red-500', 'scale-110');
                
                // Button updates
                btnElement.classList.remove('border-[#333]', 'text-gray-400', 'hover:text-white', 'hover:border-gray-500');
                btnElement.classList.add('border-red-500', 'text-red-500');
                
                // Quick pop animation
                icon.classList.add('scale-125');
                setTimeout(() => icon.classList.remove('scale-125'), 150);
            } else {
                // Update state
                btnElement.setAttribute('data-in-wishlist', 'false');
                
                // SVG updates
                icon.setAttribute('fill', 'none');
                icon.classList.remove('text-red-500', 'scale-110', 'scale-125');
                icon.classList.add('group-hover:text-white', 'group-hover:scale-110');
                
                // Button updates
                btnElement.classList.remove('border-red-500', 'text-red-500');
                btnElement.classList.add('border-[#333]', 'text-gray-400', 'hover:text-white', 'hover:border-gray-500');
            }
        } else {
            if (data.message && data.message.toLowerCase().includes("login")) {
                window.location.href = "/auth/login";
            }
        }
    } catch (error) {
        console.error("Error:", error);
    }
}

// --- Dynamic Variant Update Script ---
document.addEventListener('DOMContentLoaded', () => {
    const variantBtns = document.querySelectorAll('.variant-btn');
    const priceDisplay = document.getElementById('priceDisplay');
    const discountContainer = document.getElementById('discountContainer');
    const regularPriceDisplay = document.getElementById('regularPriceDisplay');
    const discountBadge = document.getElementById('discountBadge');
    
    const stockStatusContainer = document.getElementById('stockStatusContainer');
    const selectedVariantIdInput = document.getElementById('selectedVariantId');
    const qtyInput = document.getElementById('qtyInput');
    const qtyMinus = document.getElementById('qtyMinus');
    const qtyPlus = document.getElementById('qtyPlus');
    const addToCartBtn = document.getElementById('addToCartBtn');
    
    let currentMaxStock = parseInt(qtyInput.max) || 0;

    variantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            // Remove active state
            variantBtns.forEach(b => {
                b.classList.remove('text-white', 'border-[#00FFFF]');
                b.classList.add('text-gray-500', 'border-[#333]');
            });
            
            // Add active state
            this.classList.remove('text-gray-500', 'border-[#333]');
            this.classList.add('text-white', 'border-[#00FFFF]');
            
            // Update Price & Discounts
            const newPrice = this.getAttribute('data-price');
            const regPrice = this.getAttribute('data-regprice');
            const hasDiscount = this.getAttribute('data-hasdiscount') === 'true';
            
            priceDisplay.textContent = '₹' + newPrice;
            
            if (hasDiscount) {
                const discountPct = this.getAttribute('data-discountpct');
                discountContainer.classList.remove('hidden');
                discountContainer.classList.add('flex');
                regularPriceDisplay.textContent = '₹' + regPrice;
                discountBadge.textContent = discountPct + '% OFF';
            } else {
                discountContainer.classList.add('hidden');
                discountContainer.classList.remove('flex');
            }
            
            // Update hidden input for cart
            selectedVariantIdInput.value = this.getAttribute('data-id');
            
            // Update Stock
            currentMaxStock = parseInt(this.getAttribute('data-stock'));
            qtyInput.max = currentMaxStock;
            
            // Update Stock Badges
            let stockHtml = '';
            if (currentMaxStock > 10) {
                stockHtml = `<span class="inline-flex items-center gap-1.5 text-xs font-bold text-green-400 uppercase tracking-widest bg-green-400/10 px-3 py-1.5 rounded border border-green-400/20"><span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>In Stock</span>`;
            } else if (currentMaxStock > 0 && currentMaxStock <= 10) {
                stockHtml = `<span class="inline-flex items-center gap-1.5 text-xs font-bold text-orange-400 uppercase tracking-widest bg-orange-400/10 px-3 py-1.5 rounded border border-orange-400/20"><span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>Hurry! Only ${currentMaxStock} left</span>`;
            } else {
                stockHtml = `<span class="inline-flex items-center gap-1.5 text-xs font-bold text-red-500 uppercase tracking-widest bg-red-500/10 px-3 py-1.5 rounded border border-red-500/20"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Out of Stock</span>`;
            }
            stockStatusContainer.innerHTML = stockHtml;
            
            // Update Button State
            if (currentMaxStock > 0) {
                qtyInput.value = 1;
                addToCartBtn.textContent = 'Add To Cart';
                addToCartBtn.disabled = false;
            } else {
                qtyInput.value = 0;
                addToCartBtn.textContent = 'Sold Out';
                addToCartBtn.disabled = true;
            }
        });
    });

    // Quantity Handlers
    qtyMinus.addEventListener('click', () => {
        let current = parseInt(qtyInput.value);
        if (current > 1) qtyInput.value = current - 1;
    });

    qtyPlus.addEventListener('click', () => {
        let current = parseInt(qtyInput.value);
        if (current < currentMaxStock) qtyInput.value = current + 1;
    });
});
</script>