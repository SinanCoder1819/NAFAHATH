<!-- Main Layout using Tailwind CSS matching the dark glassmorphism theme -->
<section class="max-w-[1400px] mx-auto px-6 py-12 flex flex-col lg:flex-row gap-12">
    
    <!-- LEFT SIDEBAR: FILTERS & SORT -->
    <aside class="w-full lg:w-64 flex-shrink-0">
        <div class="flex justify-between items-end border-b border-[#333] pb-4 mb-6">
            <h2 class="text-xs font-bold tracking-widest text-white uppercase">Filters & Sort</h2>
            <a href="/shop" class="text-[10px] text-gray-400 hover:text-[#00FFFF] uppercase tracking-wider transition-colors">Clear All</a>
        </div>

        <form id="filterForm" action="/shop" method="GET" class="space-y-6">
    <!-- Retain current search if any -->
    <% if (search) { %>
        <input type="hidden" name="search" value="<%= search %>">
    <% } %>

    <!-- CATEGORIES ACCORDION -->
    <div class="border-b border-[#333] pb-4">
        <button type="button" class="flex justify-between items-center w-full text-xs font-bold tracking-widest text-white uppercase mb-4 focus:outline-none group" onclick="toggleAccordion('categories-content', this)">
            <span class="group-hover:text-[#00FFFF] transition-colors">Categories</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200 text-gray-500 group-hover:text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        
        <div id="categories-content" class="space-y-4 pt-2">
            <label class="flex items-center cursor-pointer group">
                <input type="radio" name="category" value="" <%= category === '' ? 'checked' : '' %> class="peer hidden">
                <div class="w-4 h-4 border border-[#444] rounded-sm mr-3 peer-checked:bg-[#00FFFF] peer-checked:border-[#00FFFF] transition-all flex items-center justify-center">
                    <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-sm text-gray-400 peer-checked:text-white peer-checked:font-semibold group-hover:text-white transition-colors">All Categories</span>
            </label>
            
            <label class="flex items-center cursor-pointer group">
                <input type="radio" name="category" value="men" <%= category === 'men' ? 'checked' : '' %> class="peer hidden">
                <div class="w-4 h-4 border border-[#444] rounded-sm mr-3 peer-checked:bg-[#00FFFF] peer-checked:border-[#00FFFF] transition-all flex items-center justify-center">
                    <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-sm text-gray-400 peer-checked:text-white peer-checked:font-semibold group-hover:text-white transition-colors">Men</span>
            </label>

            <label class="flex items-center cursor-pointer group">
                <input type="radio" name="category" value="women" <%= category === 'women' ? 'checked' : '' %> class="peer hidden">
                <div class="w-4 h-4 border border-[#444] rounded-sm mr-3 peer-checked:bg-[#00FFFF] peer-checked:border-[#00FFFF] transition-all flex items-center justify-center">
                    <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-sm text-gray-400 peer-checked:text-white peer-checked:font-semibold group-hover:text-white transition-colors">Women</span>
            </label>
        </div>
    </div>

    <!-- NEW PRICE RANGE ACCORDION -->
    <div class="border-b border-[#333] pb-4">
        <button type="button" class="flex justify-between items-center w-full text-xs font-bold tracking-widest text-white uppercase mb-4 focus:outline-none group" onclick="toggleAccordion('price-content', this)">
            <span class="group-hover:text-[#00FFFF] transition-colors">Price Range</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200 text-gray-500 group-hover:text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        
        <div id="price-content" class="space-y-4 pt-2">
            <div class="flex items-center gap-2">
                <input type="number" name="minPrice" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" placeholder="Min ₹" class="w-1/2 bg-[#141414] border border-[#333] focus:border-[#00FFFF] text-white text-sm rounded px-2 py-1.5 outline-none">
                <span class="text-gray-500">-</span>
                <input type="number" name="maxPrice" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" placeholder="Max ₹" class="w-1/2 bg-[#141414] border border-[#333] focus:border-[#00FFFF] text-white text-sm rounded px-2 py-1.5 outline-none">
            </div>
            <button type="submit" class="w-full bg-[#333] hover:bg-[#00FFFF] text-white hover:text-black text-xs font-bold uppercase tracking-widest py-2 rounded transition-colors">Apply Price</button>
        </div>
    </div>

    <!-- SORT BY ACCORDION -->
    <div class="border-b border-[#333] pb-4">
        <button type="button" class="flex justify-between items-center w-full text-xs font-bold tracking-widest text-white uppercase mb-4 focus:outline-none group" onclick="toggleAccordion('sort-content', this)">
            <span class="group-hover:text-[#00FFFF] transition-colors">Sort By</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200 text-gray-500 group-hover:text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        
        <div id="sort-content" class="flex flex-col space-y-1 pt-2">
            <!-- Newest -->
            <label class="cursor-pointer group py-1.5 flex items-center justify-between">
                <input type="radio" name="sort" value="newest" <%= sort === 'newest' ? 'checked' : '' %> class="peer hidden">
                <span class="text-sm font-medium text-gray-500 peer-checked:text-[#00FFFF] group-hover:text-white transition-colors">Newest Arrivals</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#00FFFF] opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </label>

            <!-- Price: Low to High -->
            <label class="cursor-pointer group py-1.5 flex items-center justify-between">
                <input type="radio" name="sort" value="priceAsc" <%= sort === 'priceAsc' ? 'checked' : '' %> class="peer hidden">
                <span class="text-sm font-medium text-gray-500 peer-checked:text-[#00FFFF] group-hover:text-white transition-colors">Price: Low to High</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#00FFFF] opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </label>

            <!-- Price: High to Low -->
            <label class="cursor-pointer group py-1.5 flex items-center justify-between">
                <input type="radio" name="sort" value="priceDesc" <%= sort === 'priceDesc' ? 'checked' : '' %> class="peer hidden">
                <span class="text-sm font-medium text-gray-500 peer-checked:text-[#00FFFF] group-hover:text-white transition-colors">Price: High to Low</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#00FFFF] opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </label>

            <!-- Name: A to Z -->
            <label class="cursor-pointer group py-1.5 flex items-center justify-between">
                <input type="radio" name="sort" value="aToZ" <%= sort === 'aToZ' ? 'checked' : '' %> class="peer hidden">
                <span class="text-sm font-medium text-gray-500 peer-checked:text-[#00FFFF] group-hover:text-white transition-colors">Name: A to Z</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#00FFFF] opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </label>

            <!-- Name: Z to A -->
            <label class="cursor-pointer group py-1.5 flex items-center justify-between">
                <input type="radio" name="sort" value="zToA" <%= sort === 'zToA' ? 'checked' : '' %> class="peer hidden">
                <span class="text-sm font-medium text-gray-500 peer-checked:text-[#00FFFF] group-hover:text-white transition-colors">Name: Z to A</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#00FFFF] opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </label>
        </div>
    </div>
</form>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <main class="flex-1">
        
        <!-- Top Bar (Title & Search) -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
            <h1 class="text-3xl font-bold text-white tracking-tight">All Products</h1>
            
            <form action="/shop" method="GET" class="w-full md:w-[450px]">
                <!-- Retain current filters if any -->
                <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
                <% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
                <% if (typeof minPrice !== 'undefined' && !isNaN(minPrice)) { %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
                <% if (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>
                
                <!-- Advanced Search Bar matching mockup -->
                <div class="flex items-center border border-[#333] rounded-lg h-12 bg-[#141414] p-1.5 focus-within:border-[#00FFFF] transition-colors">
                    
                    <!-- Input -->
                    <input type="text" name="search" id="searchInput" value="<%= search %>" placeholder="Search categories..." class="flex-1 bg-transparent text-sm text-white px-3 focus:outline-none placeholder-gray-500">
                    
                    <!-- Integrated Search Button -->
                    <button type="submit" class="h-full px-4 rounded-md bg-[#28c9f4] hover:bg-[#66FFFF] text-black text-sm font-semibold transition-colors">
                        Search
                    </button>

                    <!-- Clear Button (Only shows if search has text) -->
                    <% if (search) { %>
                        <a href="/shop?category=<%= category %>&sort=<%= sort %><%= (typeof minPrice !== 'undefined' && !isNaN(minPrice)) ? '&minPrice='+minPrice : '' %><%= (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) ? '&maxPrice='+maxPrice : '' %>" class="ml-3 mr-2 text-sm font-bold text-[#28c9f4] hover:text-white transition-colors tracking-wide uppercase">
                            Clear
                        </a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- PRODUCT GRID -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-12">
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <a href="/productDetail/<%= product._id %>" class="group cursor-pointer block text-left">
                        <div class="aspect-[4/5] flex justify-center items-center mb-5 overflow-hidden bg-transparent">
                            <!-- Show a placeholder if they didn't upload an image for the product yet -->
                            <img src="<%= product.primaryImage || 'https://placehold.co/400x500/111/444?text=Perfume' %>" alt="<%= product.productName %>" class="h-5/6 object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
                        </div>
                        <h3 class="text-base font-semibold text-white mb-1 tracking-tight group-hover:text-[#00FFFF] transition-colors"><%= product.productName %></h3>
                        <p class="text-xs text-gray-500 font-serif-italic mb-3"><%= product.brand %></p>
                        
                        <% 
                           let displayPrice = 0;
                           if (product.variants && product.variants.length > 0) {
                               displayPrice = product.variants[0].salePrice > 0 ? product.variants[0].salePrice : product.variants[0].regularPrice;
                           }
                        %>
                        <p class="text-sm font-semibold text-white">₹<%= displayPrice %></p>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-20 text-center border border-dashed border-[#333] rounded-lg">
                    <p class="text-gray-400 text-lg">No products found matching your criteria.</p>
                    <a href="/shop" class="inline-block mt-4 text-[#00FFFF] hover:underline text-sm font-bold tracking-widest uppercase">Clear Filters</a>
                </div>
            <% } %>
        </div>

        <!-- PAGINATION -->
        <% if (totalPages > 1) { 
            let queryParams = `&search=${search}&category=${category}&sort=${sort}`;
            if (typeof minPrice !== 'undefined' && !isNaN(minPrice)) queryParams += `&minPrice=${minPrice}`;
            if (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) queryParams += `&maxPrice=${maxPrice}`;
        %>
            <div id="paginationContainer" class="flex justify-center items-center mt-20 gap-2">
                <!-- Previous Button -->
                <a href="<%= currentPage > 1 ? '?page=' + (currentPage - 1) + queryParams : '#' %>" 
                   class="w-8 h-8 flex items-center justify-center border border-[#444] text-gray-400 hover:text-white hover:border-[#00FFFF] transition-colors <%= currentPage === 1 ? 'opacity-50 cursor-not-allowed pointer-events-none' : '' %>">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </a>

                <!-- Page Numbers -->
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %><%= queryParams %>" 
                       class="w-8 h-8 flex items-center justify-center border text-xs font-bold transition-colors <%= currentPage === i ? 'bg-[#00FFFF] text-black border-[#00FFFF]' : 'border-[#444] text-white hover:border-[#00FFFF]' %>">
                        <%= i %>
                    </a>
                <% } %>

                <!-- Next Button -->
                <a href="<%= currentPage < totalPages ? '?page=' + (currentPage + 1) + queryParams : '#' %>" 
                   class="w-8 h-8 flex items-center justify-center border border-[#444] text-gray-400 hover:text-white hover:border-[#00FFFF] transition-colors <%= currentPage === totalPages ? 'opacity-50 cursor-not-allowed pointer-events-none' : '' %>">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
            </div>
        <% } %>
    </main>
</section>

<script>
function toggleAccordion(id, btn) {
    const content = document.getElementById(id);
    const icon = btn.querySelector('svg');
    if (content.style.display === 'none' || content.style.display === '') {
        content.style.display = 'block';
        icon.style.transform = 'rotate(0deg)';
    } else {
        content.style.display = 'none';
        icon.style.transform = 'rotate(-180deg)';
    }
}

// AJAX Filtering Logic
document.addEventListener('DOMContentLoaded', () => {
    const filterForm = document.getElementById('filterForm');
    const productGrid = document.getElementById('productGrid');
    const paginationContainer = document.getElementById('paginationContainer');

    const fetchFilteredProducts = async (url) => {
        try {
            if (productGrid) {
                productGrid.style.transition = 'opacity 0.3s ease';
                productGrid.style.opacity = '0.4';
            }
            
            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const text = await response.text();
            
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, 'text/html');
            
            const newGrid = doc.getElementById('productGrid');
            const newPagination = doc.getElementById('paginationContainer');
            
            if (newGrid && productGrid) {
                productGrid.innerHTML = newGrid.innerHTML;
                productGrid.style.opacity = '1'; 
            }
            
            if (paginationContainer) {
                paginationContainer.innerHTML = newPagination ? newPagination.innerHTML : '';
            }
            
            window.history.pushState({}, '', url);
            
        } catch (error) {
            console.error("Error fetching products:", error);
            if (productGrid) productGrid.style.opacity = '1';
        }
    };

    if (filterForm) {
        // Auto-submit form when ANY radio button (Category or Sort) is clicked
        filterForm.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                filterForm.dispatchEvent(new Event('submit', { cancelable: true }));
            });
        });

        // Hijack the main filter form submission
        filterForm.addEventListener('submit', (e) => {
            e.preventDefault(); 
            const formData = new FormData(filterForm);
            const searchParams = new URLSearchParams(formData);
            const url = `/shop?${searchParams.toString()}`;
            fetchFilteredProducts(url);
        });
    }

    // Hijack Pagination Links
    document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href && link.href.includes('/shop?page=')) {
            e.preventDefault(); 
            fetchFilteredProducts(link.href);
            document.querySelector('.flex-1').scrollIntoView({ behavior: 'smooth' });
        }
    });
});
</script>
