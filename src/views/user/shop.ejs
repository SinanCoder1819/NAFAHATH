<%# ── Tiny style block: ONLY animation keyframes (no layout CSS) ── %>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
*{font-family:'Inter',-apple-system,sans-serif;}

@keyframes spGlow {
  0%,100% { transform: scale(1);    opacity: .7; }
  50%      { transform: scale(1.25); opacity: 1;  }
}
@keyframes spDot {
  0%,100% { opacity: 1;  transform: scale(1);  }
  50%      { opacity: .3; transform: scale(.6); }
}

/* Hero pseudo-elements (cannot be done with Tailwind) */
.sp-hero::before {
  content: ''; position: absolute; top: -60px; right: -20px;
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(40,201,244,0.1) 0%, transparent 70%);
  animation: spGlow 8s ease-in-out infinite;
}
.sp-hero::after {
  content: ''; position: absolute; bottom: -50px; left: 30%;
  width: 220px; height: 220px;
  background: radial-gradient(circle, rgba(120,80,255,0.06) 0%, transparent 70%);
  animation: spGlow 12s ease-in-out infinite reverse;
}

/* Hero badge dot */
.sp-hero-badge::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: #28c9f4; animation: spDot 2s ease-in-out infinite;
  display:inline-block; flex-shrink:0;
}

/* Card image glow on hover */
.sp-card-img::after {
  content: ''; position: absolute; bottom: 10%; left: 50%;
  transform: translateX(-50%); width: 60%; height: 40%;
  background: radial-gradient(ellipse, rgba(40,201,244,0.1) 0%, transparent 70%);
  opacity: 0; transition: opacity .4s; border-radius: 50%; filter: blur(20px);
}
.sp-card:hover .sp-card-img::after { opacity: 1; }

/* Category radio checked styles (sibling selector, not possible in Tailwind) */
.sp-cat-item input:checked ~ .sp-cat-box         { background: #28c9f4; border-color: #28c9f4; }
.sp-cat-item input:checked ~ .sp-cat-box svg     { opacity: 1; }
.sp-cat-item input:checked ~ .sp-cat-label       { color: #fff; font-weight: 600; }
.sp-cat-box svg { opacity: 0; transition: opacity .15s; }

/* Accordion btn open state (JS toggled) */
.sp-acc-btn.open     { color: #28c9f4; }
.sp-acc-btn.open svg { transform: rotate(180deg); }

/* Sort selected (JS toggled) */
.sp-sort-item.is-selected                  { background: rgba(40,201,244,0.06); }
.sp-sort-item.is-selected .sp-sort-label  { color: #28c9f4; font-weight: 600; }
.sp-sort-item.is-selected .sp-sort-check  { opacity: 1; }
</style>

<%# ═══════════════════════════════════════════════════════════
    SHOP PAGE WRAPPER
═══════════════════════════════════════════════════════════ %>
<div class="max-w-[1380px] mx-auto px-7 pt-9 pb-20 text-[#c8cdd8]">

  <%# ═══════ HERO ═══════ %>
  <div class="sp-hero relative overflow-hidden rounded-2xl
              bg-gradient-to-br from-[#050d14] via-[#0a1a28] to-[#040e1a]
              border border-[#28c9f4]/10
              shadow-[0_8px_40px_rgba(0,0,0,0.55),inset_0_1px_0_rgba(40,201,244,0.06)]
              p-12 mb-11">

    <%# dot-grid overlay %>
    <div class="absolute inset-0 pointer-events-none"
         style="background-image:radial-gradient(circle,rgba(40,201,244,0.04)1px,transparent 1px);background-size:30px 30px;"></div>

    <%# hero inner %>
    <div class="relative z-10 flex items-center justify-between flex-wrap gap-6">

      <div>
        <div class="sp-hero-badge inline-flex items-center gap-1.5
                    text-[10px] font-bold tracking-[0.14em] uppercase
                    text-[#28c9f4] px-3 py-1
                    border border-[#28c9f4]/25 rounded-full
                    bg-[#28c9f4]/[0.07] mb-3">
          Nafahath Collection
        </div>
        <h1 class="text-[36px] font-extrabold m-0 tracking-[-1.5px] leading-none
                   bg-gradient-to-br from-white to-[#94c8df]
                   bg-clip-text text-transparent [-webkit-text-fill-color:transparent]">
          All Products
        </h1>
        <p class="text-[13.5px] text-[#374151] mt-2 font-normal">
          Discover our curated collection of luxury fragrances.
        </p>
      </div>

      <%# SEARCH FORM %>
      <form action="/shop" method="GET" class="flex gap-0 relative z-10" id="searchForm">
        <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
        <% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
        <% if (typeof minPrice !== 'undefined' && !isNaN(minPrice)) { %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
        <% if (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>

        <div class="flex items-center h-12
                    bg-white/[0.04] border border-white/10
                    rounded-xl px-[18px] pr-1.5
                    min-w-[360px] sm:min-w-full
                    focus-within:border-[#28c9f4]/50
                    focus-within:shadow-[0_0_0_3px_rgba(40,201,244,0.08)]
                    transition-[border-color,box-shadow] duration-[250ms]">

          <%# search icon %>
          <svg class="text-[#374151] shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>

          <input type="text" name="search" id="searchInput" value="<%= search %>"
                 placeholder="Search fragrances, brands…"
                 class="flex-1 bg-transparent border-none outline-none
                        text-[#e2e8f0] text-sm font-[inherit] px-3
                        placeholder-[#2d3748]">

          <% if (search) { %>
            <a href="/shop?category=<%= category %>&sort=<%= sort %><%= (typeof minPrice !== 'undefined' && !isNaN(minPrice)) ? '&minPrice='+minPrice : '' %><%= (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) ? '&maxPrice='+maxPrice : '' %>"
               class="inline-flex items-center gap-1 text-[#28c9f4] text-xs font-bold
                      tracking-[0.06em] uppercase no-underline px-3
                      hover:text-white transition-colors duration-200">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              Clear
            </a>
          <% } %>

          <button type="submit"
                  class="h-9 px-5 rounded-lg
                         bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9]
                         text-[#03111a] border-none text-xs font-bold
                         cursor-pointer font-[inherit] tracking-[0.04em]
                         hover:from-[#4dd8f8] hover:to-[#38bdf8]
                         hover:shadow-[0_4px_14px_rgba(40,201,244,0.35)]
                         transition-all duration-200">
            Search
          </button>
        </div>
      </form>
    </div>
  </div><%# /hero %>

  <%# ═══════ LAYOUT ═══════ %>
  <div class="flex gap-8 items-start max-[900px]:flex-col">

    <%# ═══════ SIDEBAR ═══════ %>
    <aside class="w-64 shrink-0 sticky top-6
                  bg-[#0a0e16]/70 backdrop-blur-xl
                  border border-white/[0.07] rounded-[18px]
                  p-7
                  shadow-[0_4px_28px_rgba(0,0,0,0.4)]
                  max-[900px]:w-full max-[900px]:static">

      <%# sidebar header %>
      <div class="flex justify-between items-center
                  mb-6 pb-[18px] border-b border-white/[0.06]">
        <div class="flex items-center gap-2
                    text-[11px] font-extrabold tracking-[0.14em] uppercase text-[#e2e8f0]">
          <svg class="text-[#28c9f4]" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          Filters &amp; Sort
        </div>
        <a href="/shop"
           class="text-[10px] font-bold tracking-[0.08em] uppercase text-[#374151]
                  no-underline px-2 py-1 rounded-md
                  border border-white/[0.07]
                  hover:text-[#f87171] hover:border-[#f87171]/30 hover:bg-[#f87171]/[0.06]
                  transition-all duration-200">
          Reset
        </a>
      </div>

      <form id="filterForm" action="/shop" method="GET">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>

        <%# ─── CATEGORIES ─── %>
        <div class="border-b border-white/[0.05] pb-5 mb-5">
          <button type="button"
                  class="sp-acc-btn open
                         flex justify-between items-center w-full
                         bg-none border-none cursor-pointer
                         text-[10px] font-extrabold tracking-[0.14em] uppercase
                         text-[#64748b] p-0 mb-4 font-[inherit]
                         transition-colors duration-200
                         hover:text-[#e2e8f0]"
                  onclick="spToggle('catContent', this)">
            Categories
            <svg class="transition-transform duration-[250ms] text-[#374151]"
                 width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="catContent">
            <label class="sp-cat-item flex items-center gap-2.5 cursor-pointer py-1.5 mb-0.5 transition-all duration-200 group">
              <input type="radio" name="category" value="" <%= category === '' ? 'checked' : '' %> class="hidden">
              <div class="sp-cat-box w-4 h-4 shrink-0 border border-[rgba(255,255,255,0.15)] rounded border-[1.5px]
                          flex items-center justify-center transition-all duration-200 bg-transparent">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="sp-cat-label text-[13px] text-[#64748b] transition-colors duration-200 font-medium
                           group-hover:text-[#e2e8f0]">All Categories</span>
            </label>
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <label class="sp-cat-item flex items-center gap-2.5 cursor-pointer py-1.5 mb-0.5 transition-all duration-200 group">
                  <input type="radio" name="category" value="<%= cat.name %>" <%= category.toLowerCase() === cat.name.toLowerCase() ? 'checked' : '' %> class="hidden">
                  <div class="sp-cat-box w-4 h-4 shrink-0 border-[1.5px] border-[rgba(255,255,255,0.15)] rounded
                              flex items-center justify-center transition-all duration-200 bg-transparent">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <span class="sp-cat-label text-[13px] text-[#64748b] transition-colors duration-200 font-medium
                               group-hover:text-[#e2e8f0]"><%= cat.name %></span>
                </label>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-[#374151] py-1">No categories found</p>
            <% } %>
          </div>
        </div>

        <%# ─── PRICE RANGE ─── %>
        <div class="border-b border-white/[0.05] pb-5 mb-5">
          <button type="button"
                  class="sp-acc-btn open
                         flex justify-between items-center w-full
                         bg-none border-none cursor-pointer
                         text-[10px] font-extrabold tracking-[0.14em] uppercase
                         text-[#64748b] p-0 mb-4 font-[inherit]
                         transition-colors duration-200 hover:text-[#e2e8f0]"
                  onclick="spToggle('priceContent', this)">
            Price Range
            <svg class="transition-transform duration-[250ms] text-[#374151]"
                 width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="priceContent">
            <div class="flex items-center gap-2 mb-3.5">
              <input type="number" name="minPrice"
                     value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>"
                     placeholder="Min ₹"
                     class="flex-1 min-w-0 bg-white/[0.03] border border-white/[0.08] text-[#e2e8f0]
                            px-3 py-2.5 rounded-[9px] text-[13px] outline-none font-[inherit]
                            transition-[border-color] duration-200 w-0
                            focus:border-[#28c9f4]/45 placeholder-[#2d3748]">
              <span class="text-[#374151] text-xs shrink-0">—</span>
              <input type="number" name="maxPrice"
                     value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"
                     placeholder="Max ₹"
                     class="flex-1 min-w-0 bg-white/[0.03] border border-white/[0.08] text-[#e2e8f0]
                            px-3 py-2.5 rounded-[9px] text-[13px] outline-none font-[inherit]
                            transition-[border-color] duration-200 w-0
                            focus:border-[#28c9f4]/45 placeholder-[#2d3748]">
            </div>
            <button type="submit"
                    class="w-full py-2.5 rounded-[9px]
                           bg-[#28c9f4]/[0.08] border border-[#28c9f4]/20
                           text-[#28c9f4] text-[11px] font-bold tracking-[0.1em] uppercase
                           cursor-pointer font-[inherit]
                           hover:bg-[#28c9f4]/[0.15] hover:border-[#28c9f4]/40
                           transition-all duration-[250ms]">
              Apply Price
            </button>
          </div>
        </div>

        <%# ─── SORT BY ─── %>
        <div>
          <button type="button"
                  class="sp-acc-btn open
                         flex justify-between items-center w-full
                         bg-none border-none cursor-pointer
                         text-[10px] font-extrabold tracking-[0.14em] uppercase
                         text-[#64748b] p-0 mb-4 font-[inherit]
                         transition-colors duration-200 hover:text-[#e2e8f0]"
                  onclick="spToggle('sortContent', this)">
            Sort By
            <svg class="transition-transform duration-[250ms] text-[#374151]"
                 width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="sortContent">
            <% [
              ['newest',    'Newest Arrivals'],
              ['priceAsc',  'Price: Low to High'],
              ['priceDesc', 'Price: High to Low'],
              ['aToZ',      'Name: A → Z'],
              ['zToA',      'Name: Z → A'],
            ].forEach(([val, label]) => { %>
              <label class="sp-sort-item <%= sort === val ? 'is-selected' : '' %>
                            flex items-center justify-between
                            px-2.5 py-2 rounded-[9px] cursor-pointer
                            transition-all duration-200 mb-0.5
                            hover:bg-white/[0.04]">
                <input type="radio" name="sort" value="<%= val %>" <%= sort === val ? 'checked' : '' %> class="hidden">
                <span class="sp-sort-label text-[13px] text-[#64748b] font-medium transition-colors duration-200"><%= label %></span>
                <div class="sp-sort-check
                            w-4 h-4 rounded-full
                            bg-[#28c9f4]/15 border-[1.5px] border-[#28c9f4]
                            flex items-center justify-center
                            opacity-0 transition-opacity duration-200 shrink-0">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#28c9f4" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </label>
            <% }) %>
          </div>
        </div>

      </form>
    </aside><%# /sidebar %>

    <%# ═══════ MAIN ═══════ %>
    <main class="flex-1 min-w-0">

      <%# Top bar %>
      <div class="flex items-center justify-between mb-7 flex-wrap gap-3">
        <div class="text-xs font-semibold text-[#374151]">
          Showing <span class="text-[#28c9f4]"><%= products ? products.length : 0 %></span> products
          <% if (totalPages > 1) { %> · Page <span class="text-[#28c9f4]"><%= currentPage %></span> of <span class="text-[#28c9f4]"><%= totalPages %></span><% } %>
        </div>
        <div class="flex flex-wrap gap-2">
          <% if (category) { %>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#28c9f4]
                         bg-[#28c9f4]/[0.08] border border-[#28c9f4]/20
                         px-2.5 py-1 rounded-full"><%= category %></span>
          <% } %>
          <% if (search) { %>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#28c9f4]
                         bg-[#28c9f4]/[0.08] border border-[#28c9f4]/20
                         px-2.5 py-1 rounded-full">🔍 <%= search %></span>
          <% } %>
          <% if (typeof minPrice !== 'undefined' && !isNaN(minPrice) && minPrice) { %>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#28c9f4]
                         bg-[#28c9f4]/[0.08] border border-[#28c9f4]/20
                         px-2.5 py-1 rounded-full">Min ₹<%= minPrice %></span>
          <% } %>
          <% if (typeof maxPrice !== 'undefined' && !isNaN(maxPrice) && maxPrice) { %>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#28c9f4]
                         bg-[#28c9f4]/[0.08] border border-[#28c9f4]/20
                         px-2.5 py-1 rounded-full">Max ₹<%= maxPrice %></span>
          <% } %>
        </div>
      </div>

      <%# PRODUCT GRID %>
      <div id="productGrid"
           class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5
                  transition-[opacity,transform] duration-300 ease-in-out">

        <% if (products && products.length > 0) { %>
          <% products.forEach((product, idx) => { %>
            <%
              let displayPrice = 0, wasPrice = 0;
              let defaultVariantId = '';
              if (product.variants && product.variants.length > 0) {
                const v = product.variants[0];
                displayPrice = v.salePrice > 0 ? v.salePrice : v.regularPrice;
                if (v.salePrice > 0) wasPrice = v.regularPrice;
                defaultVariantId = v._id;
              }
              const isSale = wasPrice > 0;
              const isNew  = idx < 3 && !isSale;
              const isWishlisted = (typeof wishlistProductIds !== 'undefined') && wishlistProductIds.includes(product._id.toString());
              const isInCart = (typeof cartProductIds !== 'undefined') && cartProductIds.includes(product._id.toString());
            %>
            <div class="sp-card group relative bg-[#0a0e16]/60 border border-white/[0.06]
                        rounded-[16px] sm:rounded-[18px] overflow-hidden block
                        transition-all duration-300
                        hover:-translate-y-1.5 hover:border-[#28c9f4]/[0.22]
                        hover:shadow-[0_20px_50px_rgba(0,0,0,0.55),0_0_0_1px_rgba(40,201,244,0.06)]">

              <% if (isNew)  { %>
                <div class="absolute top-2.5 left-2.5 sm:top-3.5 sm:left-3.5 z-[3]
                            text-[8px] sm:text-[9px] font-extrabold tracking-[0.1em] uppercase
                            px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full pointer-events-none
                            bg-[#28c9f4]/15 text-[#28c9f4] border border-[#28c9f4]/30">New</div>
              <% } %>
              <% if (isSale) { %>
                <div class="absolute top-2.5 left-2.5 sm:top-3.5 sm:left-3.5 z-[3]
                            text-[8px] sm:text-[9px] font-extrabold tracking-[0.1em] uppercase
                            px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full pointer-events-none
                            bg-[#fbbf24]/15 text-[#fbbf24] border border-[#fbbf24]/30">Sale</div>
              <% } %>

              <%# wishlist button %>
              <button type="button"
                      onclick="toggleWishlistShop('<%= product._id %>', this, event)"
                      data-in-wishlist="<%= isWishlisted %>"
                      title="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
                      class="absolute top-2.5 right-2.5 sm:top-3.5 sm:right-3.5 z-[10] w-7.5 h-7.5 sm:w-8 sm:h-8 rounded-full
                             bg-black/40 backdrop-blur-md border border-white/10
                             flex items-center justify-center
                             hover:text-red-400 hover:border-red-500/40 hover:bg-red-500/10
                             transition-all duration-200 cursor-pointer
                             <%= isWishlisted ? 'text-red-500 border-red-500/50 bg-red-500/15' : 'text-gray-400' %>">
                <svg width="13" height="13" class="sm:w-[15px] sm:h-[15px]" viewBox="0 0 24 24"
                     fill="<%= isWishlisted ? 'currentColor' : 'none' %>"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="transition-transform duration-200">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>

              <%# card image %>
              <a href="/productDetail/<%= product._id %>"
                 class="sp-card-img relative overflow-hidden aspect-[4/5]
                        flex items-center justify-center p-4 sm:p-5 block no-underline"
                 style="background:radial-gradient(circle at 50% 60%,rgba(40,201,244,0.04) 0%,transparent 65%)">
                <img src="<%= product.primaryImage || (product.galleryImages && product.galleryImages[0]) || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume' %>"
                     alt="<%= product.productName %>" loading="lazy"
                     class="w-[82%] sm:w-[75%] h-full object-contain relative z-10 bg-transparent
                            drop-shadow-[0_12px_24px_rgba(0,0,0,0.65)]
                            transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]
                            group-hover:scale-108 group-hover:-translate-y-1
                            [.sp-card:hover_&]:scale-108 [.sp-card:hover_&]:-translate-y-1">

                <%# quick-view overlay %>
                <div class="absolute inset-0 z-[5] flex items-end justify-center pb-4 sm:pb-5
                            bg-gradient-to-t from-black/60 to-transparent
                            opacity-0 transition-opacity duration-300
                            [.sp-card:hover_&]:opacity-100">
                  <div class="inline-flex items-center gap-1.5
                              bg-white/[0.12] backdrop-blur-[10px]
                              border border-white/20 text-white
                              text-[10px] sm:text-[11px] font-bold tracking-[0.1em] uppercase
                              px-3.5 sm:px-[18px] py-2 sm:py-2.5 rounded-full
                              translate-y-2 transition-transform duration-300
                              [.sp-card:hover_&]:translate-y-0 hover:bg-[#28c9f4] hover:text-[#03111a] hover:border-[#28c9f4]">
                    <svg width="12" height="12" class="sm:w-[13px] sm:h-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    View Details
                  </div>
                </div>
              </a><%# /card-img %>

              <%# card body %>
              <div class="px-4 py-4 sm:px-5 sm:pt-[18px] sm:pb-[22px] border-t border-white/[0.04]">
                <div class="text-[9px] sm:text-[10px] font-bold tracking-[0.12em] uppercase text-[#374151] mb-1 sm:mb-1.5">
                  <%= product.brand %>
                </div>
                <a href="/productDetail/<%= product._id %>"
                   class="block text-[13.5px] sm:text-[15px] font-bold text-[#e2e8f0] tracking-[-0.2px] leading-[1.3] mb-2.5 sm:mb-3.5
                          no-underline transition-colors duration-200
                          hover:text-[#28c9f4] [.sp-card:hover_&]:text-[#28c9f4] line-clamp-2 h-[35px] sm:h-[40px]">
                  <%= product.productName %>
                </a>
                <div class="flex items-center justify-between">
                  <div class="flex items-baseline gap-1 sm:gap-1.5">
                    <span class="text-[16px] sm:text-[18px] font-extrabold text-white tracking-[-0.5px]">₹<%= displayPrice.toLocaleString('en-IN') %></span>
                    <% if (wasPrice > 0) { %>
                      <span class="text-[10px] sm:text-xs text-[#374151] line-through">₹<%= wasPrice.toLocaleString('en-IN') %></span>
                    <% } %>
                  </div>
                  <% if (product.variants && product.variants.length > 1) { %>
                    <button type="button"
                            onclick="handleShopCartClick(this, event)"
                            data-product="<%= encodeURIComponent(JSON.stringify({ _id: product._id, productName: product.productName, brand: product.brand, primaryImage: product.primaryImage || (product.galleryImages && product.galleryImages[0]) || '', variants: product.variants })) %>"
                            title="Add to Cart"
                            class="w-8 h-8 sm:w-9 sm:h-9 rounded-[8px] sm:rounded-[10px]
                                   bg-[#28c9f4]/[0.08] border border-[#28c9f4]/15
                                   flex items-center justify-center text-[#28c9f4]
                                   hover:bg-[#28c9f4] hover:text-[#03111a] hover:border-[#28c9f4]
                                   active:scale-95
                                   transition-all duration-200 shrink-0 cursor-pointer
                                   [.sp-card:hover_&]:bg-[#28c9f4]/[0.18] [.sp-card:hover_&]:border-[#28c9f4]/40">
                      <svg width="13" height="13" class="sm:w-[15px] sm:h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                  <% } else { %>
                    <button type="button"
                            onclick="addToCartShop('<%= product._id %>', '<%= defaultVariantId %>', event, this)"
                            title="Add to Cart"
                            class="w-8 h-8 sm:w-9 sm:h-9 rounded-[8px] sm:rounded-[10px]
                                   bg-[#28c9f4]/[0.08] border border-[#28c9f4]/15
                                   flex items-center justify-center text-[#28c9f4]
                                   hover:bg-[#28c9f4] hover:text-[#03111a] hover:border-[#28c9f4]
                                   active:scale-95
                                   transition-all duration-200 shrink-0 cursor-pointer
                                   [.sp-card:hover_&]:bg-[#28c9f4]/[0.18] [.sp-card:hover_&]:border-[#28c9f4]/40">
                      <svg width="13" height="13" class="sm:w-[15px] sm:h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                  <% } %>
                </div>
              </div><%# /card-body %>

            </div>
          <% }) %>

        <% } else { %>
          <%# EMPTY STATE %>
          <div class="col-span-full flex flex-col items-center justify-center
                      py-20 px-10 text-center
                      border border-dashed border-white/[0.08] rounded-[18px]
                      bg-[#0a0e16]/50">
            <div class="w-16 h-16 rounded-2xl
                        bg-[#28c9f4]/[0.06] border border-[#28c9f4]/15
                        flex items-center justify-center text-[#28c9f4] mb-5">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <div class="text-lg font-bold text-[#e2e8f0] mb-2">No products found</div>
            <div class="text-[13px] text-[#374151] mb-6">Try adjusting your filters or search term.</div>
            <a href="/shop"
               class="inline-flex items-center gap-1.5
                      text-xs font-bold tracking-[0.08em] uppercase
                      text-[#28c9f4] no-underline px-5 py-2.5
                      border border-[#28c9f4]/30 rounded-[9px]
                      bg-[#28c9f4]/[0.06]
                      hover:bg-[#28c9f4]/[0.12] hover:border-[#28c9f4]/50
                      transition-all duration-200">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.78"/></svg>
              Clear All Filters
            </a>
          </div>
        <% } %>
      </div><%# /productGrid %>

      <%# PAGINATION %>
      <% if (totalPages > 1) {
        let queryParams = `&search=${search}&category=${category}&sort=${sort}&brand=${brand}`;
        if (typeof minPrice !== 'undefined' && !isNaN(minPrice)) queryParams += `&minPrice=${minPrice}`;
        if (typeof maxPrice !== 'undefined' && !isNaN(maxPrice)) queryParams += `&maxPrice=${maxPrice}`;
      %>
        <div id="paginationContainer"
             class="flex justify-center items-center gap-1.5 mt-[60px] flex-wrap">

          <a href="<%= currentPage > 1 ? '?page=' + (currentPage - 1) + queryParams : '#' %>"
             class="w-[38px] h-[38px] flex items-center justify-center
                    border border-white/10 rounded-[10px]
                    text-[13px] font-bold text-[#64748b] no-underline
                    bg-white/[0.02]
                    hover:border-[#28c9f4]/50 hover:text-[#28c9f4] hover:bg-[#28c9f4]/[0.06]
                    transition-all duration-200
                    <%= currentPage === 1 ? 'opacity-30 pointer-events-none' : '' %>">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </a>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %><%= queryParams %>"
               class="w-[38px] h-[38px] flex items-center justify-center
                      border rounded-[10px]
                      text-[13px] font-bold no-underline
                      transition-all duration-200
                      <%= currentPage === i
                        ? 'bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9] border-transparent text-[#03111a] shadow-[0_4px_14px_rgba(40,201,244,0.35)]'
                        : 'border-white/10 text-[#64748b] bg-white/[0.02] hover:border-[#28c9f4]/50 hover:text-[#28c9f4] hover:bg-[#28c9f4]/[0.06]' %>">
              <%= i %>
            </a>
          <% } %>

          <a href="<%= currentPage < totalPages ? '?page=' + (currentPage + 1) + queryParams : '#' %>"
             class="w-[38px] h-[38px] flex items-center justify-center
                    border border-white/10 rounded-[10px]
                    text-[13px] font-bold text-[#64748b] no-underline
                    bg-white/[0.02]
                    hover:border-[#28c9f4]/50 hover:text-[#28c9f4] hover:bg-[#28c9f4]/[0.06]
                    transition-all duration-200
                    <%= currentPage === totalPages ? 'opacity-30 pointer-events-none' : '' %>">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

        </div>
      <% } %>

    </main><%# /main %>
  </div><%# /layout %>
</div><%# /wrapper %>

<!-- VARIANT SELECTION MODAL -->
<div id="shopVariantModal" class="fixed inset-0 z-[200] hidden flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300">
  <div class="bg-[#070b12]/95 border border-white/[0.1] rounded-[24px] p-5 sm:p-7 w-full max-w-md shadow-[0_25px_60px_rgba(0,0,0,0.8)] relative text-white transition-all">
    
    <!-- Close Button -->
    <button onclick="closeVariantModalShop()" type="button" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/[0.06] border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/15 transition cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Product Header Summary -->
    <div class="flex items-center gap-3.5 pb-4 border-b border-white/[0.08] mb-5">
      <img id="variantModalImg" src="" alt="" class="w-14 h-16 sm:w-16 sm:h-20 object-contain rounded-xl bg-black/50 border border-white/[0.08] p-1.5 shrink-0">
      <div class="min-w-0 flex-1">
        <p id="variantModalBrand" class="text-[10px] font-extrabold text-[#28c9f4] uppercase tracking-widest mb-0.5 truncate"></p>
        <h3 id="variantModalTitle" class="text-sm sm:text-base font-extrabold text-white leading-snug line-clamp-1"></h3>
        <p class="text-[11px] text-gray-400 mt-1">Select your preferred size/variant</p>
      </div>
    </div>

    <!-- Variant List Header -->
    <label class="block text-[10px] font-extrabold uppercase tracking-widest text-gray-400 mb-3">Available Options</label>
    
    <!-- Variants Container -->
    <div id="variantModalOptions" class="space-y-2.5 max-h-[220px] overflow-y-auto pr-1 custom-scrollbar mb-5">
      <!-- Options injected via JS -->
    </div>

    <!-- Quantity & Total Price Footer Bar -->
    <div class="flex items-center justify-between gap-4 pt-4 border-t border-white/[0.08]">
      <!-- Quantity Counter -->
      <div class="flex items-center gap-2 bg-white/[0.04] border border-white/[0.1] rounded-xl p-1">
        <button type="button" onclick="changeVariantModalQty(-1)" class="w-7 h-7 rounded-lg bg-white/[0.06] hover:bg-white/[0.15] text-white flex items-center justify-center font-bold text-sm transition cursor-pointer border-none">-</button>
        <span id="variantModalQty" class="w-6 text-center text-xs font-bold text-white">1</span>
        <button type="button" onclick="changeVariantModalQty(1)" class="w-7 h-7 rounded-lg bg-white/[0.06] hover:bg-white/[0.15] text-white flex items-center justify-center font-bold text-sm transition cursor-pointer border-none">+</button>
      </div>

      <!-- Add to Cart Submit Button -->
      <button id="variantModalSubmitBtn" type="button" onclick="confirmVariantAddToCart()" class="flex-1 bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9] text-[#03111a] py-3 px-5 rounded-xl font-extrabold text-xs uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all shadow-[0_4px_20px_rgba(40,201,244,0.3)] cursor-pointer border-none flex items-center justify-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Add to Cart</span>
      </button>
    </div>

  </div>
</div>

<script>
/* ── Toast notification helper ── */
function showShopToast(msg, type = 'success') {
  let toastContainer = document.getElementById('shopToastContainer');
  if (!toastContainer) {
    toastContainer = document.createElement('div');
    toastContainer.id = 'shopToastContainer';
    toastContainer.className = 'fixed bottom-6 right-6 z-[9999] flex flex-col gap-2 pointer-events-none';
    document.body.appendChild(toastContainer);
  }
  
  const toast = document.createElement('div');
  const isSuccess = type === 'success';
  toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl backdrop-blur-xl border text-xs font-semibold shadow-2xl transition-all duration-300 transform translate-y-4 opacity-0 ${
    isSuccess 
      ? 'bg-[#06141d]/90 border-[#28c9f4]/40 text-[#28c9f4] shadow-[0_10px_30px_rgba(40,201,244,0.2)]'
      : 'bg-[#1a080c]/90 border-red-500/40 text-red-400 shadow-[0_10px_30px_rgba(239,68,68,0.2)]'
  }`;
  
  const iconSvg = isSuccess 
    ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
    : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;
    
  toast.innerHTML = `${iconSvg}<span>${msg}</span>`;
  toastContainer.appendChild(toast);
  
  requestAnimationFrame(() => {
    toast.classList.remove('translate-y-4', 'opacity-0');
  });
  
  setTimeout(() => {
    toast.classList.add('translate-y-4', 'opacity-0');
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

/* ── Wishlist Toggle Function ── */
async function toggleWishlistShop(productId, btn, event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const icon = btn.querySelector('svg');
  const adding = btn.getAttribute('data-in-wishlist') !== 'true';
  const url = adding ? `/wishlist/add/${productId}` : `/wishlist/remove/${productId}`;
  
  try {
    const res = await fetch(url, {
      method: adding ? 'POST' : 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }
    });
    
    if (res.status === 401) {
      window.location.href = '/auth/login';
      return;
    }
    
    const data = await res.json();
    if (data.success) {
      btn.setAttribute('data-in-wishlist', adding ? 'true' : 'false');
      btn.setAttribute('title', adding ? 'Remove from Wishlist' : 'Add to Wishlist');
      
      if (adding) {
        btn.classList.remove('text-gray-400');
        btn.classList.add('text-red-500', 'border-red-500/50', 'bg-red-500/15');
        icon.setAttribute('fill', 'currentColor');
      } else {
        btn.classList.remove('text-red-500', 'border-red-500/50', 'bg-red-500/15');
        btn.classList.add('text-gray-400');
        icon.setAttribute('fill', 'none');
      }
      
      icon.style.transform = 'scale(1.3)';
      setTimeout(() => icon.style.transform = 'scale(1)', 200);

      showShopToast(data.message || (adding ? 'Added to wishlist!' : 'Removed from wishlist.'), 'success');
      
      const badge = document.getElementById('navWishlistBadge');
      if (badge) {
        let current = parseInt(badge.textContent) || 0;
        if (adding) current += 1;
        else if (current > 0) current -= 1;
        badge.textContent = current > 99 ? '99+' : current;
        if (current === 0) badge.classList.add('hidden');
        else badge.classList.remove('hidden');
      }
    } else {
      showShopToast(data.message || 'Action failed', 'error');
    }
  } catch (err) {
    console.error(err);
    showShopToast('Something went wrong', 'error');
  }
}

/* ── Add to Cart Function ── */
async function addToCartShop(productId, variantId, event, btn, qty = 1) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  if (!variantId) {
    showShopToast('Product variant not available', 'error');
    return;
  }
  
  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ productId, variantId, quantity: qty })
    });
    
    if (res.status === 401) {
      window.location.href = '/auth/login';
      return;
    }
    
    const data = await res.json();
    if (data.success) {
      showShopToast(data.message || 'Added to cart successfully!', 'success');
      const badge = document.getElementById('navCartBadge');
      if (badge) {
        let current = parseInt(badge.textContent) || 0;
        current += qty;
        badge.textContent = current > 99 ? '99+' : current;
        badge.classList.remove('hidden');
      }
    } else {
      showShopToast(data.message || 'Failed to add to cart', 'error');
    }
  } catch (err) {
    console.error(err);
    showShopToast('Something went wrong', 'error');
  }
}

/* ── Multi-Variant Selection Modal Logic ── */
let currentModalProduct = null;
let currentSelectedVariantId = null;
let currentTriggerBtn = null;
let currentModalQty = 1;

function handleShopCartClick(btn, event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  const rawData = btn.getAttribute('data-product');
  if (!rawData) return;
  
  try {
    const product = JSON.parse(decodeURIComponent(rawData));
    currentModalProduct = product;
    currentTriggerBtn = btn;
    currentModalQty = 1;
    document.getElementById('variantModalQty').textContent = 1;

    document.getElementById('variantModalImg').src = product.primaryImage || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume';
    document.getElementById('variantModalBrand').textContent = product.brand || 'Nafahath';
    document.getElementById('variantModalTitle').textContent = product.productName || 'Perfume';

    const container = document.getElementById('variantModalOptions');
    container.innerHTML = '';

    if (product.variants && product.variants.length > 0) {
      const defaultVar = product.variants.find(v => v.stock > 0) || product.variants[0];
      currentSelectedVariantId = defaultVar._id;

      product.variants.forEach((v) => {
        const isSelected = (v._id.toString() === currentSelectedVariantId.toString());
        const price = v.salePrice > 0 ? v.salePrice : v.regularPrice;
        const wasPrice = v.salePrice > 0 ? v.regularPrice : 0;
        const discountPct = (wasPrice > 0) ? Math.round(((wasPrice - price) / wasPrice) * 100) : 0;
        const isOutOfStock = v.stock <= 0;

        const optionCard = document.createElement('div');
        optionCard.className = `variant-option-card border rounded-xl p-3.5 flex items-center justify-between cursor-pointer transition-all duration-200 ${
          isOutOfStock ? 'opacity-50 cursor-not-allowed border-white/[0.05] bg-white/[0.01]' :
          isSelected ? 'border-[#28c9f4] bg-[#28c9f4]/10 shadow-[0_0_15px_rgba(40,201,244,0.15)]' : 'border-white/10 bg-white/[0.02] hover:border-white/20'
        }`;
        
        optionCard.onclick = () => {
          if (isOutOfStock) return;
          currentSelectedVariantId = v._id;
          document.querySelectorAll('.variant-option-card').forEach(el => {
            el.className = 'variant-option-card border rounded-xl p-3.5 flex items-center justify-between cursor-pointer transition-all duration-200 border-white/10 bg-white/[0.02] hover:border-white/20';
          });
          optionCard.className = 'variant-option-card border rounded-xl p-3.5 flex items-center justify-between cursor-pointer transition-all duration-200 border-[#28c9f4] bg-[#28c9f4]/10 shadow-[0_0_15px_rgba(40,201,244,0.15)]';
          updateModalSubmitButton();
        };

        optionCard.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-4 h-4 rounded-full border flex items-center justify-center ${isSelected ? 'border-[#28c9f4] bg-[#28c9f4]' : 'border-gray-500'}">
              ${isSelected ? '<div class="w-1.5 h-1.5 rounded-full bg-[#03111a]"></div>' : ''}
            </div>
            <div>
              <span class="text-xs font-bold text-white uppercase tracking-wider">${v.size}</span>
              <span class="text-[10px] block ${isOutOfStock ? 'text-red-400 font-semibold' : v.stock < 5 ? 'text-amber-400 font-medium' : 'text-gray-400'}">
                ${isOutOfStock ? 'Out of Stock' : (v.stock < 5 ? `Only ${v.stock} left` : 'In Stock')}
              </span>
            </div>
          </div>
          <div class="text-right">
            <div class="flex items-baseline justify-end gap-1.5">
              <span class="text-sm font-extrabold text-white">₹${price.toLocaleString('en-IN')}</span>
              ${wasPrice > 0 ? `<span class="text-[10px] text-gray-500 line-through">₹${wasPrice.toLocaleString('en-IN')}</span>` : ''}
            </div>
            ${discountPct > 0 ? `<span class="text-[9px] font-bold text-[#28c9f4] bg-[#28c9f4]/10 px-1.5 py-0.5 rounded">${discountPct}% OFF</span>` : ''}
          </div>
        `;

        container.appendChild(optionCard);
      });
    }

    updateModalSubmitButton();
    document.getElementById('shopVariantModal').classList.remove('hidden');
  } catch (err) {
    console.error('Error opening variant modal:', err);
  }
}

function closeVariantModalShop() {
  document.getElementById('shopVariantModal').classList.add('hidden');
}

function changeVariantModalQty(delta) {
  currentModalQty = Math.max(1, currentModalQty + delta);
  document.getElementById('variantModalQty').textContent = currentModalQty;
  updateModalSubmitButton();
}

function updateModalSubmitButton() {
  const btn = document.getElementById('variantModalSubmitBtn');
  if (!currentModalProduct || !currentSelectedVariantId) return;
  const selectedVar = currentModalProduct.variants.find(v => v._id.toString() === currentSelectedVariantId.toString());
  if (!selectedVar || selectedVar.stock <= 0) {
    btn.disabled = true;
    btn.className = 'flex-1 bg-gray-700 text-gray-400 py-3 px-5 rounded-xl font-bold text-xs uppercase cursor-not-allowed border-none flex items-center justify-center gap-2';
    btn.innerHTML = '<span>Out of Stock</span>';
  } else {
    btn.disabled = false;
    btn.className = 'flex-1 bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9] text-[#03111a] py-3 px-5 rounded-xl font-extrabold text-xs uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all shadow-[0_4px_20px_rgba(40,201,244,0.3)] cursor-pointer border-none flex items-center justify-center gap-2';
    const unitPrice = selectedVar.salePrice > 0 ? selectedVar.salePrice : selectedVar.regularPrice;
    const totalPrice = unitPrice * currentModalQty;
    btn.innerHTML = `
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span>Add to Cart — ₹${totalPrice.toLocaleString('en-IN')}</span>
    `;
  }
}

async function confirmVariantAddToCart() {
  if (!currentModalProduct || !currentSelectedVariantId) return;
  const productId = currentModalProduct._id;
  const variantId = currentSelectedVariantId;
  const qty = currentModalQty;
  const triggeringBtn = currentTriggerBtn;

  closeVariantModalShop();
  await addToCartShop(productId, variantId, null, triggeringBtn, qty);
}

/* ── Accordion toggle ── */
function spToggle(id, btn) {
  const el     = document.getElementById(id);
  const isOpen = el.style.display !== 'none' && el.style.display !== '';
  el.style.display = isOpen ? 'none' : '';
  btn.classList.toggle('open', !isOpen);
}

/* ── Sort highlight on change ── */
document.querySelectorAll('.sp-sort-item').forEach(item => {
  const radio = item.querySelector('input[type="radio"]');
  if (radio) {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.sp-sort-item').forEach(i => i.classList.remove('is-selected'));
      item.classList.add('is-selected');
    });
  }
});

/* ══════════════════════════════════
   AJAX FILTERING (logic preserved)
══════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
  const filterForm          = document.getElementById('filterForm');
  const productGrid         = document.getElementById('productGrid');
  const paginationContainer = document.getElementById('paginationContainer');

  const fetchFilteredProducts = async (url, pushToHistory = true) => {
    try {
      if (productGrid) {
        productGrid.style.transition = 'all 0.3s ease';
        productGrid.style.opacity    = '0.3';
        productGrid.style.transform  = 'scale(0.98)';
      }
      const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const text     = await response.text();
      const parser   = new DOMParser();
      const doc      = parser.parseFromString(text, 'text/html');
      const newGrid  = doc.getElementById('productGrid');
      const newPagination = doc.getElementById('paginationContainer');

      if (newGrid && productGrid) {
        productGrid.innerHTML = newGrid.innerHTML;
        setTimeout(() => {
          productGrid.style.opacity   = '1';
          productGrid.style.transform = 'scale(1)';
        }, 50);
      }
      if (paginationContainer) {
        paginationContainer.innerHTML = newPagination ? newPagination.innerHTML : '';
      }
      if (pushToHistory) window.history.pushState({}, '', url);
    } catch (err) {
      console.error('Error fetching products:', err);
      if (productGrid) productGrid.style.opacity = '1';
    }
  };

  if (filterForm) {
    filterForm.querySelectorAll('input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', () => {
        filterForm.dispatchEvent(new Event('submit', { cancelable: true }));
      });
    });
    filterForm.addEventListener('submit', e => {
      e.preventDefault();
      const url = `/shop?${new URLSearchParams(new FormData(filterForm)).toString()}`;
      fetchFilteredProducts(url);
    });
  }

  document.addEventListener('click', e => {
    const link = e.target.closest('a');
    if (link && link.href && link.href.includes('/shop?page=')) {
      e.preventDefault();
      fetchFilteredProducts(link.href);
      document.querySelector('main').scrollIntoView({ behavior: 'smooth' });
    }
  });

  window.addEventListener('popstate', () => {
    fetchFilteredProducts(window.location.href, false);
    const params    = new URL(window.location.href).searchParams;
    const catRadio  = document.querySelector(`input[name="category"][value="${params.get('category') || ''}"]`);
    const sortRadio = document.querySelector(`input[name="sort"][value="${params.get('sort') || ''}"]`);
    if (catRadio)  catRadio.checked  = true;
    if (sortRadio) sortRadio.checked = true;
  });
});
</script>
