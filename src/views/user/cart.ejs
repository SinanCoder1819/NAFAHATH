<%- /* cart.ejs – Tailwind CSS version */ '' %>

  <!-- Toast animation only -->
  <style>
    .ct-toast {
      transform: translateY(20px);
      opacity: 0;
      transition: transform .3s, opacity .3s;
    }

    .ct-toast.show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>

  <!-- PAGE WRAPPER -->
  <div class="max-w-[1280px] mx-auto px-7 py-12 min-h-[70vh] text-[#c8cdd8] font-['Inter',sans-serif]">

    <!-- HEADER -->
    <div class="text-center mb-14">
      <!-- eyebrow -->
      <div
        class="inline-flex items-center gap-1.5 text-[10px] font-bold tracking-[0.16em] uppercase text-[#28c9f4] mb-3.5">
        <span class="w-7 h-px bg-gradient-to-r from-transparent to-[rgba(40,201,244,0.4)]"></span>
        Your Selections
        <span class="w-7 h-px bg-gradient-to-r from-[rgba(40,201,244,0.4)] to-transparent"></span>
      </div>
      <h1
        class="text-[42px] font-extrabold tracking-tight bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent m-0 mb-2.5">
        Shopping Cart</h1>
      <p class="text-[12px] text-[#374151] tracking-[0.1em]">Review your curated fragrances before checkout</p>
    </div>

    <% if (cart && cart.items.length> 0) { %>

      <!-- LAYOUT -->
      <div id="cart-content-wrapper" class="flex gap-7 items-start flex-wrap lg:flex-nowrap w-full">

        <!-- ── LEFT: ITEMS ── -->
        <div class="flex-1 min-w-0 w-full">

          <!-- DELIVERY ADDRESS BAR (Flipkart style) -->
          <div class="bg-[#0c121d]/40 border border-white/[0.06] rounded-2xl p-6 md:p-7 mb-6 flex items-center justify-between gap-4 shadow-sm">
            <div class="min-w-0 flex-1">
              <% if (typeof defaultAddress !== 'undefined' && defaultAddress) { %>
                <p class="text-sm sm:text-base text-gray-400 font-medium tracking-wide">
                  Deliver to: <span class="font-bold text-white"><%= defaultAddress.fullName %></span>, <span class="font-semibold text-gray-300"><%= defaultAddress.postalCode %></span>
                  <span class="bg-[#00FFFF]/10 border border-[#00FFFF]/20 text-[#00FFFF] text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-md ml-2 tracking-wider">
                    <%= defaultAddress.isDefault ? 'Default' : 'Saved' %>
                  </span>
                </p>
                <p class="text-sm sm:text-[15px] text-gray-300 mt-2 truncate leading-relaxed">
                  <%= defaultAddress.addressLine %>, <%= defaultAddress.city %>, <%= defaultAddress.state %>
                </p>
              <% } else { %>
                <p class="text-sm sm:text-base font-bold text-white">No delivery address added yet</p>
                <p class="text-xs sm:text-sm text-gray-500 mt-2">Add a default address in your profile to view coordinates here.</p>
              <% } %>
            </div>
            <div>
              <a href="<%= (typeof defaultAddress !== 'undefined' && defaultAddress) ? `/address?edit=${defaultAddress._id}&redirect=/cart` : '/address?add=true&redirect=/cart' %>" class="border border-white/10 text-[#00FFFF] px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-[#00FFFF]/5 hover:border-[#00FFFF]/30 transition-all duration-300 no-underline whitespace-nowrap block">
                <%= (typeof defaultAddress !== 'undefined' && defaultAddress) ? 'Change' : '+ Add Address' %>
              </a>
            </div>
          </div>

          <!-- ITEMS LIST -->
          <% let hasOutOfStock = false; %>
          <% cart.items.forEach(item => { %>
            <% 
              const variantObj = item.productId.variants.find(v => v._id.toString() === item.variantId.toString()) || (item.productId.variants && item.productId.variants[0]);
              const availableStock = variantObj ? variantObj.stock : 0;
              const isBlocked = item.productId.isDeleted;
              const isOutOfStock = item.quantity > availableStock;
              if (isOutOfStock || isBlocked) hasOutOfStock = true;

              // Calculate price details
              const unitPrice = variantObj ? (variantObj.salePrice > 0 ? variantObj.salePrice : variantObj.regularPrice) : 0;
              const originalUnitPrice = variantObj ? variantObj.regularPrice : 0;
              const hasDiscount = variantObj && variantObj.salePrice > 0 && variantObj.regularPrice > variantObj.salePrice;
              const discountPercent = hasDiscount ? Math.round(((originalUnitPrice - unitPrice) / originalUnitPrice) * 100) : 0;

              // Delivery date helper (estimated delivery in 3 days)
              const deliveryDate = new Date();
              deliveryDate.setDate(deliveryDate.getDate() + 3);
              const formattedDelivery = deliveryDate.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            %>

            <!-- ITEM CARD (Flipkart style) -->
            <div 
              class="bg-[#0c121d]/40 border border-white/[0.06] rounded-2xl p-6 sm:p-7 mb-5 hover:border-white/[0.12] transition-all duration-300"
              id="cart-item-<%= item.productId._id %>-<%= item.variantId %>"
            >
              
              <!-- Deal Flag / Tag -->
              <div class="mb-4 flex justify-between items-start">
                <span class="bg-emerald-950/20 text-emerald-400 border border-emerald-800/30 text-[10px] sm:text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-md">
                  <%= hasDiscount ? `${discountPercent}% Off Deal` : 'Nafahath Select' %>
                </span>
                
                <!-- Stock warnings -->
                <% if (isBlocked || isOutOfStock) { %>
                  <span class="text-[10px] sm:text-xs font-extrabold tracking-[0.08em] uppercase text-red-400 bg-red-950/20 border border-red-800/30 px-3 py-1.5 rounded-md">
                    OUT OF STOCK
                  </span>
                <% } %>
              </div>

              <!-- Main Item Content -->
              <div class="flex gap-5 sm:gap-6 items-start flex-col sm:flex-row">
                
                <!-- Left: Product Image -->
                <a href="/productDetail/<%= item.productId._id %>" class="w-28 h-36 shrink-0 rounded-2xl border border-white/10 overflow-hidden bg-[#0f1522] block group">
                  <img 
                    src="<%= item.productId.primaryImage || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume' %>" 
                    onerror="this.src='https://placehold.co/400x500/0a0e16/1e2533?text=Perfume'"
                    alt="<%= item.productId.productName %>" 
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  >
                </a>

                <!-- Right: Product Info & Dynamic Stepper -->
                <div class="flex-1 min-w-0 space-y-3.5 w-full">
                  <div>
                    <span class="text-xs sm:text-sm text-gray-500 font-semibold mb-1 block"><%= item.productId.brand %></span>
                    <a href="/productDetail/<%= item.productId._id %>" class="text-base sm:text-lg font-extrabold text-[#e2e8f0] hover:text-[#00FFFF] transition-colors leading-snug no-underline">
                      <%= item.productId.productName %>
                    </a>
                  </div>

                  <!-- Stars & Assured Tag -->
                  <div class="flex items-center flex-wrap gap-3 text-xs sm:text-sm">
                    <div class="flex items-center gap-1 bg-[#00FFFF]/10 border border-[#00FFFF]/20 text-[#00FFFF] px-2 py-0.5 rounded text-xs font-bold">
                      <span class="text-amber-400">★</span>
                      <span>4.8</span>
                    </div>
                    <span class="text-gray-600">•</span>
                    <span class="text-gray-500 font-medium">82 Ratings</span>
                    <span class="text-gray-600">•</span>
                    <div class="flex items-center gap-1.5 text-[#00FFFF] text-xs font-bold tracking-wider uppercase bg-[#00FFFF]/[0.02] border border-[#00FFFF]/20 px-2.5 py-0.5 rounded-full">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                      Assured
                    </div>
                  </div>

                  <!-- Size & Stepper controls -->
                  <div class="flex items-center gap-5 py-1">
                    <span class="text-xs sm:text-sm font-bold tracking-wider text-gray-300 bg-white/[0.04] border border-white/[0.08] px-3 py-1.5 rounded-lg">
                      <%= variantObj ? variantObj.size : '100ml' %>
                    </span>

                    <!-- Quantity Stepper -->
                    <div class="flex items-center bg-white/[0.03] border border-white/[0.08] rounded-xl overflow-hidden shadow-inner">
                      <button 
                        class="w-8.5 h-8.5 flex items-center justify-center text-gray-500 hover:text-[#00FFFF] hover:bg-[#00FFFF]/[0.08] transition-all bg-transparent border-none cursor-pointer text-base font-bold"
                        onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'decrement')"
                      >−</button>
                      <span class="quantity-display min-w-[36px] text-center text-sm font-bold text-[#e2e8f0] border-l border-r border-white/[0.06] px-1 leading-8">
                        <%= item.quantity %>
                      </span>
                      <button 
                        class="w-8.5 h-8.5 flex items-center justify-center text-gray-500 hover:text-[#00FFFF] hover:bg-[#00FFFF]/[0.08] transition-all bg-transparent border-none cursor-pointer text-base font-bold"
                        onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'increment')"
                      >+</button>
                    </div>
                  </div>

                  <!-- Price details row -->
                  <div class="flex items-baseline flex-wrap gap-2.5 pt-2">
                    <span class="text-xl sm:text-2xl font-extrabold text-[#00FFFF]">₹<span class="item-total"><%= item.totalPrice %></span></span>
                    
                    <% if (hasDiscount) { %>
                      <span class="item-regular-total text-sm sm:text-base text-gray-500 line-through" data-unit-price="<%= originalUnitPrice %>">₹<%= (originalUnitPrice * item.quantity).toLocaleString('en-IN') %></span>
                      <span class="text-sm sm:text-base font-extrabold text-emerald-400"><%= discountPercent %>% Off</span>
                    <% } %>
                    <span class="text-xs text-gray-600 ml-1">(₹<%= unitPrice.toLocaleString('en-IN') %> ea)</span>
                  </div>

                  <!-- Delivery date -->
                  <div class="text-xs sm:text-sm text-gray-500 flex items-center gap-1.5 pt-1.5">
                    <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                    <span>Delivery by <span class="text-gray-400 font-semibold"><%= formattedDelivery %></span> | <span class="text-emerald-400 font-semibold">FREE</span></span>
                  </div>
                </div>

              </div>

              <!-- Action Row Divider -->
              <div class="border-t border-white/[0.04] pt-4 mt-5 grid grid-cols-3 items-center">
                <!-- Save for later -->
                <button 
                  onclick="saveForLater('<%= item.productId._id %>', '<%= item.variantId %>')"
                  class="justify-self-start text-xs sm:text-sm font-bold uppercase tracking-wider text-gray-500 hover:text-[#00FFFF] transition-colors cursor-pointer bg-transparent border-none flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  Save for later
                </button>
                <!-- Remove -->
                <button 
                  onclick="removeFromCart('<%= item.productId._id %>', '<%= item.variantId %>')"
                  class="justify-self-center text-xs sm:text-sm font-bold uppercase tracking-wider text-gray-500 hover:text-red-400 transition-colors cursor-pointer bg-transparent border-none flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  Remove
                </button>
                <!-- Buy this now -->
                <a 
                  href="/checkout"
                  class="justify-self-end text-xs sm:text-sm font-extrabold uppercase tracking-wider text-[#00FFFF] hover:underline transition-colors flex items-center gap-1 no-underline"
                >
                  Buy this now
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>

            </div>
          <% }) %>

        </div>

        <!-- ── RIGHT: SUMMARY ── -->
        <div class="w-full lg:w-[350px] shrink-0">
          <div class="bg-[#0a0e16]/75 backdrop-blur-xl border border-white/[0.07] rounded-2xl p-6 sticky top-24 shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
            
            <!-- Summary Title -->
            <div class="text-[11px] font-extrabold tracking-[0.16em] uppercase text-gray-400 mb-5 pb-4 border-b border-white/[0.06] flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00FFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                <rect x="9" y="3" width="6" height="4" rx="1" />
              </svg>
              PRICE DETAILS
            </div>

            <% 
              let totalOriginalPrice = 0;
              let totalDiscount = 0;
              cart.items.forEach(item => {
                if (item.productId && item.productId.variants) {
                  const variant = item.productId.variants.find(v => v._id.toString() === item.variantId.toString()) || item.productId.variants[0];
                  if (variant) {
                    totalOriginalPrice += variant.regularPrice * item.quantity;
                    const discountPerUnit = variant.regularPrice - (variant.salePrice > 0 ? variant.salePrice : variant.regularPrice);
                    totalDiscount += discountPerUnit * item.quantity;
                  } else {
                    totalOriginalPrice += item.totalPrice;
                  }
                } else {
                  totalOriginalPrice += item.totalPrice;
                }
              });
            %>

            <!-- Price Breakdown -->
            <div class="space-y-4 mb-5 pb-5 border-b border-white/[0.06]">
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400">Price (<%= cart.items.length %> item<%= cart.items.length !== 1 ? 's' : '' %>)</span>
                <span class="text-white font-medium">₹<span id="cartSubtotal"><%= totalOriginalPrice %></span></span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400">Discount</span>
                <span class="text-emerald-400 font-medium">-₹<span id="cartDiscount"><%= totalDiscount %></span></span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400">Delivery Charges</span>
                <span class="text-emerald-400 font-medium uppercase tracking-wider">FREE</span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-gray-400">Estimated Taxes</span>
                <span class="text-gray-500 text-[10px] italic">Included</span>
              </div>
            </div>

            <!-- Total Price -->
            <div class="flex justify-between items-baseline mb-6">
              <span class="text-xs font-extrabold text-white uppercase tracking-wider">Total Amount</span>
              <span class="text-2xl font-extrabold text-[#00FFFF] tracking-tight">₹<span id="cartTotal"><%= cart.cartTotal %></span></span>
            </div>

            <!-- Checkout Button -->
            <% if (hasOutOfStock) { %>
              <button disabled class="block w-full py-4 rounded-xl bg-white/[0.04] text-gray-500 border border-white/[0.08] text-xs font-extrabold tracking-widest uppercase text-center cursor-not-allowed">
                Resolve Stock Issues First
              </button>
            <% } else { %>
              <a href="/checkout" class="block w-full py-4 rounded-xl bg-gradient-to-r from-[#00FFFF] to-[#0ea5e9] text-[#03111a] text-xs font-extrabold tracking-widest uppercase text-center hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(0,255,255,0.4)] transition-all duration-300 no-underline shadow-[0_4px_20px_rgba(0,255,255,0.2)]">
                Place Order
              </a>
            <% } %>

            <!-- Secured Checkout badge -->
            <div class="flex items-center justify-center gap-1.5 mt-4 text-[9px] font-bold tracking-[0.1em] uppercase text-gray-600">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              256-Bit SSL Encrypted Checkout
            </div>

          </div>
        </div><!-- /summary col -->

      </div><!-- /layout -->

      <% } else { %>

        <!-- EMPTY STATE -->
        <div class="flex flex-col items-center py-20 px-10 bg-[#0a0e16]/60 border border-white/[0.06] rounded-3xl max-w-lg mx-auto text-center">
          
          <!-- Flipkart Empty Cart Vector Illustration (Tailwind custom adapted for Dark theme) -->
          <svg class="w-32 h-32 text-gray-500 mb-6 mx-auto" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="cartOutlineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4b5563" />
                <stop offset="100%" stop-color="#1f2937" />
              </linearGradient>
              <linearGradient id="logoTagGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#facc15" />
                <stop offset="100%" stop-color="#eab308" />
              </linearGradient>
            </defs>
            <circle cx="48" cy="98" r="8" fill="#374151" stroke="#4b5563" stroke-width="2"/>
            <circle cx="48" cy="98" r="3" fill="#9ca3af"/>
            <circle cx="82" cy="98" r="8" fill="#374151" stroke="#4b5563" stroke-width="2"/>
            <circle cx="82" cy="98" r="3" fill="#9ca3af"/>
            
            <path d="M25 35H32L42 78H90L100 45H36" stroke="url(#cartOutlineGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="50" y1="46" x2="50" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
            <line x1="66" y1="46" x2="66" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
            <line x1="82" y1="46" x2="82" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
            <line x1="43" y1="56" x2="97" y2="56" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
            
            <g transform="translate(54, 15)">
              <rect x="0" y="0" width="22" height="11" rx="2.5" fill="url(#logoTagGrad)"/>
              <path d="M11 2.5L12.5 5.5H15.5L13 7.5L14 10.5L11 8.5L8 10.5L9 7.5L6.5 5.5H9.5L11 2.5Z" fill="#1e3a8a"/>
            </g>
            
            <rect x="62" y="38" width="6" height="8" rx="1" fill="#ef4444"/>
          </svg>

          <div class="text-[20px] font-extrabold text-[#e2e8f0] mb-2.5">Your cart is empty!</div>
          <div class="text-[12px] text-gray-500 mb-8 max-w-xs mx-auto">
            Explore our curated fragrances and add selections to your shopping cart.
          </div>

          <a href="/shop" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl
                bg-[rgba(40,201,244,0.08)] border border-[rgba(40,201,244,0.22)]
                text-[#28c9f4] text-[11px] font-extrabold tracking-[0.1em] uppercase no-underline
                hover:bg-[rgba(40,201,244,0.15)] hover:border-[rgba(40,201,244,0.45)]
                hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(40,201,244,0.2)] transition-all">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1 4 1 10 7 10" />
              <path d="M3.51 15a9 9 0 1 0 .49-3.78" />
            </svg>
            Continue Shopping
          </a>

        </div>
      <% } %>
    </div><!-- /page wrapper -->

  <script>
    /* ── ANIMATION FOR PRICING DIGITS (Flipkart Style sliding text) ── */
    function animatePriceUpdateEl(el, newText) {
      if (!el) return;
      const oldText = el.innerText.trim();
      if (oldText === String(newText).trim()) return;

      el.style.display = 'inline-block';
      el.style.transition = 'transform 0.1s cubic-bezier(0.4, 0, 1, 1), opacity 0.1s ease-in';
      el.style.transform = 'translateY(50%)';
      el.style.opacity = '0';

      setTimeout(() => {
        el.innerText = newText;
        el.style.transition = 'none';
        el.style.transform = 'translateY(-50%)';
        el.offsetHeight; // Force reflow
        
        el.style.transition = 'transform 0.16s cubic-bezier(0, 0, 0.2, 1), opacity 0.16s ease-out';
        el.style.transform = 'translateY(0)';
        el.style.opacity = '1';
      }, 100);
    }

    /* ── SLOW STAGGERED ODOMETER DIGIT ROLLING ANIMATION FOR TOTAL AMOUNT ── */
    function setOdometerValue(element, value) {
      if (!element) return;
      const formatString = Number(value).toLocaleString('en-IN');
      
      element.innerHTML = '';
      element.style.display = 'inline-flex';
      element.style.alignItems = 'baseline';
      
      for (let i = 0; i < formatString.length; i++) {
        const char = formatString[i];
        if (char >= '0' && char <= '9') {
          const digit = parseInt(char);
          
          const col = document.createElement('span');
          col.style.display = 'inline-block';
          col.style.height = '1em';
          col.style.overflow = 'hidden';
          col.style.position = 'relative';
          col.style.verticalAlign = 'bottom';
          
          const strip = document.createElement('span');
          strip.style.display = 'flex';
          strip.style.flexDirection = 'column';
          strip.style.transition = 'transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
          strip.style.transform = 'translateY(0)';
          
          for (let d = 0; d <= 9; d++) {
            const digitSpan = document.createElement('span');
            digitSpan.innerText = d;
            digitSpan.style.display = 'block';
            digitSpan.style.height = '1em';
            digitSpan.style.lineHeight = '1em';
            strip.appendChild(digitSpan);
          }
          
          col.appendChild(strip);
          element.appendChild(col);
          
          // Trigger transition with slow staggered delay (150ms delay per column)
          setTimeout(() => {
            strip.style.transform = `translateY(-${digit}em)`;
          }, 50 + i * 150);
        } else {
          const staticSpan = document.createElement('span');
          staticSpan.innerText = char;
          staticSpan.style.display = 'inline-block';
          staticSpan.style.verticalAlign = 'bottom';
          element.appendChild(staticSpan);
        }
      }
    }

    // Initialize Odometer on page load for the cart total
    const cartTotalEl = document.getElementById('cartTotal');
    if (cartTotalEl) {
      const originalValue = cartTotalEl.innerText.trim();
      setOdometerValue(cartTotalEl, originalValue);
    }

    /* ── UPDATE QUANTITY ── */
    async function updateQuantity(productId, variantId, action) {
      try {
        const response = await fetch('/cart/update', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId, action })
        });
        const data = await response.json();

        if (data.success) {
          const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
          const qtyEl = itemRow.querySelector('.quantity-display');
          qtyEl.innerText = action === 'increment'
            ? parseInt(qtyEl.innerText) + 1
            : parseInt(qtyEl.innerText) - 1;

          itemRow.querySelectorAll('.item-total').forEach(el => animatePriceUpdateEl(el, data.itemTotal));

          const newQty = parseInt(qtyEl.innerText);
          itemRow.querySelectorAll('.item-regular-total').forEach(el => {
            const unitPrice = parseFloat(el.getAttribute('data-unit-price')) || 0;
            animatePriceUpdateEl(el, '₹' + (unitPrice * newQty).toLocaleString('en-IN'));
          });

          animatePriceUpdateEl(document.getElementById('cartSubtotal'), data.totalOriginalPrice);
          animatePriceUpdateEl(document.getElementById('cartDiscount'), data.totalDiscount);
          
          // Animate total amount with the odometer rolling digits
          setOdometerValue(document.getElementById('cartTotal'), data.cartTotal);
        } else {
          showToast(data.message, 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Error updating quantity', 'error');
      }
    }

    /* ── REMOVE FROM CART ── */
    async function removeFromCart(productId, variantId) {
      try {
        const response = await fetch('/cart/remove', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId })
        });
        const data = await response.json();

        if (data.success) {
          const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
          itemRow.style.opacity = '0';
          setTimeout(() => {
            itemRow.remove();

            // ADD THIS CODE TO DECREASE THE NAVBAR BADGE:
            const badge = document.getElementById('navCartBadge');
            if (badge) {
              let current = parseInt(badge.textContent) || 0;
              if (current > 0) {
                current -= 1; // Decrease cart count
                badge.textContent = current;
              }
              if (current === 0) {
                badge.classList.add('hidden'); // Hide the badge if cart is empty
              }
            }

            // Update cart totals on the page
            if (document.getElementById('cartSubtotal')) {
              animatePriceUpdateEl(document.getElementById('cartSubtotal'), data.totalOriginalPrice);
            }
            if (document.getElementById('cartDiscount')) {
              animatePriceUpdateEl(document.getElementById('cartDiscount'), data.totalDiscount);
            }
            if (document.getElementById('cartTotal')) {
              setOdometerValue(document.getElementById('cartTotal'), data.cartTotal);
            }
            if (document.querySelectorAll('[id^="cart-item-"]').length === 0) {
              const wrapper = document.getElementById('cart-content-wrapper');
              if (wrapper) {
                wrapper.innerHTML = `
                <div class="flex flex-col items-center w-full py-20 px-10 bg-[#0a0e16]/60 border border-white/[0.06] rounded-3xl max-w-lg mx-auto text-center" style="animation: fadeIn 0.4s ease">
                  
                  <svg class="w-32 h-32 text-gray-500 mb-6 mx-auto" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <linearGradient id="cartOutlineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#4b5563" />
                        <stop offset="100%" stop-color="#1f2937" />
                      </linearGradient>
                      <linearGradient id="logoTagGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#facc15" />
                        <stop offset="100%" stop-color="#eab308" />
                      </linearGradient>
                    </defs>
                    <circle cx="48" cy="98" r="8" fill="#374151" stroke="#4b5563" stroke-width="2"/>
                    <circle cx="48" cy="98" r="3" fill="#9ca3af"/>
                    <circle cx="82" cy="98" r="8" fill="#374151" stroke="#4b5563" stroke-width="2"/>
                    <circle cx="82" cy="98" r="3" fill="#9ca3af"/>
                    
                    <path d="M25 35H32L42 78H90L100 45H36" stroke="url(#cartOutlineGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="50" y1="46" x2="50" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
                    <line x1="66" y1="46" x2="66" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
                    <line x1="82" y1="46" x2="82" y2="76" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
                    <line x1="43" y1="56" x2="97" y2="56" stroke="#374151" stroke-width="3" stroke-linecap="round"/>
                    
                    <g transform="translate(54, 15)">
                      <rect x="0" y="0" width="22" height="11" rx="2.5" fill="url(#logoTagGrad)"/>
                      <path d="M11 2.5L12.5 5.5H15.5L13 7.5L14 10.5L11 8.5L8 10.5L9 7.5L6.5 5.5H9.5L11 2.5Z" fill="#1e3a8a"/>
                    </g>
                    
                    <rect x="62" y="38" width="6" height="8" rx="1" fill="#ef4444"/>
                  </svg>

                  <div class="text-[20px] font-extrabold text-[#e2e8f0] mb-2.5">Your cart is empty!</div>
                  <div class="text-[12px] text-gray-500 mb-8 max-w-xs mx-auto">Explore our curated fragrances and add selections to your shopping cart.</div>
                  <a href="/shop" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[rgba(40,201,244,0.08)] border border-[rgba(40,201,244,0.22)] text-[#28c9f4] text-[11px] font-extrabold tracking-[0.1em] uppercase no-underline hover:bg-[rgba(40,201,244,0.15)] hover:border-[rgba(40,201,244,0.45)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(40,201,244,0.2)] transition-all">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.78"/></svg>
                    Continue Shopping
                  </a>
                </div>
              `;
              }
            }
          }, 300);
          showToast('Item removed from cart', 'success');
        } else {
          showToast('Error removing item', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Something went wrong', 'error');
      }
    }

    /* ── SAVE FOR LATER ── */
    async function saveForLater(productId, variantId) {
      try {
        const response = await fetch(`/wishlist/add/${productId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();

        if (response.ok || data.success) {
          // Remove from cart once successfully added to wishlist
          await removeFromCart(productId, variantId);
          showToast('Item saved for later!', 'success');
        } else {
          showToast(data.message || 'Error saving item', 'error');
        }
      } catch (err) {
        console.error('Save for later error:', err);
        showToast('Something went wrong', 'error');
      }
    }
  </script>