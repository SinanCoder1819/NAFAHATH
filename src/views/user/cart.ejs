<!-- Main Cart Section -->
<section class="max-w-7xl mx-auto px-6 py-12 md:py-20 min-h-[70vh]">
    <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Your Cart</h1>
        <p class="text-xs text-gray-500 uppercase tracking-widest">Review your exquisite selections</p>
    </div>

    <% if (cart && cart.items.length > 0) { %>
        <div class="flex flex-col lg:flex-row gap-12">
            
            <!-- Cart Items List (Left Side) -->
            <div class="lg:w-2/3 space-y-8">
                <div class="hidden md:grid grid-cols-12 text-[10px] font-bold text-gray-500 uppercase tracking-widest pb-4 border-b border-[#333]">
                    <div class="col-span-6">Product</div>
                    <div class="col-span-2 text-center">Price</div>
                    <div class="col-span-2 text-center">Quantity</div>
                    <div class="col-span-2 text-right">Total</div>
                </div>

                <% let hasOutOfStock = false; %>
                <% cart.items.forEach(item => { %>
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center py-6 border-b border-[#222]" id="cart-item-<%= item.productId._id %>-<%= item.variantId %>">
                        
                        <div class="col-span-1 md:col-span-6 flex gap-6 items-center">
                            <a href="/productDetail/<%= item.productId._id %>" class="shrink-0 w-24 h-32 bg-transparent flex justify-center items-center">
                                <img src="<%= item.productId.primaryImage || 'https://placehold.co/400x500/111/444?text=Perfume' %>" onerror="this.onerror=null; this.src='https://placehold.co/400x500/111/444?text=Perfume';" alt="<%= item.productId.productName %>" class="h-full object-contain drop-shadow-[0_5px_15px_rgba(0,0,0,0.5)]">
                            </a>
                            <div>
                                <h3 class="text-sm font-semibold text-white mb-1 hover:text-[#00FFFF] transition-colors"><a href="/productDetail/<%= item.productId._id %>"><%= item.productId.productName %></a></h3>
                                <p class="text-xs text-gray-500 font-serif-italic mb-2"><%= item.productId.brand %></p>
                                <% 
                                    // Find variant string
                                    const variantObj = item.productId.variants.find(v => v._id.toString() === item.variantId.toString());
                                    const availableStock = variantObj ? variantObj.stock : 0;
                                    const isOutOfStock = item.quantity > availableStock;
                                    if (isOutOfStock) hasOutOfStock = true;
                                %>
                                <div class="flex flex-wrap gap-2 items-center mb-2">
                                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest bg-[#222] inline-block px-2 py-1 rounded-sm"><%= variantObj ? variantObj.size : 'Unknown' %></p>
                                    <% if (isOutOfStock) { %>
                                        <span class="text-[10px] font-bold text-red-500 uppercase tracking-widest bg-red-500/10 px-2 py-1 rounded-sm border border-red-500/20">
                                            <%= availableStock === 0 ? 'Out of Stock' : `Only ${availableStock} left` %>
                                        </span>
                                    <% } %>
                                </div>
                                
                                <div class="mt-3 md:hidden flex justify-between items-center w-full">
                                    <span class="text-sm font-bold text-white">₹<span class="item-price"><%= item.price %></span></span>
                                    <button onclick="removeFromCart('<%= item.productId._id %>', '<%= item.variantId %>')" class="text-xs text-gray-500 hover:text-red-500 uppercase font-bold tracking-widest transition-colors">Remove</button>
                                </div>
                            </div>
                        </div>

                        <!-- Unit Price (Desktop) -->
                        <div class="hidden md:block col-span-2 text-center">
                            <p class="text-sm font-semibold text-white">₹<span class="item-price"><%= item.price %></span></p>
                        </div>

                        <!-- Quantity Controls -->
                        <div class="col-span-1 md:col-span-2 flex justify-center">
                            <div class="flex items-center border border-[#333] rounded-sm w-fit">
                                <button onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'decrement')" class="px-3 py-1.5 text-gray-400 hover:text-white hover:bg-[#222] transition-colors">-</button>
                                <span class="px-4 py-1.5 text-sm font-bold text-white min-w-[40px] text-center quantity-display"><%= item.quantity %></span>
                                <button onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'increment')" class="px-3 py-1.5 text-gray-400 hover:text-white hover:bg-[#222] transition-colors">+</button>
                            </div>
                        </div>

                        <!-- Total Price & Remove (Desktop) -->
                        <div class="hidden md:flex col-span-2 flex-col items-end gap-2">
                            <p class="text-sm font-bold text-[#00FFFF]">₹<span class="item-total"><%= item.totalPrice %></span></p>
                            <button onclick="removeFromCart('<%= item.productId._id %>', '<%= item.variantId %>')" class="text-[10px] text-gray-500 hover:text-red-500 uppercase font-bold tracking-widest transition-colors">Remove</button>
                        </div>

                    </div>
                <% }) %>
            </div>

            <!-- Order Summary (Right Side) -->
            <div class="lg:w-1/3">
                <div class="bg-[#0a0a0a] border border-[#222] p-8 rounded-lg sticky top-24">
                    <h2 class="text-lg font-bold text-white mb-6 uppercase tracking-widest border-b border-[#222] pb-4">Order Summary</h2>
                    
                    <div class="space-y-4 text-sm mb-6 pb-6 border-b border-[#222]">
                        <div class="flex justify-between text-gray-300">
                            <span>Subtotal</span>
                            <span class="font-bold text-white">₹<span id="cartSubtotal"><%= cart.cartTotal %></span></span>
                        </div>
                        <div class="flex justify-between text-gray-300">
                            <span>Shipping</span>
                            <span class="text-gray-500">Calculated at checkout</span>
                        </div>
                        <div class="flex justify-between text-gray-300">
                            <span>Taxes</span>
                            <span class="text-gray-500">Included</span>
                        </div>
                    </div>

                    <div class="flex justify-between text-lg font-bold text-white mb-8">
                        <span>Total</span>
                        <span class="text-[#00FFFF]">₹<span id="cartTotal"><%= cart.cartTotal %></span></span>
                    </div>

                    <% if (hasOutOfStock) { %>
                        <button disabled class="block w-full bg-[#333] text-gray-500 text-center text-sm font-bold uppercase tracking-widest py-4 rounded-sm cursor-not-allowed">
                            Resolve Stock Issues
                        </button>
                    <% } else { %>
                        <a href="/checkout" class="block w-full bg-[#00FFFF] hover:bg-[#66FFFF] text-black text-center text-sm font-bold uppercase tracking-widest py-4 rounded-sm transition-all shadow-[0_0_15px_rgba(0,255,255,0.1)] hover:shadow-[0_0_20px_rgba(0,255,255,0.3)]">
                            Proceed to Checkout
                        </a>
                    <% } %>
                    
                    <div class="mt-6 flex justify-center items-center gap-2 text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                        <span class="text-[10px] uppercase tracking-widest">Secure Checkout</span>
                    </div>
                </div>
            </div>

        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-20 bg-[#0a0a0a] border border-[#222] rounded-lg max-w-3xl mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-[#333] mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <h2 class="text-2xl font-bold text-white mb-2">Your Cart is Empty</h2>
            <p class="text-gray-500 mb-8">Looks like you haven't added any luxury fragrances yet.</p>
            <a href="/shop" class="inline-block bg-[#333] hover:bg-[#00FFFF] text-white hover:text-black text-xs font-bold uppercase tracking-widest px-8 py-4 rounded-sm transition-colors">
                Continue Shopping
            </a>
        </div>
    <% } %>
</section>

<!-- Toast CSS built dynamically -->
<style>
#custom-toast { z-index: 1000; }
</style>

<script>
function showToast(message, type = 'success') {
    const existingToast = document.getElementById('custom-toast');
    if (existingToast) existingToast.remove();

    const toast = document.createElement('div');
    toast.id = 'custom-toast';
    toast.className = `fixed bottom-10 right-10 flex items-center gap-3 px-6 py-4 rounded shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50 ${type === 'success' ? 'bg-[#111] border border-[#00FFFF] text-white' : 'bg-[#111] border border-red-500 text-white'}`;
    
    const icon = type === 'success' 
        ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00FFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>`;
        
    toast.innerHTML = `${icon} <span class="text-sm font-semibold tracking-wide">${message}</span>`;
    document.body.appendChild(toast);
    
    setTimeout(() => toast.classList.remove('translate-y-20', 'opacity-0'), 10);
    setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

async function updateQuantity(productId, variantId, action) {
    try {
        const response = await fetch('/cart/update', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, variantId, action })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Update UI
            const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
            
            // Update quantity number
            const qtyElement = itemRow.querySelector('.quantity-display');
            let currentQty = parseInt(qtyElement.innerText);
            qtyElement.innerText = action === 'increment' ? currentQty + 1 : currentQty - 1;
            
            // Update item total
            const totalElements = itemRow.querySelectorAll('.item-total');
            totalElements.forEach(el => el.innerText = data.itemTotal);
            
            // Update cart subtotal & total
            document.getElementById('cartSubtotal').innerText = data.cartTotal;
            document.getElementById('cartTotal').innerText = data.cartTotal;
            
        } else {
            showToast(data.message, 'error');
        }
    } catch (error) {
        console.error("Error updating cart:", error);
        showToast("Error updating quantity", 'error');
    }
}

async function removeFromCart(productId, variantId) {
    try {
        const response = await fetch('/cart/remove', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, variantId })
        });
        
        const data = await response.json();
        
        if (data.success) {
            const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
            itemRow.style.opacity = '0';
            setTimeout(() => {
                itemRow.remove();
                
                // Update totals
                document.getElementById('cartSubtotal').innerText = data.cartTotal;
                document.getElementById('cartTotal').innerText = data.cartTotal;
                
                // Check if empty
                if(document.querySelectorAll('[id^="cart-item-"]').length === 0) {
                    window.location.reload();
                }
            }, 300);
            showToast("Item removed from cart");
        } else {
            showToast(data.message, 'error');
        }
    } catch (error) {
        console.error("Error removing item:", error);
        showToast("Error removing item", 'error');
    }
}
</script>
