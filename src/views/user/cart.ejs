<%- /* cart.ejs – Tailwind CSS version */ '' %>

<!-- Toast animation only -->
<style>
  .ct-toast { transform: translateY(20px); opacity: 0; transition: transform .3s, opacity .3s; }
  .ct-toast.show { transform: translateY(0); opacity: 1; }
</style>

<!-- PAGE WRAPPER -->
<div class="max-w-[1280px] mx-auto px-7 py-12 min-h-[70vh] text-[#c8cdd8] font-['Inter',sans-serif]">

  <!-- HEADER -->
  <div class="text-center mb-14">
    <!-- eyebrow -->
    <div class="inline-flex items-center gap-1.5 text-[10px] font-bold tracking-[0.16em] uppercase text-[#28c9f4] mb-3.5">
      <span class="w-7 h-px bg-gradient-to-r from-transparent to-[rgba(40,201,244,0.4)]"></span>
      Your Selections
      <span class="w-7 h-px bg-gradient-to-r from-[rgba(40,201,244,0.4)] to-transparent"></span>
    </div>
    <h1 class="text-[42px] font-extrabold tracking-tight bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent m-0 mb-2.5">Shopping Cart</h1>
    <p class="text-[12px] text-[#374151] tracking-[0.1em]">Review your curated fragrances before checkout</p>
  </div>

  <% if (cart && cart.items.length > 0) { %>

    <!-- LAYOUT -->
    <div id="cart-content-wrapper" class="flex gap-7 items-start flex-wrap lg:flex-nowrap">

      <!-- ── LEFT: ITEMS ── -->
      <div class="flex-1 min-w-0 w-full">

        <!-- Table Header (desktop) -->
        <div class="hidden sm:grid grid-cols-[1fr_100px_140px_110px] pb-3.5 border-b border-white/[0.06] mb-1">
          <div class="text-[10px] font-extrabold tracking-[0.14em] uppercase text-[#374151]">Product</div>
          <div class="text-[10px] font-extrabold tracking-[0.14em] uppercase text-[#374151] text-center">Unit Price</div>
          <div class="text-[10px] font-extrabold tracking-[0.14em] uppercase text-[#374151] text-center">Quantity</div>
          <div class="text-[10px] font-extrabold tracking-[0.14em] uppercase text-[#374151] text-right">Total</div>
        </div>

        <% let hasOutOfStock = false; %>
        <% cart.items.forEach(item => { %>
          <%
            const variantObj = item.productId.variants.find(v => v._id.toString() === item.variantId.toString());
            const availableStock = variantObj ? variantObj.stock : 0;
            const isBlocked = item.productId.isDeleted;
            const isOutOfStock = item.quantity > availableStock;
            if (isOutOfStock || isBlocked) hasOutOfStock = true;
          %>

          <!-- CART ROW -->
          <div class="grid grid-cols-[1fr] sm:grid-cols-[1fr_100px_140px_110px] items-center py-5 border-b border-white/[0.04] hover:bg-white/[0.01] transition-all duration-200"
               id="cart-item-<%= item.productId._id %>-<%= item.variantId %>">

            <!-- PRODUCT CELL -->
            <div class="flex items-center gap-4">
              <!-- Image box -->
              <a href="/productDetail/<%= item.productId._id %>"
                 class="w-20 h-24 sm:w-24 sm:h-28 shrink-0 rounded-md border border-white/10 overflow-hidden bg-[#0f1522] group block">
                <img src="<%= item.productId.primaryImage || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume' %>"
                     onerror="this.src='https://placehold.co/400x500/0a0e16/1e2533?text=Perfume'"
                     alt="<%= item.productId.productName %>"
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
              </a>

              <!-- Info -->
              <div>
                <a href="/productDetail/<%= item.productId._id %>"
                   class="text-sm font-bold text-[#e2e8f0] no-underline block mb-1 leading-snug hover:text-[#28c9f4] transition-colors duration-200">
                  <%= item.productId.productName %>
                </a>
                <div class="text-[11px] text-[#374151] mb-2.5"><%= item.productId.brand %></div>

                <!-- Badges -->
                <div class="flex flex-wrap gap-1.5 items-center">
                  <span class="text-[9px] font-extrabold tracking-[0.1em] uppercase text-[#64748b]
                               bg-white/[0.04] border border-white/[0.08] px-2 py-0.5 rounded-[5px]">
                    <%= variantObj ? variantObj.size : 'Unknown' %>
                  </span>
                  <% if (isBlocked) { %>
                    <span class="text-[9px] font-extrabold tracking-[0.08em] uppercase text-[#f87171]
                                 bg-[rgba(248,113,113,0.08)] border border-[rgba(248,113,113,0.2)] px-2 py-0.5 rounded-[5px]">
                      Unavailable
                    </span>
                  <% } else if (isOutOfStock) { %>
                    <span class="text-[9px] font-extrabold tracking-[0.08em] uppercase text-[#f87171]
                                 bg-[rgba(248,113,113,0.08)] border border-[rgba(248,113,113,0.2)] px-2 py-0.5 rounded-[5px]">
                      <%= availableStock === 0 ? 'Out of Stock' : `Only ${availableStock} left` %>
                    </span>
                  <% } %>
                </div>

                <!-- Mobile: price + remove (hidden on desktop) -->
                <div class="sm:hidden mt-2 flex flex-col gap-1.5">
                  <span class="text-sm font-bold text-[#e2e8f0]">₹<span class="item-price"><%= item.price %></span></span>
                  <button onclick="removeFromCart('<%= item.productId._id %>', '<%= item.variantId %>')"
                          class="text-[9px] font-extrabold tracking-widest uppercase text-[#374151] hover:text-red-400 transition-colors cursor-pointer bg-transparent border-none flex items-center gap-1 mt-1.5">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Remove
                  </button>
                </div>
              </div>
            </div>

            <!-- UNIT PRICE -->
            <div class="hidden sm:block text-center">
              <span class="text-sm font-semibold text-[#94a3b8]">₹<span class="item-price"><%= item.price %></span></span>
            </div>

            <!-- QUANTITY -->
            <div class="hidden sm:flex justify-center">
              <div class="flex items-center bg-white/[0.03] border border-white/[0.08] rounded-xl overflow-hidden">
                <button class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-[#28c9f4] hover:bg-[#28c9f4]/[0.08] transition-all bg-transparent border-none cursor-pointer text-[17px] font-light"
                        onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'decrement')">−</button>
                <span class="quantity-display min-w-[36px] text-center text-sm font-bold text-[#e2e8f0]
                             border-l border-r border-white/[0.06] px-1 leading-8">
                  <%= item.quantity %>
                </span>
                <button class="w-8 h-8 flex items-center justify-content-center text-gray-500 hover:text-[#28c9f4] hover:bg-[#28c9f4]/[0.08] transition-all bg-transparent border-none cursor-pointer text-[17px] font-light"
                        onclick="updateQuantity('<%= item.productId._id %>', '<%= item.variantId %>', 'increment')">+</button>
              </div>
            </div>

            <!-- TOTAL + REMOVE -->
            <div class="hidden sm:flex flex-col items-end gap-2">
              <span class="text-[15px] font-extrabold text-[#28c9f4]">₹<span class="item-total"><%= item.totalPrice %></span></span>
              <button onclick="removeFromCart('<%= item.productId._id %>', '<%= item.variantId %>')"
                      class="text-[9px] font-extrabold tracking-widest uppercase text-[#374151] hover:text-red-400 transition-colors cursor-pointer bg-transparent border-none flex items-center gap-1">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Remove
              </button>
            </div>

          </div>
        <% }) %>
      </div><!-- /items col -->

      <!-- ── RIGHT: SUMMARY ── -->
      <div class="w-full lg:w-[340px] shrink-0">
        <div class="bg-[#0a0e16]/75 backdrop-blur-xl border border-white/[0.07] rounded-[20px] p-7 sticky top-24
                    shadow-[0_8px_32px_rgba(0,0,0,0.4)]">

          <!-- Summary title -->
          <div class="text-[11px] font-extrabold tracking-[0.16em] uppercase text-[#e2e8f0]
                      mb-5 pb-4 border-b border-white/[0.06] flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#28c9f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
              <rect x="9" y="3" width="6" height="4" rx="1"/>
            </svg>
            Order Summary
          </div>

          <!-- Summary rows -->
          <div class="mb-5 pb-5 border-b border-white/[0.06]">
            <div class="flex justify-between items-center text-[13px] mb-3">
              <span class="text-[#64748b]">Subtotal (<%= cart.items.length %> item<%= cart.items.length !== 1 ? 's' : '' %>)</span>
              <span class="text-[#e2e8f0] font-semibold">₹<span id="cartSubtotal"><%= cart.cartTotal %></span></span>
            </div>
            <div class="flex justify-between items-center text-[13px] mb-3">
              <span class="text-[#64748b]">Shipping</span>
              <span class="text-[#374151] font-normal text-xs">Calculated at checkout</span>
            </div>
            <div class="flex justify-between items-center text-[13px]">
              <span class="text-[#64748b]">Taxes</span>
              <span class="text-[#374151] font-normal text-xs">Included</span>
            </div>
          </div>

          <!-- Total row -->
          <div class="flex justify-between items-baseline mb-6">
            <span class="text-sm font-extrabold text-[#e2e8f0] tracking-[0.04em]">Total</span>
            <span class="text-[26px] font-extrabold text-[#28c9f4] tracking-tight">₹<span id="cartTotal"><%= cart.cartTotal %></span></span>
          </div>

          <!-- Checkout button -->
          <% if (hasOutOfStock) { %>
            <button disabled
                    class="block w-full py-4 rounded-xl bg-white/[0.05] text-[#374151] border border-white/[0.08]
                           text-xs font-extrabold tracking-widest uppercase text-center cursor-not-allowed">
              Resolve Stock Issues First
            </button>
          <% } else { %>
            <a href="/checkout"
               class="block w-full py-4 rounded-xl bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9]
                      text-[#03111a] text-xs font-extrabold tracking-widest uppercase text-center
                      hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(40,201,244,0.4)] transition-all no-underline
                      shadow-[0_4px_20px_rgba(40,201,244,0.25)]">
              Proceed to Checkout
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline;margin-left:6px;"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          <% } %>

          <!-- Secure badge -->
          <div class="flex items-center justify-center gap-1.5 mt-3.5 text-[10px] font-semibold tracking-[0.1em] uppercase text-[#2d3748]">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Secured by SSL Encryption
          </div>

        </div>
      </div><!-- /summary col -->

    </div><!-- /layout -->

  <% } else { %>

    <!-- EMPTY STATE -->
    <div class="flex flex-col items-center py-20 px-10 bg-[#0a0e16]/60 border border-white/[0.06] rounded-3xl max-w-lg mx-auto text-center">

      <!-- Icon box -->
      <div class="w-20 h-20 rounded-[20px] bg-[rgba(40,201,244,0.06)] border border-[rgba(40,201,244,0.12)]
                  flex items-center justify-center text-[#28c9f4] mb-6">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>

      <div class="text-[22px] font-extrabold text-[#e2e8f0] mb-2">Your Cart is Empty</div>
      <div class="text-[13px] text-[#374151] mb-7">
        You haven't added any luxury fragrances yet.<br>Explore our curated collection.
      </div>

      <a href="/shop"
         class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl
                bg-[rgba(40,201,244,0.08)] border border-[rgba(40,201,244,0.22)]
                text-[#28c9f4] text-[11px] font-extrabold tracking-[0.1em] uppercase no-underline
                hover:bg-[rgba(40,201,244,0.15)] hover:border-[rgba(40,201,244,0.45)]
                hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(40,201,244,0.2)] transition-all">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.78"/></svg>
        Continue Shopping
      </a>

    </div>

  <% } %>
</div><!-- /page wrapper -->

<script>

/* ── UPDATE QUANTITY ── */
async function updateQuantity(productId, variantId, action) {
  try {
    const response = await fetch('/cart/update', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, variantId, action })
    });
    const data = await response.json();

    if (data.success) {
      const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
      const qtyEl   = itemRow.querySelector('.quantity-display');
      qtyEl.innerText = action === 'increment'
        ? parseInt(qtyEl.innerText) + 1
        : parseInt(qtyEl.innerText) - 1;

      itemRow.querySelectorAll('.item-total').forEach(el => el.innerText = data.itemTotal);
      document.getElementById('cartSubtotal').innerText = data.cartTotal;
      document.getElementById('cartTotal').innerText = data.cartTotal;
    } else {
      showToast(data.message, 'error');
    }
  } catch (err) {
    console.error(err);
    showToast('Error updating quantity', 'error');
  }
}

/* ── REMOVE FROM CART ── */
async function removeFromCart(productId, variantId) {
  try {
    const response = await fetch('/cart/remove', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, variantId })
    });
    const data = await response.json();

    if (data.success) {
      const itemRow = document.getElementById(`cart-item-${productId}-${variantId}`);
      itemRow.style.opacity = '0';
      setTimeout(() => {
        itemRow.remove();
        
        // ADD THIS CODE TO DECREASE THE NAVBAR BADGE:
        const badge = document.getElementById('navCartBadge');
        if (badge) {
          let current = parseInt(badge.textContent) || 0;
          if (current > 0) {
            current -= 1; // Decrease cart count
            badge.textContent = current;
          }
          if (current === 0) {
            badge.classList.add('hidden'); // Hide the badge if cart is empty
          }
        }
        
        // Update cart totals on the page
        if (document.getElementById('cartSubtotal')) {
            document.getElementById('cartSubtotal').innerText = data.cartTotal;
        }
        if (document.getElementById('cartTotal')) {
            document.getElementById('cartTotal').innerText = data.cartTotal;
        }
                if (document.querySelectorAll('[id^="cart-item-"]').length === 0) {
          const wrapper = document.getElementById('cart-content-wrapper');
          if (wrapper) {
             wrapper.innerHTML = `
                <div class="flex flex-col items-center w-full py-20 px-10 bg-[#0a0e16]/60 border border-white/[0.06] rounded-3xl max-w-lg mx-auto text-center" style="animation: fadeIn 0.4s ease">
                  <div class="w-20 h-20 rounded-[20px] bg-[rgba(40,201,244,0.06)] border border-[rgba(40,201,244,0.12)] flex items-center justify-center text-[#28c9f4] mb-6">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                      <line x1="3" y1="6" x2="21" y2="6"/>
                      <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                  </div>
                  <div class="text-[22px] font-extrabold text-[#e2e8f0] mb-2">Your Cart is Empty</div>
                  <div class="text-[13px] text-[#374151] mb-7">You haven't added any luxury fragrances yet.<br>Explore our curated collection.</div>
                  <a href="/shop" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[rgba(40,201,244,0.08)] border border-[rgba(40,201,244,0.22)] text-[#28c9f4] text-[11px] font-extrabold tracking-[0.1em] uppercase no-underline hover:bg-[rgba(40,201,244,0.15)] hover:border-[rgba(40,201,244,0.45)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(40,201,244,0.2)] transition-all">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.78"/></svg>
                    Continue Shopping
                  </a>
                </div>
             `;
          }
        }
      }, 300);
      showToast('Item removed from cart', 'success');
    } else {
      showToast('Error removing item', 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    showToast('Something went wrong', 'error');
  }
}
</script>
