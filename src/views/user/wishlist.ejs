<!-- Main Wishlist Section -->
<section class="max-w-7xl mx-auto px-6 py-12 md:py-20 min-h-[60vh] flex flex-col justify-center">
    
    <!-- Title Area -->
    <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">Your Wishlist</h1>
        <p class="text-xs text-gray-500 uppercase tracking-widest">Time To Fulfill Your Wishes</p>
    </div>

    <% if (wishlist && wishlist.length > 0) { %>
        <!-- Wishlist Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
            <% wishlist.forEach(product => { %>
                <div class="group block text-left" id="wishlist-item-<%= product._id %>">
                    <a href="/productDetail/<%= product._id %>" class="block aspect-[4/5] flex justify-center items-center mb-6 overflow-hidden bg-transparent">
                        <img src="<%= product.primaryImage || 'https://placehold.co/400x500/111/444?text=Perfume' %>" onerror="this.onerror=null; this.src='https://placehold.co/400x500/111/444?text=Perfume';" alt="<%= product.productName %>" class="h-4/5 object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]">
                    </a>
                    
                    <!-- Details -->
                    <h3 class="text-sm font-semibold text-white mb-1"><%= product.productName %></h3>
                    <p class="text-xs text-gray-500 font-serif-italic mb-3"><%= product.brand %></p>
                    <p class="text-xs font-bold text-white uppercase tracking-widest mb-6">
                        <%= product.category %> 
                        <span class="ml-2 font-semibold">
                            <% if (product.variants && product.variants.length > 0) { %>
                                ₹<%= product.variants[0].salePrice > 0 ? product.variants[0].salePrice : product.variants[0].regularPrice %>
                            <% } else { %>
                                ₹0
                            <% } %>
                        </span>
                    </p>

                    <!-- Divider -->
                    <hr class="border-[#222] mb-6">

                    <!-- Actions -->
                    <div class="flex items-center gap-4">
                        <form action="/cart/add" method="POST" class="flex-1">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <% if (product.variants && product.variants.length > 0) { %>
                                <input type="hidden" name="variantId" value="<%= product.variants[0]._id %>">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="w-full bg-[#00FFFF] hover:bg-[#66FFFF] text-black text-xs font-bold uppercase tracking-widest py-3 rounded-sm transition-all shadow-[0_0_15px_rgba(0,255,255,0.1)] hover:shadow-[0_0_20px_rgba(0,255,255,0.3)]">
                                    Add To Cart
                                </button>
                            <% } else { %>
                                <button type="button" disabled class="w-full bg-[#333] text-gray-500 text-xs font-bold uppercase tracking-widest py-3 rounded-sm cursor-not-allowed">
                                    Unavailable
                                </button>
                            <% } %>
                        </form>
                        
                        <button onclick="removeFromWishlist('<%= product._id %>')" class="flex-1 text-xs font-bold text-gray-400 hover:text-red-500 uppercase tracking-widest transition-colors py-3">
                            Remove
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-20 bg-[#111] border border-[#222] rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-[#333] mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <h2 class="text-2xl font-bold text-white mb-2">Your Wishlist is Empty</h2>
            <p class="text-gray-500 mb-8">You haven't saved any items to your wishlist yet.</p>
        </div>
    <% } %>

    <!-- Bottom Section -->
    <div class="mt-32 text-center border-t border-[#1a1a1a] pt-16">
        <p class="text-xs text-gray-500 mb-6">Looking for more?</p>
        <a href="/shop" class="text-xs font-bold text-white uppercase tracking-widest hover:text-[#00FFFF] transition-colors flex justify-center items-center gap-2">
            Browse All Collections
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
    </div>

</section>

<script>
async function removeFromWishlist(productId) {
    
    try {
        const response = await fetch(`/wishlist/remove/${productId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Remove the card from the DOM with a smooth animation
            const item = document.getElementById(`wishlist-item-${productId}`);
            item.style.opacity = '0';
            setTimeout(() => {
                item.remove();
                // Optionally reload if it was the last item to show the empty state
                if(document.querySelectorAll('[id^="wishlist-item-"]').length === 0) {
                    window.location.reload();
                }
            }, 300);
        } else {
            alert(data.message || "Failed to remove item");
        }
    } catch (error) {
        console.error("Error:", error);
        alert("Something went wrong");
    }
}
</script>
