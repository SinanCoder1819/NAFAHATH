<style>
@keyframes wlPulse {
  0%,100% { transform: scale(1); }
  50%      { transform: scale(1.3); }
}
@keyframes wlHeart {
  0%,100% { transform: scale(1); }
  50%      { transform: scale(1.15); }
}
.wl-heart-badge { animation: wlHeart 3s ease-in-out infinite; }
.wl-header-eyebrow-icon { animation: wlPulse 2.5s ease-in-out infinite; }

/* Card image hover effects */
.wl-card:hover .wl-name-el { color: #28c9f4; }
.wl-name-el {
  font-size: 15px; font-weight: 700; color: #e2e8f0;
  margin-bottom: 4px; line-height: 1.3; transition: color .2s;
}
.wl-add-btn-disabled {
  flex: 1; width: 100%; padding: 11px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.05); color: #374151;
  font-size: 10.5px; font-weight: 800; letter-spacing: 0.1em;
  text-transform: uppercase; cursor: not-allowed;
}
/* Toast */
.wl-toast {
  position: fixed; bottom: 32px; right: 32px; z-index: 9999;
  display: flex; align-items: center; gap: 12px;
  padding: 14px 20px; border-radius: 14px;
  background: rgba(8,12,20,0.95); backdrop-filter: blur(14px);
  font-family: 'Inter', sans-serif;
  font-size: 13px; font-weight: 600; color: #e2e8f0;
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
  transform: translateY(20px); opacity: 0;
  transition: transform .3s, opacity .3s;
}
.wl-toast.show { transform: translateY(0); opacity: 1; }
.wl-toast.success { border: 1px solid rgba(40,201,244,0.3); }
.wl-toast.error   { border: 1px solid rgba(248,113,113,0.3); }
</style>

<div class="max-w-[1280px] mx-auto px-7 py-12 text-[#c8cdd8] font-[Inter,sans-serif]">

  <!-- HEADER -->
  <div class="text-center mb-16">
    <div class="inline-flex items-center gap-2 text-[10px] font-bold tracking-[0.16em] uppercase text-[#28c9f4] mb-3.5
                before:content-[''] before:h-px before:w-8 before:bg-gradient-to-r before:from-transparent before:to-[rgba(40,201,244,0.45)]
                after:content-[''] after:h-px after:w-8 after:bg-gradient-to-r after:from-[rgba(40,201,244,0.45)] after:to-transparent">
      <span class="wl-header-eyebrow-icon text-[#28c9f4]">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      </span>
      Your Wishlist
    </div>
    <h1 class="text-[44px] font-extrabold tracking-tight bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent m-0 mb-2.5">Saved Fragrances</h1>
    <p class="text-[12px] text-[#374151] tracking-[0.1em]">Items you've loved — ready to be yours</p>
    <% if (wishlist && wishlist.length > 0) { %>
      <div class="wl-count inline-flex items-center gap-1.5 mt-3.5 text-[11px] font-bold tracking-[0.08em]
                  text-[#28c9f4] bg-[rgba(40,201,244,0.07)] border border-[rgba(40,201,244,0.18)] rounded-[20px] px-3 py-1">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <%= wishlist.length %> item<%= wishlist.length !== 1 ? 's' : '' %> saved
      </div>
    <% } %>
  </div>

  <% if (wishlist && wishlist.length > 0) { %>

    <!-- HORIZONTAL LIST -->
    <div class="flex flex-col gap-5">
      <% wishlist.forEach(product => { %>
        <%
          let displayPrice = 0, wasPrice = 0;
          let availableVariant = null;
          if (product.variants && product.variants.length > 0) {
            const v = product.variants[0];
            displayPrice = v.salePrice > 0 ? v.salePrice : v.regularPrice;
            if (v.salePrice > 0) wasPrice = v.regularPrice;
            availableVariant = product.variants.find(va => va.stock > 0);
          }
        %>
        <div class="wl-card relative bg-[#0a0e16]/60 border border-white/[0.06] rounded-xl overflow-hidden flex flex-row items-center p-4 sm:p-5
                    hover:-translate-y-1 hover:border-[#28c9f4]/30 hover:shadow-[0_12px_40px_rgba(0,0,0,0.4)]
                    transition-all duration-300 group"
             id="wishlist-item-<%= product._id %>">

          <!-- Left Image -->
          <a href="/productDetail/<%= product._id %>"
             class="w-24 h-32 sm:w-28 sm:h-36 shrink-0 rounded-lg overflow-hidden bg-[#0f1522] mr-5 sm:mr-7 relative">
            <img src="<%= product.primaryImage || 'https://placehold.co/400x500/0a0e16/1e2533?text=Perfume' %>"
                 onerror="this.src='https://placehold.co/400x500/0a0e16/1e2533?text=Perfume'"
                 alt="<%= product.productName %>"
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          </a>

          <!-- Middle Info -->
          <div class="flex-1 flex flex-col justify-center min-w-0">
            <div class="text-[11px] sm:text-[12px] font-bold tracking-wide uppercase mb-1.5 <%= availableVariant ? 'text-[#4ade80]' : 'text-red-500' %>">
              <%= availableVariant ? 'In Stock' : 'Out of Stock' %>
            </div>
            
            <a href="/productDetail/<%= product._id %>" class="text-[16px] sm:text-[18px] text-[#e2e8f0] font-bold mb-1 hover:text-[#28c9f4] transition-colors truncate block">
              <%= product.productName %>
            </a>
            
            <div class="text-[12px] sm:text-[13px] text-[#64748b] mb-3"><%= product.brand %></div>

            <div class="flex items-end gap-3 flex-wrap">
              <span class="text-[18px] sm:text-[22px] font-extrabold text-[#e2e8f0]">₹<%= displayPrice.toLocaleString('en-IN') %></span>
              <% if (wasPrice > displayPrice) { %>
                <span class="text-[13px] sm:text-[14px] font-semibold text-[#64748b] line-through mb-[3px] sm:mb-[4px]">₹<%= wasPrice.toLocaleString('en-IN') %></span>
                <span class="text-[13px] sm:text-[14px] font-bold text-[#4ade80] mb-[3px] sm:mb-[4px]">
                  <%= Math.round(((wasPrice - displayPrice)/wasPrice)*100) %>% off
                </span>
              <% } %>
            </div>
          </div>

          <!-- Right Actions -->
          <div class="flex flex-col justify-between items-end self-stretch py-1 pl-4 border-l border-white/5 ml-4 sm:ml-6 min-w-[120px] sm:min-w-[150px]">
            <button class="text-[#64748b] hover:text-red-500 transition-colors p-2 -mr-2 bg-transparent border-none cursor-pointer" onclick="removeFromWishlist('<%= product._id %>')" title="Remove from wishlist">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
              </svg>
            </button>

            <div class="mt-auto pt-4 w-full">
              <% if (availableVariant) { %>
                <button onclick="addWishlistItemToCart('<%= product._id %>', '<%= availableVariant._id %>')" 
                        class="w-full px-2 sm:px-4 py-2.5 rounded-lg bg-gradient-to-r from-[#28c9f4] to-[#0ea5e9] text-[#03111a] text-[10px] sm:text-[11px] font-extrabold tracking-widest uppercase hover:-translate-y-px hover:shadow-[0_6px_22px_rgba(40,201,244,0.38)] transition-all cursor-pointer border-none text-center">
                  Add to Cart
                </button>
              <% } else { %>
                <a href="/shop" class="block w-full px-2 sm:px-4 py-2.5 rounded-lg border border-[#28c9f4]/40 bg-[#28c9f4]/5 text-[#28c9f4] text-[10px] sm:text-[11px] font-extrabold tracking-widest uppercase hover:bg-[#28c9f4]/15 transition-all text-center no-underline">
                  Explore Similar
                </a>
              <% } %>
            </div>
          </div>

        </div>
      <% }) %>
    </div>

    <!-- BROWSE LINK -->
    <div class="mt-20 text-center pt-10 border-t border-white/5">
      <p class="text-[11px] text-[#2d3748] mb-3.5 tracking-[0.08em]">Looking for more?</p>
      <a href="/shop"
         class="inline-flex items-center gap-2 text-[11px] font-extrabold tracking-[0.14em] uppercase
                text-[#e2e8f0] no-underline px-6 py-3 border border-white/[0.08] rounded-[10px]
                bg-white/[0.02] transition-all duration-[250ms]
                hover:text-[#28c9f4] hover:border-[rgba(40,201,244,0.35)] hover:bg-[rgba(40,201,244,0.06)]
                hover:shadow-[0_4px_18px_rgba(40,201,244,0.12)]">
        Browse All Collections
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

  <% } else { %>

    <!-- EMPTY STATE -->
    <div class="flex flex-col items-center py-20 px-10 bg-[#0a0e16]/60 border border-white/[0.06] rounded-3xl max-w-[540px] mx-auto mb-16 text-center">
      <div class="w-20 h-20 rounded-[20px] bg-red-500/[0.06] border border-red-500/[0.15]
                  flex items-center justify-center text-red-400 mb-6">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <div class="text-[22px] font-extrabold text-[#e2e8f0] mb-2">Your Wishlist is Empty</div>
      <div class="text-[13px] text-[#374151] mb-7 leading-relaxed">You haven't saved any fragrances yet.<br>Browse our collection and heart the ones you love.</div>
      <a href="/shop"
         class="inline-flex items-center gap-2 py-3.5 px-7 rounded-xl
                bg-[rgba(40,201,244,0.08)] border border-[rgba(40,201,244,0.22)]
                text-[#28c9f4] text-[11px] font-extrabold tracking-[0.1em] uppercase no-underline
                transition-all duration-[250ms]
                hover:bg-[rgba(40,201,244,0.16)] hover:border-[rgba(40,201,244,0.5)]
                hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(40,201,244,0.2)]">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.78"/></svg>
        Explore Collection
      </a>
    </div>

    <!-- BROWSE LINK -->
    <div class="mt-20 text-center pt-10 border-t border-white/5">
      <p class="text-[11px] text-[#2d3748] mb-3.5 tracking-[0.08em]">Looking for more?</p>
      <a href="/shop"
         class="inline-flex items-center gap-2 text-[11px] font-extrabold tracking-[0.14em] uppercase
                text-[#e2e8f0] no-underline px-6 py-3 border border-white/[0.08] rounded-[10px]
                bg-white/[0.02] transition-all duration-[250ms]
                hover:text-[#28c9f4] hover:border-[rgba(40,201,244,0.35)] hover:bg-[rgba(40,201,244,0.06)]
                hover:shadow-[0_4px_18px_rgba(40,201,244,0.12)]">
        Browse All Collections
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

  <% } %>
</div>

<script>
/* ── TOAST ── */
function wlToast(message, type = 'success') {
  const old = document.getElementById('wl-toast-el');
  if (old) old.remove();
  const t = document.createElement('div');
  t.id = 'wl-toast-el';
  t.className = `wl-toast ${type}`;
  const icon = type === 'success'
    ? `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#28c9f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
    : `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
  t.innerHTML = `${icon}<span>${message}</span>`;
  document.body.appendChild(t);
  setTimeout(() => t.classList.add('show'), 10);
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 350); }, 3200);
}

/* ── REMOVE FROM WISHLIST ── */
async function removeFromWishlist(productId) {
  try {
    const response = await fetch(`/wishlist/remove/${productId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await response.json();

    if (data.success) {
      const item = document.getElementById(`wishlist-item-${productId}`);
      item.style.transition = 'opacity .35s, transform .35s';
      item.style.opacity  = '0';
      item.style.transform = 'scale(0.92)';
      
      setTimeout(() => {
        item.remove();
        
        // Update count badge on page
        const remaining = document.querySelectorAll('[id^="wishlist-item-"]').length;
        const countEl = document.querySelector('.wl-count');
        if (countEl) countEl.textContent = `♥ ${remaining} item${remaining !== 1 ? 's' : ''} saved`;
        // ADD THIS CODE TO DECREASE THE NAVBAR BADGE:
        const badge = document.getElementById('navWishlistBadge');
        if (badge) {
          let current = parseInt(badge.textContent) || 0;
          if (current > 0) {
            current -= 1; // Decrease wishlist count
            badge.textContent = current;
          }
          if (current === 0) badge.classList.add('hidden'); // Hide if empty
        }
        if (remaining === 0) window.location.reload();
      }, 380);
      
      wlToast('Removed from wishlist');
    } else {
      wlToast(data.message || 'Failed to remove item', 'error');
    }
  } catch (err) {
    console.error(err);
    wlToast('Something went wrong', 'error');
  }
}

/* ── ADD ITEM TO CART FROM WISHLIST ── */
async function addWishlistItemToCart(productId, variantId) {
  try {
    const res = await fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, variantId, quantity: 1 })
    });
    const data = await res.json();
    
    if (data.success) {
      wlToast('Added to cart!', 'success');
      
      // 1. UPDATE NAVBAR CART BADGE
      const cartBadge = document.getElementById('navCartBadge');
      if (cartBadge) {
        let currentCart = parseInt(cartBadge.textContent) || 0;
        currentCart += 1;
        cartBadge.textContent = currentCart > 99 ? '99+' : currentCart;
        cartBadge.classList.remove('hidden');
      }

      // 2. REMOVE ITEM FROM WISHLIST UI
      const item = document.getElementById(`wishlist-item-${productId}`);
      if (item) {
        item.style.transition = 'opacity .35s, transform .35s';
        item.style.opacity = '0';
        item.style.transform = 'scale(0.92)';
        
        setTimeout(() => {
          item.remove();
          
          // Update the "X items saved" text
          const remaining = document.querySelectorAll('[id^="wishlist-item-"]').length;
          const countEl = document.querySelector('.wl-count');
          if (countEl) countEl.textContent = `♥ ${remaining} item${remaining !== 1 ? 's' : ''} saved`;
          
          // Decrease the Navbar Wishlist Badge
          const wlBadge = document.getElementById('navWishlistBadge');
          if (wlBadge) {
            let wlCurrent = parseInt(wlBadge.textContent) || 0;
            if (wlCurrent > 0) wlCurrent -= 1;
            wlBadge.textContent = wlCurrent;
            if (wlCurrent === 0) wlBadge.classList.add('hidden');
          }
          
          // Reload if wishlist is empty to show empty state
          if (remaining === 0) window.location.reload();
        }, 380);
      }
    } else {
      wlToast(data.message || 'Failed to add to cart.', 'error');
    }
  } catch (e) {
    console.error(e);
    wlToast('Something went wrong', 'error');
  }
}
</script>