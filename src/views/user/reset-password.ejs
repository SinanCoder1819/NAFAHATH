<main class="min-h-screen bg-[#0a0a0a] flex items-center justify-center p-6 relative overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/10 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/5 blur-[120px] rounded-full"></div>

    <div class="w-full max-w-md bg-[#0f0f0f]/80 backdrop-blur-xl border border-gray-800 rounded-[2.5rem] p-10 md:p-12 relative z-10 shadow-2xl">

        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-white mb-3">Set New Password</h2>
            <p class="text-gray-400 text-sm leading-relaxed">Choose a strong password for your account.</p>
        </div>

        <div id="responseMessage" class="hidden mb-6 p-3 rounded-xl text-xs font-medium text-center border"></div>

        <form id="resetForm" class="space-y-6">

            <div>
                <label class="block text-[10px] font-medium text-gray-500 mb-2 ml-1 uppercase tracking-widest">New Password</label>
                <div class="relative">
                    <input type="password" name="password" id="password" placeholder="Enter your new password"
                        class="w-full bg-black/40 border border-gray-700 rounded-2xl px-5 py-4 outline-none focus:border-[#00FFFF] focus:ring-1 focus:ring-[#00FFFF]/30 transition-all text-sm text-white placeholder:text-gray-600 pr-12">
                    <button type="button" onclick="togglePassword('password', 'eye1')"
                        class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition">
                        <svg id="eye1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </button>
                </div>
                <p id="passwordError" class="hidden text-red-400 text-[11px] mt-1.5 ml-1"></p>
            </div>

            <div>
                <label class="block text-[10px] font-medium text-gray-500 mb-2 ml-1 uppercase tracking-widest">Confirm New Password</label>
                <div class="relative">
                    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm your new password"
                        class="w-full bg-black/40 border border-gray-700 rounded-2xl px-5 py-4 outline-none focus:border-[#00FFFF] focus:ring-1 focus:ring-[#00FFFF]/30 transition-all text-sm text-white placeholder:text-gray-600 pr-12">
                    <button type="button" onclick="togglePassword('confirmPassword', 'eye2')"
                        class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition">
                        <svg id="eye2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </button>
                </div>
                <p id="confirmError" class="hidden text-red-400 text-[11px] mt-1.5 ml-1"></p>
            </div>

            <div class="pt-2">
                <button type="submit" id="saveBtn"
                    class="w-full bg-[#00FFFF] text-black py-4 rounded-2xl font-bold uppercase tracking-widest text-sm hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_25px_rgba(0,255,255,0.25)] disabled:opacity-60 disabled:cursor-not-allowed">
                    Save
                </button>
            </div>
        </form>
    </div>
</main>

<script>
    const saveBtn = document.getElementById('saveBtn');
    const msgDiv = document.getElementById('responseMessage');
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const passwordError = document.getElementById('passwordError');
    const confirmError = document.getElementById('confirmError');

    function togglePassword(id, eyeId) {
        const input = document.getElementById(id);
        const eye = document.getElementById(eyeId);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        eye.innerHTML = isHidden
            ? `<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />`
            : `<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`;
    }

    function showFieldError(el, msg) {
        el.textContent = msg;
        el.classList.remove('hidden');
    }
    function clearFieldError(el) {
        el.textContent = '';
        el.classList.add('hidden');
    }
    function showMessage(text, type) {
        msgDiv.textContent = text;
        msgDiv.className = 'mb-6 p-3 rounded-xl text-xs font-medium text-center border block';
        if (type === 'error') {
            msgDiv.classList.add('bg-red-900/50', 'text-red-200', 'border-red-800');
        } else {
            msgDiv.classList.add('bg-green-900/50', 'text-green-200', 'border-green-800');
        }
    }

    passwordInput.addEventListener('input', () => clearFieldError(passwordError));
    confirmInput.addEventListener('input', () => clearFieldError(confirmError));

    document.getElementById('resetForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearFieldError(passwordError);
        clearFieldError(confirmError);

        const password = passwordInput.value;
        const confirmPassword = confirmInput.value;
        let valid = true;

        if (!password) {
            showFieldError(passwordError, 'Password is required.');
            valid = false;
        } else if (password.length < 8) {
            showFieldError(passwordError, 'Password must be at least 8 characters.');
            valid = false;
        } else if (!/[A-Z]/.test(password)) {
            showFieldError(passwordError, 'Password must contain at least one uppercase letter.');
            valid = false;
        } else if (!/[a-z]/.test(password)) {
            showFieldError(passwordError, 'Password must contain at least one lowercase letter.');
            valid = false;
        } else if (!/[0-9]/.test(password)) {
            showFieldError(passwordError, 'Password must contain at least one number.');
            valid = false;
        } else if (!/[!@#$%^&*(),.?":{}|<>]/.test(password)) {
            showFieldError(passwordError, 'Password must contain at least one special character (e.g. !@#$%^&*).');
            valid = false;
        }

        if (!confirmPassword) {
            showFieldError(confirmError, 'Please confirm your password.');
            valid = false;
        } else if (password !== confirmPassword) {
            showFieldError(confirmError, 'Passwords do not match.');
            valid = false;
        }

        if (!valid) return;

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        try {
            const response = await fetch('/auth/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password, confirmPassword })
            });

            const data = await response.json();

            if (response.ok) {
                showMessage('Password reset successfully! Redirecting to login...', 'success');
                setTimeout(() => {
                    window.location.href = '/auth/login';
                }, 1500);
            } else {
                showMessage(data.message || 'Something went wrong.', 'error');
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save';
            }
        } catch (err) {
            showMessage('Network error. Please try again.', 'error');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save';
        }
    });
</script>
