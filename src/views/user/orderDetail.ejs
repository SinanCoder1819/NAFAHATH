<!-- Cancel Item Modal -->
<div id="cancelItemModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 hidden backdrop-blur-sm">
    <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 max-w-md w-full shadow-2xl relative text-white">
        <h3 class="text-xl font-serif italic mb-2">Cancel Specific Fragrance Item</h3>
        <input type="hidden" id="cancelTargetItemId" value="">
        <div class="mb-6">
            <label class="block text-[10px] uppercase tracking-wider text-gray-500 font-bold mb-2">Reason</label>
            <textarea id="cancelItemReasonInput" placeholder="Reason..." class="w-full bg-[#161616] border border-gray-800 text-slate-100 text-sm rounded-xl p-4 h-24 resize-none"></textarea>
        </div>
        <div class="flex items-center justify-end gap-3">
            <button onclick="closeCancelItemModal()" class="px-5 py-3 rounded-xl border border-gray-800 text-xs font-bold text-gray-400">Discard</button>
            <button id="cancelItemSubmitBtn" onclick="submitCancelItem()" class="px-5 py-3 rounded-xl bg-red-600 text-white text-xs font-bold">Confirm Cancel</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const d = new Date();
        d.setDate(d.getDate() + 3);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const input = document.getElementById("returnPickupDateInput");
        if (input) input.value = `${yyyy}-${mm}-${dd}`;
    });

    function startCancelWizard() {
        showCancelStep(2);
        document.getElementById('cancelWizardModal').classList.remove('hidden');
    }
    function closeCancelWizard() { document.getElementById('cancelWizardModal').classList.add('hidden'); }
    function showCancelStep(step) {
        document.getElementById('cancelStep2View').classList.add('hidden');
        document.getElementById('cancelStep3View').classList.add('hidden');
        document.getElementById('cancelStep4View').classList.add('hidden');
        if (step === 2) document.getElementById('cancelStep2View').classList.remove('hidden');
        else if (step === 3) document.getElementById('cancelStep3View').classList.remove('hidden');
        else if (step === 4) document.getElementById('cancelStep4View').classList.remove('hidden');
    }
    function goToCancelStep3() { showCancelStep(3); }
    function goToCancelStep2() { showCancelStep(2); }

    async function submitCancelWizard() {
        const btn = document.getElementById('cancelConfirmBtn');
        const selectedReason = document.querySelector('input[name="cancelReasonRadio"]:checked')?.value || 'Ordered by mistake';
        const comments = document.getElementById('cancelCommentsInput').value.trim();
        btn.disabled = true;
        try {
            const res = await fetch('/orders/<%= order._id %>/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: selectedReason, comments })
            });
            const data = await res.json();
            if (res.ok && data.success) { showCancelStep(4); }
            else { alert(data.message || 'Failed'); btn.disabled = false; }
        } catch (err) { alert('Network error'); btn.disabled = false; }
    }

    function startReturnWizard() {
        showReturnStep(2);
        document.getElementById('returnWizardModal').classList.remove('hidden');
    }
    function closeReturnWizard() { document.getElementById('returnWizardModal').classList.add('hidden'); }
    function showReturnStep(step) {
        document.getElementById('returnStep2View').classList.add('hidden');
        document.getElementById('returnStep3View').classList.add('hidden');
        document.getElementById('returnStep4View').classList.add('hidden');
        document.getElementById('returnStep5View').classList.add('hidden');
        if (step === 2) document.getElementById('returnStep2View').classList.remove('hidden');
        else if (step === 3) document.getElementById('returnStep3View').classList.remove('hidden');
        else if (step === 4) document.getElementById('returnStep4View').classList.remove('hidden');
        else if (step === 5) document.getElementById('returnStep5View').classList.remove('hidden');
    }
    function goToReturnStep3() { showReturnStep(3); }
    function goToReturnStep2() { showReturnStep(2); }
    function goToReturnStep4() { showReturnStep(4); }

    async function submitReturnWizard() {
        const btn = document.getElementById('returnSubmitBtn');
        const selectedReason = document.querySelector('input[name="returnReasonRadio"]:checked')?.value || 'Product is defective';
        const comments = document.getElementById('returnCommentsInput').value.trim();
        const pickupMethod = document.querySelector('input[name="pickupMethodRadio"]:checked')?.value || 'Pick up from my address';
        const pickupDate = document.getElementById('returnPickupDateInput').value;

        btn.disabled = true;
        try {
            const res = await fetch('/orders/<%= order._id %>/return', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: selectedReason, comments, pickupMethod, pickupDate })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                document.getElementById('returnSuccessPickupDateDisplay').textContent = data.pickupDate || pickupDate;
                showReturnStep(5);
            } else { alert(data.message || 'Failed'); btn.disabled = false; }
        } catch(err) { alert('Network error'); btn.disabled = false; }
    }

    function openCancelItemModal(itemId) {
        document.getElementById('cancelTargetItemId').value = itemId;
        document.getElementById('cancelItemModal').classList.remove('hidden');
    }
    function closeCancelItemModal() {
        document.getElementById('cancelItemModal').classList.add('hidden');
    }
    async function submitCancelItem() {
        const itemId = document.getElementById('cancelTargetItemId').value;
        const reason = document.getElementById('cancelItemReasonInput').value.trim();
        const btn = document.getElementById('cancelItemSubmitBtn');
        if (!itemId) return;
        btn.disabled = true;
        try {
            const response = await fetch('/orders/<%= order._id %>/cancel-item', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemId, reason })
            });
            const data = await response.json();
            if (response.ok && data.success) {
                location.reload();
            } else { alert(data.message || 'Failed'); btn.disabled = false; }
        } catch(err) { alert('Network error'); btn.disabled = false; }
    }

    // ── FLIPKART STYLE INTERACTIVE DELIVERY STEP TRACKER ──
    const orderStatusHierarchy = ["Pending", "Processing", "Shipped", "Out for Delivery", "Delivered"];
    const currentOrderStatus = "<%= order.status %>";

    const deliveryStepData = {
        "Pending": {
            title: "1. Order Placed & Confirmed",
            icon: "📋",
            description: "Your order #<%= order.orderId %> has been received and verified by Nafahath Perfumes. Stock reserved for packaging.",
            timestamp: "Placed on <%= new Date(order.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>"
        },
        "Processing": {
            title: "2. Fragrance Quality Check & Packaging",
            icon: "📦",
            description: "Your perfume items are undergoing final scent quality inspection, bottle seal verification, and luxury protective packaging.",
            timestamp: "Processing in progress at fulfillment center. Expected dispatch within 24 hours."
        },
        "Shipped": {
            title: "3. Handed Over to Express Logistics",
            icon: "🚚",
            description: "Your package is currently in transit with our logistics courier partner. Courier AWB tracking: NAF-EXPRESS-<%= order.orderId.slice(-6) %>.",
            timestamp: "In transit. Estimated arrival: 2-4 business days."
        },
        "Out for Delivery": {
            title: "4. Out for Delivery Today",
            icon: "🛵",
            description: "Our local courier delivery executive is out for delivery with your fragrance package today. Please keep your phone reachable.",
            timestamp: "Delivery agent arriving today."
        },
        "Delivered": {
            title: "5. Order Delivered Successfully",
            icon: "🏠",
            description: "Package successfully delivered to destination address: <%= order.shippingAddress.fullName %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>.",
            timestamp: "Delivered to recipient address."
        }
    };

    function selectDeliveryStep(code) {
        const step = deliveryStepData[code];
        if (!step) return;

        const currentIdx = orderStatusHierarchy.indexOf(currentOrderStatus);
        const selectedIdx = orderStatusHierarchy.indexOf(code);

        // Highlight active circle ring
        orderStatusHierarchy.forEach(c => {
            const circle = document.getElementById(`stepCircle-${c}`);
            if (circle) {
                circle.classList.remove('ring-4', 'ring-[#22d3ee]/60', 'scale-125');
            }
        });
        const activeCircle = document.getElementById(`stepCircle-${code}`);
        if (activeCircle) {
            activeCircle.classList.add('ring-4', 'ring-[#22d3ee]/60', 'scale-125');
        }

        // Update Card Contents
        const iconBox = document.getElementById('detailIconBox');
        const title = document.getElementById('detailTitle');
        const desc = document.getElementById('detailDescription');
        const timeText = document.getElementById('detailTimeText');
        const badge = document.getElementById('detailBadge');

        if (iconBox) iconBox.textContent = step.icon;
        if (title) title.textContent = step.title;
        if (desc) desc.textContent = step.description;
        if (timeText) timeText.textContent = step.timestamp;

        if (badge) {
            if (selectedIdx < currentIdx) {
                badge.textContent = "COMPLETED ✓";
                badge.className = "px-2.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-widest border border-emerald-500/40 text-emerald-400 bg-emerald-500/10";
            } else if (selectedIdx === currentIdx) {
                badge.textContent = "CURRENT STAGE ●";
                badge.className = "px-2.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-widest border border-[#22d3ee]/40 text-[#22d3ee] bg-[#22d3ee]/10 animate-pulse";
            } else {
                badge.textContent = "UPCOMING ◯";
                badge.className = "px-2.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-widest border border-gray-700 text-gray-500 bg-gray-800/40";
            }
        }
    }

    // Auto select current order status step on page load
    document.addEventListener("DOMContentLoaded", function() {
        if (deliveryStepData[currentOrderStatus]) {
            selectDeliveryStep(currentOrderStatus);
        } else {
            selectDeliveryStep("Pending");
        }
    });
</script>
