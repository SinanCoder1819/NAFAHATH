<main class="min-h-screen bg-[#060606] text-white py-12 px-4 md:px-8 lg:px-12 font-['Inter',sans-serif]">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar Navigation -->
        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 sticky top-28 shadow-2xl">
                <div class="mb-10">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-[#22d3ee] font-bold mb-6 opacity-80">Dashboard</p>
                    <nav class="flex flex-col gap-2">
                        <a href="/profile" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium">Profile</span>
                        </a>
                        
                        <a href="/orders" class="group flex items-center gap-4 px-4 py-3 rounded-xl bg-[#22d3ee]/10 text-[#22d3ee] border border-[#22d3ee]/20 transition-all">
                            <svg class="w-5 h-5 opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                            <span class="text-sm font-medium">My Orders</span>
                        </a>

                        <a href="/wallet" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                            <span class="text-sm font-medium">Wallet</span>
                        </a>

                        <a href="/address" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                            <span class="text-sm font-medium">Addresses</span>
                        </a>

                        <a href="/referrals" class="group flex items-center gap-4 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition-all border border-transparent">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z"/></svg>
                            <span class="text-sm font-medium">Refer & Earn</span>
                        </a>
                    </nav>
                </div>

                <div class="pt-6 border-t border-gray-800">
                    <form action="/auth/logout" method="post">
                        <button class="flex items-center gap-4 px-4 py-3 text-red-400 hover:bg-red-500/10 rounded-xl transition-all group w-full text-left">
                            <svg class="w-5 h-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Order Details Section -->
        <section class="flex-1 space-y-8">
            
            <div class="relative overflow-hidden bg-[#0f0f0f] border border-gray-800 rounded-3xl p-8 md:p-10 shadow-2xl">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-[#22d3ee]/10 blur-[80px] rounded-full"></div>
                
                <!-- Detail Header -->
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-gray-800/80 mb-8">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <a href="/orders" class="text-xs text-gray-500 hover:text-white transition-all flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                                Back to My Orders
                            </a>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-serif text-white italic mb-1">Order #<%= order.orderId %></h2>
                        <p class="text-xs text-gray-400">Placed on <%= new Date(order.createdAt).toLocaleString("en-US", { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <!-- Invoice Download Link -->
                        <a href="/orders/<%= order._id %>/invoice" class="px-5 py-3 rounded-xl border border-[#22d3ee]/20 hover:border-[#22d3ee]/40 bg-[#22d3ee]/5 hover:bg-[#22d3ee]/10 text-xs font-bold uppercase tracking-wider text-[#22d3ee] hover:text-cyan-300 transition-all flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                            Invoice PDF
                        </a>

                        <!-- Return Order Action (Only if delivered) -->
                        <% if (order.status === "Delivered") { %>
                            <button onclick="startReturnWizard('<%= order._id %>', '<%= order.orderId %>')" class="px-5 py-3 rounded-xl border border-[#22d3ee]/30 hover:border-[#22d3ee] bg-[#22d3ee]/10 text-[#22d3ee] hover:text-[#03111a] hover:bg-[#22d3ee] text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                                Return / Replace
                            </button>
                        <% } %>

                        <!-- Cancel Order Action (Only if Pending or Processing) -->
                        <% if (["Pending", "Processing"].includes(order.status)) { %>
                            <button onclick="startCancelWizard('<%= order._id %>', '<%= order.orderId %>')" class="px-5 py-3 rounded-xl border border-red-500/30 hover:border-red-500 bg-red-500/5 hover:bg-red-500/15 text-red-400 hover:text-red-300 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                                Cancel Order
                            </button>
                        <% } %>
                    </div>
                </div>

                <!-- ── ORDER PROGRESS TRACKER (Flipkart Style Interactive Tracker) ── -->
                <% if (!["Cancelled", "Returned", "Return Requested"].includes(order.status)) { %>
                    <div class="mb-10 bg-[#121212]/40 border border-gray-800/60 rounded-3xl p-6 md:p-8 shadow-xl">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-widest text-[#22d3ee]">Delivery Progress Tracker</h4>
                                <p class="text-[11px] text-gray-400 mt-1">Click on any stage below to inspect detailed status tracking</p>
                            </div>
                            <span class="px-3.5 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider border border-[#22d3ee]/30 text-[#22d3ee] bg-[#22d3ee]/10">
                                Current: <%= order.status %>
                            </span>
                        </div>

                        <div class="relative flex items-center justify-between mb-8 px-2">
                            <!-- Progress Line background -->
                            <div class="absolute left-6 right-6 top-1/2 -translate-y-1/2 h-[3px] bg-gray-800 z-0"></div>
                            
                            <!-- Highlighted Progress Line -->
                            <% 
                                let percent = "0%";
                                if (order.status === "Pending") percent = "10%";
                                else if (order.status === "Processing") percent = "30%";
                                else if (order.status === "Shipped") percent = "55%";
                                else if (order.status === "Out for Delivery") percent = "80%";
                                else if (order.status === "Delivered") percent = "100%";
                            %>
                            <div class="absolute left-6 top-1/2 -translate-y-1/2 h-[3px] bg-gradient-to-r from-[#22d3ee] to-[#00b4d8] z-0 transition-all duration-500 shadow-[0_0_10px_rgba(34,211,238,0.5)]" style="width: calc(<%= percent %> - 1.5rem);"></div>

                            <!-- Steps -->
                            <% 
                                const steps = [
                                    { label: "Pending", code: "Pending" },
                                    { label: "Processing", code: "Processing" },
                                    { label: "Shipped", code: "Shipped" },
                                    { label: "Out for Delivery", code: "Out for Delivery" },
                                    { label: "Delivered", code: "Delivered" }
                                ];
                                const isPassed = (code) => {
                                    const hierarchy = ["Pending", "Processing", "Shipped", "Out for Delivery", "Delivered"];
                                    return hierarchy.indexOf(order.status) >= hierarchy.indexOf(code);
                                };
                            %>
                            <% steps.forEach((step, idx) => { %>
                                <button 
                                    type="button"
                                    id="stepBtn-<%= step.code %>"
                                    onclick="selectDeliveryStep('<%= step.code %>')"
                                    class="relative z-10 flex flex-col items-center group cursor-pointer bg-transparent border-none focus:outline-none transition-all">
                                    
                                    <div id="stepCircle-<%= step.code %>" class="w-10 h-10 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300 group-hover:scale-110
                                                <%= isPassed(step.code) ? 'border-[#22d3ee] bg-[#0f0f0f] text-[#22d3ee] scale-110 shadow-[0_0_15px_rgba(34,211,238,0.3)]' : 'border-gray-800 bg-[#0f0f0f] text-gray-500' %>">
                                        <% if (isPassed(step.code)) { %>
                                            ✓
                                        <% } else { %>
                                            <%= idx + 1 %>
                                        <% } %>
                                    </div>
                                    
                                    <span id="stepLabel-<%= step.code %>" class="text-[10px] font-extrabold uppercase tracking-widest mt-2.5 transition-all
                                                 <%= isPassed(step.code) ? 'text-[#22d3ee]' : 'text-gray-600 group-hover:text-gray-300' %>">
                                        <%= step.label %>
                                    </span>
                                </button>
                            <% }) %>
                        </div>

                        <!-- Flipkart Style Detailed Information Card -->
                        <div id="deliveryDetailCard" class="bg-[#161822] border border-[#22d3ee]/20 rounded-2xl p-5 transition-all duration-300 relative overflow-hidden">
                            <div class="flex items-start gap-4">
                                <div id="detailIconBox" class="w-12 h-12 rounded-xl bg-[#22d3ee]/10 border border-[#22d3ee]/30 flex items-center justify-center text-xl text-[#22d3ee] shrink-0">
                                    📦
                                </div>
                                <div class="flex-grow min-w-0">
                                    <div class="flex items-center justify-between gap-2 mb-1">
                                        <h4 id="detailTitle" class="text-sm font-extrabold text-white">Select a stage to view progress</h4>
                                        <span id="detailBadge" class="px-2.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-widest border border-gray-700 text-gray-400">
                                            Status
                                        </span>
                                    </div>
                                    <p id="detailDescription" class="text-xs text-gray-300 leading-relaxed mb-2">Click on any progress step above to view status details and timelines.</p>
                                    <p id="detailTimestamp" class="text-[11px] text-[#22d3ee] font-semibold flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span id="detailTimeText">Updated status information</span>
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                <% } else if (order.status === 'Cancelled') { %>
                    <!-- Cancelled Order Banner -->
                    <div class="mb-10 p-6 rounded-2xl border border-red-500/30 bg-red-500/5 text-center">
                        <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 mx-auto mb-3">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        </div>
                        <h3 class="text-lg font-serif italic text-red-300 mb-1">Order Cancelled</h3>
                        <% if (order.cancellationReason) { %>
                            <p class="text-xs text-gray-400 italic mb-1">Reason: "<%= order.cancellationReason %>"</p>
                        <% } %>
                        <% if (order.cancellationComments) { %>
                            <p class="text-xs text-gray-500">Comments: "<%= order.cancellationComments %>"</p>
                        <% } %>
                    </div>
                <% } else { %>
                    <!-- ── STEP 6: RETURN STATUS TIMELINE (6 Stages Including Refund Completed) ── -->
                    <div id="return-timeline" class="mb-10 bg-[#0d121a] border border-[#22d3ee]/30 rounded-3xl p-6 md:p-8 shadow-xl">
                        <div class="flex items-center justify-between pb-4 border-b border-gray-800/80 mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-2xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-base font-extrabold text-white tracking-wide">6. Return Status Timeline</h3>
                                    <p class="text-xs text-gray-400">Return Reason: <span class="text-teal-300 font-semibold"><%= order.returnReason || 'Product Return' %></span></p>
                                </div>
                            </div>
                            <span class="px-3.5 py-1.5 rounded-full text-[11px] font-extrabold uppercase bg-teal-500/15 border border-teal-500/30 text-teal-300 tracking-wider">
                                <%= order.returnStatus || 'Return Requested' %>
                            </span>
                        </div>

                        <% 
                            const rStagesOrder = [
                                "Return Requested",
                                "Pick Up Scheduled",
                                "Picked Up",
                                "Under Review",
                                "Refund Initiated",
                                "Refund Completed"
                            ];
                            const currentRStage = order.returnStatus || "Return Requested";
                            const currentIdx = rStagesOrder.indexOf(currentRStage) !== -1 ? rStagesOrder.indexOf(currentRStage) : 0;
                            
                            const getStageStyle = (stageCode) => {
                                const idx = rStagesOrder.indexOf(stageCode);
                                if (idx < currentIdx) {
                                    return { icon: "✓", circleClass: "bg-emerald-500 text-black shadow-md shadow-emerald-500/20", titleClass: "text-emerald-400" };
                                } else if (idx === currentIdx) {
                                    return { icon: "●", circleClass: "bg-[#22d3ee] text-black animate-pulse shadow-md shadow-[#22d3ee]/20", titleClass: "text-[#22d3ee]" };
                                } else {
                                    return { icon: "◯", circleClass: "border-2 border-gray-700 bg-[#0d121a] text-gray-600", titleClass: "text-gray-500" };
                                }
                            };
                        %>

                        <!-- Timeline Vertical Step Tracker -->
                        <div class="relative pl-12 space-y-8 before:absolute before:left-[13px] before:top-3 before:bottom-3 before:w-[2px] before:bg-gray-800">
                            
                            <!-- 1. Return Requested -->
                            <% const stg1 = getStageStyle("Return Requested"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg1.circleClass %>">
                                    <%= stg1.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg1.titleClass %>">Return Requested</h4>
                                    <p class="text-[11px] text-gray-400"><%= order.returnTimeline?.requestedAt ? new Date(order.returnTimeline.requestedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : new Date(order.updatedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></p>
                                </div>
                            </div>

                            <!-- 2. Pick Up Scheduled -->
                            <% const stg2 = getStageStyle("Pick Up Scheduled"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg2.circleClass %>">
                                    <%= stg2.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg2.titleClass %>">Pick Up Scheduled</h4>
                                    <p class="text-[11px] text-gray-400"><%= order.returnPickupDate ? new Date(order.returnPickupDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : 'Scheduled' %> (<%= order.returnPickupMethod || 'Pick up from address' %>)</p>
                                </div>
                            </div>

                            <!-- 3. Picked Up -->
                            <% const stg3 = getStageStyle("Picked Up"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg3.circleClass %>">
                                    <%= stg3.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg3.titleClass %>">Picked Up</h4>
                                    <p class="text-[11px] text-gray-400">Package handed to courier</p>
                                </div>
                            </div>

                            <!-- 4. Under Review -->
                            <% const stg4 = getStageStyle("Under Review"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg4.circleClass %>">
                                    <%= stg4.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg4.titleClass %>">Under Review</h4>
                                    <p class="text-[11px] text-gray-400">Quality inspection in progress at fulfillment center</p>
                                </div>
                            </div>

                            <!-- 5. Refund Initiated -->
                            <% const stg5 = getStageStyle("Refund Initiated"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg5.circleClass %>">
                                    <%= stg5.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg5.titleClass %>">Refund Initiated</h4>
                                    <p class="text-[11px] text-gray-400">Refund processing initiated to original payment source</p>
                                </div>
                            </div>

                            <!-- 6. Refund Completed (New 6th Option) -->
                            <% const stg6 = getStageStyle("Refund Completed"); %>
                            <div class="relative group">
                                <div class="absolute -left-12 top-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-extrabold ring-4 ring-[#0d121a] <%= stg6.circleClass %>">
                                    <%= stg6.icon %>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5 <%= stg6.titleClass %>">Refund Completed</h4>
                                    <p class="text-[11px] text-gray-400">Refund successfully credited to user's account / wallet</p>
                                </div>
                            </div>

                        </div>
                    </div>
                <% } %>

                <!-- ── CONTENT LAYOUT GRID ── -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    
                    <!-- Left: Products List (2 columns wide) -->
                    <div class="lg:col-span-2 space-y-6">
                        <h3 class="text-xs font-bold uppercase tracking-widest text-[#22d3ee] mb-4">Ordered Scents</h3>
                        
                        <div class="space-y-4">
                            <% order.items.forEach(item => { %>
                                <div class="border border-gray-800 bg-[#121212]/20 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center gap-5">
                                    
                                    <!-- Image -->
                                    <div class="w-16 h-16 rounded-xl border border-gray-800 bg-black overflow-hidden shrink-0">
                                        <img src="<%= item.primaryImage || 'https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=300&q=80' %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                                    </div>
                                    
                                    <!-- Descriptions -->
                                    <div class="flex-grow min-w-0">
                                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1">
                                            <h4 class="text-sm font-semibold text-white truncate"><%= item.productName %></h4>
                                            
                                            <% if (item.status !== "Pending" || order.status !== "Pending") { %>
                                                <% 
                                                    let itemBadge = "";
                                                    if (item.status === "Cancelled") itemBadge = "border-red-600/20 text-red-400 bg-red-500/5";
                                                    else if (item.status === "Returned") itemBadge = "border-teal-600/20 text-teal-300 bg-teal-500/5";
                                                    else if (item.status === "Delivered") itemBadge = "border-emerald-600/20 text-emerald-400 bg-emerald-500/5";
                                                    else itemBadge = "border-gray-800 text-gray-400";
                                                %>
                                                <span class="px-2 py-0.5 rounded text-[8px] font-extrabold uppercase tracking-widest border <%= itemBadge %>">
                                                    <%= item.status %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-gray-500 mb-1"><%= item.brand %> • Size: <span class="text-gray-300 font-medium"><%= item.size %></span></p>
                                        <p class="text-xs font-bold text-[#22d3ee]">₹<%= item.price.toLocaleString() %> <span class="text-gray-600 font-normal">x <%= item.quantity %></span></p>
                                    </div>
                                    
                                    <!-- Actions & Total -->
                                    <div class="sm:text-right w-full sm:w-auto flex sm:flex-col items-center sm:items-end justify-between gap-3 shrink-0">
                                        <span class="text-sm font-extrabold text-white">₹<%= item.totalPrice.toLocaleString() %></span>
                                        
                                        <% if (["Pending", "Processing"].includes(order.status) && !["Cancelled", "Returned"].includes(item.status)) { %>
                                            <button onclick="openCancelItemModal('<%= item._id %>')" class="text-[9px] font-bold uppercase tracking-widest text-red-400 hover:text-red-300 bg-red-500/5 border border-red-500/10 px-2.5 py-1.5 rounded-lg hover:border-red-500/30 transition-all cursor-pointer">
                                                Cancel Item
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Right Column: Shipping & Pricing Info -->
                    <div class="space-y-6">
                        
                        <!-- Delivery coordinate card -->
                        <div class="bg-[#121212]/30 border border-gray-800/60 rounded-2xl p-6">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-[#22d3ee] mb-4 flex items-center gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                                Shipping Coordinates
                            </h3>
                            <div class="space-y-2 text-xs text-gray-300">
                                <p class="font-bold text-white"><%= order.shippingAddress.fullName %></p>
                                <p class="text-gray-400 leading-relaxed"><%= order.shippingAddress.addressLine %></p>
                                <p class="text-gray-400"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.postalCode %></p>
                                <p class="pt-2 text-gray-500 flex items-center gap-1 font-medium">
                                    <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                    <%= order.shippingAddress.phone %>
                                </p>
                            </div>
                        </div>

                        <!-- Payment meta card -->
                        <div class="bg-[#121212]/30 border border-gray-800/60 rounded-2xl p-6">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-[#22d3ee] mb-4 flex items-center gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                Transaction Summary
                            </h3>
                            <div class="space-y-3 text-xs text-gray-300">
                                <div class="flex justify-between">
                                    <span class="text-gray-500">Method</span>
                                    <span class="font-semibold text-slate-200"><%= order.paymentMethod === 'COD' ? 'Cash on Delivery (COD)' : order.paymentMethod %></span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-500">Status</span>
                                    <% 
                                        let statusText = "Pending";
                                        let statusColor = "text-amber-400";
                                        if (order.paymentStatus === "Refunded") {
                                            statusText = "Refunded";
                                            statusColor = "text-purple-400";
                                        } else if (order.status === "Delivered" || order.paymentStatus === "Paid") {
                                            statusText = "Paid";
                                            statusColor = "text-emerald-400";
                                        } else {
                                            statusText = "Pending";
                                            statusColor = "text-amber-400";
                                        }
                                    %>
                                    <span class="font-extrabold uppercase tracking-wide <%= statusColor %>"><%= statusText %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing totals breakdown card -->
                        <div class="bg-[#121212]/30 border border-gray-800/60 rounded-2xl p-6 space-y-4">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-[#22d3ee] border-b border-gray-800 pb-3">Bill Details</h3>
                            
                            <div class="space-y-3 text-xs">
                                <div class="flex justify-between text-gray-400">
                                    <span>Subtotal</span>
                                    <span>₹<%= order.subtotal.toLocaleString() %></span>
                                </div>
                                <% if (order.discount > 0) { %>
                                    <div class="flex justify-between text-emerald-400 font-medium">
                                        <span>Discount Applied</span>
                                        <span>- ₹<%= order.discount.toLocaleString() %></span>
                                    </div>
                                <% } %>
                                <div class="flex justify-between text-gray-400">
                                    <span>Shipping</span>
                                    <span><%= order.shipping > 0 ? `₹${order.shipping}` : 'Free' %></span>
                                </div>
                                <% if (order.taxes > 0) { %>
                                    <div class="flex justify-between text-gray-500">
                                        <span>Taxes (GST 18%)</span>
                                        <span>₹<%= order.taxes.toLocaleString() %></span>
                                    </div>
                                <% } %>
                                
                                <div class="border-t border-gray-800/60 pt-3 flex justify-between items-end">
                                    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Total Paid</span>
                                    <span class="text-xl font-extrabold text-[#22d3ee] font-serif">₹<%= order.finalTotal.toLocaleString() %></span>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>
</main>

