<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600&display=swap');

  @keyframes nvSheen {
    0% {
      background-position: 0% center;
    }

    100% {
      background-position: 200% center;
    }
  }

  .nv-brand-name {
    font-family: 'Playfair Display', serif;
    background: linear-gradient(135deg, #C5A267 0%, #f0d08a 50%, #C5A267 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: nvSheen 4s linear infinite;
  }
</style>

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

<nav
  class="sticky top-0 z-[100] font-[Inter,sans-serif] bg-black/80 backdrop-blur-lg border-b border-white/5 shadow-[0_1px_0_rgba(40,201,244,0.08)]"
  x-data="{ open: false, profileOpen: false }">
  <div class="max-w-[1400px] mx-auto px-7 h-[68px] flex items-center justify-between">


    <!-- Favicon -->
    
    <!-- BRAND -->
    <a href="/" class="flex flex-col no-underline leading-[1.1] shrink-0">
      <span class="nv-brand-name text-[19px] font-semibold tracking-[0.22em]">NAFAHATH</span>
      <span class="text-[7px] tracking-[0.45em] text-[#8a6d3b] uppercase pl-px">Perfumes &amp; Fragrances</span>
    </a>
    
    <!-- DESKTOP NAV LINKS -->
    <ul class="hidden md:flex items-center gap-9 list-none m-0 p-0">
      <li>
        <a href="/" class="relative text-[10.5px] font-bold tracking-[0.22em] uppercase text-gray-500 hover:text-white no-underline transition-colors duration-[250ms] pb-[3px]
                  after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-[1.5px]
                  after:bg-gradient-to-r after:from-[#28c9f4] after:to-[#0ea5e9]
                  after:w-0 hover:after:w-full after:transition-all after:duration-300 after:rounded-full">
          Home
        </a>
      </li>
      <li>
        <a href="/shop" class="relative text-[10.5px] font-bold tracking-[0.22em] uppercase text-gray-500 hover:text-white no-underline transition-colors duration-[250ms] pb-[3px]
                  after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-[1.5px]
                  after:bg-gradient-to-r after:from-[#28c9f4] after:to-[#0ea5e9]
                  after:w-0 hover:after:w-full after:transition-all after:duration-300 after:rounded-full">
          Shop
        </a>
      </li>
      <li>
        <a href="/about" class="relative text-[10.5px] font-bold tracking-[0.22em] uppercase text-gray-500 hover:text-white no-underline transition-colors duration-[250ms] pb-[3px]
                  after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-[1.5px]
                  after:bg-gradient-to-r after:from-[#28c9f4] after:to-[#0ea5e9]
                  after:w-0 hover:after:w-full after:transition-all after:duration-300 after:rounded-full">
          About
        </a>
      </li>
    </ul>

    <!-- RIGHT ACTIONS -->
    <div class="flex items-center gap-2">

      <% if (user) { %>
        <!-- CART -->
        <!-- CART -->
        <a href="/cart" title="Cart"
          class="relative w-10 h-10 rounded-xl flex items-center justify-center border border-white/5 bg-white/[0.02] text-gray-500 hover:text-[#28c9f4] hover:border-[#28c9f4]/30 hover:bg-[#28c9f4]/5 hover:shadow-[0_0_16px_rgba(40,201,244,0.15)] transition-all duration-[220ms] no-underline">

          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <path d="M16 10a4 4 0 0 1-8 0" />
          </svg>

          <!-- Add this badge code right below the SVG -->
          <span id="navCartBadge"
            class="absolute -top-[5px] -right-[5px] min-w-[17px] h-[17px] px-1 bg-[#28c9f4] text-[#03111a] text-[9px] font-extrabold rounded-[20px] flex items-center justify-center border-[1.5px] border-[#04080e] <%= locals.cartCount > 0 ? '' : 'hidden' %>">
            <%= locals.cartCount> 99 ? '99+' : (locals.cartCount || 0) %>
          </span>

        </a>

        <!-- WISHLIST -->
        <a href="/wishlist" title="Wishlist" class="relative w-10 h-10 rounded-xl flex items-center justify-center border border-white/5 bg-white/[0.02] text-gray-500
                  hover:text-[#28c9f4] hover:border-[#28c9f4]/30 hover:bg-[#28c9f4]/5 hover:shadow-[0_0_16px_rgba(40,201,244,0.15)]
                  transition-all duration-[220ms] no-underline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <span id="navWishlistBadge"
            class="absolute -top-[5px] -right-[5px] min-w-[17px] h-[17px] px-1 bg-[#28c9f4] text-[#03111a] text-[9px] font-extrabold rounded-[20px] flex items-center justify-center border-[1.5px] border-[#04080e] <%= locals.wishlistCount > 0 ? '' : 'hidden' %>">
            <%= locals.wishlistCount> 99 ? '99+' : (locals.wishlistCount || 0) %>
          </span>
        </a>
        <% } %>

          <!-- PROFILE -->
          <div class="relative flex items-center gap-2" @click.away="profileOpen = false">
            <% if (user && (user.name || user.fullname)) { %>
              <span
                class="hidden sm:inline text-[10px] font-bold tracking-[0.1em] uppercase text-[#C5A267] whitespace-nowrap">
                <%= user.name || user.fullname %>
              </span>
              <% } %>

                <button class="bg-transparent border-0 cursor-pointer p-0 flex items-center gap-2"
                  @click="profileOpen = !profileOpen">
                  <div
                    class="w-9 h-9 rounded-full border border-[#C5A267]/35 bg-[#C5A267]/10 flex items-center justify-center text-[#C5A267] overflow-hidden hover:border-[#C5A267]/70 transition-colors duration-200">
                    <% if (user && user.profileImage) { %>
                      <img id="navProfilePic" src="<%= user.profileImage %>" alt="Profile"
                        class="w-full h-full object-cover">
                      <% } else { %>
                        <svg id="navDefaultIcon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                          <circle cx="12" cy="7" r="4" />
                        </svg>
                        <% } %>
                  </div>
                </button>

                <!-- DROPDOWN -->
                <div
                  class="absolute top-[calc(100%+12px)] right-0 w-56 bg-[#060a12]/95 backdrop-blur-xl border border-white/[0.08] rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.6)] overflow-hidden z-50"
                  x-show="profileOpen" x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
                  style="display:none;">
                  <% if (user) { %>
                    <div class="px-[18px] py-4 border-b border-white/[0.06]">
                      <div class="text-[13px] font-semibold text-slate-200">
                        <%= user.name || user.fullname %>
                      </div>
                      <div class="text-[10px] text-gray-700 mt-0.5 whitespace-nowrap overflow-hidden text-ellipsis">
                        <%= user.email %>
                      </div>
                    </div>
                    <div class="p-2">
                      <a href="/profile"
                        class="block px-3 py-2.5 rounded-[10px] text-xs font-medium text-slate-500 no-underline transition-all duration-200 hover:text-[#C5A267] hover:bg-[#C5A267]/[0.06]">
                        My Profile
                      </a>
                      <a href="/orders"
                        class="block px-3 py-2.5 rounded-[10px] text-xs font-medium text-slate-500 no-underline transition-all duration-200 hover:text-[#C5A267] hover:bg-[#C5A267]/[0.06]">
                        Order History
                      </a>
                      <div class="h-px bg-white/5 my-1"></div>
                      <form action="/auth/logout" method="post" class="m-0">
                        <button
                          class="w-full bg-transparent border-0 cursor-pointer text-left font-[inherit] block px-3 py-2.5 rounded-[10px] text-xs font-medium text-red-400 transition-all duration-200 hover:bg-red-400/[0.06] hover:text-red-500">
                          Sign Out
                        </button>
                      </form>
                    </div>
                    <% } else { %>
                      <div class="p-4 flex flex-col gap-2">
                        <a href="/auth/login" class="block text-center px-2.5 py-2.5 rounded-[10px] text-[10px] font-extrabold tracking-[0.1em] uppercase no-underline transition-all duration-200
                        bg-gradient-to-br from-[#C5A267] to-[#f0d08a] text-[#04080e]">
                          Log In
                        </a>
                        <a href="/auth/signup" class="block text-center px-2.5 py-2.5 rounded-[10px] text-[10px] font-extrabold tracking-[0.1em] uppercase no-underline transition-all duration-200
                        border border-white/10 text-slate-200 hover:border-[#C5A267]/40 hover:text-[#C5A267]">
                          Sign Up
                        </a>
                      </div>
                      <% } %>
                </div>
          </div>

          <!-- MOBILE BURGER -->
          <button
            class="flex md:hidden items-center justify-center bg-transparent border-0 cursor-pointer p-1.5 text-slate-500 hover:text-slate-200 transition-colors duration-200"
            @click="open = !open">
            <svg x-show="!open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
            <svg x-show="open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>

    </div>
  </div>

  <!-- MOBILE DRAWER -->
  <div class="bg-[#04080e]/[0.97] backdrop-blur-lg border-t border-white/5 px-7 py-6" x-show="open"
    x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2"
    style="display:none;">
    <a href="/"
      class="block py-3 text-[11px] font-bold tracking-[0.2em] uppercase text-slate-500 no-underline border-b border-white/[0.04] transition-colors duration-200 hover:text-[#28c9f4]">
      Home
    </a>
    <a href="/shop"
      class="block py-3 text-[11px] font-bold tracking-[0.2em] uppercase text-slate-500 no-underline border-b border-white/[0.04] transition-colors duration-200 hover:text-[#28c9f4]">
      Shop
    </a>
    <a href="/about"
      class="block py-3 text-[11px] font-bold tracking-[0.2em] uppercase text-slate-500 no-underline border-b border-white/[0.04] transition-colors duration-200 hover:text-[#28c9f4] last:border-b-0">
      About
    </a>
    <% if (user) { %>
      <div class="mt-5 pt-5 border-t border-white/[0.06] flex gap-3">
        <a href="/wishlist" title="Wishlist" class="relative w-10 h-10 rounded-xl flex items-center justify-center border border-white/5 bg-white/[0.02] text-gray-500
                  hover:text-[#28c9f4] hover:border-[#28c9f4]/30 hover:bg-[#28c9f4]/5
                  transition-all duration-[220ms] no-underline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </a>
      </div>
      <% } %>
  </div>
</nav>