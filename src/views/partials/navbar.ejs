<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

<nav x-data="{ open: false, profileOpen: false }" class="sticky top-0 z-50 bg-black/80 backdrop-blur-md border-b border-gray-900">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex flex-col">
            <h1 class="text-xl font-serif-brand tracking-[0.2em] text-[#C5A267]">NAFAHATH</h1>
            <span class="text-[7px] tracking-[0.4em] text-[#C5A267] uppercase">Perfumes & Fragrances</span>
        </a>

        <div class="hidden md:flex space-x-10 text-[11px] tracking-[0.2em] font-medium text-gray-300">
            <a href="/" class="hover:text-white transition">HOME</a>
            <a href="/shop" class="hover:text-white transition">SHOP</a>
            <a href="/about" class="hover:text-white transition">ABOUT</a>
        </div>

        <div class="flex items-center space-x-4 md:space-x-6">
            <div class="flex items-center space-x-3 md:space-x-5 text-gray-300">
                <% if (user) { %>
                    <a href="/cart" class="hover:text-white transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                        </svg>
                    </a>

                    <a href="/wishlist" class="hidden md:block hover:text-white transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                            class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                        </svg>
                    </a>
                <% } %>

                <div class="relative flex items-center" @click.away="profileOpen = false">
                    <% if (user && (user.name || user.fullname)) { %>
                        <span class="hidden sm:inline mr-2 text-[10px] font-bold tracking-widest text-[#C5A267] uppercase">
                            <%= user.name || user.fullname %>
                        </span>
                    <% } %>

                    <button @click="profileOpen = !profileOpen" class="hover:text-white transition focus:outline-none flex items-center">
                        <div class="w-8 h-8 rounded-full overflow-hidden border border-gray-700 flex items-center justify-center bg-gray-800">
                            <% if (user && user.profileImage) { %>
                                <img id="navProfilePic" src="<%= user.profileImage %>" alt="Profile" class="w-full h-full object-cover rounded-full">
                            <% } else { %>
                                <svg id="navDefaultIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                </svg>
                            <% } %>
                        </div>
                    </button>

                    <div x-show="profileOpen" 
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         class="absolute right-0 mt-3 w-56 bg-[#0a0a0a]/95 backdrop-blur-xl border border-gray-800 rounded-2xl shadow-2xl py-3 z-[60]"
                         style="display: none; top: 100%;">
                        
                        <% if (user) { %>
                            <div class="px-5 py-3 border-b border-gray-800/50 mb-2 text-white">
                                <p class="text-sm font-semibold truncate"><%= user.name || user.fullname %></p>
                                <p class="text-[10px] text-gray-500 truncate"><%= user.email %></p>
                            </div>
                            <div class="px-2 space-y-1">
                                <a href="/profile" class="block px-3 py-2 text-xs text-gray-300 hover:text-[#C5A267] hover:bg-[#C5A267]/5 rounded-xl">My Profile</a>
                                <a href="/orders" class="block px-3 py-2 text-xs text-gray-300 hover:text-[#C5A267] hover:bg-[#C5A267]/5 rounded-xl">Order History</a>
                                <a href="/auth/logout" class="block px-3 py-2 text-xs text-red-500 hover:bg-red-500/5 rounded-xl">Sign Out</a>
                            </div>
                        <% } else { %>
                            <div class="p-4 space-y-3">
                                <a href="/auth/login" class="block w-full text-center bg-[#C5A267] text-black py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest">Log in</a>
                                <a href="/auth/signup" class="block w-full text-center border border-gray-700 text-white py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest">Signup</a>
                            </div>
                        <% } %>
                    </div>
                </div>

                <button @click="open = !open" class="md:hidden text-gray-300 hover:text-white focus:outline-none">
                    <svg x-show="!open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                    <svg x-show="open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <div x-show="open" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 -translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-4"
         class="md:hidden bg-black border-b border-gray-900 px-6 py-6 space-y-4"
         style="display: none;">
        
        <a href="/" class="block text-[11px] tracking-[0.2em] font-medium text-gray-300 hover:text-[#C5A267] transition">HOME</a>
        <a href="/shop" class="block text-[11px] tracking-[0.2em] font-medium text-gray-300 hover:text-[#C5A267] transition">SHOP</a>
        <a href="/about" class="block text-[11px] tracking-[0.2em] font-medium text-gray-300 hover:text-[#C5A267] transition">ABOUT</a>
        
        <% if (user) { %>
            <div class="pt-4 border-t border-gray-900 flex space-x-6">
                <a href="/wishlist" class="text-gray-300 hover:text-white flex items-center space-x-2 text-[10px] tracking-widest uppercase">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-[#C5A267]">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                    <span>Wishlist</span>
                </a>
            </div>
        <% } %>
    </div>
</nav>